@page "/distribution-points-manager"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using blazorBookLibrary.Data
@using BookLibrary.Domain
@using static BookLibrary.Shared.Commons
@using BookLibrary.Shared.Services
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.FSharp.Core
@inject IAdminServices AdminServices
@inject IDistributionPointService DistributionPointService
@inject AuthenticationStateProvider AuthStateProvider
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JSRuntime
@inject ILogger<DistributionPointsManager> Logger
@rendermode InteractiveServer

<PageTitle>@L["DistributionPointsManager"] — @L["TheModernArchivist"]</PageTitle>

<div class="sanctuary-container py-5">
    <div class="mb-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["DistributionPointsManager"]</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h1 class="display-4 text-serif mb-2">@L["DistributionPointsManager"]</h1>
                <p class="text-muted lead">@L["ManageDistributionPoints"]</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4 py-2 mb-2 shadow-sm" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg me-2"></i> @L["AddNewDistributionPoint"]
            </button>
        </div>
    </div>

    <div class="card-sanctuary p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h2 class="h4 text-serif mb-0">@L["DistributionPoints"]</h2>
            <div class="input-group" style="max-width: 350px;">
                <span class="input-group-text bg-transparent border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control border-start-0 ps-0" 
                       placeholder="@L["SearchByName"]" 
                       @bind="searchQuery" @bind:event="oninput" 
                       @onkeyup="HandleKeyUp" />
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@L["Loading"]...</span>
                </div>
                <p class="mt-2 text-muted">@L["RetrievingArchivalRecords"]...</p>
            </div>
        }
        else if (distributionPoints == null || !distributionPoints.Any())
        {
            <div class="text-center py-5 bg-surface-low rounded-3">
                <i class="bi bi-geo-alt display-4 text-muted mb-3 d-block"></i>
                <p class="text-muted mb-0">@L["NoDistributionPointsFound"]</p>
            </div>
        }
        else
        {
            <div class="editorial-ledger-container">
                <table class="editorial-ledger w-100">
                    <thead>
                        <tr>
                            <th class="ps-3">@L["Name"]</th>
                            <th>@L["DistributionPointInfo"]</th>
                            <th>@L["ReferenceUsers"]</th>
                            <th class="text-end pe-3">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dp in distributionPoints)
                        {
                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="fw-bold">@dp.Name.Value</div>
                                    <div class="text-muted small">ID: @dp.DistributionPointId.Value.ToString().Substring(0, 8)...</div>
                                </td>
                                <td class="py-3">
                                    <div class="text-wrap" style="max-width: 300px;">@dp.Info.Value</div>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (dp.ReferenceUsers.Any())
                                        {
                                            @foreach (var userId in dp.ReferenceUsers)
                                            {
                                                var user = GetManagerById(userId.Value.ToString());
                                                <span class="badge-sanctuary d-flex align-items-center gap-1">
                                                    @(user?.Nome ?? "User") @(user?.Cognome ?? "")
                                                    <button type="button" class="btn-close ms-1" style="font-size: 0.5rem;" 
                                                            @onclick="() => UnassignManager(dp, userId)" aria-label="Remove"></button>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">@L["NoneNotSet"]</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end pe-3 py-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        <div class="dropdown">
                                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-person-plus me-1"></i> @L["AssignManager"]
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                                @if (availableManagers != null && availableManagers.Any(m => !dp.ReferenceUsers.Any(ru => ru.Value.ToString() == m.Id)))
                                                {
                                                    @foreach (var manager in availableManagers.Where(m => !dp.ReferenceUsers.Any(ru => ru.Value.ToString() == m.Id)))
                                                    {
                                                        <li>
                                                            <button class="dropdown-item py-2" @onclick="() => AssignManager(dp, manager)">
                                                                <div class="fw-bold small">@manager.Nome @manager.Cognome</div>
                                                                <div class="text-muted smaller">@manager.Email</div>
                                                            </button>
                                                        </li>
                                                    }
                                                }
                                                else
                                                {
                                                    <li><span class="dropdown-item-text text-muted small">@L["NoArchivalManagersFound"]</span></li>
                                                }
                                            </ul>
                                        </div>

                                        @if (dp.ReferenceUsers.Any())
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-person-dash me-1"></i> @L["UnassignManager"]
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                                    @foreach (var userId in dp.ReferenceUsers)
                                                    {
                                                        var user = GetManagerById(userId.Value.ToString());
                                                        <li>
                                                            <button class="dropdown-item py-2 text-danger" @onclick="() => UnassignManager(dp, userId)">
                                                                <div class="fw-bold small">@(user?.Nome ?? "User") @(user?.Cognome ?? "")</div>
                                                                <div class="text-muted smaller">@(user?.Email ?? "ID: " + userId.Value)</div>
                                                            </button>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        <a href="/books-manager?dp=@dp.DistributionPointId.Value" class="btn btn-outline-info btn-sm rounded-pill px-3 d-inline-flex align-items-center text-decoration-none">
                                            <i class="bi bi-journal-text me-1"></i> @L["Books"]
                                        </a>
                                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => OpenEditModal(dp)">
                                            <i class="bi bi-pencil me-1"></i> @L["Edit"]
                                        </button>
                                        @if (removablePoints.Contains(dp.DistributionPointId.Value))
                                        {
                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="() => ConfirmRemove(dp)">
                                                <i class="bi bi-trash me-1"></i> @L["RemoveDistributionPoint"]
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Modal for Create/Edit *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg card-sanctuary">
                <div class="modal-header border-bottom-dashed px-4 py-3">
                    <h5 class="modal-title text-serif">@(isEditMode ? L["EditDistributionPoint"] : L["AddNewDistributionPoint"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body px-4 py-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase">@L["DistributionPointName"]</label>
                        <input type="text" class="form-control form-control-lg border-sanctuary" @bind="editingName" placeholder="e.g. Central Library Hub" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold small text-uppercase">@L["DistributionPointInfo"]</label>
                        <textarea class="form-control border-sanctuary" @bind="editingInfo" rows="3" placeholder="Address, opening hours, or special instructions..."></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0 small py-2">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" @onclick="CloseModal">@L["Cancel"]</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="SaveDistributionPoint" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        @L["Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private HashSet<Guid> removablePoints = new();
    private List<DistributionPoint>? distributionPoints;
    private List<ApplicationUser>? availableManagers;
    private string searchQuery = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showModal = false;
    private bool isEditMode = false;
    private string editingName = "";
    private string editingInfo = "";
    private DistributionPoint? currentEditPoint;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadDistributionPoints(), LoadManagers());
    }

    private async Task LoadDistributionPoints()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = string.IsNullOrWhiteSpace(searchQuery) 
                ? await DistributionPointService.GetAllDistributionPointsAsync(userContext) 
                : await DistributionPointService.FindDistributionPointsAsync(userContext,Name.New(searchQuery));
            
            if (result.IsOk)
            {
                distributionPoints = result.ResultValue.ToList();
                removablePoints.Clear();
                foreach (var dp in distributionPoints)
                {
                    var isRemovableResult = await DistributionPointService.IsRemovableAsync(userContext, dp.DistributionPointId);
                    if (isRemovableResult.IsOk && isRemovableResult.ResultValue)
                    {
                        removablePoints.Add(dp.DistributionPointId.Value);
                    }
                }
            }
            else
            {
                Logger.LogError("Error loading distribution points: {Error}", result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception loading distribution points");
            await ShowStatus(L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<ApplicationUser>> LoadManagers()
    {
        var users = await UserManager.GetUsersInRoleAsync("Manager");
        var admins = await UserManager.GetUsersInRoleAsync("Admin");
        availableManagers = users.Concat(admins)
            .GroupBy(u => u.Id)
            .Select(g => g.First())
            .ToList();
        return availableManagers;
    }

    private ApplicationUser? GetManagerById(string id)
    {
        return availableManagers?.FirstOrDefault(m => m.Id == id);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadDistributionPoints();
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        currentEditPoint = null;
        editingName = "";
        editingInfo = "";
        errorMessage = "";
        showModal = true;
    }

    private void OpenEditModal(DistributionPoint dp)
    {
        isEditMode = true;
        currentEditPoint = dp;
        editingName = dp.Name.Value;
        editingInfo = dp.Info.Value;
        errorMessage = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveDistributionPoint()
    {
        errorMessage = "";
        
        var nameResult = NonEmptyName.New(editingName);
        if (nameResult.IsError)
        {
            errorMessage = nameResult.ErrorValue;
            return;
        }

        isSaving = true;
        try
        {
            FSharpResult<Unit, string> result;
            if (isEditMode && currentEditPoint != null)
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var userContext = TenantState.GetUserContext(authState.User);
                // Update Name if changed
                if (currentEditPoint.Name.Value != editingName)
                {
                    result = await AdminServices.RenameDistributionPointAsync(userContext,currentEditPoint.DistributionPointId, nameResult.ResultValue);
                    if (result.IsError) 
                    { 
                        Logger.LogError("Error renaming distribution point: {Error}", result.ErrorValue);
                        errorMessage = L["ErrorOccurred"].Value; 
                        return; 
                    }
                }
                
                // Update Info if changed
                if (currentEditPoint.Info.Value != editingInfo)
                {
                    result = await AdminServices.UpdateDistributionPointInfoAsync(userContext,currentEditPoint.DistributionPointId, Info.New(editingInfo));
                    if (result.IsError) 
                    { 
                        Logger.LogError("Error updating distribution point info: {Error}", result.ErrorValue);
                        errorMessage = L["ErrorOccurred"].Value; 
                        return; 
                    }
                }
                
                await ShowStatus(L["DistributionPointUpdated"], "success");
            }
            else
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var userContext = TenantState.GetUserContext(authState.User);
                var tenantId = TenantState.CurrentTenant?.TenantId ?? TenantId.Default;

                // safe to get the userId as it is authenticated
                var userId = userContext.UserId.Value;

                var newDp = DistributionPoint.New(tenantId, nameResult.ResultValue, Info.New(editingInfo), userId);
                result = await DistributionPointService.CreateDistributionPointAsync(userContext, newDp);
                if (result.IsError) 
                { 
                    Logger.LogError("Error creating distribution point: {Error}", result.ErrorValue);
                    errorMessage = L["ErrorOccurred"].Value; 
                    return; 
                }
                
                await ShowStatus(L["DistributionPointCreated"], "success");
            }

            showModal = false;
            await LoadDistributionPoints();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception saving distribution point");
            errorMessage = L["ErrorOccurred"].Value;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AssignManager(DistributionPoint dp, ApplicationUser user)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var userId = UserId.NewUserId(Guid.Parse(user.Id));
            var result = await AdminServices.AssignUserToDistributionPointAsync(userContext, dp.DistributionPointId, userId);
            
            if (result.IsOk)
            {
                await ShowStatus(L["ManagerAssigned"], "success");
                await LoadDistributionPoints();
            }
            else
            {
                Logger.LogError("Error assigning manager {UserId} to distribution point {DistributionPointId}: {Error}", user.Id, dp.DistributionPointId.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception assigning manager {UserId} to distribution point {DistributionPointId}", user.Id, dp.DistributionPointId.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "error");
        }
    }

    private async Task UnassignManager(DistributionPoint dp, UserId userId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = await AdminServices.UnassignUserFromDistributionPointAsync(userContext, dp.DistributionPointId, userId);
            
            if (result.IsOk)
            {
                await ShowStatus(L["ManagerUnassigned"], "success");
                await LoadDistributionPoints();
            }
            else
            {
                Logger.LogError("Error unassigning manager {UserId} from distribution point {DistributionPointId}: {Error}", userId.Value, dp.DistributionPointId.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception unassigning manager {UserId} from distribution point {DistributionPointId}", userId.Value, dp.DistributionPointId.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "error");
        }
    }

    private async Task ConfirmRemove(DistributionPoint dp)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", L["ConfirmRemoveDistributionPoint"].Value);
            if (!confirmed) return;

            var result = await DistributionPointService.RemoveDistributionPointAsync(userContext, dp.DistributionPointId);
            if (result.IsOk)
            {
                await ShowStatus(L["DistributionPointRemoved"].Value, "success");
                await LoadDistributionPoints();
            }
            else
            {
                Logger.LogError("Error removing distribution point {DistributionPointId}: {Error}", dp.DistributionPointId.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception removing distribution point {DistributionPointId}", dp.DistributionPointId.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "error");
        }
    }

    private async Task ShowStatus(string message, string type)
    {
        await JSRuntime.InvokeVoidAsync("showToast", message, type);
    }
}

