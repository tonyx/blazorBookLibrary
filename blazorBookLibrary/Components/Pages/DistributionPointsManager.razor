    .badge-sanctuary {
        background: #f0f4f8;
        color: #4a5568;
        padding: 0.35rem 0.85rem;
        border-radius: 2rem;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid #e2e8f0;
    }
    
    .text-serif {
        font-family: 'Playfair Display', serif;
    }
    
    .border-bottom-dashed {
        border-bottom: 1px dashed #dee2e6 !important;
    }
    
    .border-sanctuary {
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
