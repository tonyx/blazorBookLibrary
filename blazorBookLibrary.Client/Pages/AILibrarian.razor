@page "/ai-librarian"
@using System.Web
@using System.Text.RegularExpressions
@using System.Threading
@using System.Globalization
@using Microsoft.FSharp.Collections
@using Microsoft.FSharp.Core
@using static BookLibrary.Shared.Commons
@using BookLibrary.Domain
@using BookLibrary.Shared
@using BookLibrary.Shared.Services
@using blazorBookLibrary.Shared.Resources
@inject ILibrarianChatService LibrarianChatService
@inject blazorBookLibrary.Client.Services.AiRateLimitStateService RateLimitService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@inject IUserTenantResolverService UserTenantResolverService
@inject ITenantService TenantService
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject blazorBookLibrary.Client.Services.IUserLocationService UserLocationService
@inject ILogger<AILibrarian> Logger
@rendermode InteractiveAuto
@implements IAsyncDisposable

<PageTitle>@L["AILibrarian"] — @L["BiblioNet"]</PageTitle>

<div class="sanctuary-container py-4">

    <AiLibrarianEphemeralBanner />

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--outline-variant) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-semibold">
                    <i class="bi bi-stars me-1"></i> RAG AI Discovery
                </span>
                @if (_contextBooks.Count > 0)
                {
                    <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">
                        <i class="bi bi-collection me-1"></i> @_contextBooks.Count @L["ActiveCatalogContext"]
                    </span>
                }
            </div>
            <h1 class="display-6 serif fw-bold mb-1" style="color: var(--primary);">@L["AILibrarian"]</h1>
            <p class="text-muted small mb-0">@L["AILibrarianSubtitle"]</p>
        </div>

        <!-- Mode & Scope Toolbar -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group p-1 bg-surface-low rounded-pill border shadow-xs" role="group">
                <button type="button" 
                        class="btn btn-sm rounded-pill px-3 @(!_includeGeneralKnowledge ? "btn-primary shadow-xs" : "btn-light text-muted border-0 bg-transparent")"
                        @onclick="() => SetMode(false)">
                    <i class="bi bi-journal-bookmark-fill me-1"></i> @L["StrictCatalogMode"]
                </button>
                <button type="button" 
                        class="btn btn-sm rounded-pill px-3 @(_includeGeneralKnowledge ? "btn-primary shadow-xs" : "btn-light text-muted border-0 bg-transparent")"
                        @onclick="() => SetMode(true)">
                    <i class="bi bi-globe2 me-1"></i> @L["BroadKnowledgeMode"]
                </button>
            </div>
            
            @if (_speechSynthSupported)
            {
                <button type="button" 
                        class="btn btn-sm rounded-pill px-3 d-flex align-items-center gap-1 @(_autoSpeechEnabled ? "btn-primary shadow-xs" : "btn-outline-secondary")"
                        @onclick="ToggleAutoSpeech"
                        title="@L["AutoReadAloud"]">
                    <i class="bi @(_autoSpeechEnabled ? "bi-volume-up-fill" : "bi-volume-mute")"></i>
                    <span class="d-none d-sm-inline">@L["AutoReadAloud"]</span>
                </button>
            }

            @if (_contextBooks.Count > 0)
            {
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-1 @(_forceNewSearch ? "active btn-secondary text-white" : "")"
                        @onclick="ToggleForceNewSearch"
                        title="@L["SearchAnewTooltip"]">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>@L["SearchAnew"]</span>
                </button>

                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 d-flex align-items-center gap-1"
                        @onclick="ClearConversation"
                        title="@L["ClearChat"]">
                    <i class="bi bi-trash3"></i>
                    <span class="d-none d-sm-inline">@L["ClearChat"]</span>
                </button>
            }
        </div>
    </div>

    <!-- Location Proximity Filter Indicator -->
    <div class="mb-3 text-center animate-fade-in">
        @if (userLocation != null)
        {
            <span class="badge bg-surface border text-muted shadow-xs px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2">
                <i class="bi bi-geo-alt-fill text-primary"></i>
                <span>@L["UserLocation_FilteringWithin", Math.Round(userLocation.RadiusInMeters / 1000.0, 0)]</span>
                <a href="/user-location" class="text-primary fw-semibold text-decoration-none hover-underline ms-1">
                    @L["UserLocation_ChangeLocation"]
                </a>
            </span>
        }
        else
        {
            <span class="badge bg-surface border text-muted shadow-xs px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2">
                <i class="bi bi-compass text-secondary"></i>
                <span>@L["UserLocation_WorldwideNotice"]</span>
                <a href="/user-location" class="text-primary fw-semibold text-decoration-none hover-underline ms-1">
                    @L["UserLocation_SetYourLocation"]
                </a>
            </span>
        }
    </div>

    @if (userCoordinates != null && availableTenants.Count > 1)
    {
        <!-- Multi-tenant Proximity Selection Pills -->
        <div class="surrounding-libraries-selector mb-4 p-3 bg-surface-low rounded-xl border" style="border-color: var(--outline-variant) !important;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                    <span class="small fw-bold text-uppercase text-muted letter-spacing-1" style="font-size: 0.78rem;">
                        @L["MultiTenant_LibrariesInRadius"] (@selectedTenantIds.Count / @availableTenants.Count)
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-link text-primary p-0 text-decoration-none fw-semibold" style="font-size: 0.8rem;" @onclick="SelectAllTenants">
                        <i class="bi bi-check-all me-1"></i>@L["MultiTenant_SelectAll"]
                    </button>
                    <span class="text-muted" style="font-size: 0.8rem;">|</span>
                    <button type="button" class="btn btn-sm btn-link text-muted p-0 text-decoration-none" style="font-size: 0.8rem;" @onclick="DeselectAllTenants">
                        <i class="bi bi-dash-circle me-1"></i>@L["MultiTenant_DeselectAll"]
                    </button>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tenant in availableTenants)
                {
                    var tid = tenant.TenantId;
                    var pillId = $"ai-tenant-pill-{tid.Value}";
                    var isChecked = selectedTenantIds.Contains(tid);
                    var distance = GetTenantDistance(tenant);
                    <div id="@pillId"
                         class="form-check form-check-inline tenant-pill-check m-0 px-3 py-1 rounded-pill @(isChecked ? "bg-primary-subtle text-primary border-primary fw-semibold" : "bg-surface-lowest text-muted border")" 
                         style="cursor: pointer; border: 1px solid var(--outline-variant); transition: all 0.2s ease;"
                         tabindex="0"
                         @onclick="() => ToggleTenant(tid)"
                         @onmouseenter="() => HandleTenantMouseEnter(tenant, pillId)"
                         @onmouseleave="HandleTenantMouseLeave"
                         @onfocus="() => HandleTenantMouseEnter(tenant, pillId)"
                         @onblur="HandleTenantMouseLeave">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="@($"ai-tenant-check-{tid.Value}")" 
                               checked="@isChecked" 
                               @onclick:stopPropagation="true"
                               @onchange="() => ToggleTenant(tid)" />
                        <label class="form-check-label small user-select-none mb-0" for="@($"ai-tenant-check-{tid.Value}")" style="cursor: pointer;" @onclick:stopPropagation="true">
                            @tenant.Name.Value
                            @if (distance.HasValue)
                            {
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1" style="font-size: 0.72rem;">@FormatDistance(distance.Value)</span>
                            }
                        </label>
                    </div>
                }
            </div>
            @{
                var hCoords = hoveredTenant != null && hoveredTenant.GeoLocSettings.OptCoordinates != null && FSharpOption<Coordinates>.get_IsSome(hoveredTenant.GeoLocSettings.OptCoordinates)
                    ? hoveredTenant.GeoLocSettings.OptCoordinates.Value
                    : null;
                var hDist = hoveredTenant != null ? GetTenantDistance(hoveredTenant) : null;
            }
            <TenantGeoPopover 
                PopoverId="ai-librarian-tenant-geo-popover"
                MapContainerId="ai-librarian-tenant-hover-mini-map"
                IsVisible="@(isPopoverVisible && hoveredTenant != null)"
                TenantName="@(hoveredTenant?.Name?.Value ?? "")"
                Address="@(hoveredTenant?.Address ?? "")"
                DistanceMeters="@hDist"
                TenantLatitude="@(hCoords != null ? hCoords.Latitude : (double?)null)"
                TenantLongitude="@(hCoords != null ? hCoords.Longitude : (double?)null)"
                UserLatitude="@(userCoordinates != null ? userCoordinates.Latitude : (double?)null)"
                UserLongitude="@(userCoordinates != null ? userCoordinates.Longitude : (double?)null)"
                TriggerElementId="@hoveredTriggerId"
                OnHoverStateChanged="OnPopoverHoverChanged" />
            @if (!selectedTenantIds.Any())
            {
                <div class="text-danger small mt-2 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>@L["MultiTenant_SelectAtLeastOne"]</span>
                </div>
            }
        </div>
    }

    <!-- Main Workspace: Split View -->
    <div class="row g-4">
        
        <!-- Conversation Column -->
        <div class="@(_contextBooks.Count > 0 ? "col-lg-7 col-xl-8" : "col-12")">
            <div class="card-sanctuary bg-surface-low border-0 p-3 p-md-4 d-flex flex-column" style="min-height: 650px; height: calc(100vh - 260px);">
                
                <!-- Chat Message Stream -->
                <div class="flex-grow-1 overflow-y-auto pe-2 mb-3 chat-stream-container" id="chatStream">
                    
                    @if (_messages.Count == 0)
                    {
                        <div class="text-center py-5 animate-fade-in">
                            <div class="d-inline-flex p-4 rounded-circle bg-surface-container mb-3 shadow-xs">
                                <i class="bi bi-stars text-primary" style="font-size: 2.5rem;"></i>
                            </div>
                            <h4 class="serif fw-bold mb-2">@L["AILibrarian"]</h4>
                            <p class="text-muted mx-auto mb-4" style="max-width: 520px; font-size: 0.95rem;">
                                @L["AILibrarianWelcome"]
                            </p>

                            <!-- Suggested Questions -->
                            <div class="d-flex flex-column align-items-center gap-2 max-w-md mx-auto" style="max-width: 580px;">
                                <button class="btn btn-light bg-surface border text-start w-100 py-2 px-3 rounded-xl small shadow-xs transition-hover"
                                        @onclick='() => SubmitSampleQuery(L["SampleQuestion1"].Value)'>
                                    <i class="bi bi-chat-left-quote me-2 text-primary"></i> "@L["SampleQuestion1"]"
                                </button>
                                <button class="btn btn-light bg-surface border text-start w-100 py-2 px-3 rounded-xl small shadow-xs transition-hover"
                                        @onclick='() => SubmitSampleQuery(L["SampleQuestion2"].Value)'>
                                    <i class="bi bi-chat-left-quote me-2 text-primary"></i> "@L["SampleQuestion2"]"
                                </button>
                                <button class="btn btn-light bg-surface border text-start w-100 py-2 px-3 rounded-xl small shadow-xs transition-hover"
                                        @onclick='() => SubmitSampleQuery(L["SampleQuestion3"].Value)'>
                                    <i class="bi bi-chat-left-quote me-2 text-primary"></i> "@L["SampleQuestion3"]"
                                </button>
                            </div>
                        </div>
                    }

                    @foreach (var msg in _messages)
                    {
                        <div class="d-flex @(msg.Role == "user" ? "justify-content-end" : "justify-content-start") mb-4 animate-fade-in">
                            @if (msg.Role != "user")
                            {
                                <div class="me-2 d-none d-sm-flex align-items-start mt-1">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-xs" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        <i class="bi bi-stars"></i>
                                    </div>
                                </div>
                            }

                            <div class="card p-3 border-0 @(msg.Role == "user" ? "bg-primary text-white" : "bg-surface shadow-xs")" 
                                 style="max-width: 85%; border-radius: var(--radius-lg); @(msg.Role == "user" ? "border-bottom-right-radius: 4px;" : "border-bottom-left-radius: 4px;")">
                                
                                <div class="d-flex align-items-center justify-content-between mb-1 gap-2">
                                    <span class="x-small fw-bold @(msg.Role == "user" ? "text-white-50" : "text-muted")">
                                        @(msg.Role == "user" ? "You" : L["AILibrarian"])
                                    </span>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (msg.Role == "assistant" && _speechSynthSupported)
                                        {
                                            var currentIdx = _messages.IndexOf(msg);
                                            var isSpeakingThis = (_currentlySpeakingIndex == currentIdx);
                                            <button type="button" 
                                                    class="btn btn-sm btn-link p-0 text-decoration-none speech-btn @(isSpeakingThis ? "text-danger" : "text-muted")"
                                                    @onclick="() => ToggleSpeakMessage(currentIdx, msg.Content)"
                                                    title="@(isSpeakingThis ? L["StopReading"] : L["ReadAloud"])">
                                                <i class="bi @(isSpeakingThis ? "bi-stop-circle-fill animate-pulse" : "bi-volume-up")"></i>
                                            </button>
                                        }
                                        <span class="x-small @(msg.Role == "user" ? "text-white-50" : "text-muted opacity-75")">
                                            @msg.Timestamp.ToString("HH:mm")
                                        </span>
                                    </div>
                                </div>

                                <div class="message-body @(msg.Role == "user" ? "text-white" : "")" style="font-size: 0.95rem; line-height: 1.6;">
                                    @if (msg.Role == "user")
                                    {
                                        <div class="user-text">@msg.Content</div>
                                    }
                                    else
                                    {
                                        <div class="markdown-content">
                                            @((MarkupString)RenderMarkdownToHtml(msg.Content))
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (_isThinking)
                    {
                        <div class="d-flex justify-content-start mb-4 animate-fade-in">
                            <div class="me-2 d-none d-sm-flex align-items-start mt-1">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-xs" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    <i class="bi bi-stars"></i>
                                </div>
                            </div>
                            <div class="card p-3 border-0 bg-surface shadow-xs rounded-xl" style="border-bottom-left-radius: 4px;">
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                                    <span class="serif italic">@L["Thinking"]</span>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger rounded-xl small py-2 px-3 mb-3 animate-fade-in" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
                        </div>
                    }
                </div>

                <!-- Input Console -->
                <div class="pt-2 border-top" style="border-color: var(--outline-variant) !important;">
                    @if (_contextBooks.Count > 0 && !_forceNewSearch)
                    {
                        <div class="d-flex align-items-center justify-content-between px-2 mb-2">
                            <span class="x-small text-muted italic">
                                <i class="bi bi-link-45deg text-primary me-1"></i> Multi-turn reasoning on @_contextBooks.Count active books
                            </span>
                            <button type="button" class="btn btn-link p-0 x-small text-decoration-none" @onclick="ToggleForceNewSearch">
                                Switch to fresh search
                            </button>
                        </div>
                    }

                    @if (_isListening)
                    {
                        <div class="d-flex align-items-center justify-content-between px-3 py-1 mb-2 bg-danger-subtle text-danger rounded-pill x-small animate-fade-in border border-danger-subtle flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="spinner-grow spinner-grow-sm text-danger" role="status" aria-hidden="true"></span>
                                <span class="fw-semibold">@L["VoiceListening"]</span>
                                <span class="badge bg-danger text-white rounded-pill px-2" style="font-size: 0.72rem;">@_speechLanguage</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm bg-white rounded-pill border p-0 overflow-hidden" role="group">
                                    <button type="button" class="btn btn-xs py-0 px-2 border-0 @(_speechLanguage == "it-IT" ? "btn-danger text-white fw-bold" : "btn-light text-muted")" style="font-size: 0.72rem;" @onclick='() => ChangeSpeechLanguage("it-IT")'>IT</button>
                                    <button type="button" class="btn btn-xs py-0 px-2 border-0 @(_speechLanguage == "en-US" ? "btn-danger text-white fw-bold" : "btn-light text-muted")" style="font-size: 0.72rem;" @onclick='() => ChangeSpeechLanguage("en-US")'>EN</button>
                                </div>
                                <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none fw-semibold ms-1" @onclick="StopListening">
                                    <i class="bi bi-x-circle me-1"></i> @L["StopListening"]
                                </button>
                            </div>
                        </div>
                    }

                    @if (RateLimitService.IsRateLimited)
                    {
                        <div class="alert alert-warning border-0 rounded-xl py-2 px-3 mb-2 d-flex align-items-center justify-content-between animate-fade-in" role="alert" style="background: rgba(255, 193, 7, 0.15); border-left: 4px solid #ffc107 !important;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-hourglass-split text-warning fs-5"></i>
                                <span class="small">
                                    @(RateLimitService.IsGuest 
                                        ? string.Format(L["AiRateLimit_GuestMessage"], RateLimitService.RemainingSeconds) 
                                        : string.Format(L["AiRateLimit_UserMessage"], RateLimitService.RemainingSeconds))
                                </span>
                            </div>
                            @if (RateLimitService.IsGuest)
                            {
                                <div class="d-flex align-items-center gap-2 ms-2">
                                    <a href="Account/Login" class="btn btn-xs btn-primary rounded-pill px-2 py-1 text-nowrap">@L["AiRateLimit_SignIn"]</a>
                                </div>
                            }
                        </div>
                    }

                    <div class="input-group bg-surface rounded-xl shadow-sm border overflow-hidden p-1">
                        <textarea id="librarianChatInput"
                                  class="form-control border-0 bg-transparent shadow-none px-3 py-2" 
                                  rows="2"
                                  placeholder="@(RateLimitService.IsRateLimited ? string.Format(L["AiRateLimit_WaitSeconds"], RateLimitService.RemainingSeconds) : L["AskLibrarianPlaceholder"])"
                                  @bind="_userInput"
                                  @bind:event="oninput"
                                  @onkeydown="HandleKeyDown"
                                  disabled="@(_isThinking || RateLimitService.IsRateLimited)"></textarea>

                        @if (_speechRecSupported)
                        {
                            <button class="btn @(_isListening ? "btn-danger" : "btn-light border") align-self-end m-1 px-3 py-2 rounded-xl transition-hover" 
                                    type="button" 
                                    @onclick="ToggleListening" 
                                    disabled="@(_isThinking || RateLimitService.IsRateLimited)"
                                    title="@L["VoiceInput"]">
                                <i class="bi @(_isListening ? "bi-mic-fill animate-pulse text-white" : "bi-mic text-primary")"></i>
                            </button>
                        }

                        <button class="btn-sanctuary-primary align-self-end m-1 px-3 py-2" 
                                type="button" 
                                @onclick="SendMessage" 
                                disabled="@(_isThinking || RateLimitService.IsRateLimited || string.IsNullOrWhiteSpace(_userInput))">
                            @if (_isThinking)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else if (RateLimitService.IsRateLimited)
                            {
                                <i class="bi bi-hourglass-split"></i>
                                <span class="ms-1">@(RateLimitService.RemainingSeconds)s</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                                <span class="d-none d-sm-inline ms-1">@L["AskQuestion"]</span>
                            }
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- Catalog Context Shelf (Right Column) -->
        @if (_contextBooks.Count > 0)
        {
            <div class="col-lg-5 col-xl-4 animate-fade-in">
                <div class="card-sanctuary bg-surface-low border-0 p-3 p-md-4 d-flex flex-column" style="min-height: 650px; height: calc(100vh - 260px);">
                    
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">
                        <div>
                            <h5 class="serif fw-bold mb-0">@L["ActiveCatalogContext"]</h5>
                            <span class="x-small text-muted">@_contextBooks.Count grounded items retrieved</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 x-small fw-semibold">
                            <i class="bi bi-database me-1"></i> pgvector
                        </span>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto pe-1 books-shelf-container">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var res in _contextBooks)
                            {
                                var book = res.Book;
                                <div class="card bg-surface border-0 rounded-xl p-3 shadow-xs transition-hover" id="book-card-@book.Id">
                                    <div class="d-flex gap-3">
                                        <!-- Thumbnail -->
                                        <a href="/book-view/@book.Id" class="flex-shrink-0 text-decoration-none">
                                            <div class="bg-surface-low rounded p-1 shadow-2xs d-flex align-items-center justify-content-center overflow-hidden" 
                                                 style="width: 52px; height: 74px;">
                                                @if (book.ImageUrl != null && FSharpOption<Uri>.get_IsSome(book.ImageUrl))
                                                {
                                                    <img src="@book.ImageUrl.Value.ToString()" alt="@book.Title.Value" style="max-width: 100%; max-height: 100%; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-book-half text-muted opacity-50" style="font-size: 1.5rem;"></i>
                                                }
                                            </div>
                                        </a>

                                        <!-- Book Info -->
                                        <div class="flex-grow-1 min-w-0">
                                            <a href="/book-view/@book.Id" class="text-decoration-none text-reset">
                                                <h6 class="serif fw-bold mb-1 text-truncate" title="@book.Title.Value">
                                                    @book.Title.Value
                                                </h6>
                                            </a>

                                            <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                                @if (FSharpOption<TenantSearchInfo>.get_IsSome(res.TenantInfo))
                                                {
                                                    var tInfo = res.TenantInfo.Value;
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle x-small rounded-pill" title="@tInfo.Address">
                                                        <i class="bi bi-building me-1"></i>@tInfo.TenantName
                                                    </span>
                                                }
                                                <span class="badge bg-surface-low text-secondary border border-subtle x-small rounded-pill">
                                                    @book.Year.Value
                                                </span>
                                                <span class="badge bg-surface-low text-muted border border-subtle x-small rounded-pill">
                                                    @book.MainCategory.Value()
                                                </span>
                                                @if (FSharpOption<double>.get_IsSome(res.Score))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle x-small rounded-pill" title="Similarity Score">
                                                        @((res.Score.Value * 100).ToString("F0"))% match
                                                    </span>
                                                }
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="x-small">
                                                    @if (book.AvailabilityStatus == AvailabilityStatus.Available)
                                                    {
                                                        <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>@L["Available"]</span>
                                                    }
                                                    else if (book.AvailabilityStatus == AvailabilityStatus.Reserved)
                                                    {
                                                        <span class="text-warning fw-bold"><i class="bi bi-clock-fill me-1"></i>@L["Reserved"]</span>
                                                    }
                                                    else if (book.AvailabilityStatus == AvailabilityStatus.Consultable)
                                                    {
                                                        <span class="text-info fw-bold"><i class="bi bi-eye-fill me-1"></i>@L["Consultable"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i>@L["NotAvailable"]</span>
                                                    }
                                                </div>

                                                <a href="/book-view/@book.Id" class="btn btn-sm btn-link p-0 text-primary text-decoration-none x-small fw-semibold">
                                                    @L["BookDetails"] <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    @if (FSharpOption<string>.get_IsSome(book.Description) && !string.IsNullOrWhiteSpace(book.Description.Value))
                                    {
                                        <p class="x-small text-muted mt-2 mb-0 text-truncate-2 italic" style="line-height: 1.4;">
                                            @book.Description.Value
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }

    </div>

</div>

