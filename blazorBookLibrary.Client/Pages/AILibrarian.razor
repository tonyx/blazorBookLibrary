@code {
    private List<LibrarianChatMessage> _messages = new();
    private List<BookSearchResult> _contextBooks = new();
    private List<BookId> _scopeBookIds = new();
    private bool _includeGeneralKnowledge = false;
    private bool _forceNewSearch = false;
    private string _userInput = "";
    private bool _isThinking = false;
    private string? _errorMessage;

    // Multi-tenant selection & proximity state
    private List<Tenant> availableTenants = new();
    private HashSet<TenantId> selectedTenantIds = new();
    private HashSet<TenantId> _previousAvailableTenantIds = new();
    private Coordinates? userCoordinates = null;
    private blazorBookLibrary.Client.Services.UserLocation? userLocation = null;
    private bool isLoadingTenants = false;
    private TenantId _currentTenant = TenantId.Default;

    // Mini-map hover popover state
    private System.Threading.CancellationTokenSource? hoverCts;
    private bool isPopoverVisible = false;
    private bool isMouseOverPopover = false;
    private Tenant? hoveredTenant = null;
    private string? hoveredTriggerId = null;

    // Voice recognition & speech synthesis state
    private DotNetObjectReference<AILibrarian>? _dotNetHelper;
    private bool _speechRecSupported = false;
    private bool _speechSynthSupported = false;
    private bool _isListening = false;
    private bool _autoSpeechEnabled = false;
    private int _currentlySpeakingIndex = -1;

    private void HandleRateLimitChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            try
            {
                _speechRecSupported = await JSRuntime.InvokeAsync<bool>("librarianSpeech.isRecognitionSupported");
                _speechSynthSupported = await JSRuntime.InvokeAsync<bool>("librarianSpeech.isSynthesisSupported");
                StateHasChanged();
            }
            catch
            {
                // Fallback in case JS environment doesn't allow immediate invoke
            }

            if (userCoordinates == null)
            {
                var coords = await UserLocationService.GetCoordinatesAsync();
                if (coords != null)
                {
                    await LoadSurroundingTenantsAsync();
                    StateHasChanged();
                }
            }
        }
    }

    private async Task<UserContext> GetUserContextAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var context = Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
        if (_currentTenant != null && _currentTenant != TenantId.Default)
        {
            return context.WithNewTenant(_currentTenant);
        }
        else if (TenantState.CurrentTenant != null)
        {
            return context.WithNewTenant(TenantState.CurrentTenant.TenantId);
        }
        return context;
    }

    private async Task<TenantId> ResolveCurrentTenantAsync()
    {
        if (TenantState.CurrentTenant != null)
        {
            return TenantState.CurrentTenant.TenantId;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);

        var tenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext, FSharpOption<CancellationToken>.None);
        if (tenantResult.IsOk)
        {
            var tenantInfo = await TenantService.GetTenantAsync(userContext, tenantResult.ResultValue, FSharpOption<CancellationToken>.None);
            if (tenantInfo.IsOk)
            {
                TenantState.CurrentTenant = tenantInfo.ResultValue;
            }
            return tenantResult.ResultValue;
        }

        return TenantId.Default;
    }

    private async Task LoadSurroundingTenantsAsync()
    {
        isLoadingTenants = true;
        try
        {
            userLocation = await UserLocationService.GetLocationAsync();
            userCoordinates = await UserLocationService.GetCoordinatesAsync();
            var userContext = await GetUserContextAsync();

            if (userCoordinates == null)
            {
                // In worldwide mode (no coordinates specified), radius-based multitenant search is unavailable
                if (TenantState.CurrentTenant != null)
                {
                    availableTenants = new List<Tenant> { TenantState.CurrentTenant };
                }
                else
                {
                    _currentTenant = await ResolveCurrentTenantAsync();
                    var tenantResult = await TenantService.GetTenantAsync(userContext, _currentTenant, FSharpOption<CancellationToken>.None);
                    if (tenantResult.IsOk)
                    {
                        availableTenants = new List<Tenant> { tenantResult.ResultValue };
                    }
                    else
                    {
                        availableTenants = new();
                    }
                }
                selectedTenantIds = new HashSet<TenantId>(availableTenants.Select(t => t.TenantId));
                _previousAvailableTenantIds = new HashSet<TenantId>(selectedTenantIds);
                return;
            }

            var scope = TenantScope.NewProximityTenants(userCoordinates, true);
            var result = await UserTenantResolverService.ResolveSearchTenantsAsync(userContext, scope, FSharpOption<CancellationToken>.None);
            if (result.IsOk && result.ResultValue.Any())
            {
                availableTenants = result.ResultValue.ToList();
            }
            else
            {
                var proxResult = await TenantService.GetAllowedTenantsByProximityAsync(userContext, userCoordinates, FSharpOption<CancellationToken>.None);
                if (proxResult.IsOk && proxResult.ResultValue.Any())
                {
                    availableTenants = proxResult.ResultValue.ToList();
                }
                else if (TenantState.CurrentTenant != null)
                {
                    availableTenants = new List<Tenant> { TenantState.CurrentTenant };
                }
                else
                {
                    _currentTenant = await ResolveCurrentTenantAsync();
                    var tenantResult = await TenantService.GetTenantAsync(userContext, _currentTenant, FSharpOption<CancellationToken>.None);
                    if (tenantResult.IsOk)
                    {
                        availableTenants = new List<Tenant> { tenantResult.ResultValue };
                    }
                    else
                    {
                        availableTenants = new();
                    }
                }
            }

            // By default, select all available tenants (or keep existing selections that are still valid)
            var currentAvailableIds = new HashSet<TenantId>(availableTenants.Select(t => t.TenantId));
            var wasFullySelected = selectedTenantIds.Count == 0 || selectedTenantIds.SetEquals(_previousAvailableTenantIds);

            if (wasFullySelected || !selectedTenantIds.Any(t => currentAvailableIds.Contains(t)))
            {
                selectedTenantIds = new HashSet<TenantId>(currentAvailableIds);
            }
            else
            {
                selectedTenantIds.RemoveWhere(id => !currentAvailableIds.Contains(id));
            }
            _previousAvailableTenantIds = currentAvailableIds;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load surrounding tenants");
        }
        finally
        {
            isLoadingTenants = false;
        }
    }

    private void SelectAllTenants()
    {
        selectedTenantIds = new HashSet<TenantId>(availableTenants.Select(t => t.TenantId));
        _forceNewSearch = true;
    }

    private void DeselectAllTenants()
    {
        selectedTenantIds.Clear();
        _forceNewSearch = true;
    }

    private void ToggleTenant(TenantId tenantId)
    {
        if (selectedTenantIds.Contains(tenantId))
        {
            selectedTenantIds.Remove(tenantId);
        }
        else
        {
            selectedTenantIds.Add(tenantId);
        }
        _forceNewSearch = true;
    }

    private double? GetTenantDistance(Tenant tenant)
    {
        if (userCoordinates != null && tenant.GeoLocSettings.OptCoordinates != null && FSharpOption<Coordinates>.get_IsSome(tenant.GeoLocSettings.OptCoordinates))
        {
            return userCoordinates.DistanceInMeters(tenant.GeoLocSettings.OptCoordinates.Value);
        }
        return null;
    }

    private string FormatDistance(double meters)
    {
        if (meters < 1000.0)
        {
            return $"~{Math.Round(meters, 0)} m";
        }
        return $"~{Math.Round(meters / 1000.0, 1)} km";
    }

    private void HandleTenantMouseEnter(Tenant tenant, string triggerId)
    {
        hoverCts?.Cancel();
        hoverCts?.Dispose();
        hoverCts = new System.Threading.CancellationTokenSource();
        var token = hoverCts.Token;

        Task.Delay(200, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                InvokeAsync(() =>
                {
                    hoveredTenant = tenant;
                    hoveredTriggerId = triggerId;
                    isPopoverVisible = true;
                    StateHasChanged();
                });
            }
        });
    }

    private void HandleTenantMouseLeave()
    {
        hoverCts?.Cancel();
        hoverCts?.Dispose();
        hoverCts = new System.Threading.CancellationTokenSource();
        var token = hoverCts.Token;

        Task.Delay(180, token).ContinueWith(t =>
        {
            if (!t.IsCanceled && !isMouseOverPopover)
            {
                InvokeAsync(() =>
                {
                    isPopoverVisible = false;
                    hoveredTenant = null;
                    StateHasChanged();
                });
            }
        });
    }

    private void OnPopoverHoverChanged(bool isOver)
    {
        isMouseOverPopover = isOver;
        if (!isOver)
        {
            HandleTenantMouseLeave();
        }
    }

    private void OnTenantChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSurroundingTenantsAsync();
            StateHasChanged();
        });
    }

    private void OnLocationChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSurroundingTenantsAsync();
            StateHasChanged();
        });
    }

    private void SetMode(bool includeGeneral)
    {
        _includeGeneralKnowledge = includeGeneral;
    }

    private void ToggleForceNewSearch()
    {
        _forceNewSearch = !_forceNewSearch;
    }

    private async Task ClearConversation()
    {
        if (_currentlySpeakingIndex != -1)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopSpeaking", _dotNetHelper);
            _currentlySpeakingIndex = -1;
        }
        if (_isListening)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopListening");
            _isListening = false;
        }
        _messages.Clear();
        _contextBooks.Clear();
        _scopeBookIds.Clear();
        _forceNewSearch = false;
        _errorMessage = null;
    }

    private async Task SubmitSampleQuery(string sampleText)
    {
        _userInput = sampleText;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (userCoordinates != null && availableTenants.Count > 1 && !selectedTenantIds.Any())
        {
            _errorMessage = L["MultiTenant_SelectAtLeastOne"];
            return;
        }

        var text = _userInput.Trim();
        if (string.IsNullOrWhiteSpace(text) || _isThinking) return;

        if (_isListening)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopListening");
            _isListening = false;
        }
        if (_currentlySpeakingIndex != -1)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopSpeaking", _dotNetHelper);
            _currentlySpeakingIndex = -1;
        }

        _errorMessage = null;
        _isThinking = true;
        _userInput = "";

        // Add user message to local history
        var userMsg = new LibrarianChatMessage
        {
            Role = "user",
            Content = text,
            Timestamp = DateTime.Now
        };
        _messages.Add(userMsg);
        StateHasChanged();

        try
        {
            var userContext = await GetUserContextAsync();

            FSharpOption<FSharpList<BookId>> scopeIdsOption =
                (!_forceNewSearch && _scopeBookIds.Count > 0)
                    ? FSharpOption<FSharpList<BookId>>.Some(ListModule.OfSeq(_scopeBookIds))
                    : FSharpOption<FSharpList<BookId>>.None;

            FSharpOption<FSharpList<TenantId>> targetTenantsOption =
                (userCoordinates != null && selectedTenantIds.Any())
                    ? FSharpOption<FSharpList<TenantId>>.Some(ListModule.OfSeq(selectedTenantIds))
                    : FSharpOption<FSharpList<TenantId>>.None;

            var request = new LibrarianChatRequest
            {
                Message = text,
                ConversationHistory = ListModule.OfSeq(_messages.Take(_messages.Count - 1)),
                IncludeGeneralKnowledge = _includeGeneralKnowledge,
                ScopeBookIds = scopeIdsOption,
                ForceNewSearch = _forceNewSearch,
                TargetTenantIds = targetTenantsOption
            };

            var result = await LibrarianChatService.ChatAsync(
                userContext, 
                request, 
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                var response = result.ResultValue;
                
                var assistantMsg = new LibrarianChatMessage
                {
                    Role = "assistant",
                    Content = response.AnswerMarkdown,
                    Timestamp = DateTime.Now
                };
                _messages.Add(assistantMsg);

                // Update context books & scope IDs
                if (response.ReferencedBooks != null && response.ReferencedBooks.Length > 0)
                {
                    _contextBooks = response.ReferencedBooks.ToList();
                }
                
                if (response.ScopeBookIds != null && response.ScopeBookIds.Length > 0)
                {
                    _scopeBookIds = response.ScopeBookIds.ToList();
                }

                // Reset force search flag once search has completed
                _forceNewSearch = false;

                // Auto-read aloud if enabled
                if (_autoSpeechEnabled && _speechSynthSupported)
                {
                    var lastIndex = _messages.Count - 1;
                    var culture = CultureInfo.CurrentUICulture.Name;
                    _ = JSRuntime.InvokeVoidAsync("librarianSpeech.speak", _dotNetHelper, lastIndex, response.AnswerMarkdown, culture);
                }
            }
            else
            {
                if (!RateLimitService.IsRateLimited)
                {
                    _errorMessage = result.ErrorValue;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isThinking = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('chatStream'); if (el) el.scrollTop = el.scrollHeight;");
        }
        catch
        {
            // Ignore JS scroll error during disposal/prerender
        }
    }

    private string RenderMarkdownToHtml(string rawMarkdown)
    {
        if (string.IsNullOrEmpty(rawMarkdown)) return "";

        // First HTML-encode the string to protect against XSS
        var encoded = HttpUtility.HtmlEncode(rawMarkdown);

        // Transform book citation links:
        // Handles: [Title](book://<guid>), [Title](book:<guid>), [Title](/book-view/<guid>), and bare GUIDs [Title](<guid>)
        var citationRegex = new Regex(
            @"\[([^\]]+)\]\(\s*(?:&lt;|<)?\s*(?:book:\/\/|book:|\/?book-view\/)?\s*(?:&lt;|<)?([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{32})(?:&gt;|>)?\s*(?:&gt;|>)?\s*\)|\[([^\]]+)\]\(\s*(?:&lt;|<)?\s*(?:book:\/\/|book:|\/?book-view\/)\s*(?:&lt;|<)?([a-zA-Z0-9\-]+)(?:&gt;|>)?\s*(?:&gt;|>)?\s*\)",
            RegexOptions.Compiled);
        encoded = citationRegex.Replace(encoded, match =>
        {
            var title = match.Groups[1].Success ? match.Groups[1].Value.Trim() : match.Groups[3].Value.Trim();
            var guid = match.Groups[2].Success ? match.Groups[2].Value.Trim() : match.Groups[4].Value.Trim();

            var tenantTooltip = "";
            var bookRes = _contextBooks.FirstOrDefault(r => r.Book.BookId.Value.ToString().Equals(guid, StringComparison.OrdinalIgnoreCase));
            if (bookRes?.TenantInfo != null && FSharpOption<TenantSearchInfo>.get_IsSome(bookRes.TenantInfo))
            {
                var tInfo = bookRes.TenantInfo.Value;
                var escapedTName = HttpUtility.HtmlEncode(tInfo.TenantName);
                tenantTooltip = $" title=\"{title} — {escapedTName}\"";
            }

            return $"<a href=\"/book-view/{guid}\" class=\"book-citation-chip\"{tenantTooltip}><i class=\"bi bi-book-half\"></i> {title}</a>";
        });

        // Transform regular links: [Text](http...) -> external link
        var externalLinkRegex = new Regex(@"\[(.*?)\]\((https?:\/\/[^\s\)]+)\)", RegexOptions.Compiled);
        encoded = externalLinkRegex.Replace(encoded, match =>
        {
            var text = match.Groups[1].Value;
            var url = match.Groups[2].Value;
            return $"<a href=\"{url}\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-primary text-decoration-underline\">{text}</a>";
        });

        // Headers
        encoded = Regex.Replace(encoded, @"^### (.*?)$", "<h6 class=\"serif fw-bold mt-3 mb-1 text-primary\">$1</h6>", RegexOptions.Multiline);
        encoded = Regex.Replace(encoded, @"^## (.*?)$", "<h5 class=\"serif fw-bold mt-3 mb-2 text-primary\">$1</h5>", RegexOptions.Multiline);
        encoded = Regex.Replace(encoded, @"^# (.*?)$", "<h4 class=\"serif fw-bold mt-4 mb-2 text-primary\">$1</h4>", RegexOptions.Multiline);

        // Bold and Italic
        encoded = Regex.Replace(encoded, @"\*\*(.*?)\*\*", "<strong>$1</strong>");
        encoded = Regex.Replace(encoded, @"\*(.*?)\*", "<em>$1</em>");

        // Bullet lists
        encoded = Regex.Replace(encoded, @"^[\*\-] (.*?)$", "<li class=\"mb-1\">$1</li>", RegexOptions.Multiline);
        encoded = Regex.Replace(encoded, @"((<li class=""mb-1"">.*?<\/li>\s*)+)", "<ul class=\"mb-2 ps-3\">$1</ul>");

        // Paragraph line breaks
        encoded = encoded.Replace("\r\n", "\n").Replace("\r", "\n");
        var paragraphs = encoded.Split(new[] { "\n\n" }, StringSplitOptions.None);
        var finalSb = new System.Text.StringBuilder();

        foreach (var p in paragraphs)
        {
            var trimmed = p.Trim();
            if (string.IsNullOrWhiteSpace(trimmed)) continue;

            if (trimmed.StartsWith("<h") || trimmed.StartsWith("<ul") || trimmed.StartsWith("<ol") || trimmed.StartsWith("<div"))
            {
                finalSb.AppendLine(trimmed);
            }
            else
            {
                var withBreaks = trimmed.Replace("\n", "<br />");
                finalSb.AppendLine($"<p class=\"mb-2\">{withBreaks}</p>");
            }
        }

        return finalSb.ToString();
    }

    // Voice recognition & speech synthesis methods

    private string _speechLanguage = "it-IT";

    protected override void OnInitialized()
    {
        var current = CultureInfo.CurrentUICulture.Name;
        _speechLanguage = current.StartsWith("it", StringComparison.OrdinalIgnoreCase) ? "it-IT" : "en-US";
        RateLimitService.OnChange += HandleRateLimitChanged;
        TenantState.OnChange += OnTenantChanged;
        UserLocationService.OnLocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSurroundingTenantsAsync();
    }

    private async Task ToggleListening()
    {
        if (_isListening)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopListening");
            _isListening = false;
        }
        else
        {
            _errorMessage = null;
            var started = await JSRuntime.InvokeAsync<bool>("librarianSpeech.startListening", _dotNetHelper, _speechLanguage);
            _isListening = started;
        }
    }

    private async Task ChangeSpeechLanguage(string lang)
    {
        _speechLanguage = lang;
        if (_isListening)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopListening");
            _errorMessage = null;
            var started = await JSRuntime.InvokeAsync<bool>("librarianSpeech.startListening", _dotNetHelper, _speechLanguage);
            _isListening = started;
        }
    }

    private async Task StopListening()
    {
        await JSRuntime.InvokeVoidAsync("librarianSpeech.stopListening");
        _isListening = false;
    }

    private void ToggleAutoSpeech()
    {
        _autoSpeechEnabled = !_autoSpeechEnabled;
        if (!_autoSpeechEnabled && _currentlySpeakingIndex != -1)
        {
            _ = JSRuntime.InvokeVoidAsync("librarianSpeech.stopSpeaking", _dotNetHelper);
            _currentlySpeakingIndex = -1;
        }
    }

    private async Task ToggleSpeakMessage(int index, string markdownContent)
    {
        if (_currentlySpeakingIndex == index)
        {
            await JSRuntime.InvokeVoidAsync("librarianSpeech.stopSpeaking", _dotNetHelper);
            _currentlySpeakingIndex = -1;
        }
        else
        {
            var culture = CultureInfo.CurrentUICulture.Name;
            await JSRuntime.InvokeVoidAsync("librarianSpeech.speak", _dotNetHelper, index, markdownContent, culture);
        }
    }

    [JSInvokable]
    public async Task OnSpeechRecognized(string transcript, bool isFinal)
    {
        await InvokeAsync(() =>
        {
            if (!string.IsNullOrWhiteSpace(transcript))
            {
                _userInput = transcript;
                StateHasChanged();
            }
        });
    }

    [JSInvokable]
    public async Task OnSpeechCompleted(string finalTranscript)
    {
        await InvokeAsync(async () =>
        {
            _isListening = false;
            if (!string.IsNullOrWhiteSpace(finalTranscript))
            {
                _userInput = finalTranscript.Trim();
                _errorMessage = null;
                StateHasChanged();
                await SendMessage();
            }
            else
            {
                StateHasChanged();
            }
        });
    }

    [JSInvokable]
    public async Task OnSpeechError(string error)
    {
        await InvokeAsync(() =>
        {
            _isListening = false;
            if (!string.IsNullOrWhiteSpace(error))
            {
                _errorMessage = error;
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnSpeechEnd()
    {
        await InvokeAsync(() =>
        {
            _isListening = false;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnSpeechSynthesisStatus(int messageIndex, bool isPlaying)
    {
        await InvokeAsync(() =>
        {
            if (isPlaying)
            {
                _currentlySpeakingIndex = messageIndex;
            }
            else if (_currentlySpeakingIndex == messageIndex || messageIndex == -1)
            {
                _currentlySpeakingIndex = -1;
            }
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        RateLimitService.OnChange -= HandleRateLimitChanged;
        TenantState.OnChange -= OnTenantChanged;
        UserLocationService.OnLocationChanged -= OnLocationChanged;
        hoverCts?.Cancel();
        hoverCts?.Dispose();
        try
        {
            if (_isListening)
            {
                await JSRuntime.InvokeVoidAsync("librarianSpeech.stopListening");
            }
            if (_currentlySpeakingIndex != -1)
            {
                await JSRuntime.InvokeVoidAsync("librarianSpeech.stopSpeaking", _dotNetHelper);
            }
            _dotNetHelper?.Dispose();
        }
        catch
        {
            // Ignore JS errors during disposal
        }
    }
}

