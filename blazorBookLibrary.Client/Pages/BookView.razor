@page "/book-view/{BookIdStr}"
@implements IAsyncDisposable
@using System.Globalization
@using System.Threading
@using static BookLibrary.Shared.Commons
@using blazorBookLibrary.Shared
@using BookLibrary.Domain
@using BookLibrary.Shared.Services
@using Microsoft.FSharp.Core
@using Microsoft.AspNetCore.SignalR.Client
@using QRCoder

@inject IBookService BookService
@inject IAuthorService AuthorService
@inject IUserService UserService
@inject ILogger<BookView> Logger
@inject IReservationService ReservationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject IDetailsService DetailsService
@inject IReviewService ReviewService
@inject IEditorService EditorService
@inject IUserTenantResolverService UserTenantResolverService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@using Microsoft.Extensions.Localization
@using blazorBookLibrary.Shared.Resources
@using BookLibrary.Shared.Formats
@inject IStringLocalizer<SharedResources> L
@inject IBotScoreService BotScoreService
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject ITenantService TenantService
@rendermode InteractiveAuto

<PageTitle>@L["BookDetails"]</PageTitle>

@if (!string.IsNullOrEmpty(schemaOrgJsonLd))
{
    <HeadContent>
        <script type="application/ld+json">
            @((MarkupString)schemaOrgJsonLd)
        </script>
    </HeadContent>
}

<style>
    .tag-chip {
        padding: 0.4rem 1rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        font-weight: 500;
        white-space: nowrap;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
    }
    .type-book { background-color: #3b82f6; color: white; }
    .type-author { background-color: #10b981; color: white; }
    .type-general { background-color: #f59e0b; color: white; }
    .type-person { background-color: #06b6d4; color: white; }
    .type-generic { background-color: #6b7280; color: white; }
</style>

<div class="sanctuary-container">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-end mb-5 border-bottom pb-4" style="border-color: var(--outline-variant) !important;">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--secondary);">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-reset">@L["Home"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@L["BookDetails"]</li>
                </ol>
            </nav>
            <h1 class="display-5 mb-0" style="font-family: var(--font-serif); font-weight: 800; color: var(--primary);">@L["BookDetails"]</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (bookDetails != null)
            {
                <div class="dropdown">
                    <button class="btn-sanctuary-outline dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@L["CiteOrExport"]">
                        <i class="bi bi-quote me-1"></i> @L["Cite"]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li><button class="dropdown-item py-2" @onclick="DownloadBibTex"><i class="bi bi-file-earmark-code me-2 text-warning"></i> BibTeX (.bib)</button></li>
                        <li><button class="dropdown-item py-2" @onclick="CopyBibTex"><i class="bi bi-clipboard me-2 text-secondary"></i> @L["CopyBibTeX"]</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item py-2" @onclick="DownloadSchemaOrg"><i class="bi bi-diagram-3 me-2 text-info"></i> Schema.org (.jsonld)</button></li>
                        <li><button class="dropdown-item py-2" @onclick="CopySchemaOrg"><i class="bi bi-clipboard me-2 text-secondary"></i> @L["CopyJSONLD"]</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item py-2" @onclick="DownloadDublinCore"><i class="bi bi-file-earmark-text me-2 text-primary"></i> Dublin Core (.xml)</button></li>
                        <li><button class="dropdown-item py-2" @onclick="CopyDublinCore"><i class="bi bi-clipboard me-2 text-secondary"></i> @L["CopyDublinCore"]</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item py-2" @onclick="DownloadMarcXml"><i class="bi bi-file-earmark-code me-2 text-warning"></i> MARCXML (.xml)</button></li>
                        <li><button class="dropdown-item py-2" @onclick="CopyMarcXml"><i class="bi bi-clipboard me-2 text-secondary"></i> @L["CopyMarcXml"]</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item py-2" @onclick="DownloadMods"><i class="bi bi-file-earmark-code me-2 text-info"></i> MODS (.xml)</button></li>
                        <li><button class="dropdown-item py-2" @onclick="CopyMods"><i class="bi bi-clipboard me-2 text-secondary"></i> @L["CopyMods"]</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item py-2" @onclick="DownloadOnix"><i class="bi bi-file-earmark-text me-2 text-danger"></i> ONIX 3.0 (.xml)</button></li>
                        <li><button class="dropdown-item py-2" @onclick="CopyOnix"><i class="bi bi-clipboard me-2 text-secondary"></i> @L["CopyOnix"]</button></li>
                    </ul>
                </div>
            }
            <button class="btn-sanctuary-outline" @onclick="GoBack">
                <i class="bi bi-arrow-left me-2"></i>@L["Back"]
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
            <div class="spinner-grow text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (bookDetails != null)
    {
        <div class="row g-5">
            <!-- Left Column: Visual & Status Rail -->
            <div class="col-lg-4">
                <div class="card-sanctuary floating mb-4 text-center">
                    <div class="book-cover-wrap mb-4 bg-surface-low shadow-sm" style="height: 450px; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                        @if (FSharpOption<Uri>.get_IsSome(bookDetails.Book.ImageUrl))
                        {
                            <img src="@bookDetails.Book.ImageUrl.Value.ToString()" 
                                 alt="@bookDetails.Book.Title.Value Cover" 
                                 class="w-100 h-100" 
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <div class="text-center text-muted opacity-25">
                                <i class="bi bi-journal-text" style="font-size: 5rem;"></i>
                                <span class="d-block mt-3 serif">@L["NoCoverAvailable"]</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column gap-3 mt-2">
                        <div class="d-flex justify-content-center">
                            @if (bookDetails.Book.ImmediatelyAvailable)
                            {
                                <span class="badge-sanctuary badge-available">
                                    <i class="bi bi-check2-circle"></i> @L["AvailableForLoan"]
                                </span>
                            }
                            else
                            {
                                <span class="badge-sanctuary badge-borrowed">
                                    <i class="bi bi-hourglass-split"></i> @L["NotAvailable"]
                                </span>
                            }
                        </div>
                        
                        <div class="d-flex justify-content-center">
                             <span class="badge-sanctuary badge-neutral">
                                <i class="bi @(bookDetails.Book.Availability.CanCirculate ? "bi-journal-check" : "bi-journal-lock")"></i>
                                @GetAvailabilityLocalName(bookDetails.Book.Availability)
                            </span>
                        </div>
                    </div>

                    @if (bookDetails.Book.Availability.CanCirculate)
                    {
                        <div class="mt-5 p-4 bg-surface-low rounded-xl">
                            @if (isLoanConfirmedForBorrower)
                            {
                                <div class="p-4 text-center rounded-xl bg-success-subtle border border-success-subtle shadow-sm animate-fade-in my-2">
                                    <i class="bi bi-check-circle-fill text-success display-4 d-block mb-3"></i>
                                    <h5 class="serif fw-bold text-success mb-2">@L["LoanConfirmedTitle"]</h5>
                                    <p class="text-muted small mb-3">
                                        @L["LoanConfirmedMessage"]
                                    </p>
                                    <div class="p-2 bg-white rounded-lg border border-success-subtle small font-monospace text-success fw-bold d-inline-block px-3">
                                        <i class="bi bi-bookmark-check me-1"></i> @L["LoanStatusActive"]
                                    </div>
                                </div>
                            }
                            else
                            {
                                <h6 class="serif mb-3">@L["ReserveThisVolume"]</h6>
                                @if (isAuthenticated)
                            {
                                @if (userReservation != null)
                                {
                                    <div class="p-3 mb-1 small text-start bg-surface-lowest rounded shadow-sm border-start border-4 border-info animate-fade-in">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-check2-all text-info fw-bold"></i>
                                            <span class="fw-bold">@L["Active Reservation"]</span>
                                        </div>
                                        <p class="mb-3 text-muted">@L["AlreadyReservedMessage", userReservation.ReservedAt.ToLocalTime().ToString("g")]</p>
                                        
                                        @if (!string.IsNullOrEmpty(userPickupQrBase64))
                                        {
                                            <div class="mt-3 p-3 bg-white rounded-xl border text-center shadow-sm">
                                                <div class="x-small text-muted text-uppercase fw-bold mb-2">@L["PatronPickupPass"]</div>
                                                <img src="data:image/png;base64,@userPickupQrBase64" alt="Pickup QR Code" style="width: 170px; height: 170px; object-fit: contain;" class="d-inline-block rounded" />
                                                
                                                @if (!string.IsNullOrEmpty(userReservation.ReservationCode.Value))
                                                {
                                                    <div class="mt-2">
                                                        <span class="x-small text-muted text-uppercase fw-bold d-block">@L["ReservationCode"]</span>
                                                        <span class="font-monospace fw-bold fs-5 text-primary" style="letter-spacing: 0.15em;">@userReservation.ReservationCode.Value</span>
                                                    </div>
                                                }
                                                
                                                <p class="x-small text-muted mt-2 mb-0">
                                                    <i class="bi bi-qr-code-scan me-1 text-primary"></i>@L["ShowQrAtDeskHelp"]
                                                </p>
                                            </div>
                                        }

                                        <div class="mt-3 pt-3 border-top">
                                            @if (string.IsNullOrEmpty(activePin))
                                            {
                                                <button class="btn btn-sm btn-outline-info w-100 py-2 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                                        style="border-radius: 8px;"
                                                        @onclick="GeneratePin"
                                                        disabled="@isGeneratingPin">
                                                    @if (isGeneratingPin)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-shield-lock-fill"></i>
                                                    }
                                                    <span>@L["Get Checkout PIN"]</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="p-3 text-center rounded shadow-inner border border-info-subtle position-relative overflow-hidden" 
                                                     style="background: linear-gradient(135deg, rgba(13, 202, 240, 0.05), rgba(13, 202, 240, 0.15)); backdrop-filter: blur(8px); border-radius: 12px;">
                                                    <div class="small text-muted text-uppercase tracking-wider fw-bold mb-1" style="font-size: 0.7rem;">@L["Checkout PIN"]</div>
                                                    <div class="h3 font-monospace fw-bold tracking-widest text-info my-2" style="font-size: 2rem; letter-spacing: 0.15em;">@activePin</div>
                                                    
                                                    <div class="d-flex align-items-center justify-content-center gap-2 mt-2 text-info">
                                                        <i class="bi bi-stopwatch-fill animate-pulse"></i>
                                                        <span class="font-monospace fw-bold">@formattedCountdown</span>
                                                    </div>
                                                    
                                                    @if (isPinExpired)
                                                    {
                                                        <div class="text-danger small mt-2 fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @L["PIN expired. Please regenerate."]
                                                        </div>
                                                        <button class="btn btn-sm btn-outline-danger w-100 mt-2 py-1" style="border-radius: 6px;" @onclick="GeneratePin">
                                                            @L["Regenerate PIN"]
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (loggedInUserDetails != null && 
                                         loggedInUserDetails.FutureReservations.Length >= Configuration.GetValue<int>("BooksLibrary:MaxReservationsPerUser", 3))
                                {
                                    <div class="p-3 mb-1 small text-start bg-surface-lowest rounded shadow-sm border-start border-4 border-warning">
                                        <i class="bi bi-exclamation-octagon-fill me-2 text-warning"></i>
                                        @L["MaxReservationsReachedMessage", Configuration.GetValue<int>("BooksLibrary:MaxReservationsPerUser", 3)]
                                    </div>
                                }
                                else
                                {
                                    <button class="btn-sanctuary-primary w-100 justify-content-center" @onclick="ReserveBook">
                                        <i class="bi bi-calendar2-check"></i> @L["Reserve"]
                                    </button>
                                    <p class="text-muted small mt-3 mb-0">
                                        <i class="bi bi-people-fill me-1"></i> @L["Reservations"]: @bookDetails.ReservationsDetails.Length
                                    </p>
                                }
                            }
                            else
                            {
                                @if (guestReservationSubmitted)
                                {
                                    <div class="p-3 mb-1 small text-start bg-surface-lowest rounded shadow-sm border-start border-4 border-success animate-fade-in">
                                        <div class="d-flex align-items-center gap-2 mb-2 text-success">
                                            <i class="bi bi-check2-circle fw-bold fs-5"></i>
                                            <span class="fw-bold">@L["ReservationRequested"]</span>
                                        </div>
                                        <p class="mb-2 text-muted">@L["GuestReservationSuccess", guestName]</p>

                                        @if (!string.IsNullOrEmpty(guestPickupQrBase64))
                                        {
                                            <div class="mt-3 p-3 bg-white rounded-xl border text-center shadow-sm">
                                                <div class="x-small text-muted text-uppercase fw-bold mb-2">@L["PatronPickupPass"]</div>
                                                <img src="data:image/png;base64,@guestPickupQrBase64" alt="Pickup QR Code" style="width: 170px; height: 170px; object-fit: contain;" class="d-inline-block rounded" />
                                                
                                                @if (!string.IsNullOrEmpty(guestReservationCode))
                                                {
                                                    <div class="mt-2">
                                                        <span class="x-small text-muted text-uppercase fw-bold d-block">@L["ReservationCode"]</span>
                                                        <span class="font-monospace fw-bold fs-5 text-primary" style="letter-spacing: 0.15em;">@guestReservationCode</span>
                                                    </div>
                                                }
                                                
                                                <p class="x-small text-muted mt-2 mb-0">
                                                    <i class="bi bi-qr-code-scan me-1 text-primary"></i>@L["ShowQrAtDeskHelp"]
                                                </p>
                                            </div>
                                        }

                                        <div class="small text-muted fst-italic mt-3">
                                            <i class="bi bi-info-circle me-1"></i>@L["GuestReservationDeskHelp"]
                                        </div>
                                    </div>
                                }
                                else if (!bookDetails.Book.Availability.AllowsGuest)
                                {
                                    <div class="p-3 mb-1 small text-start bg-surface-lowest rounded shadow-sm border-start border-4 border-warning">
                                        <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                                            <i class="bi bi-person-lock fw-bold"></i>
                                            <span class="fw-bold">@L["RegisteredUsersOnlyTitle"]</span>
                                        </div>
                                        <p class="mb-2 text-muted">@L["RegisteredUsersOnlyNotice"]</p>
                                        <a href="/Account/Login" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                            <i class="bi bi-box-arrow-in-right me-1"></i>@L["LogIn"]
                                        </a>
                                    </div>
                                }
                                else if (bookDetails.Book.Available && bookDetails.PendingReservationsDetails.IsEmpty)
                                {
                                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3 text-start" style="border-radius: 8px;">
                                        <i class="bi bi-info-circle-fill text-info fs-6"></i>
                                        <div>
                                            @L["GuestReservationNotice"]
                                            <a href="/Account/Login" class="fw-bold text-decoration-underline text-reset ms-1">@L["LogIn"]</a>
                                        </div>
                                    </div>

                                    @if (libraryTenant?.GeoLocSettings != null && libraryTenant.GeoLocSettings.IsEnabled && libraryTenant.GeoLocSettings.OptCoordinates != null && Microsoft.FSharp.Core.FSharpOption<Coordinates>.get_IsSome(libraryTenant.GeoLocSettings.OptCoordinates))
                                    {
                                        var coords = libraryTenant.GeoLocSettings.OptCoordinates.Value;
                                        <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3 text-start" style="border-radius: 8px;">
                                            <i class="bi bi-geo-alt-fill text-warning fs-6"></i>
                                            <div>
                                                <strong>@L["ProximityCheckRequired"]</strong>: @string.Format(L["GuestReservationProximityNotice"].Value, (int)coords.RadiusInMeters)
                                            </div>
                                        </div>
                                    }

                                    <div class="mb-2 text-start">
                                        <label class="form-label small fw-semibold mb-1">@L["YourName"] <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm" placeholder="@L["FullName"]" @bind="guestName" />
                                    </div>

                                    <div class="mb-2 text-start">
                                        <label class="form-label small fw-semibold mb-1">@L["PhoneNumber"] <span class="text-muted fw-normal">(@L["Optional"])</span></label>
                                        <input type="tel" class="form-control form-control-sm" placeholder="+123456789" @bind="guestPhone" />
                                    </div>

                                    <div class="mb-2 text-start">
                                        <label class="form-label small fw-semibold mb-1">@L["Email"] <span class="text-muted fw-normal">(@L["Optional"])</span></label>
                                        <input type="email" class="form-control form-control-sm" placeholder="name@example.com" @bind="guestEmail" />
                                    </div>

                                    <div class="mb-3 text-start">
                                        <label class="form-label small fw-semibold mb-1">@L["Notes"] <span class="text-muted fw-normal">(@L["Optional"])</span></label>
                                        <textarea class="form-control form-control-sm" rows="2" placeholder="@L["OptionalNotesPlaceholder"]" @bind="guestNotes"></textarea>
                                    </div>

                                    @if (!string.IsNullOrEmpty(guestFormError))
                                    {
                                        <div class="text-danger small mb-2 text-start">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@guestFormError
                                        </div>
                                    }

                                    <button class="btn-sanctuary-primary w-100 justify-content-center" @onclick="ReserveAsGuest" disabled="@isSubmittingGuest">
                                        @if (isSubmittingGuest)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>@L["Submitting..."]</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-check-fill me-1"></i>
                                            <span>@L["ReserveAsGuest"]</span>
                                        }
                                    </button>
                                }
                                else
                                {
                                    <div class="p-3 mb-1 small text-start bg-surface-lowest rounded shadow-sm border-start border-4 border-warning">
                                        <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                                            <i class="bi bi-clock-history fw-bold"></i>
                                            <span class="fw-bold">@L["UnavailableForGuestReservation"]</span>
                                        </div>
                                        <p class="mb-2 text-muted">@L["GuestReservationWaitlistNotice"]</p>
                                        <a href="/Account/Login" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                            <i class="bi bi-box-arrow-in-right me-1"></i>@L["LogInToJoinWaitlist"]
                                        </a>
                                    </div>
                                }
                            }
                            }
                        </div>
                    }

                    <div class="mt-4 pt-4 border-top text-start" style="border-color: var(--outline-variant) !important;">
                         @if (isReviewSystemEnabled)
                         {
                            <button class="btn-sanctuary-outline w-100 justify-content-center" disabled="@(!canAddReview)" @onclick="AddReview">
                                <i class="bi bi-pencil-square me-2"></i> @L["AddReview"]
                            </button>
                            
                            @if (userReview != null)
                            {
                                <button class="btn btn-outline-primary w-100 justify-content-center mt-2 shadow-sm" @onclick="EditReview">
                                    <i class="bi bi-pencil-fill me-2"></i> @L["EditYourReview"]
                                </button>
                            }
                         }

                         @if (isReviewSystemEnabled && !canAddReview && loggedInUserDetails != null)
                        {
                            var restrictionMessage = !hasLoaned 
                                ? L["ReviewRestrictionMessage"] 
                                : L["AlreadyHasApprovedReview"];
                                
                            <div class="mt-3 p-3 bg-surface-low rounded border-start border-3 border-secondary small text-muted">
                                <i class="bi bi-info-circle me-1"></i> @restrictionMessage
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Editorial Details -->
            <div class="col-lg-8">
                <div class="card-sanctuary bg-surface-lowest">
                    <h2 class="serif display-6 mb-2">@bookDetails.Book.Title.Value</h2>
                    
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @foreach (var author in bookDetails.Authors)
                        {
                            <a href="/author-view/@author.AuthorId.Value" class="text-decoration-none">
                                <span class="badge-sanctuary badge-neutral" style="color: var(--secondary);">
                                    <i class="bi bi-person-fill"></i> @author.Name.Value
                                </span>
                            </a>
                        }
                    </div>

                    @if (bookDetails.Book.Tags.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @foreach (var tag in bookDetails.Book.Tags)
                            {
                                <span class="tag-chip @GetTagColorClass(GetTagTypeName(tag)) shadow-sm">
                                    <i class="bi bi-tag-fill me-1"></i> @tag.TagName
                                </span>
                            }
                        </div>
                    }

                    <div class="row mt-5">
                        <div class="col-md-7">
                            <h5 class="serif mb-3 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">@L["Description"]</h5>
                            @if (FSharpOption<string>.get_IsSome(bookDetails.Book.Description))
                            {
                                <div class="pe-md-4" style="line-height: 1.8; color: var(--on-surface); font-size: 1.05rem;">
                                    @bookDetails.Book.Description.Value
                                </div>
                            }
                            else
                            {
                                <p class="text-muted fst-italic">@L["NoDescriptionAvailable"]</p>
                            }
                        </div>
                        
                        <div class="col-md-5 mt-4 mt-md-0">
                            <div class="p-4 bg-surface-low rounded-xl">
                                <h5 class="serif mb-4">@L["Metadata"]</h5>
                                <dl class="details-list mb-0">
                                    <dt>@L["ISBN"]</dt>
                                    <dd class="font-monospace">@bookDetails.Book.Isbn.Value</dd>

                                    @if (FSharpOption<SbnCode>.get_IsSome(bookDetails.Book.SbnCode))
                                    {
                                        <dt>@L["SBN"]</dt>
                                        <dd>
                                            <span class="font-monospace">@bookDetails.Book.SbnCode.Value.Value</span>
                                            @if (bookDetails.Book.SbnCode.Value.IsInvalidSbn)
                                            {
                                                <span class="badge bg-warning text-dark x-small ms-1 py-0 px-1" title="Marked as invalid format">invalid</span>
                                            }
                                        </dd>
                                    }

                                    <dt>@L["PublicationYear"]</dt>
                                    <dd>@bookDetails.Book.Year.Value</dd>

                                    @if (!string.IsNullOrEmpty(resolvedPublisher))
                                    {
                                        <dt>@L["Publisher"]</dt>
                                        <dd>@resolvedPublisher</dd>
                                    }

                                    <dt>@L["MainCategory"]</dt>
                                    <dd>
                                        <span class="badge-sanctuary badge-neutral mt-1">@bookDetails.Book.MainCategory.Value()</span>
                                    </dd>

                                    @if (FSharpOption<DistributionPoint>.get_IsSome(bookDetails.DistributionPoint))
                                    {
                                        <dt>@L["DistributionPoint"]</dt>
                                        <dd>
                                            <span class="badge-sanctuary badge-neutral mt-1">
                                                <i class="bi bi-geo-alt-fill me-1"></i>
                                                @bookDetails.DistributionPoint.Value.Name.Value
                                            </span>
                                        </dd>
                                    }
                                    
                                    @if (bookDetails.Book.AdditionalCategories.Any())
                                    {
                                        <dt>@L["Categories"]</dt>
                                        <dd>
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var cat in bookDetails.Book.AdditionalCategories)
                                                {
                                                    <span class="badge-sanctuary bg-surface-container text-muted" style="font-size: 0.7rem;">@cat.Value()</span>
                                                }
                                            </div>
                                        </dd>
                                    }
                                </dl>
                            </div>
                        </div>

                        @if (bookDetails.Book.Papers.Any())
                        {
                            <div class="col-12 mt-5 pt-4 border-top" style="border-color: var(--outline-variant) !important;">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <h3 class="h4 text-serif mb-0">@L["CollectedPapers"]</h3>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 small">
                                            @(bookDetails.Book.Papers.Length) @(bookDetails.Book.Papers.Length == 1 ? L["Paper"] : L["Papers"])
                                        </span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary shadow-sm rounded-pill px-3" @onclick="TogglePapersDrillDown">
                                        <i class="bi @(isPapersDrillDownOpen ? "bi-chevron-up" : "bi-layers-half") me-1"></i>
                                        @(isPapersDrillDownOpen ? L["HidePapers"] : L["DrillDownPapers"])
                                    </button>
                                </div>

                                @if (isPapersDrillDownOpen)
                                {
                                    <div class="d-flex flex-column gap-3 animate-fade-in">
                                        @for (int i = 0; i < bookDetails.Book.Papers.Length; i++)
                                        {
                                            var paper = bookDetails.Book.Papers[i];
                                            var paperIndex = i + 1;
                                            <div class="p-4 bg-surface-low rounded-xl border border-neutral shadow-sm">
                                                <div class="d-flex align-items-baseline gap-2 mb-2">
                                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 small fw-bold">#@paperIndex</span>
                                                    <h5 class="serif mb-0 fw-bold">@paper.Title.Value</h5>
                                                </div>

                                                @if (FSharpOption<string>.get_IsSome(paper.Description) && !string.IsNullOrWhiteSpace(paper.Description.Value))
                                                {
                                                    <p class="serif italic text-muted small mb-3 lh-base" style="white-space: pre-wrap;">
                                                        @paper.Description.Value
                                                    </p>
                                                }

                                                @if (paper.Authors.Any())
                                                {
                                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                                        <span class="x-small text-muted text-uppercase fw-bold me-1"><i class="bi bi-people me-1"></i>@L["Authors"]:</span>
                                                        @foreach (var authorId in paper.Authors)
                                                        {
                                                            <a href="/author-view/@authorId.Value" class="badge-sanctuary badge-neutral text-decoration-none p-1 px-2 small">
                                                                <i class="bi bi-person me-1"></i>@GetPaperAuthorName(authorId)
                                                            </a>
                                                        }
                                                    </div>
                                                }

                                                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top border-light">
                                                    @if (paper.Categories.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-1 align-items-center me-3">
                                                            <span class="x-small text-muted text-uppercase fw-bold me-1">@L["Categories"]:</span>
                                                            @foreach (var cat in paper.Categories)
                                                            {
                                                                <span class="badge-sanctuary bg-surface-container text-muted small" style="font-size: 0.75rem;">@cat.Value()</span>
                                                            }
                                                        </div>
                                                    }
                                                    @if (paper.Tags.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                                            <span class="x-small text-muted text-uppercase fw-bold me-1">@L["Tags"]:</span>
                                                            @foreach (var tag in paper.Tags)
                                                            {
                                                                <span class="tag-chip @GetTagColorClass(GetTagTypeName(tag)) py-1 px-2 small" style="font-size: 0.75rem;">
                                                                    @tag.TagName
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (shuffledReviews != null && shuffledReviews.Any())
                        {
                            <div class="mt-5 pt-4 border-top" style="border-color: var(--outline-variant) !important;">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h3 class="h4 text-serif mb-0">@L["PatronReflections"]</h3>
                                    <button class="btn btn-sm btn-outline-neutral shadow-sm" @onclick="ToggleReviews">
                                        <i class="bi @(showReviews ? "bi-eye-slash" : "bi-eye") me-2"></i>
                                        @(showReviews ? L["HideReviews"] : L["ShowReviews"])
                                    </button>
                                </div>

                                @if (showReviews)
                                {
                                    <div class="review-frame p-4 bg-surface-low rounded shadow-sm animate-fade-in border border-neutral">
                                        <div class="small text-muted italic mb-4 p-2 border-start border-3 border-neutral bg-surface-container">
                                            <i class="bi bi-info-circle me-1"></i> @L["ReviewsDisclaimer"]
                                        </div>

                                        @{
                                            var review = shuffledReviews[currentReviewIndex];
                                        }

                                        <div class="review-content mb-4">
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <div>
                                                    <div class="fw-bold text-serif h5 mb-0">@string.Format(L["ReviewBy"], review.AppUser.UserName)</div>
                                                    <div class="small text-muted">@review.Review.Date.ToLocalTime().ToString("D")</div>
                                                </div>
                                                <div class="review-index badge bg-neutral text-muted px-2 py-1 small">
                                                    @(currentReviewIndex + 1) / @shuffledReviews.Count
                                                </div>
                                            </div>
                                            <div class="review-text-container p-3 bg-surface rounded-lg shadow-inner mt-2">
                                                <p class="review-text text-serif italic mb-0" style="font-size: 1.1rem; line-height: 1.7; color: var(--text-main);">
                                                    “@review.Review.Comment”
                                                </p>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-4">
                                            <button class="btn btn-sm btn-neutral px-3" 
                                                    @onclick="PrevReview" 
                                                    disabled="@(shuffledReviews.Count <= 1)">
                                                <i class="bi bi-chevron-left me-1"></i> @L["PreviousReview"]
                                            </button>
                                            <div class="review-dots d-flex gap-1">
                                                @for (int i = 0; i < shuffledReviews.Count; i++)
                                                {
                                                    <div class="dot @(i == currentReviewIndex ? "active" : "")" style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--surface-neutral); opacity: @(i == currentReviewIndex ? "1" : "0.3");"></div>
                                                }
                                            </div>
                                            <button class="btn btn-sm btn-neutral px-3" 
                                                    @onclick="NextReview" 
                                                    disabled="@(shuffledReviews.Count <= 1)">
                                                @L["NextReview"] <i class="bi bi-chevron-right ms-1"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string BookIdStr { get; set; } = "";

    private bool isLoading = true;
    private bool isPapersDrillDownOpen = false;
    private Dictionary<Guid, Author> _resolvedPaperAuthors = new();
    private bool showReviews = false;
    private int currentReviewIndex = 0;
    private bool isReviewSystemEnabled = true;
    private List<Details.ReviewDetails> shuffledReviews = new();
    private Details.BookDetails? bookDetails;
    private string? schemaOrgJsonLd;
    private string? resolvedPublisher;
    private Details.UserDetails? loggedInUserDetails;
    private bool canAddReview = false;
    private bool hasLoaned = false;
    private Review? userReview;
    private Reservation? userReservation;
    private string statusMessage = "";
    private string statusClass = "alert-info";

    private bool isAuthenticated = false;
    private string guestName = "";
    private string guestPhone = "";
    private string guestEmail = "";
    private string guestNotes = "";
    private bool isSubmittingGuest = false;
    private bool guestReservationSubmitted = false;
    private string? guestPickupQrBase64 = null;
    private string? userPickupQrBase64 = null;
    private string? guestReservationCode = null;
    private Guid? guestReservationId = null;
    private bool isLoanConfirmedForBorrower = false;
    private string? guestFormError = null;
    private Tenant? libraryTenant;

    private void UpdateUserPickupQr()
    {
        if (userReservation != null && !string.IsNullOrEmpty(userReservation.ReservationCode.Value))
        {
            try
            {
                var pickupUrl = NavManager.ToAbsoluteUri($"/confirm-loan/{userReservation.ReservationId.Value}?code={userReservation.ReservationCode.Value}").ToString();
                using var qrGenerator = new QRCodeGenerator();
                using var qrCodeData = qrGenerator.CreateQrCode(pickupUrl, QRCodeGenerator.ECCLevel.Q);
                var qrCode = new PngByteQRCode(qrCodeData);
                byte[] qrCodeAsPngByteArr = qrCode.GetGraphic(20);
                userPickupQrBase64 = Convert.ToBase64String(qrCodeAsPngByteArr);
            }
            catch (Exception qrEx)
            {
                Logger.LogWarning(qrEx, "Could not generate user pickup QR code");
                userPickupQrBase64 = null;
            }
        }
        else
        {
            userPickupQrBase64 = null;
        }
    }

    private string activePin = "";
    private DateTime pinExpiresAt;
    private string formattedCountdown = "15:00";
    private bool isPinExpired = false;
    private bool isGeneratingPin = false;
    private System.Threading.Timer? countdownTimer;

    private async Task GeneratePin()
    {
        if (userReservation == null) return;
        isGeneratingPin = true;
        StateHasChanged();
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = TenantState.GetUserContext(authState.User);
            var result = await ReservationService.GeneratePickupPinAsync(context, userReservation.ReservationId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                activePin = result.ResultValue.Item1;
                pinExpiresAt = result.ResultValue.Item2;
                isPinExpired = false;
                StartCountdown();
            }
            else
            {
                Logger.LogError("Error generating pickup PIN: {Error}", result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while generating pickup PIN");
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
        finally
        {
            isGeneratingPin = false;
            StateHasChanged();
        }
    }

    private void StartCountdown()
    {
        countdownTimer?.Dispose();
        isPinExpired = false;
        countdownTimer = new System.Threading.Timer(async _ =>
        {
            var remaining = pinExpiresAt - DateTime.UtcNow;
            if (remaining.TotalSeconds <= 0)
            {
                isPinExpired = true;
                formattedCountdown = "00:00";
                countdownTimer?.Dispose();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                formattedCountdown = $"{(int)remaining.TotalMinutes:D2}:{remaining.Seconds:D2}";
                await InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);
    }

    public async ValueTask DisposeAsync()
    {
        countdownTimer?.Dispose();
        if (hubConnection is not null)
        {
            try
            {
                if (guestReservationId.HasValue)
                {
                    await hubConnection.SendAsync("LeaveReservationGroup", guestReservationId.Value);
                }
                if (userReservation != null)
                {
                    await hubConnection.SendAsync("LeaveReservationGroup", userReservation.ReservationId.Value);
                }
                if (bookDetails != null)
                {
                    await hubConnection.SendAsync("LeaveBookGroup", bookDetails.Book.BookId.Value);
                    await hubConnection.SendAsync("LeaveTenantGroup", bookDetails.Book.TenantId.Value);
                }
            }
            catch {}
            await hubConnection.DisposeAsync();
        }
    }

    private void GoBack()
    {
        JSRuntime.InvokeVoidAsync("history.back");
    }

    private async Task ReserveBook()
    {
        if (bookDetails == null) return;
        
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated != true)
        {
            await ShowStatus(L["PleaseLoginToReserve"], "alert-warning");
            return;
        }

        var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userIdStr) || !Guid.TryParse(userIdStr, out var userGuid))
        {
            await ShowStatus(L["UserIdentifierNotFound"], "alert-danger");
            return;
        }

        var sharpinoUserId = UserId.NewUserId(userGuid);
        
        int maxReservations = Configuration.GetValue<int>("BooksLibrary:MaxReservationsPerUser", 3);

        if (userReservation != null)
        {
            await ShowStatus(L["AlreadyReservedMessage", userReservation.ReservedAt.ToLocalTime().ToString("g")], "alert-warning");
            return;
        }

        if (loggedInUserDetails != null && loggedInUserDetails.FutureReservations.Length >= maxReservations)
        {
            await ShowStatus(L["MaxReservationsReachedMessage", maxReservations], "alert-warning");
            return;
        }

        try 
        {
            isLoading = true;
            StateHasChanged();

            int loanDuration = Configuration.GetValue<int>("BooksLibrary:TimeSlotLoanDurationInDays", 25);
            var now = DateTime.UtcNow;
            var nextSlot = bookDetails.GetNextAvailableTimeSlot(loanDuration, now);
            var context = ConverterUtils.fromClaimsPrincipal(authState.User);

            var tryTenant = await UserTenantResolverService.GetTenantForUserAsync(context);
            if (tryTenant.IsError) 
            {
                Logger.LogError(tryTenant.ErrorValue);
                await ShowStatus("an error occurred", "error");
                return;
            }
            var tenantId = tryTenant.ResultValue;
            
            var reservation = Reservation.New(tenantId, bookDetails.Book.BookId, sharpinoUserId, nextSlot, now);
            
            var result = await ReservationService.AddReservationAsync(context, reservation, ShortLang.New(CultureInfo.CurrentCulture.Name.Substring(0,2)), FSharpOption<System.Threading.CancellationToken>.None);
            
            if (result.IsOk)
            {
                isLoanConfirmedForBorrower = false;
                userReservation = reservation;
                UpdateUserPickupQr();
                await ShowStatus(L["ReservationSuccessMessage"], "alert-success");
                await LoadBookDetails();
                await LoadUserReservation();

                if (hubConnection != null && hubConnection.State == HubConnectionState.Connected && userReservation != null)
                {
                    try
                    {
                        await hubConnection.SendAsync("JoinReservationGroup", userReservation.ReservationId.Value);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to join reservation group in ReserveBook");
                    }
                }
            }
            else
            {
                await ShowStatus(L["ReservationFailedMessage", result.ErrorValue], "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(L["ReservationFailedMessage", ex.Message], "alert-danger");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReserveAsGuest()
    {
        if (bookDetails == null) return;

        guestFormError = null;
        if (string.IsNullOrWhiteSpace(guestName))
        {
            guestFormError = L["NameIsRequired"]?.Value ?? "Name is required.";
            return;
        }

        try
        {
            isSubmittingGuest = true;
            StateHasChanged();

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = TenantState.GetUserContext(authState.User);
            var tenantId = bookDetails.Book.TenantId;

            int loanDuration = Configuration.GetValue<int>("BooksLibrary:TimeSlotLoanDurationInDays", 25);
            var now = DateTime.UtcNow;
            var nextSlot = bookDetails.GetNextAvailableTimeSlot(loanDuration, now);

            FSharpOption<string> ToOpt(string? s) =>
                string.IsNullOrWhiteSpace(s) ? FSharpOption<string>.None : FSharpOption<string>.Some(s.Trim());

            FSharpOption<Coordinates> guestCoordinates = FSharpOption<Coordinates>.None;

            if (libraryTenant?.GeoLocSettings != null && libraryTenant.GeoLocSettings.IsEnabled)
            {
                DeviceLocationResult? locResult = null;
                try
                {
                    locResult = await JSRuntime.InvokeAsync<DeviceLocationResult>("tenantMap.getDeviceCoordinates");
                }
                catch (Exception jsEx)
                {
                    Logger.LogWarning(jsEx, "Failed to invoke tenantMap.getDeviceCoordinates");
                }

                if (locResult == null || !locResult.Success)
                {
                    guestFormError = !string.IsNullOrWhiteSpace(locResult?.ErrorMessage)
                        ? locResult.ErrorMessage
                        : (L["GeolocationRequiredForGuest"]?.Value ?? "Location access is required to verify proximity to the library.");
                    return;
                }

                guestCoordinates = FSharpOption<Coordinates>.Some(
                    Coordinates.New(locResult.Latitude, locResult.Longitude, locResult.Accuracy > 0 ? locResult.Accuracy : 50.0)
                );
            }

            var guestPatron = new GuestPatron(
                guestName.Trim(),
                ToOpt(guestPhone),
                ToOpt(guestEmail),
                ToOpt(guestNotes),
                guestCoordinates
            );

            var reservation = Reservation.NewGuest(tenantId, bookDetails.Book.BookId, guestPatron, nextSlot, now);
            var langStr = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
            var result = await ReservationService.AddReservationAsync(
                context,
                reservation,
                ShortLang.New(string.IsNullOrEmpty(langStr) ? "en" : langStr),
                FSharpOption<CancellationToken>.None
            );

            if (result.IsOk)
            {
                guestReservationSubmitted = true;
                guestReservationId = reservation.ReservationId.Value;
                guestReservationCode = reservation.ReservationCode.Value;
                isLoanConfirmedForBorrower = false;
                try
                {
                    var pickupUrl = NavManager.ToAbsoluteUri($"/confirm-loan/{reservation.ReservationId.Value}?code={reservation.ReservationCode.Value}").ToString();
                    using var qrGenerator = new QRCodeGenerator();
                    using var qrCodeData = qrGenerator.CreateQrCode(pickupUrl, QRCodeGenerator.ECCLevel.Q);
                    var qrCode = new PngByteQRCode(qrCodeData);
                    byte[] qrCodeAsPngByteArr = qrCode.GetGraphic(20);
                    guestPickupQrBase64 = Convert.ToBase64String(qrCodeAsPngByteArr);
                }
                catch (Exception qrEx)
                {
                    Logger.LogWarning(qrEx, "Could not generate guest pickup QR code");
                }

                if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
                {
                    try
                    {
                        await hubConnection.SendAsync("JoinReservationGroup", reservation.ReservationId.Value);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Could not join reservation SignalR group in BookView");
                    }
                }

                await ShowStatus(L["ReservationSuccessMessage"].Value, "alert-success");
                await LoadBookDetails();
            }
            else
            {
                guestFormError = result.ErrorValue;
                await ShowStatus(L["ReservationFailedMessage", result.ErrorValue].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            guestFormError = ex.Message;
            await ShowStatus(L["ReservationFailedMessage", ex.Message].Value, "alert-danger");
        }
        finally
        {
            isSubmittingGuest = false;
            StateHasChanged();
        }
    }

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavManager.ToAbsoluteUri("/hubs/library"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<Guid>("ReservationConfirmedIntoLoan", async (confirmedReservationId) =>
            {
                var matchesGuest = guestReservationId.HasValue && guestReservationId.Value == confirmedReservationId;
                var matchesUser = userReservation != null && userReservation.ReservationId.Value == confirmedReservationId;

                if (matchesGuest || matchesUser)
                {
                    await JSRuntime.InvokeVoidAsync("playScanSound");
                    isLoanConfirmedForBorrower = true;
                    guestReservationSubmitted = false;
                    guestPickupQrBase64 = null;
                    userPickupQrBase64 = null;
                    userReservation = null;
                    activePin = "";
                    await LoadBookDetails();
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<Guid, Guid>("BookAvailabilityChanged", async (tenantId, bookId) =>
            {
                if (bookDetails != null && bookDetails.Book.BookId.Value == bookId)
                {
                    var prevGuestResId = guestReservationId;
                    var prevUserRes = userReservation;
                    await LoadBookDetails();
                    await LoadUserReservation();

                    if (prevGuestResId.HasValue && !isLoanConfirmedForBorrower)
                    {
                        var isStillPending = bookDetails.PendingReservationsDetails.Any(r => r.Reservation.ReservationId.Value == prevGuestResId.Value);
                        if (!isStillPending)
                        {
                            await JSRuntime.InvokeVoidAsync("playScanSound");
                            isLoanConfirmedForBorrower = true;
                            guestReservationSubmitted = false;
                            guestPickupQrBase64 = null;
                        }
                    }
                    else if (prevUserRes != null && userReservation == null && !isLoanConfirmedForBorrower)
                    {
                        await JSRuntime.InvokeVoidAsync("playScanSound");
                        isLoanConfirmedForBorrower = true;
                        userPickupQrBase64 = null;
                        activePin = "";
                    }

                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<Guid>("BookDetailsChanged", async (id) =>
            {
                if (bookDetails != null && bookDetails.Book.BookId.Value == id)
                {
                    await LoadBookDetails();
                    await LoadUserReservation();
                    await InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not start SignalR hub connection in BookView. Expected during prerendering.");
        }

        isReviewSystemEnabled = Configuration.GetValue<bool>("BooksLibrary:ReviewSytemEnabled", true);
        await LoadBookDetails();
        await LoadUserReservation();

        if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
        {
            try
            {
                if (bookDetails != null)
                {
                    await hubConnection.SendAsync("JoinBookGroup", bookDetails.Book.BookId.Value);
                    await hubConnection.SendAsync("JoinTenantGroup", bookDetails.Book.TenantId.Value);
                }
                if (userReservation != null)
                {
                    await hubConnection.SendAsync("JoinReservationGroup", userReservation.ReservationId.Value);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to join SignalR groups in BookView");
            }
        }
    }

    private async Task LoadBookDetails()
    {
        isLoading = true;
        statusMessage = "";

        try
        {
            if (Guid.TryParse(BookIdStr, out var guid))
            {
                var bookId = BookId.NewBookId(guid);
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var context = TenantState.GetUserContext(authState.User);
                var result = await DetailsService.GetBookDetailsAsync(context, bookId, FSharpOption<CancellationToken>.None);

                if (result.IsOk)
                {
                    bookDetails = result.ResultValue;
                    shuffledReviews = bookDetails.ApprovedVisibleReviewsInRandomOrder().ToList();
                    foreach (var author in bookDetails.Authors)
                    {
                        _resolvedPaperAuthors[author.AuthorId.Value] = author;
                    }
                    if (bookDetails.Book.Papers.Any())
                    {
                        await EnsurePaperAuthorsResolved(bookDetails.Book.Papers);
                    }

                    try
                    {
                        var tenantResult = await TenantService.GetTenantAsync(context, bookDetails.Book.TenantId, FSharpOption<CancellationToken>.None);
                        if (tenantResult.IsOk)
                        {
                            libraryTenant = tenantResult.ResultValue;
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to load library tenant details for proximity check");
                    }

                    if (FSharpOption<EditorId>.get_IsSome(bookDetails.Book.Editor))
                    {
                        try
                        {
                            var edResult = await EditorService.GetEditorAsync(context, bookDetails.Book.Editor.Value, FSharpOption<CancellationToken>.None);
                            if (edResult.IsOk)
                            {
                                resolvedPublisher = edResult.ResultValue.Name.Value;
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Failed to load editor details for publisher attribution");
                        }
                    }

                    var pubOpt = resolvedPublisher != null ? FSharpOption<string>.Some(resolvedPublisher) : FSharpOption<string>.None;
                    schemaOrgJsonLd = FormatSerializers.formatSchemaOrgBook(bookDetails, pubOpt);
                }
                else
                {
                    await ShowStatus(string.Format(L["ErrorLoadingBook"], result.ErrorValue), "alert-danger");
                }
            }
            else
            {
                await ShowStatus(L["InvalidBookIdInUrl"], "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorLoadingData"], ex.Message), "alert-danger");
        }
        finally
        {
            isLoading = false;
        }
    }

