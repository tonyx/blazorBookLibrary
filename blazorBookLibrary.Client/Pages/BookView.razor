    private async Task LoadUserReservation()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAuthenticated = user.Identity?.IsAuthenticated == true;
            var context = TenantState.GetUserContext(user);
            
            if (isAuthenticated)
            {
                var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out var userGuid))
                {
                    var sharpinoUserId = UserId.NewUserId(userGuid);
                    var result = await DetailsService.GetUserDetailsAsync(context, sharpinoUserId, FSharpOption<System.Threading.CancellationToken>.None);

                    if (result.IsOk)
                    {
                        loggedInUserDetails = result.ResultValue;
                        if (bookDetails != null)
                        {
                            userReview = loggedInUserDetails.BooksAndReviews
                                .Select(br => br.Item2)
                                .FirstOrDefault(r => r.BookId.Value == bookDetails.Book.BookId.Value);

                            userReservation = loggedInUserDetails.FutureReservations
                                .Select(t => t.Item1)
                                .FirstOrDefault(r => r.BookId.Value == bookDetails.Book.BookId.Value);

                            UpdateUserPickupQr();

                            var reviewResult = await BookService.LoanedByUserAtLeastOnceAsync(context, bookDetails.Book.BookId, sharpinoUserId, FSharpOption<CancellationToken>.None);
                            if (reviewResult.IsOk)
                            {
                                hasLoaned = reviewResult.ResultValue;
                                canAddReview = hasLoaned && !loggedInUserDetails.HasAnApprovedReviewOfBook(bookDetails.Book.BookId);
                            }
                        }
                    }
                }
            }
            else
            {
                loggedInUserDetails = null;
                userReservation = null;
                userPickupQrBase64 = null;
                userReview = null;
                canAddReview = false;
                hasLoaned = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Error loading user reservation: {Message}", ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var siteKey = Configuration["Authentication:Recaptcha:SiteKey"];
        if (siteKey is null)
            {
                Logger.LogWarning("Recaptcha SiteKey is not configured");
                return;
            }
        if (firstRender)
        {
            var token = await JSRuntime.InvokeAsync<string>("generateRecaptchaToken", siteKey, "book_view");
            var score = await BotScoreService.GetBotScoreAsync(token);
            if (score < 0.7) 
            {
                Logger.LogInformation($"suspect bot interaction. Score: {score}");
                await BotScoreService.ApplyBotDelayAsync(score);
            }
        }
    }

