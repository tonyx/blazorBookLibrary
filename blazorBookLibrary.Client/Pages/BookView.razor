    private void NextReview()
    {
        if (shuffledReviews != null && shuffledReviews.Any())
        {
            currentReviewIndex = (currentReviewIndex + 1) % shuffledReviews.Count;
        }
    }

    private void PrevReview()
    {
        if (shuffledReviews != null && shuffledReviews.Any())
        {
            currentReviewIndex = (currentReviewIndex - 1 + shuffledReviews.Count) % shuffledReviews.Count;
        }
    }

    private async Task ShowStatus(string message, string cssClass)
    {
        statusMessage = message;
        statusClass = cssClass;
        StateHasChanged();

        try
        {
            string type = "info";
            if (cssClass.Contains("success")) type = "success";
            else if (cssClass.Contains("danger")) type = "error";
            else if (cssClass.Contains("warning")) type = "warning";

            await JSRuntime.InvokeVoidAsync("showToast", message, type);
        }
        catch
        {
            // JS interop might not be available during prerendering
        }
    }


    private string GetAvailabilityLocalName(Availability availability)
    {
        if (availability.IsCirculatingIncludingGuest) return L["CirculatingIncludingGuestRule"];
        if (availability.IsCirculating) return L["CirculatingRule"];
        if (availability.IsReferenceOnly) return L["ReferenceOnlyRule"];
        return L["UnspecifiedRule"];
    }

    private string GetTagTypeName(Tag tag)
    {
        if (tag.IsBookTag) return "Book";
        if (tag.IsAuthorTag) return "Author";
        if (tag.IsGeneralTag) return "General";
        if (tag.IsPersonTag) return "Person";
        if (tag.IsGenericTag) return "Generic";
        return "Generic";
    }

    private string GetTagColorClass(string type)
    {
        return type switch
        {
            "Book" => "type-book",
            "Author" => "type-author",
            "General" => "type-general",
            "Person" => "type-person",
            "Generic" => "type-generic",
            _ => "type-generic"
        };
    }

