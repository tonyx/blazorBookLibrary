    private class SuspendPatronModel
    {
        [Required(ErrorMessage = "Suspension reason is required")]
        [MinLength(1, ErrorMessage = "Suspension reason cannot be empty")]
        public string Reason { get; set; } = "";
    }

    private class InvitePatronModel
    {
        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Invalid email address format")]
        public string Email { get; set; } = "";
    }

    private async Task HandleInvitePatron()
    {
        isInviting = true;
        inviteErrorMessage = null;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal == null) return;
            var userContext = TenantState.GetUserContext(claimsPrincipal);
            var tenantId = TenantId.NewTenantId(Id);

            // 1. Look up user ID by exact email address using ASP.NET Identity database via UserService
            var lookupResult = await UserService.GetUserIdByEmailAsync(userContext, inviteModel.Email.Trim(), Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
            if (lookupResult.IsError)
            {
                Logger.LogError("Error looking up user ID by email {Email}: {Error}", inviteModel.Email, lookupResult.ErrorValue);
                inviteErrorMessage = L["ErrorOccurred"].Value;
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
                return;
            }

            var targetUserId = lookupResult.ResultValue;

            // 2. Call InvitePatronAsync in TenantService
            var inviteResult = await TenantService.InvitePatronAsync(userContext, tenantId, targetUserId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
            if (inviteResult.IsError)
            {
                Logger.LogError("Error inviting patron: {Error}", inviteResult.ErrorValue);
                inviteErrorMessage = L["ErrorOccurred"].Value;
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            }
            else
            {
                inviteModel = new();
                await JSRuntime.InvokeVoidAsync("showToast", L["Patron invited successfully!"].Value, "success");
                
                // Refresh tenant details to show the newly invited patron
                var refreshResult = await DetailsService.GetTenantDetailsAsync(userContext, tenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                if (refreshResult.IsOk)
                {
                    libraryDetails = refreshResult.ResultValue;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while inviting patron");
            inviteErrorMessage = L["ErrorOccurred"].Value;
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isInviting = false;
            StateHasChanged();
        }
    }

