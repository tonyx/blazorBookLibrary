    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenantId = TenantId.NewTenantId(Id);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;

            if (claimsPrincipal == null || claimsPrincipal.Identity == null || !claimsPrincipal.Identity.IsAuthenticated)
            {
                isAuthorized = false;
                errorMessage = L["NotAuthenticated"] ?? "You must be authenticated to view this page.";
                isLoading = false;
                return;
            }

            var userContext = TenantState.GetUserContext(claimsPrincipal);

            var result = await DetailsService.GetTenantDetailsAsync(userContext, tenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);

            if (result.IsOk)
            {
                var details = result.ResultValue;
                
                var currentUserIdClaim = claimsPrincipal.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier) ?? claimsPrincipal.FindFirst("sub");
                var isAdmin = claimsPrincipal.IsInRole("Admin");

                if (currentUserIdClaim != null && Guid.TryParse(currentUserIdClaim.Value, out var guid))
                {
                    isOwner = guid.Equals(details.Tenant.OwnerId.Value);
                }

                if (isAdmin || isOwner)
                {
                    libraryDetails = details;
                    isAuthorized = true;

                    joinRequestsList.Clear();
                    if (libraryDetails != null && libraryDetails.Tenant.JoinRequests != null)
                    {
                        foreach (var requesterId in libraryDetails.Tenant.JoinRequests)
                        {
                            var userRes = await UserService.GetUserAsync(userContext, requesterId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                            if (userRes.IsOk)
                            {
                                joinRequestsList.Add(userRes.ResultValue);
                            }
                        }
                    }

                    if (isOwner && TenantState.CurrentTenant?.TenantId.Value != details.Tenant.TenantId.Value)
                    {
                        try
                        {
                            var switchResult = await UserService.SetCurrentTenantAsync(userContext, userContext.UserId.Value, details.Tenant.TenantId,
                                Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);

                            if (switchResult.IsOk)
                            {
                                await TenantState.SetTenantAsync(details.Tenant);
                            }
                            else
                            {
                                Logger.LogError("Error auto-switching current tenant to owned tenant: {Error}", switchResult.ErrorValue);
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, "Exception when auto-selecting owned tenant");
                        }
                    }
                }
                else
                {
                    isAuthorized = false;
                    errorMessage = L["AccessDeniedTenantDetails"] ?? "Access denied. You must be an Admin or the Tenant Owner to view these library details.";
                }
            }
            else
            {
                errorMessage = result.ErrorValue;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Tab))
        {
            if (Tab.Equals("approvals", StringComparison.OrdinalIgnoreCase) || 
                Tab.Equals("joinRequests", StringComparison.OrdinalIgnoreCase))
            {
                activeTab = "joinRequests";
            }
            else if (Tab.Equals("invitedPatrons", StringComparison.OrdinalIgnoreCase))
            {
                activeTab = "invitedPatrons";
            }
            else if (Tab.Equals("loans", StringComparison.OrdinalIgnoreCase))
            {
                activeTab = "loans";
            }
            else if (Tab.Equals("reservations", StringComparison.OrdinalIgnoreCase))
            {
                activeTab = "reservations";
            }
            else if (Tab.Equals("patrons", StringComparison.OrdinalIgnoreCase))
            {
                activeTab = "patrons";
            }
        }
    }
