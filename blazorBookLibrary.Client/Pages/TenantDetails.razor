    private bool IsFirstInQueue(ReservationDetails res)
    {
        if (libraryDetails == null || libraryDetails.PendingReservations == null) return false;
        
        var bookRes = libraryDetails.PendingReservations
            .Where(r => r.Book.Id == res.Book.Id && r.Reservation.IsPending)
            .OrderBy(r => r.Reservation.TimeSlot.Start)
            .FirstOrDefault();
            
        return bookRes != null && bookRes.Reservation.ReservationId.Value == res.Reservation.ReservationId.Value;
    }

    private void SelectReservation(ReservationDetails res)
    {
        selectedReservation = res;
        
        var preFill = Configuration.GetValue<bool>("BooksLibrary:PreFillReservationCode", false);
        if (preFill)
        {
            reservationCodeInput = res.Reservation.ReservationCode.Value;
        }
        else
        {
            reservationCodeInput = "";
        }
    }

    private async Task ProcessConversion()
    {
        if (selectedReservation == null) return;

        if (checkoutMethod == "code" && string.IsNullOrWhiteSpace(reservationCodeInput))
        {
            await JSRuntime.InvokeVoidAsync("showToast", L["ReservationCodeRequired"].Value, "warning");
            return;
        }

        if (checkoutMethod == "pin" && (string.IsNullOrWhiteSpace(pickupPinInput) || pickupPinInput.Length != 6))
        {
            await JSRuntime.InvokeVoidAsync("showToast", "6-digit Pickup PIN is required", "warning");
            return;
        }

        isProcessingReservation = true;
        try
        {
            var resId = selectedReservation.Reservation.ReservationId;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            
            Microsoft.FSharp.Core.FSharpResult<Microsoft.FSharp.Core.Unit, string> result;
            
            if (checkoutMethod == "code")
            {
                var resCode = ReservationCode.ReservationCode.NewReservationCode(reservationCodeInput);
                result = await LoanService.TransformReservationIntoLoanAsync(
                    context,
                    resId,
                    resCode,
                    DateTime.UtcNow,
                    Microsoft.FSharp.Core.FSharpOption<CancellationToken>.None);
            }
            else
            {
                result = await LoanService.TransformReservationIntoLoanByPinAsync(
                    context,
                    resId,
                    pickupPinInput,
                    DateTime.UtcNow,
                    Microsoft.FSharp.Core.FSharpOption<CancellationToken>.None);
            }

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["ReservationConvertedSuccess"].Value, "success");
                selectedReservation = null;
                reservationCodeInput = "";
                pickupPinInput = "";
                
                // Refresh tenant details to show updated lists
                var tenantId = TenantId.NewTenantId(Id);
                var refreshResult = await DetailsService.GetTenantDetailsAsync(context, tenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                if (refreshResult.IsOk)
                {
                    libraryDetails = refreshResult.ResultValue;
                }
            }
            else
            {
                Logger.LogError("Error converting reservation {ReservationId} into loan: {Error}", resId.Value, result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value + ": " + result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while converting reservation {ReservationId} with code {ReservationCode} into loan", selectedReservation.Reservation.ReservationId.Value, reservationCodeInput);
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isProcessingReservation = false;
            StateHasChanged();
        }
    }

