@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    private BookLibrary.Shared.Details.TenantDetails? libraryDetails;
    private bool isLoading = true;
    private bool isAuthorized = false;
    private string errorMessage = "";
    private string activeTab = "patrons";
    private bool isOwner = false;
    private bool isUpdatingPrivacy = false;
    private List<User> joinRequestsList = new();
    private bool isGeneratingPin = false;

    private InvitePatronModel inviteModel = new();
    private string checkoutMethod = "code";
    private string pickupPinInput = "";

    private async Task HandlePrivacyToggle(ChangeEventArgs e)
    {
        if (libraryDetails == null || isUpdatingPrivacy) return;

        var currentPublic = libraryDetails.Tenant.Public;
        var newPublic = (bool)(e.Value ?? false);

        if (newPublic == currentPublic) return;

        if (newPublic)
        {
            var warningMessage = L["SwitchToPublicWarning"].Value ?? "Making this library public means that anyone can browse the library, not only the patrons. Do you want to proceed?";
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", warningMessage);
            if (!confirmed)
            {
                // Revert visual state in browser DOM immediately to prevent discrepancy
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('privacyToggleSwitch').checked = false;");
                return;
            }
        }

        isUpdatingPrivacy = true;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal == null) return;
            var userContext = TenantState.GetUserContext(claimsPrincipal);
            var tenantId = TenantId.NewTenantId(Id);

            Microsoft.FSharp.Core.FSharpResult<Microsoft.FSharp.Core.Unit, string> result;
            if (newPublic)
            {
                result = await TenantService.SetPublicAsync(userContext, tenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
            }
            else
            {
                result = await TenantService.SetPrivateAsync(userContext, tenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
            }

            if (result.IsError)
            {
                Logger.LogError("Error updating tenant privacy: {Error}", result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue ?? L["ErrorOccurred"].Value, "error");
                // Revert checkbox
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('privacyToggleSwitch').checked = {(!newPublic).ToString().ToLower()};");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["PrivacyUpdatedSuccessfully"].Value ?? "Library visibility updated successfully.", "success");
                
                // Refresh aggregate details to update badges and stats dynamically
                var refreshResult = await DetailsService.GetTenantDetailsAsync(userContext, tenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                if (refreshResult.IsOk)
                {
                    libraryDetails = refreshResult.ResultValue;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while updating tenant privacy");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            // Revert checkbox
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('privacyToggleSwitch').checked = {(!newPublic).ToString().ToLower()};");
        }
