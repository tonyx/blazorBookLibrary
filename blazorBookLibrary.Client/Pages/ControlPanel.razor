@page "/control-panel"
@using Microsoft.AspNetCore.Authorization
@using BookLibrary.Shared.Services
@using blazorBookLibrary.Shared.Resources
@using Microsoft.Extensions.Localization
@using BookLibrary.Domain
@using static BookLibrary.Shared.Commons
@attribute [Authorize(Roles = "Admin")]
@inject IAdminServices ReconciliationService
@inject IDistributionPointService DistributionPointService
@inject IBookService BookService
@inject ITenantService TenantService
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResources> L
@inject ILogger<ControlPanel> Logger
@inject IJSRuntime JSRuntime
@using Microsoft.FSharp.Core
@rendermode InteractiveAuto

<PageTitle>@L["ControlPanel"]</PageTitle>

<div class="sanctuary-container py-5">
    <div class="mb-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["ControlPanel"]</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h1 class="display-4 text-serif mb-2">@L["AdminTools"]</h1>
                <p class="text-muted lead mb-0">@L["VectorReconciliation"]</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Purge Vectors -->
        <div class="col-md-6">
            <div class="sanctuary-card p-4 h-100 d-flex flex-column border shadow-sm transition-hover bg-surface-low">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-circle me-3">
                        <i class="bi bi-eraser-fill text-primary h4 mb-0"></i>
                    </div>
                    <h3 class="h5 text-serif mb-0">@L["PurgeVectors"]</h3>
                </div>
                <p class="text-muted small flex-grow-1">@L["PurgeVectorsDescription"]</p>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-sanctuary flex-grow-1 py-3" @onclick="PurgeVectors" disabled="@(isProcessing && !isPurging)">
                        @if (isPurging)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-lightning-charge me-2"></i>
                        }
                        @L["PurgeVectors"]
                    </button>
                    @if (isPurging)
                    {
                        <button class="btn btn-outline-danger px-4 animate-fade-in" @onclick="CancelOperation" title="@L["Cancel"]">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Adjust Book States -->
        <div class="col-md-6">
            <div class="sanctuary-card p-4 h-100 d-flex flex-column border shadow-sm transition-hover bg-surface-low">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-secondary bg-opacity-10 rounded-circle me-3">
                        <i class="bi bi-arrow-repeat text-secondary h4 mb-0"></i>
                    </div>
                    <h3 class="h5 text-serif mb-0">@L["AdjustBookStates"]</h3>
                </div>
                <p class="text-muted small flex-grow-1">@L["AdjustBookStatesDescription"]</p>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-outline-sanctuary flex-grow-1 py-3" @onclick="AdjustBookStates" disabled="@(isProcessing && !isAdjusting)">
                        @if (isAdjusting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-sync me-2"></i>
                        }
                        @L["AdjustBookStates"]
                    </button>
                    @if (isAdjusting)
                    {
                        <button class="btn btn-outline-danger px-4 animate-fade-in" @onclick="CancelOperation" title="@L["Cancel"]">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <!-- Clean Duplicated Vectors -->
        <div class="col-md-6">
            <div class="sanctuary-card p-4 h-100 d-flex flex-column border shadow-sm transition-hover bg-surface-low">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-info bg-opacity-10 rounded-circle me-3">
                        <i class="bi bi-stack text-info h4 mb-0"></i>
                    </div>
                    <h3 class="h5 text-serif mb-0">@L["CleanDuplicatedVectors"]</h3>
                </div>
                <p class="text-muted small flex-grow-1">@L["CleanDuplicatedVectorsDescription"]</p>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-outline-info flex-grow-1 py-3" @onclick="CleanDuplicatedVectors" disabled="@(isProcessing && !isCleaning)">
                        @if (isCleaning)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-magic me-2"></i>
                        }
                        @L["CleanDuplicatedVectors"]
                    </button>
                    @if (isCleaning)
                    {
                        <button class="btn btn-outline-danger px-4 animate-fade-in" @onclick="CancelOperation" title="@L["Cancel"]">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Distribution Point Maintenance -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="sanctuary-card p-4 border shadow-sm bg-surface-low">
                <div class="d-flex align-items-center mb-4">
                    <div class="p-3 bg-warning bg-opacity-10 rounded-circle me-3">
                        <i class="bi bi-building-gear text-warning h4 mb-0"></i>
                    </div>
                    <div>
                        <h3 class="h5 text-serif mb-0">@L["DistributionPointMaintenance"]</h3>
                        <p class="text-muted small mb-0">Perform batch operations on books assigned to specific distribution points</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">@L["SourceDistributionPoint"]</label>
                        <select class="form-select border-0 bg-light py-3" @bind="selectedDpId">
                            <option value="">@L["SelectDP"]</option>
                            @foreach (var dp in distributionPoints)
                            {
                                <option value="@dp.DistributionPointId.Value.ToString()">@dp.Name.Value</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">@L["TargetDistributionPoint"]</label>
                        <select class="form-select border-0 bg-light py-3" @bind="selectedTargetDpId">
                            <option value="">@L["SelectDP"]</option>
                            @foreach (var dp in distributionPoints)
                            {
                                <option value="@dp.DistributionPointId.Value.ToString()">@dp.Name.Value</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4 d-flex align-items-end gap-2">
                        <button class="btn btn-outline-danger py-3 px-3" 
                                @onclick="DetachAllBooks" 
                                title="@L["DetachAllBooks"]"
                                disabled="@(isProcessing || string.IsNullOrEmpty(selectedDpId))">
                            @if (isDetaching)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-link-45deg"></i>
                            }
                        </button>
                        
                        <button class="btn btn-sanctuary flex-grow-1 py-3" 
                                @onclick="SwitchAllBooks" 
                                disabled="@(isProcessing || string.IsNullOrEmpty(selectedDpId) || string.IsNullOrEmpty(selectedTargetDpId) || selectedDpId == selectedTargetDpId)">
                            @if (isSwitching)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-left-right me-2"></i>
                            }
                            @L["SwitchAllBooks"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tag Management -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="sanctuary-card p-4 border shadow-sm bg-surface-low">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-info bg-opacity-10 rounded-circle me-3">
                            <i class="bi bi-tags-fill text-info h4 mb-0"></i>
                        </div>
                        <div>
                            <h3 class="h5 text-serif mb-0">@L["TagManagement"]</h3>
                            <p class="text-muted small mb-0">Manage system-wide tags for books and authors</p>
                        </div>
                    </div>
                </div>

                <!-- Add New Tag Form -->
                <div class="row g-3 mb-5 p-4 bg-surface rounded-4 border-dashed shadow-sm">
                    <div class="col-12">
                        <h4 class="h6 text-uppercase fw-bold text-muted mb-3">Create New Tag</h4>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">@L["TagType"]</label>
                        <select class="form-select border-0 bg-light" @bind="newTagType">
                            <option value="Book">@L["BookTag"]</option>
                            <option value="Author">@L["AuthorTag"]</option>
                            <option value="General">@L["GeneralTag"]</option>
                            <option value="Person">@L["PersonTag"]</option>
                            <option value="Generic">@L["GenericTag"]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">@L["TagName"]</label>
                        <input type="text" class="form-control border-0 bg-light" placeholder="@L["EnterTagName"]" @bind="newTagName" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-sanctuary w-100 py-2" @onclick="AddTag" disabled="@(string.IsNullOrWhiteSpace(newTagName))">
                            <i class="bi bi-plus-lg me-2"></i>@L["AddTag"]
                        </button>
                    </div>
                </div>

                <!-- Grouped Tags with Lateral Scrolling -->
                <div class="tags-scroller-wrapper">
                    @if (!allTags.Any())
                    {
                        <div class="text-center py-5 bg-surface-low rounded-4 border border-dashed opacity-75">
                            <div class="mb-3">
                                <i class="bi bi-tags h1 text-muted"></i>
                            </div>
                            <h5 class="text-serif text-muted">No Tags Defined</h5>
                            <p class="text-muted small mb-0">Use the form above to initialize the repository with its first tags.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var type in new[] { "Book", "Author", "General", "Person", "Generic" })
                        {
                            var tagsOfType = allTags.Where(t => GetTagTypeName(t) == type).ToList();
                            if (tagsOfType.Any())
                            {
                                <div class="mb-4">
                                    <h6 class="text-uppercase small fw-bold text-muted mb-3 d-flex align-items-center">
                                        <span class="type-indicator @GetTagColorClass(type) me-2"></span>
                                        @type Tags
                                        <span class="badge bg-light text-muted ms-2 border">@tagsOfType.Count</span>
                                    </h6>
                                    <div class="tags-row-scroller pb-2">
                                        <div class="d-flex flex-nowrap gap-2">
                                            @foreach (var tag in tagsOfType)
                                            {
                                                <div class="tag-chip @GetTagColorClass(type) d-inline-flex align-items-center animate-fade-in">
                                                    <span class="me-2">@tag.TagName</span>
                                                    <button class="btn-close btn-close-white small" @onclick="() => RemoveTag(tag)" aria-label="Remove"></button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isPurging = false;
    private bool isAdjusting = false;
    private bool isCleaning = false;
    private bool isDetaching = false;
    private bool isSwitching = false;
    private bool isProcessing => isPurging || isAdjusting || isCleaning || isDetaching || isSwitching;
    private CancellationTokenSource? cts;

    private List<Tag> allTags = new();
    private string newTagName = "";
    private string newTagType = "Book";

    private List<DistributionPoint> distributionPoints = new();
    private string selectedDpId = "";
    private string selectedTargetDpId = "";
    private UserId? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTags(), LoadDistributionPoints(), LoadCurrentUser());
    }

    private async Task LoadDistributionPoints()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
        var result = await DistributionPointService.GetAllDistributionPointsAsync(userContext);
        if (result.IsOk)
        {
            distributionPoints = result.ResultValue.ToList();
        }
    }

    private async Task LoadCurrentUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");
        if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var guid))
        {
            currentUserId = UserId.NewUserId(guid);
        }
    }

    private async Task LoadTags()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userContext = TenantState.GetUserContext(authState.User);
        if (FSharpOption<TenantId>.get_IsSome(userContext.TenantId))
        {
            var tenantId = userContext.TenantId.Value;
            var result = await TenantService.GetTenantAsync(userContext, tenantId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                allTags = result.ResultValue.Tags.ToList();
            }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTag();
        }
    }

    private async Task AddTag()
    {
        if (string.IsNullOrWhiteSpace(newTagName)) return;

        Tag tag = newTagType switch
        {
            "Book" => Tag.NewBookTag(newTagName),
            "Author" => Tag.NewAuthorTag(newTagName),
            "General" => Tag.NewGeneralTag(newTagName),
            "Person" => Tag.NewPersonTag(newTagName),
            "Generic" => Tag.NewGenericTag(newTagName),
            _ => Tag.NewGenericTag(newTagName)
        };

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userContext = TenantState.GetUserContext(authState.User);
        if (FSharpOption<TenantId>.get_IsSome(userContext.TenantId))
        {
            var tenantId = userContext.TenantId.Value;
            var result = await TenantService.AddTagAsync(userContext, tenantId, tag, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                newTagName = "";
                await LoadTags();
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                Logger.LogError("Error adding tag: {Error}", result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            }
        }
    }

    private async Task RemoveTag(Tag tag)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userContext = TenantState.GetUserContext(authState.User);
        if (FSharpOption<TenantId>.get_IsSome(userContext.TenantId))
        {
            var tenantId = userContext.TenantId.Value;
            var result = await TenantService.RemoveTagAsync(userContext, tenantId, tag, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await LoadTags();
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                Logger.LogError("Error removing tag: {Error}", result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            }
        }
    }

    private string GetTagTypeName(Tag tag)
    {
        if (tag.IsBookTag) return "Book";
        if (tag.IsAuthorTag) return "Author";
        if (tag.IsGeneralTag) return "General";
        if (tag.IsPersonTag) return "Person";
        if (tag.IsGenericTag) return "Generic";
        return "Generic";
    }

    private string GetTagColorClass(string type)
    {
        return type switch
        {
            "Book" => "type-book",
            "Author" => "type-author",
            "General" => "type-general",
            "Person" => "type-person",
            "Generic" => "type-generic",
            _ => "type-generic"
        };
    }

    private void CancelOperation()
    {
        cts?.Cancel();
    }

    private async Task PurgeVectors()
    {
        isPurging = true;
        cts = new CancellationTokenSource();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await ReconciliationService.PurgeVectorsReferringDroppedBooksAsync(userContext, cts.Token);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                if (cts.IsCancellationRequested)
                {
                    await JSRuntime.InvokeVoidAsync("showToast", L["ImportCancelled"].Value, "warning");
                }
                else
                {
                    Logger.LogError("Error purging vectors: {Error}", result.ErrorValue);
                    await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
                }
            }
        }
        catch (OperationCanceledException)
        {
            await JSRuntime.InvokeVoidAsync("showToast", L["ImportCancelled"].Value, "warning");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while purging vectors");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isPurging = false;
            cts.Dispose();
            cts = null;
        }
    }

    private async Task AdjustBookStates()
    {
        isAdjusting = true;
        cts = new CancellationTokenSource();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await ReconciliationService.AdjustBookStatesReferringMissingEmbeddingsAsync(userContext, cts.Token);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                if (cts.IsCancellationRequested)
                {
                    await JSRuntime.InvokeVoidAsync("showToast", L["ImportCancelled"].Value, "warning");
                }
                else
                {
                    Logger.LogError("Error adjusting book states: {Error}", result.ErrorValue);
                    await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
                }
            }
        }
        catch (OperationCanceledException)
        {
            await JSRuntime.InvokeVoidAsync("showToast", L["ImportCancelled"].Value, "warning");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while adjusting book states");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isAdjusting = false;
            cts.Dispose();
            cts = null;
        }
    }

    private async Task CleanDuplicatedVectors()
    {
        isCleaning = true;
        cts = new CancellationTokenSource();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await ReconciliationService.PurgeDuplicatedVectorsAsync(userContext, cts.Token);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                if (cts.IsCancellationRequested)
                {
                    await JSRuntime.InvokeVoidAsync("showToast", L["ImportCancelled"].Value, "warning");
                }
                else
                {
                    Logger.LogError("Error cleaning duplicated vectors: {Error}", result.ErrorValue);
                    await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
                }
            }
        }
        catch (OperationCanceledException)
        {
            await JSRuntime.InvokeVoidAsync("showToast", L["ImportCancelled"].Value, "warning");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while cleaning duplicated vectors");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isCleaning = false;
            cts.Dispose();
            cts = null;
        }
    }

    private async Task DetachAllBooks()
    {
        if (string.IsNullOrEmpty(selectedDpId) || currentUserId == null) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", L["ConfirmDetachAllBooks"].Value);
        if (!confirmed) return;

        isDetaching = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var dpId = DistributionPointId.NewDistributionPointId(Guid.Parse(selectedDpId));
            var result = await BookService.UnsetAllBookRelatedToDPAsync(userContext, dpId, currentUserId);
            
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                Logger.LogError("Error detaching all books: {Error}", result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while detaching all books");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isDetaching = false;
        }
    }

    private async Task SwitchAllBooks()
    {
        if (string.IsNullOrEmpty(selectedDpId) || string.IsNullOrEmpty(selectedTargetDpId) || currentUserId == null) return;

        var sourceDp = distributionPoints.FirstOrDefault(d => d.DistributionPointId.Value.ToString() == selectedDpId);
        var targetDp = distributionPoints.FirstOrDefault(d => d.DistributionPointId.Value.ToString() == selectedTargetDpId);

        if (sourceDp == null || targetDp == null) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", string.Format(L["ConfirmSwitchAllBooks"].Value, sourceDp.Name.Value, targetDp.Name.Value));
        if (!confirmed) return;

        isSwitching = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var fromId = DistributionPointId.NewDistributionPointId(Guid.Parse(selectedDpId));
            var toId = DistributionPointId.NewDistributionPointId(Guid.Parse(selectedTargetDpId));
            
            // Note: Service expects (context, from, to, bookId, userId)
            // Passing BookId.NewBookId(Guid.Empty) as bookId is ignored by implementation for batch move
            var result = await BookService.MoveFromDpToAnotherDPAsync(userContext, fromId, toId,  currentUserId);
            
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["ActionSuccessful"].Value, "success");
            }
            else
            {
                Logger.LogError("Error switching all books: {Error}", result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while switching all books");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isSwitching = false;
        }
    }
}

<style>
    .border-dashed {
        border: 2px dashed var(--outline-variant) !important;
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }

    .tags-row-scroller {
        overflow-x: auto;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
    }

    .tag-chip {
        padding: 0.5rem 1rem;
