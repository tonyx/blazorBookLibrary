    private async Task GenerateEmbedding()
    {
        if (bookDetails == null || FSharpOption<string>.get_IsNone(bookDetails.Book.Description)) return;
        
        isGeneratingEmbedding = true;
        try
        {
            var text = bookDetails.Book.Description.Value;
            var context = await GetContext();
            var embeddingResult = await TextEmbeddingService.GetEmbeddingAsync(context, text); //, FSharpOption<System.Threading.CancellationToken>.None);
            
            if (!embeddingResult.IsOk)
            {
                await ShowStatus($"Embedding generation failed: {embeddingResult.ErrorValue}", "alert-danger");
                return;
            }

            var embeddingId = EmbeddingDataId.New();
            var storeResult = await VectorDbService.StoreEmbeddingAsync(embeddingId, _currentTenant, bookDetails.Book.BookId, embeddingResult.ResultValue, FSharpOption<System.Threading.CancellationToken>.None);
            
            if (!storeResult.IsOk)
            {
                await ShowStatus($"Vector storage failed: {storeResult.ErrorValue}", "alert-danger");
                return;
            }

            context = await GetContext();
            var embedResult = await BookService.EmbedDescriptionAsync(context, bookDetails.Book.BookId, embeddingId, FSharpOption<System.Threading.CancellationToken>.None);
            
            if (embedResult.IsOk)
            {
                await ShowStatus("AI embedding generated and associated successfully.", "alert-success");
                await WaitForCacheUpdateAsync(d => FSharpOption<EmbeddingDataId>.get_IsSome(d.Book.OptionalEmbedding));
            }
            else
            {
                await ShowStatus($"Failed to link embedding to book: {embedResult.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"An unexpected error occurred: {ex.Message}", "alert-danger");
        }
        finally
        {
            isGeneratingEmbedding = false;
        }
    }

    private async Task PerformSanityCheck()
    {
        if (string.IsNullOrWhiteSpace(sanityCheckQuery) || bookDetails == null) return;
        
        isPerformingSanityCheck = true;
        sanityCheckResults = null;
        try
        {
            var context = await GetContext();
            var embeddingResult = await TextEmbeddingService.GetEmbeddingAsync(context, sanityCheckQuery);
            if (!embeddingResult.IsOk)
            {
                await ShowStatus($"Query embedding failed: {embeddingResult.ErrorValue}", "alert-danger");
                return;
            }

            var searchResult = await VectorDbService.SearchSimilarEmbeddingsWithScoreAsync(embeddingResult.ResultValue, _currentTenant, sanityCheckLimit);
            if (!searchResult.IsOk)
            {
                await ShowStatus($"Semantic search failed: {searchResult.ErrorValue}", "alert-danger");
                return;
            }

            var results = new List<SanityCheckResult>();
            foreach (var item in searchResult.ResultValue)
            {
                var bookId = item.Item2;
                var score = item.Item3;
                // Fetch title for each book
                var details = await DetailsService.GetBookDetailsAsync(context, bookId, FSharpOption<CancellationToken>.None);
                if (details.IsOk)
                {
                    results.Add(new SanityCheckResult { Id = bookId, Title = details.ResultValue.Book.Title.Value, Score = score, Explanation = null, IsLoadingExplanation = false });
                }
                else
                {
                    results.Add(new SanityCheckResult { Id = bookId, Title = "Unknown Title", Score = score, Explanation = null, IsLoadingExplanation = false });
                }
            }
            sanityCheckResults = results;
        }
        catch (Exception ex)
        {
            await ShowStatus($"Sanity check error: {ex.Message}", "alert-danger");
        }
        finally
        {
            isPerformingSanityCheck = false;
        }
    }

    private async Task FetchExplanation(SanityCheckResult res)
    {
        if (res.Explanation != null || res.IsLoadingExplanation) return;
        
        res.IsLoadingExplanation = true;
        StateHasChanged();
        
        await explanationSemaphore.WaitAsync();
        try 
        {
            if (res.Explanation != null) return;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var details = await DetailsService.GetBookDetailsAsync(context, res.Id, FSharpOption<CancellationToken>.None);
            if (details.IsOk)
            {
                var book = details.ResultValue.Book;
                var desc = FSharpOption<string>.get_IsSome(book.Description) ? book.Description.Value : "";
                var bookText = $"{book.Title.Value}. {desc}";
                context = await GetContext();
                var explanationResult = await TextEmbeddingService.GetMatchExplanationAsync(context, sanityCheckQuery, bookText);
                if (explanationResult.IsOk)
                {
                    res.Explanation = explanationResult.ResultValue;
                }
                else 
                {
                    await ShowStatus($"{L["ExplanationFailed"]}: {explanationResult.ErrorValue}", "alert-warning");
                }
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"Explanation error: {ex.Message}", "alert-danger");
        }
        finally 
        {
            res.IsLoadingExplanation = false;
            explanationSemaphore.Release();
            StateHasChanged();
        }
    }

