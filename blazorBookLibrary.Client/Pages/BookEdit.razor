    private async Task ImportStagedPapers()
    {
        if (_bookDetails == null) return;
        var selectedPapers = _stagedPapers.Where(p => p.IsSelected).ToList();
        if (!selectedPapers.Any()) return;

        _isImportingStagedPapers = true;
        try
        {
            var context = await GetContext();
            var tryTenant = await UserTenantResolverService.GetTenantForUserAsync(context);
            var tenantId = tryTenant.IsOk ? tryTenant.ResultValue : _currentTenant;

            var authorNameToIdMap = new Dictionary<string, AuthorId>(StringComparer.OrdinalIgnoreCase);

            // 1. Confirm matched authors
            foreach (var paper in selectedPapers)
            {
                foreach (var author in paper.Authors)
                {
                    if (author.MatchedAuthor != null && author.ConfirmAssociate)
                    {
                        authorNameToIdMap[author.ScannedName] = author.MatchedAuthor.AuthorId;
                    }
                }
            }

            // 2. Add missing authors to catalog if opted in
            int newAuthorsCount = 0;
            foreach (var paper in selectedPapers)
            {
                foreach (var author in paper.Authors)
                {
                    if (author.MatchedAuthor == null && author.AutoAddNewAuthor && !authorNameToIdMap.ContainsKey(author.ScannedName))
                    {
                        var newAuthor = Author.NewWithoutIsni(tenantId, Name.New(author.ScannedName.Trim()));
                        var addRes = await AuthorService.AddAuthorAsync(context, newAuthor, FSharpOption<CancellationToken>.None);
                        if (addRes.IsOk)
                        {
                            authorNameToIdMap[author.ScannedName] = newAuthor.AuthorId;
                            _resolvedPaperAuthors[newAuthor.AuthorId.Value] = newAuthor;
                            newAuthorsCount++;
                        }
                        else
                        {
                            Logger.LogWarning("Failed to add author {Name}: {Error}", author.ScannedName, addRes.ErrorValue);
                        }
                    }
                }
            }

            // 3. Create Paper domain entities
            var papersToImport = new List<Paper>();
            foreach (var staged in selectedPapers)
            {
                var authorIds = new List<AuthorId>();
                foreach (var a in staged.Authors)
                {
                    if (authorNameToIdMap.TryGetValue(a.ScannedName, out var authorId))
                    {
                        authorIds.Add(authorId);
                    }
                }

                var descParts = new List<string>();
                if (!string.IsNullOrWhiteSpace(staged.Section))
                {
                    descParts.Add($"[{staged.Section.Trim()}]");
                }
                if (!string.IsNullOrWhiteSpace(staged.PageNumber))
                {
                    var pageStr = staged.PageNumber.Trim();
                    if (!pageStr.StartsWith("pag", StringComparison.OrdinalIgnoreCase) && !pageStr.StartsWith("p.", StringComparison.OrdinalIgnoreCase))
                    {
                        pageStr = $"pag. {pageStr}";
                    }
                    descParts.Add(pageStr);
                }
                if (!string.IsNullOrWhiteSpace(staged.Description))
                {
                    descParts.Add(staged.Description.Trim());
                }

                var finalDesc = descParts.Any() ? FSharpOption<string>.Some(string.Join(" — ", descParts)) : FSharpOption<string>.None;
                var authorsFsList = Microsoft.FSharp.Collections.ListModule.OfSeq(authorIds.Distinct());
                var categoriesFsList = Microsoft.FSharp.Collections.ListModule.OfSeq(staged.Categories);
                var tagsFsList = Microsoft.FSharp.Collections.ListModule.OfSeq(staged.Tags);

                var paper = Paper.New(
                    Title.New(staged.Title.Trim()),
                    finalDesc,
                    authorsFsList,
                    categoriesFsList,
                    tagsFsList
                );
                papersToImport.Add(paper);
            }

            // 4. Batch persist to book
            var fsPapersList = Microsoft.FSharp.Collections.ListModule.OfSeq(papersToImport);
            var result = await BookService.AddPapersAsync(context, _bookDetails.Book.BookId, fsPapersList, FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                var firstPaperId = papersToImport.First().PaperId.Value;
                await WaitForCacheUpdateAsync(d => d.Book.Papers.Any(p => p.PaperId.Value == firstPaperId));
                await EnsurePaperAuthorsResolved(_bookDetails.Book.Papers);

                _isScanningPapers = false;
                _stagedPapers.Clear();
                _isPapersDrillDownOpen = true;
                await ShowStatus(string.Format(L["PapersImportedSuccessfully"], papersToImport.Count, newAuthorsCount), "alert-success");
            }
            else
            {
                await ShowStatus(string.Format(L["ErrorAddingPaper"], result.ErrorValue), "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error importing scanned papers");
            await ShowStatus(string.Format(L["ErrorAddingPaper"], ex.Message), "alert-danger");
        }
        finally
        {
            _isImportingStagedPapers = false;
            StateHasChanged();
        }
    }

    public class StagedScannedAuthor
    {
        public string ScannedName { get; set; } = "";
        public Author? MatchedAuthor { get; set; }
        public List<Author> PossibleMatches { get; set; } = new();
        public bool AutoAddNewAuthor { get; set; } = true;
        public bool ConfirmAssociate { get; set; } = true;
    }

    public class StagedScannedPaper
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public bool IsSelected { get; set; } = true;
        public string Title { get; set; } = "";
        public string PageNumber { get; set; } = "";
        public string Section { get; set; } = "";
        public string Description { get; set; } = "";
        public List<StagedScannedAuthor> Authors { get; set; } = new();
        public List<Category> Categories { get; set; } = new();
        public List<Tag> Tags { get; set; } = new();
    }
}

