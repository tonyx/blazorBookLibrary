    private async Task UpdateSbn()
    {
        if (_bookDetails == null) return;

        if (string.IsNullOrWhiteSpace(editedSbn))
        {
            if (FSharpOption<SbnCode>.get_IsSome(_bookDetails.Book.SbnCode))
            {
                await UnsetSbn();
            }
            else
            {
                isEditingSbn = false;
            }
            return;
        }

        var trimmedSbn = editedSbn.Trim();
        SbnCode sbn;

        if (SbnCode.IsValid(trimmedSbn))
        {
            var validResult = SbnCode.NewValid(trimmedSbn);
            if (validResult.IsOk)
            {
                sbn = validResult.ResultValue;
            }
            else if (acceptInvalidSbn)
            {
                sbn = SbnCode.NewInvalid(trimmedSbn);
            }
            else
            {
                await ShowStatus(L["InvalidSbnCodeFormat"], "alert-warning");
                return;
            }
        }
        else if (acceptInvalidSbn)
        {
            sbn = SbnCode.NewInvalid(trimmedSbn);
        }
        else
        {
            await ShowStatus(L["InvalidSbnCodeFormat"], "alert-warning");
            return;
        }

        isUpdatingSbn = true;
        try
        {
            var context = await GetContext();
            var result = await BookService.UpdateSbnCodeAsync(context, sbn, _bookDetails.Book.BookId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await WaitForCacheUpdateAsync(d => FSharpOption<SbnCode>.get_IsSome(d.Book.SbnCode) && d.Book.SbnCode.Value.Value == sbn.Value);
                isEditingSbn = false;
                await ShowStatus(L["SbnCodeUpdated"], "alert-success");
            }
            else
            {
                await ShowStatus(string.Format(L["ErrorUpdatingSbn"], result.ErrorValue), "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorUpdatingSbn"], ex.Message), "alert-danger");
        }
        finally
        {
            isUpdatingSbn = false;
        }
    }

