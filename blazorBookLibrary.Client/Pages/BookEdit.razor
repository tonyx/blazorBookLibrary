    private async Task WaitForCacheUpdateAsync(Func<Details.BookDetails, bool> condition)
    {
        if (_bookDetails == null) return;

        int retries = 20;
        while (retries > 0)
        {
            await Task.Delay(100);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var freshDetailsResult = await DetailsService.GetBookDetailsAsync(context, _bookDetails.Book.BookId, FSharpOption<CancellationToken>.None);
            if (freshDetailsResult.IsOk)
            {
                var freshDetails = freshDetailsResult.ResultValue;
                if (condition(freshDetails))
                {
                    _bookDetails = freshDetails;
                    foreach (var author in _bookDetails.Authors)
                    {
                        _resolvedPaperAuthors[author.AuthorId.Value] = author;
                    }
                    if (_bookDetails.Book.Papers.Any())
                    {
                        await EnsurePaperAuthorsResolved(_bookDetails.Book.Papers);
                    }
                    StateHasChanged();
                    return;
                }
            }
            retries--;
        }

        // Fallback if polling times out
        await LoadBookDetails();
    }

    protected override async Task OnInitializedAsync()
    {
        _isPageLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal != null && claimsPrincipal.Identity?.IsAuthenticated == true)
            {
                var hasAccess = await TenantState.CheckManagementAccessAsync(claimsPrincipal, TenantService, UserTenantResolverService);

                if (hasAccess)
                {
                    _isAuthorized = true;

                    enableAIExplanations = Configuration.GetValue<bool>("BooksLibrary:EnableAIExtendedExplanations");
                    await LoadBookDetails();
                    
                    var user = authState.User;
                    if (user.Identity?.IsAuthenticated ?? false)
                    {
                        var userIdClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");
                        if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var guid))
                        {
                            currentUserId = UserId.NewUserId(guid);
                            var context = await GetContext();
                            
                            var userResult = await UserService.GetUserAsync(context, currentUserId);
                            if (userResult.IsOk)
                            {
                                _currentTenant = userResult.ResultValue.CurrentTenant;
                                _cachedContext = context.WithNewTenant(_currentTenant);
                                context = _cachedContext;
                            }

                            var dpResult = await UserService.GetDistributionPointsManagedByUserAsync(context, currentUserId, FSharpOption<CancellationToken>.None);
                            if (dpResult.IsOk)
                            {
                                managedDistributionPoints = dpResult.ResultValue.ToList();
                            }
                        }
                    }

                    var contextForTags = await GetContext();
                    var tenantResultForTags = await TenantService.GetTenantAsync(contextForTags, _currentTenant, FSharpOption<CancellationToken>.None);
                    if (tenantResultForTags.IsOk)
                    {
                        allAvailableTags = tenantResultForTags.ResultValue.Tags.Where(t => t.IsBookTag).ToList();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during page authorization check");
        }
        finally
        {
            _isPageLoading = false;
        }
    }

    private async Task LoadBookDetails()
    {
        _isLoading = true;
        _statusMessage = "";

        try
        {
            if (Guid.TryParse(BookIdStr, out var guid))
            {
                var bookId = BookId.NewBookId(guid);
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
                var result = await DetailsService.GetBookDetailsAsync(context, bookId, FSharpOption<CancellationToken>.None);

                if (result.IsOk)
                {
                    _bookDetails = result.ResultValue;
                    foreach (var author in _bookDetails.Authors)
                    {
                        _resolvedPaperAuthors[author.AuthorId.Value] = author;
                    }
                    if (_bookDetails.Book.Papers.Any())
                    {
                        await EnsurePaperAuthorsResolved(_bookDetails.Book.Papers);
                    }
                    if (_bookDetails.PendingReservationsDetails.Any())
                    {
                        var firstRes = _bookDetails.PendingReservationsDetails.First();
                        var preFill = Configuration.GetValue<bool>("BooksLibrary:PreFillReservationCode");
                        if (preFill)
                        {
                            _reservationCodeInput = firstRes.Reservation.ReservationCode.Value;
                        }
                    }
                }
                else
                {
                    await ShowStatus(string.Format(L["ErrorLoadingBook"], result.ErrorValue), "alert-danger");
                }
            }
            else
            {
                await ShowStatus(L["InvalidBookIdInUrl"], "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorLoadingData"], ex.Message), "alert-danger");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ConvertToLoan(Details.ReservationDetails resDetails)
    {
        if (string.IsNullOrWhiteSpace(_reservationCodeInput))
        {
            await ShowStatus("Please enter a reservation code.", "alert-warning");
            return;
        }

        try
        {
            @* var resCode = ReservationCode.ReservationCode(reservationCodeInput); *@
            var resCode = ReservationCode.ReservationCode.NewReservationCode(_reservationCodeInput);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await LoanService.TransformReservationIntoLoanAsync(
                context,
                resDetails.Reservation.ReservationId, 
                resCode, 
                DateTime.UtcNow, 
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                await ShowStatus("Reservation successfully converted to loan.", "alert-success");
                await WaitForCacheUpdateAsync(d => !d.PendingReservationsDetails.Any(r => r.Reservation.ReservationId.Value == resDetails.Reservation.ReservationId.Value));
                _reservationCodeInput = "";
            }
            else
            {
                await ShowStatus($"Error: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"An error occurred: {ex.Message}", "alert-danger");
        }
    }

    private async Task ShowStatus(string message, string cssClass)
    {
        _statusMessage = message;
        _statusClass = cssClass;
        StateHasChanged();

        try
        {
            string type = "info";
            if (cssClass.Contains("success")) type = "success";
            else if (cssClass.Contains("danger") || cssClass.Contains("error")) type = "error";
            else if (cssClass.Contains("warning")) type = "warning";

            await JSRuntime.InvokeVoidAsync("showToast", message, type);
        }
        catch
        {
            // JS interop might not be available during prerendering
        }
    }

    private async Task RemoveEmbedding()
    {
        if (_bookDetails == null || FSharpOption<EmbeddingDataId>.get_IsNone(_bookDetails.Book.OptionalEmbedding)) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", L["ConfirmRemoveEmbedding"]);
        if (!confirm) return;

        _isRemovingEmbedding = true;
        var embeddingId = _bookDetails.Book.OptionalEmbedding.Value;

        try
        {
            var context = await GetContext();
            // 1. Remove from Book object via BookService
            var bookResult = await BookService.RemoveEmbeddingAsync(context, _bookDetails.Book.BookId);
            if (!bookResult.IsOk)
            {
                await ShowStatus(string.Format(L["ErrorRemovingEmbedding"], bookResult.ErrorValue), "alert-danger");
                return;
            }

            // 2. Remove from Vector DB
            var vectorResult = await VectorDbService.RemoveEmbeddingAsync(embeddingId);
            if (!vectorResult.IsOk)
            {
                // Inform user and restore the reference in the Book object for consistency
                await ShowStatus(L["VectorDbRemovalFailed"], "alert-warning");
                context = await GetContext();
                var restoreResult = await BookService.EmbedDescriptionAsync(context, _bookDetails.Book.BookId, embeddingId);
                if (!restoreResult.IsOk)
                {
                    await ShowStatus(string.Format(L["ErrorRestoringEmbedding"], restoreResult.ErrorValue), "alert-danger");
                }
            }
            else
            {
                await ShowStatus(L["EmbeddingRemoved"], "alert-success");
            }

            await WaitForCacheUpdateAsync(d => FSharpOption<EmbeddingDataId>.get_IsNone(d.Book.OptionalEmbedding));
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorRemovingEmbedding"], ex.Message), "alert-danger");
        }
        finally
        {
            _isRemovingEmbedding = false;
        }
    }

    private async Task GenerateAIDescription()
    {
        if (_bookDetails == null) return;
        
        _isGeneratingDescription = true;
        StateHasChanged();
        try
        {
            var title = _bookDetails.Book.Title.Value;
            var authors = _bookDetails.Authors.Select(a => a.Name.Value).ToList();
            var isbn = _bookDetails.Book.Isbn.Value;
            
            var authorsFSharp = Microsoft.FSharp.Collections.ListModule.OfSeq(authors);
            var partialData = PartialBookDataMatch.NewAll(isbn, title, authorsFSharp);
            
            var context = await GetContext();
            var result = await TextEmbeddingService.GetBookDescriptionAsync(context, partialData, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                // Capture current state for undo
                _previousDescription = _isEditingDescription ? _editedDescription : (FSharpOption<string>.get_IsSome(_bookDetails.Book.Description) ? _bookDetails.Book.Description.Value : "");
                
                _isEditingDescription = true;
                _editedDescription = result.ResultValue;
                await ShowStatus(L["DescriptionGenerated"], "alert-success");
            }
            else
            {
                await ShowStatus($"{L["ErrorGeneratingDescription"]}: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"{L["ErrorGeneratingDescription"]}: {ex.Message}", "alert-danger");
        }
        finally
        {
            _isGeneratingDescription = false;
            StateHasChanged();
        }
    }

    private void UndoDescriptionChange()
    {
        if (_previousDescription != null)
        {
            _editedDescription = _previousDescription;
            _previousDescription = null;
            _isEditingDescription = true;
        }
    }

