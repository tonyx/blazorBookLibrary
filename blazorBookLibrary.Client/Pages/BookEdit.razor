    private void AddAuthorToPaper(Author author)
    {
        if (!_newPaperSelectedAuthors.Any(a => a.AuthorId.Value == author.AuthorId.Value))
        {
            _newPaperSelectedAuthors.Add(author);
            _resolvedPaperAuthors[author.AuthorId.Value] = author;
        }
        _paperAuthorSearchInput = "";
        _paperAuthorSearchResults.Clear();
        _showPaperAuthorSearchResults = false;
