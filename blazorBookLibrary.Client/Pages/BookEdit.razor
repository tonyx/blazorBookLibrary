    private async Task SavePaper()
    {
        if (_bookDetails == null || string.IsNullOrWhiteSpace(_newPaperTitle)) return;
        _isSavingPaper = true;
        try
        {
            var context = await GetContext();
            var paperTitle = Title.New(_newPaperTitle.Trim());
            var descOpt = string.IsNullOrWhiteSpace(_newPaperDescription)
                ? FSharpOption<string>.None
                : FSharpOption<string>.Some(_newPaperDescription.Trim());
            var authorsList = Microsoft.FSharp.Collections.ListModule.OfSeq(
                _newPaperSelectedAuthors.Select(a => a.AuthorId)
            );
            var categoriesList = Microsoft.FSharp.Collections.ListModule.OfSeq(_newPaperSelectedCategories);
            var tagsList = Microsoft.FSharp.Collections.ListModule.OfSeq(_newPaperSelectedTags);

            var paper = Paper.New(paperTitle, descOpt, authorsList, categoriesList, tagsList);
            var result = await BookService.AddPaperAsync(context, _bookDetails.Book.BookId, paper, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await WaitForCacheUpdateAsync(d => d.Book.Papers.Any(p => p.PaperId.Value == paper.PaperId.Value));
                _isAddingPaper = false;
                await ShowStatus(string.Format(L["PaperAddedSuccessfully"], paperTitle.Value), "alert-success");
            }
            else
            {
                await ShowStatus(string.Format(L["ErrorAddingPaper"], result.ErrorValue), "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorAddingPaper"], ex.Message), "alert-danger");
        }
        finally
        {
            _isSavingPaper = false;
        }
    }

    private async Task RemovePaper(Paper paper)
    {
        if (_bookDetails == null) return;
        if (isBookSealed)
        {
            await ShowStatus(L["BookSealedCannotEdit"], "alert-warning");
            return;
        }

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", string.Format(L["ConfirmRemovePaper"], paper.Title.Value));
        if (!confirmed) return;

        try
        {
            var context = await GetContext();
            var result = await BookService.RemovePaperAsync(context, _bookDetails.Book.BookId, paper.PaperId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await WaitForCacheUpdateAsync(d => !d.Book.Papers.Any(p => p.PaperId.Value == paper.PaperId.Value));
                await ShowStatus(L["PaperRemovedSuccessfully"].Value, "alert-success");
            }
            else
            {
                await ShowStatus(string.Format(L["ErrorRemovingPaper"], result.ErrorValue), "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorRemovingPaper"], ex.Message), "alert-danger");
        }
    }

    private async Task EnsurePaperAuthorsResolved(IEnumerable<Paper> papers)
    {
        try
        {
            var context = await GetContext();
            var missingAuthorIds = papers
                .SelectMany(p => p.Authors)
                .Where(a => !_resolvedPaperAuthors.ContainsKey(a.Value))
                .Distinct()
                .ToList();

            if (missingAuthorIds.Any())
            {
                var fsList = Microsoft.FSharp.Collections.ListModule.OfSeq(missingAuthorIds);
                var authorsRes = await AuthorService.GetAuthorsAsync(context, fsList, FSharpOption<CancellationToken>.None);
                if (authorsRes.IsOk)
                {
                    foreach (var author in authorsRes.ResultValue)
                    {
                        _resolvedPaperAuthors[author.AuthorId.Value] = author;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resolving paper authors");
        }
    }

    private string GetPaperAuthorName(AuthorId authorId)
    {
        if (_resolvedPaperAuthors.TryGetValue(authorId.Value, out var author))
        {
            return author.Name.Value;
        }
        return authorId.Value.ToString();
    }

    private async Task StartEdit()
    {
        if (_bookDetails?.Book.Editable ?? false)
        {
            isEditingTitle = true;
            editedTitle = _bookDetails!.Book.Title.Value;
        }
        else if (isBookSealed)
        {
            await ShowStatus(L["BookSealedCannotEdit"], "alert-warning");
        }
    }

    private async Task ToggleSeal()
    {
        if (_bookDetails == null) return;
        
        if (isBookSealed)
        {
            var hasLoans = FSharpOption<BookLibrary.Shared.Details.LoanDetails>.get_IsSome(_bookDetails.CurrentLoan);
            var hasReservations = _bookDetails.ReservationsDetails.Any();
            
            if (hasLoans || hasReservations)
            {
                await ShowStatus(L["CannotUnsealWithLoansOrReservations"], "alert-warning");
                return;
            }
        }

        var context = await GetContext();
        var result = isBookSealed 
            ? await BookService.UnsealAsync(context, _bookDetails.Book.BookId, FSharpOption<CancellationToken>.None)
            : await BookService.SealAsync(context, _bookDetails.Book.BookId, FSharpOption<CancellationToken>.None);
            
        if (result.IsOk)
        {
            var expectedSeal = !isBookSealed;
            await WaitForCacheUpdateAsync(d => d.Book.Sealed.IsSealed(DateTime.UtcNow) == expectedSeal);
