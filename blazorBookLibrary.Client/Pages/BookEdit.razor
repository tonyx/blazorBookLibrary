    private async Task WaitForCacheUpdateAsync(Func<Details.BookDetails, bool> condition)
    {
        if (bookDetails == null) return;

        int retries = 20;
        while (retries > 0)
        {
            await Task.Delay(100);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var freshDetailsResult = await DetailsService.GetBookDetailsAsync(context, bookDetails.Book.BookId, FSharpOption<CancellationToken>.None);
            if (freshDetailsResult.IsOk)
            {
                var freshDetails = freshDetailsResult.ResultValue;
                if (condition(freshDetails))
                {
                    bookDetails = freshDetails;
                    StateHasChanged();
                    return;
                }
            }
            retries--;
        }

        // Fallback if polling times out
        await LoadBookDetails();
    }

    protected override async Task OnInitializedAsync()
    {
        isPageLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal != null && claimsPrincipal.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(claimsPrincipal);
                var isAdmin = claimsPrincipal.IsInRole("Admin");
                bool isOwner = false;

                var tenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext);
                if (tenantResult.IsOk)
                {
                    var tenantId = tenantResult.ResultValue;
                    var tenantInfoResult = await TenantService.GetTenantAsync(userContext, tenantId);
                    if (tenantInfoResult.IsOk)
                    {
                        var tenant = tenantInfoResult.ResultValue;
                        isOwner = userContext.UserId.Value.Value.Equals(tenant.OwnerId.Value);
                    }
                }

                if (isAdmin || isOwner)
                {
                    isAuthorized = true;

                    enableAIExplanations = Configuration.GetValue<bool>("BooksLibrary:EnableAIExtendedExplanations");
                    await LoadBookDetails();
                    
                    var context = await GetContext();
                    var tagsResult = await TagService.GetBookTypeTagsAsync(context, FSharpOption<CancellationToken>.None);
                    if (tagsResult.IsOk)
                    {
                        allAvailableTags = tagsResult.ResultValue.ToList();
                    }

                    var user = authState.User;
                    if (user.Identity?.IsAuthenticated ?? false)
                    {
                        var userIdClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");
                        if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var guid))
                        {
                            currentUserId = UserId.NewUserId(guid);
                            context = await GetContext();
                            
                            var userResult = await UserService.GetUserAsync(context, currentUserId);
                            if (userResult.IsOk)
                            {
                                _currentTenant = userResult.ResultValue.CurrentTenant;
                                _cachedContext = context.WithNewTenant(_currentTenant);
                                context = _cachedContext;
                            }

                            var dpResult = await UserService.GetDistributionPointsManagedByUserAsync(context, currentUserId, FSharpOption<CancellationToken>.None);
                            if (dpResult.IsOk)
                            {
                                managedDistributionPoints = dpResult.ResultValue.ToList();
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during page authorization check");
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task LoadBookDetails()
    {
        isLoading = true;
        statusMessage = "";

        try
        {
            if (Guid.TryParse(BookIdStr, out var guid))
            {
                var bookId = BookId.NewBookId(guid);
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
                var result = await DetailsService.GetBookDetailsAsync(context, bookId, FSharpOption<CancellationToken>.None);

                if (result.IsOk)
                {
                    bookDetails = result.ResultValue;
                    if (bookDetails.PendingReservationsDetails.Any())
                    {
                        var firstRes = bookDetails.PendingReservationsDetails.First();
                        var preFill = Configuration.GetValue<bool>("BooksLibrary:PreFillReservationCode");
                        if (preFill)
                        {
                            reservationCodeInput = firstRes.Reservation.ReservationCode.Value;
                        }
                    }
                }
                else
                {
                    await ShowStatus(string.Format(L["ErrorLoadingBook"], result.ErrorValue), "alert-danger");
                }
            }
            else
            {
                await ShowStatus(L["InvalidBookIdInUrl"], "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorLoadingData"], ex.Message), "alert-danger");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConvertToLoan(Details.ReservationDetails resDetails)
    {
        if (string.IsNullOrWhiteSpace(reservationCodeInput))
        {
            await ShowStatus("Please enter a reservation code.", "alert-warning");
            return;
        }

        try
        {
            @* var resCode = ReservationCode.ReservationCode(reservationCodeInput); *@
            var resCode = ReservationCode.ReservationCode.NewReservationCode(reservationCodeInput);
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await LoanService.TransformReservationIntoLoanAsync(
                context,
                resDetails.Reservation.ReservationId, 
                resCode, 
                DateTime.UtcNow, 
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                await ShowStatus("Reservation successfully converted to loan.", "alert-success");
                await WaitForCacheUpdateAsync(d => !d.PendingReservationsDetails.Any(r => r.Reservation.ReservationId.Value == resDetails.Reservation.ReservationId.Value));
                reservationCodeInput = "";
            }
            else
            {
                await ShowStatus($"Error: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"An error occurred: {ex.Message}", "alert-danger");
        }
    }

    private async Task ShowStatus(string message, string cssClass)
    {
        statusMessage = message;
        statusClass = cssClass;
        StateHasChanged();

        try
        {
            string type = "info";
            if (cssClass.Contains("success")) type = "success";
            else if (cssClass.Contains("danger") || cssClass.Contains("error")) type = "error";
            else if (cssClass.Contains("warning")) type = "warning";

            await JSRuntime.InvokeVoidAsync("showToast", message, type);
        }
        catch
        {
            // JS interop might not be available during prerendering
        }
    }

    private async Task RemoveEmbedding()
    {
        if (bookDetails == null || FSharpOption<EmbeddingDataId>.get_IsNone(bookDetails.Book.OptionalEmbedding)) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", L["ConfirmRemoveEmbedding"]);
        if (!confirm) return;

        isRemovingEmbedding = true;
        var embeddingId = bookDetails.Book.OptionalEmbedding.Value;

        try
        {
            var context = await GetContext();
            // 1. Remove from Book object via BookService
            var bookResult = await BookService.RemoveEmbeddingAsync(context, bookDetails.Book.BookId);
            if (!bookResult.IsOk)
            {
                await ShowStatus(string.Format(L["ErrorRemovingEmbedding"], bookResult.ErrorValue), "alert-danger");
                return;
            }

            // 2. Remove from Vector DB
            var vectorResult = await VectorDbService.RemoveEmbeddingAsync(embeddingId);
            if (!vectorResult.IsOk)
            {
                // Inform user and restore the reference in the Book object for consistency
                await ShowStatus(L["VectorDbRemovalFailed"], "alert-warning");
                context = await GetContext();
                var restoreResult = await BookService.EmbedDescriptionAsync(context, bookDetails.Book.BookId, embeddingId);
                if (!restoreResult.IsOk)
                {
                    await ShowStatus(string.Format(L["ErrorRestoringEmbedding"], restoreResult.ErrorValue), "alert-danger");
                }
            }
            else
            {
                await ShowStatus(L["EmbeddingRemoved"], "alert-success");
            }

            await WaitForCacheUpdateAsync(d => FSharpOption<EmbeddingDataId>.get_IsNone(d.Book.OptionalEmbedding));
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorRemovingEmbedding"], ex.Message), "alert-danger");
        }
        finally
        {
            isRemovingEmbedding = false;
        }
    }

    private async Task GenerateAIDescription()
    {
        if (bookDetails == null) return;
        
        isGeneratingDescription = true;
        StateHasChanged();
        try
        {
            var title = bookDetails.Book.Title.Value;
            var authors = bookDetails.Authors.Select(a => a.Name.Value).ToList();
            var isbn = bookDetails.Book.Isbn.Value;
            
            var authorsFSharp = Microsoft.FSharp.Collections.ListModule.OfSeq(authors);
            var partialData = PartialBookDataMatch.NewAll(isbn, title, authorsFSharp);
            
            var context = await GetContext();
            var result = await TextEmbeddingService.GetBookDescriptionAsync(context, partialData, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                // Capture current state for undo
                previousDescription = isEditingDescription ? editedDescription : (FSharpOption<string>.get_IsSome(bookDetails.Book.Description) ? bookDetails.Book.Description.Value : "");
                
                isEditingDescription = true;
                editedDescription = result.ResultValue;
                await ShowStatus(L["DescriptionGenerated"], "alert-success");
            }
            else
            {
                await ShowStatus($"{L["ErrorGeneratingDescription"]}: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"{L["ErrorGeneratingDescription"]}: {ex.Message}", "alert-danger");
        }
        finally
        {
            isGeneratingDescription = false;
            StateHasChanged();
        }
    }

    private void UndoDescriptionChange()
    {
        if (previousDescription != null)
        {
            editedDescription = previousDescription;
            previousDescription = null;
            isEditingDescription = true;
        }
    }

    private async Task SetDistributionPoint()
    {
        if (string.IsNullOrEmpty(selectedDistributionPointIdToSet) || bookDetails == null || currentUserId == null) return;
        
        isUpdatingDP = true;
        try
        {
            var context = await GetContext();
            var dpId = DistributionPointId.NewDistributionPointId(new Guid(selectedDistributionPointIdToSet));
            var result = await BookService.SetDistributionPointAsync(context, dpId, bookDetails.Book.BookId, currentUserId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await ShowStatus(L["DistributionPointSetSuccess"], "alert-success");
                await WaitForCacheUpdateAsync(d => d.DistributionPoint != null && FSharpOption<DistributionPoint>.get_IsSome(d.DistributionPoint) && d.DistributionPoint.Value.DistributionPointId.Equals(dpId));
                selectedDistributionPointIdToSet = "";
            }
            else
            {
                await ShowStatus($"{L["ErrorSettingDistributionPoint"]}: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"{L["ErrorSettingDistributionPoint"]}: {ex.Message}", "alert-danger");
        }
        finally
        {
            isUpdatingDP = false;
        }
    }

    private async Task UnsetDistributionPoint()
    {
        if (bookDetails == null || FSharpOption<DistributionPoint>.get_IsNone(bookDetails.DistributionPoint) || currentUserId == null) return;
        
        var dp = bookDetails.DistributionPoint.Value;
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", string.Format(L["ConfirmUnsetDP"], dp.Name.Value));
        if (!confirm) return;

        isUpdatingDP = true;
        try
        {
            var context = await GetContext();
            var result = await BookService.UnSetDistributionPointAsync(context, dp.DistributionPointId, bookDetails.Book.BookId, currentUserId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await ShowStatus(L["DistributionPointUnsetSuccess"], "alert-success");
                await WaitForCacheUpdateAsync(d => FSharpOption<DistributionPoint>.get_IsNone(d.DistributionPoint));
            }
            else
            {
                await ShowStatus($"{L["ErrorUnsettingDistributionPoint"]}: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus($"{L["ErrorUnsettingDistributionPoint"]}: {ex.Message}", "alert-danger");
        }
        finally
        {
            isUpdatingDP = false;
        }
    }
}
