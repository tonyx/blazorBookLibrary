@page "/book-edit/{BookIdStr}"
@using Microsoft.AspNetCore.Authorization
@using BookLibrary.Shared.Services
@using BookLibrary.Domain
@using BookLibrary.Shared
@using blazorBookLibrary.Shared.Resources
@using static BookLibrary.Shared.Commons
@using Microsoft.FSharp.Core
@using System.Linq
@using System.Globalization
@using BlazorBarcodeScanner.ZXing.JS

@attribute [Authorize]
@inject IUserTenantResolverService UserTenantResolverService
@inject ITenantService TenantService
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject IBookService BookService
@inject IDetailsService DetailsService
@inject IAuthorService AuthorService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IBooksMetadataSearchService GoogleBooksService
@inject IEmbeddingOrchestrationService EmbeddingOrchestrationService
@inject ITextEmbeddingService TextEmbeddingService
@inject IVectorDbService VectorDbService
@inject IStringLocalizer<SharedResources> L
@inject ILoanService LoanService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ILogger<BookEdit> Logger
@rendermode InteractiveAuto

<PageTitle>@L["BookDetails"]</PageTitle>

<style>
    .editable-title {
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: all 0.2s ease;
        display: inline-block;
        border: 1px solid transparent;
    }
    .editable-title:hover {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        color: #0d6efd;
    }
    .editable-category:hover {
        opacity: 0.8;
        transform: scale(1.05);
    }
    .image-edit-badge {
        bottom: 15px;
        right: 15px;
        background: var(--primary);
        color: white;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        z-index: 10;
        border: 4px solid var(--surface-container-lowest);
    }
    .image-edit-badge:hover {
        transform: scale(1.1);
        background: var(--secondary);
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }
    .image-edit-badge i {
        font-size: 1.2rem;
    }
    .book-cover-wrap:hover .image-edit-badge {
        animation: pulse-sanctuary 2s infinite;
    }
    @@keyframes pulse-sanctuary {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    .tag-chip {
        padding: 0.4rem 1rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        font-weight: 500;
        white-space: nowrap;
        transition: all 0.2s ease;
    }
    .tag-chip .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
        padding: 0.25rem;
        font-size: 0.5rem;
    }
    .type-book { background-color: #3b82f6; color: white; }
    .type-author { background-color: #10b981; color: white; }
    .type-general { background-color: #f59e0b; color: white; }
    .type-person { background-color: #06b6d4; color: white; }
    .type-generic { background-color: #6b7280; color: white; }
</style>

@if (_isPageLoading)
{
    <div class="sanctuary-container py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]...</span>
        </div>
        <p class="mt-2 text-muted">@L["RetrievingArchivalRecords"]...</p>
    </div>
}
else if (!_isAuthorized)
{
    <div class="sanctuary-container py-5">
        <div class="card-sanctuary p-5 text-center shadow-lg border-0 rounded-4" style="max-width: 600px; margin: 0 auto; background: #fff; border: 1px solid rgba(0,0,0,0.05); border-radius: 1.25rem;">
            <div class="text-danger mb-4">
                <i class="bi bi-shield-lock-fill display-1" style="font-size: 5rem; color: #dc3545;"></i>
            </div>
            <h1 class="display-5 text-serif mb-3 text-dark">@L["AccessDenied"]</h1>
            <p class="text-muted lead mb-4">
                Access Denied. You must be the Owner of the current library (tenant) or a global Administrator to edit book records.
            </p>
            <a href="/" class="btn btn-primary rounded-pill px-5 py-3 shadow-sm shadow-hover">
                <i class="bi bi-house-door me-2"></i> @L["Home"]
            </a>
        </div>
    </div>
}
else
{
<div class="sanctuary-container">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-end mb-5 border-bottom pb-4" style="border-color: var(--outline-variant) !important;">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--secondary);">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-reset">@L["Home"]</a></li>
                    <li class="breadcrumb-item"><a href="/books-manager" class="text-decoration-none text-reset">@L["Catalog"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@L["BookDetails"]</li>
                </ol>
            </nav>
            <h1 class="serif display-5 mb-0" style="font-weight: 800; color: var(--primary);">@L["BookDetails"]</h1>
        </div>
        <div class="d-flex gap-3">
            <a href="/books-manager" class="btn-sanctuary-outline text-decoration-none">
                <i class="bi bi-arrow-left me-2"></i>@L["BackToBooks"]
            </a>
        </div>
    </div>
 
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @_statusClass alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi @(_statusClass.Contains("danger") ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill") me-2"></i>
            @_statusMessage
            <button type="button" class="btn-close" @onclick='() => _statusMessage = ""' aria-label="Close"></button>
        </div>
    }
 
    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
            <div class="spinner-grow text-primary" role="status">
                <span class="visually-hidden">@L["WaitLoading"]</span>
            </div>
        </div>
    }
    else if (_bookDetails != null)
    {
        <div class="row g-5">
            <!-- Left Column: Visual & Archival Controls -->
            <div class="col-lg-4">
                <div class="card-sanctuary floating text-center mb-4">
                    <div class="book-cover-wrap mb-4 bg-surface-low shadow-sm" style="height: 450px; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                        @if (FSharpOption<Uri>.get_IsSome(_bookDetails.Book.ImageUrl))
                        {
                            <img src="@_bookDetails.Book.ImageUrl.Value.ToString()" 
                                 alt="@_bookDetails.Book.Title.Value Cover" 
                                 class="w-100 h-100" 
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <div class="text-center text-muted opacity-25 p-4 d-flex flex-column align-items-center">
                                <i class="bi bi-journal-text" style="font-size: 5rem;"></i>
                                <span class="d-block mt-3 serif">@L["NoCoverAvailable"]</span>
                                @if (_bookDetails.Book.Editable)
                                {
                                    <button class="btn btn-link btn-sm text-decoration-none mt-2 text-serif" @onclick:stopPropagation @onclick="StartEditingImageUrl">
                                        + @L["AddCoverImage"]
                                    </button>
                                }
                            </div>
                        }

                        @if (_bookDetails.Book.Editable)
                        {
                            <div class="image-edit-badge position-absolute" @onclick="StartEditingImageUrl" @onclick:stopPropagation title="@L["ChangeImage"]">
                                <i class="bi bi-camera-fill"></i>
                            </div>
                        }
                    </div>

                    @if (_bookDetails.Book.Editable && isEditingImageUrl)
                    {
                        <div class="mt-4 p-4 bg-surface-low rounded-xl text-start animate-fade-in shadow-sm border border-dashed border-primary-subtle">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-3 d-flex justify-content-between align-items-center">
                                <span>@L["ModifyArchivalCover"]</span>
                                @if (isLookingUpCover) { <span class="spinner-border spinner-border-sm text-primary"></span> }
                            </label>
                            
                            <div class="input-group shadow-sm rounded-3 overflow-hidden mb-4 border">
                                <input type="text" class="form-control border-0 py-2 serif" 
                                       placeholder="@L["PasteImageUrl"]" 
                                       @bind="editedImageUrl" />
                                <button class="btn btn-white border-start d-flex align-items-center gap-2" type="button" @onclick="LookupCover" disabled="@isLookingUpCover">
                                    <select class="form-select form-select-sm border-0 bg-transparent py-0" @bind="coverSizeLookup" style="width: auto;" @onclick:stopPropagation>
                                        <option value="Small">S</option>
                                        <option value="Medium" selected>M</option>
                                        <option value="Large">L</option>
                                    </select>
                                    <i class="bi bi-magic text-primary"></i>@L["DiscoverCover"]
                                </button>
                            </div>

                            @if (coverPreviewUrl != null)
                            {
                                <div class="mb-4 text-center animate-fade-in bg-white p-3 rounded-lg border shadow-sm">
                                    <p class="small text-muted mb-2 italic">@L["DiscoveredCoverPreview"]</p>
                                    <div class="preview-rect bg-surface-container mx-auto overflow-hidden shadow-sm border border-4 border-white" style="width: 100px; height: 140px;">
                                        <img src="@coverPreviewUrl" class="w-100 h-100" style="object-fit: contain;" />
                                    </div>
                                    <div class="d-flex gap-2 justify-content-center mt-3">
                                        <button type="button" class="btn btn-primary btn-sm px-3" @onclick="AcceptLookup">@L["UseThisCover"]</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="DiscardLookup">@L["Discard"]</button>
                                    </div>
                                </div>
                            }

                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-primary flex-grow-1" @onclick="UpdateImageUrl" disabled="@(string.IsNullOrWhiteSpace(editedImageUrl))">
                                    <i class="bi bi-check2-circle me-2"></i>@L["FinalizeCoverUpdate"]
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="() => isEditingImageUrl = false">@L["Cancel"]</button>
                                @if (FSharpOption<Uri>.get_IsSome(_bookDetails.Book.ImageUrl))
                                {
                                    <button class="btn btn-outline-danger" @onclick="RemoveImageUrl" title="@L["DiscardCover"]">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="mt-5 text-start p-4 bg-surface-low rounded-xl">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="serif mb-0">@L["ArchivalStatus"]</h6>
                            <div class="badge-sanctuary @(isBookSealed ? "badge-borrowed" : "badge-available") d-flex align-items-center">
                                <i class="bi @(isBookSealed ? "bi-lock-fill" : "bi-unlock-fill") me-2"></i>
                                <div class="form-check form-switch p-0 m-0 d-flex align-items-center">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" id="sealSwitch" 
                                           checked="@(!isBookSealed)" 
                                           @onchange="ToggleSeal"
                                           style="cursor: pointer; width: 2em; height: 1em;" />
                                    <label class="form-check-label small fw-bold" for="sealSwitch">
                                        @(isBookSealed ? L["LockedSealed"] : L["EditableUnsealed"])
                                    </label>
                                </div>
                            </div>
                        </div>
                        <p class="small text-muted mb-0 serif italic">@L["SealDescription"]</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Administrative Details -->
            <div class="col-lg-8">
                <div class="card-sanctuary mb-5">
                    <h5 class="serif mb-4 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">@L["PrimaryArchivalMetadata"]</h5>
                    
                    <div class="row g-4">
                        <!-- Title -->
                        <div class="col-12 border-bottom pb-4" style="border-color: var(--surface-container-low) !important;">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["Title"]</label>
                             @if (isEditingTitle)
                            {
                                <div class="input-group shadow-sm rounded overflow-hidden">
                                    <input type="text" class="form-control border-0 py-3 serif h4 mb-0 fw-bold bg-surface-low" @bind="editedTitle" @onkeyup="HandleKeyUp" autofocus />
                                    <button class="btn btn-primary px-4" @onclick="UpdateTitle">@L["Confirm"]</button>
                                    <button class="btn btn-white border-start" @onclick="CancelEdit"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <h2 class="serif mb-0" style="color: var(--primary); font-weight: 800;">@_bookDetails.Book.Title.Value</h2>
                                    @if (_bookDetails.Book.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEdit"><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>

                        <!-- ISBN & SBN Grid -->
                        <div class="col-md-6 border-end" style="border-color: var(--surface-container-low) !important;">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">Identifier (ISBN-13)</label>
                            @if (isEditingIsbn)
                            {
                                <div class="p-3 bg-surface-low rounded border">
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control small py-2" @bind="editedIsbn" placeholder="ISBN..." />
                                        <button class="btn btn-primary btn-sm" @onclick="UpdateIsbn"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-white border-start" @onclick="CancelEditIsbn"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="invalidIsbnSwitch" @bind="acceptInvalidIsbn" />
                                        <label class="form-check-label x-small text-muted" for="invalidIsbnSwitch">@L["AcceptInvalidIsbn"]</label>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge-sanctuary badge-neutral font-monospace p-2">@_bookDetails.Book.Isbn.Value</span>
                                    @if (_bookDetails.Book.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditIsbn"><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>

                        <!-- SBN Code -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <label class="form-label small text-muted text-uppercase fw-bold mb-0">@L["SbnIdentifier"]</label>
                                <span class="badge bg-light text-muted border" 
                                      data-bs-toggle="tooltip" 
                                      data-bs-placement="top"
                                      title="@L["SbnTooltipHelp"]">
                                    <i class="bi bi-question-circle text-primary"></i>
                                </span>
                            </div>
                            @if (isEditingSbn)
                            {
                                <div class="p-3 bg-surface-low rounded border">
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control small py-2 font-monospace" @bind="editedSbn" @bind:event="oninput" @onkeyup="HandleSbnKeyUp" placeholder="@L["PartialSbnPlaceholder"]" autofocus />
                                        @if (!string.IsNullOrWhiteSpace(editedSbn))
                                        {
                                            <span class="input-group-text bg-white border">
                                                @if (SbnCode.IsValid(editedSbn.Trim()))
                                                {
                                                    <i class="bi bi-check-circle-fill text-success" title="Valid SBN format"></i>
                                                }
                                                else if (acceptInvalidSbn)
                                                {
                                                    <i class="bi bi-exclamation-triangle-fill text-warning" title="Invalid SBN format (accepted)"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-danger" title="Invalid SBN format"></i>
                                                }
                                            </span>
                                        }
                                        <button class="btn btn-primary btn-sm" @onclick="UpdateSbn" disabled="@isUpdatingSbn"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-white border-start" @onclick="CancelEditSbn" disabled="@isUpdatingSbn"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="form-check form-switch small mb-0">
                                            <input class="form-check-input" type="checkbox" id="invalidSbnSwitch" @bind="acceptInvalidSbn" />
                                            <label class="form-check-label x-small text-muted" for="invalidSbnSwitch">@L["AcceptInvalidSbn"]</label>
                                        </div>
                                        @if (FSharpOption<SbnCode>.get_IsSome(_bookDetails.Book.SbnCode))
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 x-small text-decoration-none" @onclick="UnsetSbn" disabled="@isUpdatingSbn" title="@L["Unset"]">
                                                <i class="bi bi-trash me-1"></i>@L["Unset"]
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    @if (FSharpOption<SbnCode>.get_IsSome(_bookDetails.Book.SbnCode))
                                    {
                                        var sbn = _bookDetails.Book.SbnCode.Value;
                                        <span class="badge-sanctuary badge-neutral font-monospace p-2 d-inline-flex align-items-center gap-2">
                                            @sbn.Value
                                            @if (sbn.IsInvalidSbn)
                                            {
                                                <span class="badge bg-warning text-dark x-small py-0 px-1" title="Marked as invalid format">invalid</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">@L["MissingSbnCode"]</span>
                                    }
                                    @if (_bookDetails.Book.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditSbn"><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Availability & Distribution Point Grid -->
                        <div class="col-md-6 border-end" style="border-color: var(--surface-container-low) !important;">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["ArchivalAvailability"]</label>
                             @if (isEditingAvailability)
                            {
                                <div class="input-group input-group-sm">
                                    <select class="form-select border-primary" @bind="editedAvailability">
                                        @foreach (var avail in Availability.AllCases())
                                        {
                                            <option value="@avail.ToString()" selected="@(avail.ToString() == _bookDetails.Book.Availability.ToString())">
                                                @GetAvailabilityLocalName(avail)
                                            </option>
                                        }
                                    </select>
                                    <button class="btn btn-primary" @onclick="UpdateAvailability"><i class="bi bi-check-lg"></i></button>
                                    <button class="btn btn-white border-start" @onclick="() => isEditingAvailability = false"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge-sanctuary @(_bookDetails.Book.Availability.IsCirculating ? "badge-available" : "badge-neutral") p-2">
                                        <i class="bi @(_bookDetails.Book.Availability.IsCirculating ? "bi-journal-check" : "bi-journal-lock") me-2"></i>
                                        @GetAvailabilityLocalName(_bookDetails.Book.Availability)
                                    </span>
                                    @if (_bookDetails.Book.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditAvailability"><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Distribution Point -->
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["DistributionPoint"]</label>
                            
                            @if (_bookDetails.DistributionPoint != null && FSharpOption<DistributionPoint>.get_IsSome(_bookDetails.DistributionPoint))
                            {
                                var dp = _bookDetails.DistributionPoint.Value;
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge-sanctuary badge-neutral p-2">
                                        <i class="bi bi-geo-alt-fill me-2 opacity-50"></i>
                                        @dp.Name.Value
                                    </span>
                                    @if (managedDistributionPoints.Any(m => m.DistributionPointId.Equals(dp.DistributionPointId)))
                                    {
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="UnsetDistributionPoint" disabled="@isUpdatingDP">
                                            @if (isUpdatingDP) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            <i class="bi bi-x-circle me-1"></i> @L["Unset"]
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @if (managedDistributionPoints.Any())
                                    {
                                        <div class="input-group input-group-sm" style="max-width: 300px;">
                                            <select class="form-select border-primary-subtle" @bind="selectedDistributionPointIdToSet">
                                                <option value="">@L["SelectToSetDP"]</option>
                                                @foreach (var dp in managedDistributionPoints)
                                                {
                                                    <option value="@dp.DistributionPointId.Value.ToString()">@dp.Name.Value</option>
                                                }
                                            </select>
                                            <button class="btn btn-primary px-3" @onclick="SetDistributionPoint" disabled="@(string.IsNullOrEmpty(selectedDistributionPointIdToSet) || isUpdatingDP)">
                                                @if (isUpdatingDP) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                @L["Set"]
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">@L["NoDistributionPointAssigned"]</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Authors & Taxonomy -->
                        <div class="col-md-6 border-end" style="border-color: var(--surface-container-low) !important;">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-3">@L["CatalogedAuthors"]</label>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var author in _bookDetails.Authors)
                                {
                                    <span class="badge-sanctuary badge-neutral p-2 d-flex align-items-center">
                                        <i class="bi bi-journal-richtext me-2 opacity-50"></i>
                                        <a href="/author-details/@author.AuthorId.Value" class="text-reset text-decoration-none fw-bold">@author.Name.Value</a>
                                        @if (_bookDetails.Book.Editable)
                                        {
                                            <span class="ms-2 ps-2 border-start" style="cursor: pointer;" @onclick="() => RemoveAuthorFromBook(author)"><i class="bi bi-x text-danger"></i></span>
                                        }
                                    </span>
                                }
                            </div>
                            
                            @if (_bookDetails.Book.Editable)
                            {
                                <div class="position-relative">
                                    <div class="input-group input-group-sm rounded bg-surface-low border p-1 shadow-sm">
                                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-person-plus"></i></span>
                                        <input type="text" 
                                               class="form-control border-0 bg-transparent py-2" 
                                               placeholder="@L["AddAuthorToRecord"]" 
                                               value="@_authorSearchInput" 
                                               @oninput="HandleAuthorSearchInput"
                                               @onfocus="() => { if(_authorSearchResults.Any()) _showAuthorSearchResults = true; }" />
                                    </div>
                                    
                                    @if (_showAuthorSearchResults)
                                    {
                                        <div class="list-group position-absolute w-100 shadow mt-1 border" style="z-index: 1100; max-height: 200px; overflow-y: auto; border-radius: 8px;">
                                            @foreach (var author in _authorSearchResults)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action text-start p-3 small border-0" @onclick="() => SelectAuthorForAdd(author)">
                                                    <div class="fw-bold">@author.Name.Value</div>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-3">@L["EditorialTaxonomy"]</label>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <!-- Main -->
                                <span class="badge-sanctuary badge-neutral p-2 d-flex align-items-center @((_bookDetails?.Book.Editable ?? false) ? "clickable" : "")" @onclick="StartEditCategory">
                                    <i class="bi bi-bookmark-fill me-2 opacity-50"></i>
                                    @_bookDetails!.Book.MainCategory.Value()
                                    @if (_bookDetails.Book.Editable) { <i class="bi bi-pencil-fill ms-2 ps-2 border-start x-small"></i> }
                                </span>
                                <!-- Additions -->
                                @foreach (var cat in _bookDetails.Book.AdditionalCategories)
                                {
                                    <span class="badge-sanctuary badge-neutral p-2 d-flex align-items-center">
                                        @cat.Value()
                                        @if (_bookDetails.Book.Editable)
                                        {
                                            <span class="ms-2 ps-2 border-start" style="cursor: pointer;" @onclick="() => RemoveAdditionalCategory(cat)"><i class="bi bi-dash text-danger"></i></span>
                                        }
                                    </span>
                                }
                            </div>
                            
                            @if (_bookDetails.Book.Editable)
                            {
                                <div class="position-relative d-inline-block">
                                    <button class="btn btn-sm btn-white border rounded-pill px-3" @onclick="() => showAddDropdown = !showAddDropdown">
                                        <i class="bi bi-plus-lg me-1"></i> @L["AddAdditionalCategory"]
                                    </button>
                                    @if (showAddDropdown)
                                    {
                                        <div class="position-absolute shadow-lg border rounded-lg bg-white p-3 mt-1" style="z-index: 1000; min-width: 250px; left: 0;">
                                            <div class="small fw-bold mb-3 border-bottom pb-2">@L["SelectCategory"]</div>
                                            <div class="row g-1">
                                                @foreach (var cat in Category.AllCases())
                                                {
                                                    if (cat != _bookDetails.Book.MainCategory && !_bookDetails.Book.AdditionalCategories.Contains(cat))
                                                    {
                                                        <div class="col-6">
                                                            <div class="dropdown-item py-1 px-2 small rounded text-truncate border mb-1" style="cursor: pointer;" @onclick="() => AddAdditionalCategoryWrapper(cat)">
                                                                @cat.Value()
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Archival Tags Section *@
                            <label class="form-label small text-muted text-uppercase fw-bold mb-3 mt-4 d-block">@L["ArchivalTags"]</label>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @foreach (var tag in _bookDetails.Book.Tags)
                                {
                                    <div class="tag-chip @GetTagColorClass(GetTagTypeName(tag)) d-inline-flex align-items-center animate-fade-in shadow-sm">
                                        <span class="me-2 small">@tag.TagName</span>
                                        @if (_bookDetails.Book.Editable)
                                        {
                                            <button type="button" class="btn-close btn-close-white small" style="font-size: 0.5rem" 
                                                    @onclick="() => RemoveTagFromBook(tag)"></button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (_bookDetails.Book.Editable)
                            {
                                <div class="position-relative d-inline-block">
                                    <button class="btn btn-sm btn-white border rounded-pill px-3" @onclick="() => showAddTagDropdown = !showAddTagDropdown">
                                        <i class="bi bi-plus-lg me-1"></i> @L["AddArchivalTag"]
                                    </button>
                                    @if (showAddTagDropdown)
                                    {
                                        <div class="position-absolute shadow-lg border rounded-lg bg-white p-3 mt-1" style="z-index: 1000; min-width: 280px; left: 0;">
                                            <div class="small fw-bold mb-3 border-bottom pb-2">@L["SelectTagToAdd"]</div>
                                            <div class="row g-1 overflow-auto" style="max-height: 300px;">
                                                @foreach (var tag in allAvailableTags)
                                                {
                                                    if (!_bookDetails.Book.Tags.Contains(tag))
                                                    {
                                                        <div class="col-12">
                                                            <div class="dropdown-item py-1 px-2 small rounded text-truncate border mb-1 d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => AddTagWrapper(tag)">
                                                                <span>@tag.TagName</span>
                                                                <span class="badge @GetTagColorClass(GetTagTypeName(tag)) x-small opacity-75">@GetTagTypeName(tag)</span>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                @if (!allAvailableTags.Any(t => !_bookDetails.Book.Tags.Contains(t)))
                                                {
                                                    <div class="col-12 text-center text-muted py-2 small">@L["NoTagsAvailable"]</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Narrative Ledger (Description) -->
                <div class="card-sanctuary p-5">
                    <div class="d-flex justify-content-between align-items-baseline mb-4 border-bottom pb-3" style="border-color: var(--outline-variant) !important;">
                        <h5 class="serif mb-0">@L["NarrativeAbstract"]</h5>
                        <div class="d-flex gap-2">
                            @if (_bookDetails.Book.Editable && !_isEditingDescription)
                            {
                                @if (_previousDescription != null)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="UndoDescriptionChange"><i class="bi bi-arrow-counterclockwise me-1"></i> @L["Undo"]</button>
                                }
                                <button class="btn btn-sm btn-outline-primary" @onclick="GenerateAIDescription" disabled="@_isGeneratingDescription">
                                    @if (_isGeneratingDescription) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    else { <i class="bi bi-magic me-1"></i> }
                                    @L["AutoGenerate"]
                                </button>
                                <button class="btn btn-sm btn-white border" @onclick="StartEditDescription"><i class="bi bi-pencil-square me-1"></i> @L["EditNarrative"]</button>
                            }
                        </div>
                    </div>

                    @if (_isEditingDescription)
                    {
                        <div class="p-4 bg-surface-low rounded-xl">
                            <textarea class="form-control border-0 serif bg-transparent mb-3" @bind="_editedDescription" rows="10" placeholder="@L["WriteDescription"]"></textarea>
                            <div class="d-flex gap-3 align-items-center">
                                <button class="btn btn-primary px-4" @onclick="UpdateDescription">@L["Save"]</button>
                                <button class="btn btn-white border px-4" @onclick="CancelEditDescription">@L["Cancel"]</button>
                                
                                <div class="ms-auto d-flex gap-2">
                                    @if (_previousDescription != null)
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="UndoDescriptionChange">
                                            <i class="bi bi-arrow-counterclockwise me-2"></i> @L["Undo"]
                                        </button>
                                    }
                                    <button class="btn btn-outline-primary" @onclick="GenerateAIDescription" disabled="@_isGeneratingDescription">
                                        @if (_isGeneratingDescription) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                        else { <i class="bi bi-magic me-2"></i> }
                                        @L["GenerateWithAI"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="serif italic text-muted lh-lg" style="font-size: 1.1rem; white-space: pre-wrap;">
                            @(FSharpOption<string>.get_IsSome(_bookDetails.Book.Description) ? _bookDetails.Book.Description.Value : L["NoDescriptionProvided"])
                        </div>

                        @if (FSharpOption<string>.get_IsSome(_bookDetails.Book.Description) && FSharpOption<EmbeddingDataId>.get_IsNone(_bookDetails.Book.OptionalEmbedding) && _bookDetails.Book.Editable)
                        {
                            <div class="mt-4 p-3 bg-surface-low rounded-xl border border-warning-subtle animate-fade-in shadow-sm d-flex align-items-center gap-3">
                                <div class="p-2 bg-warning-subtle rounded-circle text-warning">
                                    <i class="bi bi-cpu fs-5"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="serif mb-1 small fw-bold text-warning-emphasis">@L["AIVectorDataMissing"]</h6>
                                    <p class="small text-muted mb-0 serif italic">@L["NoVectorDataNote"]</p>
                                </div>
                                <button class="btn btn-sm btn-primary px-3 rounded-pill" @onclick="GenerateEmbedding" disabled="@_isGeneratingEmbedding">
                                    @if (_isGeneratingEmbedding)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>@L["Wait"]...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-magic me-1"></i>
                                        <span>@L["GenerateEmbedding"]</span>
                                    }
                                </button>
                            </div>
                        }

                        @if (FSharpOption<EmbeddingDataId>.get_IsSome(_bookDetails.Book.OptionalEmbedding))
                        {
                            <div class="mt-4 p-4 bg-surface-low rounded-xl border border-primary-subtle shadow-sm animate-fade-in">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 bg-primary-subtle rounded-circle text-primary">
                                            <i class="bi bi-shield-check fs-5"></i>
                                        </div>
                                        <h6 class="serif mb-0 fw-bold">@L["SemanticSanityCheck"]</h6>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-danger px-3" @onclick="RemoveEmbedding" disabled="@_isRemovingEmbedding">
                                            @if (_isRemovingEmbedding) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            else { <i class="bi bi-trash me-1"></i> }
                                            @L["RemoveEmbedding"]
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary px-3" @onclick="() => _showSanityCheckForm = !_showSanityCheckForm">
                                            <i class="bi @(_showSanityCheckForm ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                            @(_showSanityCheckForm ? L["Hide"] : L["PerformSanityCheck"])
                                        </button>
                                    </div>
                                </div>

                                @if (_showSanityCheckForm)
                                {
                                    <div class="sanity-check-form animate-fade-in mt-3">
                                        <p class="small text-muted mb-3 italic">@L["VerifyAIUnderstandingNote"]</p>
                                        
                                        <div class="mb-3">
                                            <label class="form-label x-small text-uppercase fw-bold text-muted">@L["TestQueryDescription"]</label>
                                            <textarea class="form-control serif bg-white border shadow-sm" @bind="_sanityCheckQuery" rows="3" placeholder="@L["SemanticSearchPlaceholder"]"></textarea>
                                        </div>

                                        <div class="d-flex align-items-end gap-3 mb-4">
                                            <div style="width: 100px;">
                                                <label class="form-label x-small text-uppercase fw-bold text-muted">@L["MaxResults"]</label>
                                                <input type="number" class="form-control" @bind="_sanityCheckLimit" min="1" max="10" />
                                            </div>
                                            <button class="btn btn-primary px-4 shadow-sm" @onclick="PerformSanityCheck" disabled="@(string.IsNullOrWhiteSpace(_sanityCheckQuery) || _isPerformingSanityCheck)">
                                                @if (_isPerformingSanityCheck) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                <i class="bi bi-search me-1"></i> @L["CheckSemanticAccuracy"]
                                            </button>
                                        </div>

                                        @if (_sanityCheckResults != null)
                                        {
                                            <div class="results-area p-3 bg-white rounded border animate-fade-in shadow-sm">
                                                <h6 class="serif border-bottom pb-2 mb-3">Semantic Results</h6>
                                                
                                                <div class="d-flex align-items-center gap-3 mb-4">
                                                    @{
                                                        var matchesPrimary = _sanityCheckResults.Any() && _sanityCheckResults.First().Id.Value == _bookDetails.Book.BookId.Value;
                                                        var inResults = _sanityCheckResults.Any(r => r.Id.Value == _bookDetails.Book.BookId.Value);
                                                    }
                                                    <div class="badge-sanctuary @(matchesPrimary ? "badge-available" : (inResults ? "badge-neutral" : "badge-borrowed")) p-3 d-flex align-items-center gap-3 flex-grow-1 border">
                                                        <i class="bi @(matchesPrimary ? "bi-check-circle-fill" : (inResults ? "bi-info-circle-fill" : "bi-exclamation-triangle-fill")) fs-4"></i>
                                                        <div>
                                                            <div class="fw-bold">@(matchesPrimary ? L["PrimaryMatchFound"] : (inResults ? L["SecondaryMatchFound"] : L["NoMatchFound"]))</div>
                                                            <div class="small opacity-75">@(matchesPrimary ? L["TopSemanticResult"] : (inResults ? L["FoundInTopResults"] : L["NotInTopResults"]))</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="list-group list-group-flush border-top">
                                                    @foreach (var res in _sanityCheckResults)
                                                    {
                                                        <div class="d-flex align-items-stretch border rounded mb-2 transition-all bg-surface-low hover-bg-surface-lowest shadow-sm overflow-hidden">
                                                            <a href="/book-edit/@res.Id.Value" class="flex-grow-1 text-decoration-none text-reset p-3 d-flex flex-column gap-1">
                                                                <div class="serif @(res.Id.Value == _bookDetails.Book.BookId.Value ? "fw-bold text-primary" : "")">
                                                                    @res.Title
                                                                    @if (res.Id.Value == _bookDetails.Book.BookId.Value) { <span class="ms-2 badge bg-primary-subtle text-primary small">@L["CurrentBook"]</span> }
                                                                </div>
                                                                <div class="small text-muted d-flex align-items-center gap-2">
                                                                    <span><i class="bi bi-bullseye me-1"></i> Match: @((res.Score * 100).ToString("F1"))%</span>
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(res.Explanation))
                                                                {
                                                                    <div class="small text-primary italic mt-2 p-2 bg-primary-subtle rounded animate-fade-in" style="font-size: 0.8rem; border-left: 3px solid var(--primary);">
                                                                        <div class="d-flex justify-content-between align-items-start">
                                                                            <span><i class="bi bi-chat-left-text me-2"></i> @res.Explanation</span>
                                                                            <button type="button" class="btn btn-link btn-sm p-0 ms-2 text-muted" @onclick:stopPropagation="true" @onclick="() => { res.Explanation = null; }">
                                                                                <i class="bi bi-x-circle-fill" style="font-size: 1rem;"></i>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </a>
                                                            
                                                            <div class="d-flex flex-column justify-content-center px-3 border-start bg-surface-container-low" style="min-width: 60px;">
                                                                @if (enableAIExplanations && string.IsNullOrEmpty(res.Explanation) && !res.IsLoadingExplanation)
                                                                {
                                                                    <button type="button" class="btn btn-primary-subtle rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm mx-auto" 
                                                                            @onclick="() => FetchExplanation(res)" 
                                                                            title="@L["ExplainMatch"]"
                                                                            style="width: 32px; height: 32px; border: 1px solid var(--primary-container);">
                                                                        <i class="bi bi-question text-primary fs-5"></i>
                                                                    </button>
                                                                }
                                                                @if (res.IsLoadingExplanation)
                                                                {
                                                                    <div class="spinner-border spinner-border-sm text-primary mx-auto" role="status">
                                                                        <span class="visually-hidden">@L["Loading"]...</span>
                                                                    </div>
                                                                }
                                                                <i class="bi bi-chevron-right text-muted mx-auto mt-2 opacity-25"></i>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <!-- Collected Papers Section -->
                <div class="card-sanctuary p-5 mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: var(--outline-variant) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="serif mb-0">@L["CollectedPapers"]</h5>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 small">
                                @(_bookDetails.Book.Papers.Length) @(_bookDetails.Book.Papers.Length == 1 ? L["Paper"] : L["Papers"])
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            @if (_bookDetails.Book.Papers.Any())
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" @onclick="TogglePapersDrillDown">
                                    <i class="bi @(_isPapersDrillDownOpen ? "bi-chevron-up" : "bi-layers-half") me-1"></i>
                                    @(_isPapersDrillDownOpen ? L["HidePapers"] : L["DrillDownPapers"])
                                </button>
                            }
                            @if (_bookDetails.Book.Editable && !_isAddingPaper && !_isScanningPapers)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" @onclick="OpenScanPapersSection">
                                    <i class="bi bi-camera me-1"></i> @L["ScanPapers"]
                                </button>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" @onclick="OpenAddPaperSection">
                                    <i class="bi bi-plus-lg me-1"></i> @L["AddPaper"]
                                </button>
                            }
                        </div>
                    </div>

                    @* Add Paper Form Section *@
                    @if (_isAddingPaper)
                    {
                        <div class="p-4 bg-surface-low rounded-xl border border-primary-subtle shadow-sm mb-4 animate-fade-in">
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                <h6 class="serif mb-0 fw-bold text-primary">
                                    <i class="bi bi-file-earmark-plus me-2"></i>@L["AddPaper"]
                                </h6>
                                <button type="button" class="btn-close small" @onclick="CancelAddPaper" aria-label="Close"></button>
                            </div>
                            <p class="small text-muted mb-3 serif italic">@L["DefinePaperForBook"]</p>

                            <!-- Title Input -->
                            <div class="mb-3">
                                <label class="form-label x-small text-uppercase fw-bold text-muted">@L["PaperTitle"] *</label>
                                <input type="text" class="form-control serif bg-white shadow-sm" placeholder="@L["PaperTitlePlaceholder"]" @bind="_newPaperTitle" />
                            </div>

                            <!-- Description Input -->
                            <div class="mb-3">
                                <label class="form-label x-small text-uppercase fw-bold text-muted">@L["PaperDescription"]</label>
                                <textarea class="form-control serif bg-white shadow-sm" rows="3" placeholder="@L["PaperDescriptionPlaceholder"]" @bind="_newPaperDescription"></textarea>
                            </div>

                            <!-- Authors Search & Selection -->
                            <div class="mb-3">
                                <label class="form-label x-small text-uppercase fw-bold text-muted">@L["PaperAuthors"]</label>
                                
                                @if (_newPaperSelectedAuthors.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        @foreach (var author in _newPaperSelectedAuthors)
                                        {
                                            <span class="badge-sanctuary badge-neutral p-2 d-flex align-items-center shadow-sm">
                                                <i class="bi bi-person-fill me-1 opacity-75"></i>
                                                @author.Name.Value
                                                <span class="ms-2 ps-2 border-start" style="cursor: pointer;" @onclick="() => RemovePaperAuthor(author)">
                                                    <i class="bi bi-x text-danger fw-bold"></i>
                                                </span>
                                            </span>
                                        }
                                    </div>
                                }

                                @if (_bookDetails.Authors.Any(a => !_newPaperSelectedAuthors.Any(sa => sa.AuthorId.Value == a.AuthorId.Value)))
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                                        <span class="x-small text-muted me-1">From book:</span>
                                        @foreach (var bookAuthor in _bookDetails.Authors.Where(a => !_newPaperSelectedAuthors.Any(sa => sa.AuthorId.Value == a.AuthorId.Value)))
                                        {
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 small" style="font-size: 0.75rem;" @onclick="() => AddAuthorToPaper(bookAuthor)">
                                                <i class="bi bi-plus"></i> @bookAuthor.Name.Value
                                            </button>
                                        }
                                    </div>
                                }

                                <div class="position-relative">
                                    <div class="input-group input-group-sm rounded bg-surface-lowest border p-1 shadow-sm">
                                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                                        <input type="text" 
                                               class="form-control border-0 bg-transparent py-1" 
                                               placeholder="@L["AddPaperAuthorPlaceholder"]" 
                                               value="@_paperAuthorSearchInput" 
                                               @oninput="HandlePaperAuthorSearchInput" 
                                               @onfocus="() => { if (_paperAuthorSearchResults.Any()) _showPaperAuthorSearchResults = true; }" />
                                        @if (_isLoadingPaperAuthors)
                                        {
                                            <span class="input-group-text bg-transparent border-0">
                                                <span class="spinner-border spinner-border-sm text-primary"></span>
                                            </span>
                                        }
                                    </div>
                                    @if (_showPaperAuthorSearchResults && _paperAuthorSearchResults.Any())
                                    {
                                        <div class="list-group position-absolute w-100 shadow mt-1 border" style="z-index: 1100; max-height: 180px; overflow-y: auto; border-radius: 8px;">
                                            @foreach (var author in _paperAuthorSearchResults)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action text-start p-2 small border-0 d-flex justify-content-between align-items-center" @onclick="() => AddAuthorToPaper(author)">
                                                    <div class="fw-bold">@author.Name.Value</div>
                                                    <i class="bi bi-plus-circle text-primary"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Categories Selection -->
                            <div class="mb-3">
                                <label class="form-label x-small text-uppercase fw-bold text-muted">@L["PaperCategories"]</label>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @foreach (var cat in _newPaperSelectedCategories)
                                    {
                                        <span class="badge-sanctuary badge-neutral p-2 d-flex align-items-center shadow-sm">
                                            <i class="bi bi-bookmark-fill me-1 opacity-50"></i>
                                            @cat.Value()
                                            <span class="ms-2 ps-2 border-start" style="cursor: pointer;" @onclick="() => _newPaperSelectedCategories.Remove(cat)">
                                                <i class="bi bi-dash text-danger fw-bold"></i>
                                            </span>
                                        </span>
                                    }
                                </div>
                                <div class="position-relative d-inline-block">
                                    <button type="button" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm" @onclick="() => _showPaperAddCategoryDropdown = !_showPaperAddCategoryDropdown">
                                        <i class="bi bi-plus-lg me-1"></i> @L["AddAdditionalCategory"]
                                    </button>
                                    @if (_showPaperAddCategoryDropdown)
                                    {
                                        <div class="position-absolute shadow-lg border rounded-lg bg-white p-3 mt-1" style="z-index: 1050; min-width: 250px; left: 0;">
                                            <div class="small fw-bold mb-2 border-bottom pb-1">@L["SelectCategory"]</div>
                                            <div class="row g-1" style="max-height: 200px; overflow-y: auto;">
                                                @foreach (var cat in Category.AllCases())
                                                {
                                                    if (!_newPaperSelectedCategories.Contains(cat))
                                                    {
                                                        <div class="col-6">
                                                            <div class="dropdown-item py-1 px-2 small rounded text-truncate border mb-1" style="cursor: pointer;" @onclick="() => { _newPaperSelectedCategories.Add(cat); _showPaperAddCategoryDropdown = false; }">
                                                                @cat.Value()
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Tags Selection -->
                            <div class="mb-4">
                                <label class="form-label x-small text-uppercase fw-bold text-muted">@L["PaperTags"]</label>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @foreach (var tag in _newPaperSelectedTags)
                                    {
                                        <div class="tag-chip @GetTagColorClass(GetTagTypeName(tag)) d-inline-flex align-items-center shadow-sm">
                                            <span class="me-2 small">@tag.TagName</span>
                                            <button type="button" class="btn-close btn-close-white small" style="font-size: 0.5rem" @onclick="() => _newPaperSelectedTags.Remove(tag)"></button>
                                        </div>
                                    }
                                </div>
                                <div class="position-relative d-inline-block">
                                    <button type="button" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm" @onclick="() => _showPaperAddTagDropdown = !_showPaperAddTagDropdown">
                                        <i class="bi bi-plus-lg me-1"></i> @L["AddArchivalTag"]
                                    </button>
                                    @if (_showPaperAddTagDropdown)
                                    {
                                        <div class="position-absolute shadow-lg border rounded-lg bg-white p-3 mt-1" style="z-index: 1050; min-width: 280px; left: 0;">
                                            <div class="small fw-bold mb-2 border-bottom pb-1">@L["SelectTagToAdd"]</div>
                                            <div class="row g-1 overflow-auto" style="max-height: 220px;">
                                                @foreach (var tag in allAvailableTags)
                                                {
                                                    if (!_newPaperSelectedTags.Contains(tag))
                                                    {
                                                        <div class="col-12">
                                                            <div class="dropdown-item py-1 px-2 small rounded text-truncate border mb-1 d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => { _newPaperSelectedTags.Add(tag); _showPaperAddTagDropdown = false; }">
                                                                <span>@tag.TagName</span>
                                                                <span class="badge @GetTagColorClass(GetTagTypeName(tag)) x-small opacity-75">@GetTagTypeName(tag)</span>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary px-4 shadow-sm" @onclick="SavePaper" disabled="@(string.IsNullOrWhiteSpace(_newPaperTitle) || _isSavingPaper)">
                                    @if (_isSavingPaper)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="bi bi-check-lg me-1"></i>@L["Save"]
                                </button>
                                <button type="button" class="btn btn-white border px-4" @onclick="CancelAddPaper">
                                    @L["Cancel"]
                                </button>
                            </div>
                        </div>
                    }

                    @* Scan / Capture Papers Section *@
                    @if (_isScanningPapers)
                    {
                        <div class="p-4 bg-surface-low rounded-xl border border-primary-subtle shadow-sm mb-4 animate-fade-in">
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                <div>
                                    <h6 class="serif mb-0 fw-bold text-primary">
                                        <i class="bi bi-camera-fill me-2"></i>@L["ScanPapers"]
                                    </h6>
                                    <span class="x-small text-muted serif italic">@L["ScanPapersSubtitle"]</span>
                                </div>
                                <button type="button" class="btn-close small" @onclick="CancelScanPapers" aria-label="Close"></button>
                            </div>

                            <!-- Mode Selection Tabs -->
                            <ul class="nav nav-pills mb-3 border-bottom pb-2">
                                <li class="nav-item">
                                    <button type="button" class="nav-link rounded-pill py-1 px-3 small @(_scanActiveTab == 0 ? "active" : "")" @onclick="() => _scanActiveTab = 0">
                                        <i class="bi bi-phone me-1"></i>@L["CaptureWithSmartphone"]
                                    </button>
                                </li>
                                <li class="nav-item ms-2">
                                    <button type="button" class="nav-link rounded-pill py-1 px-3 small @(_scanActiveTab == 1 ? "active" : "")" @onclick="() => _scanActiveTab = 1">
                                        <i class="bi bi-file-earmark-image me-1"></i>@L["UploadScannedImage"]
                                    </button>
                                </li>
                                <li class="nav-item ms-2">
                                    <button type="button" class="nav-link rounded-pill py-1 px-3 small @(_scanActiveTab == 2 ? "active" : "")" @onclick="() => _scanActiveTab = 2">
                                        <i class="bi bi-textarea-t me-1"></i>@L["PasteTableOfContentsText"]
                                    </button>
                                </li>
                            </ul>

                            @* Tab 0: Smartphone / Camera *@
                            @if (_scanActiveTab == 0)
                            {
                                <div class="mb-3 p-3 bg-white rounded-3 border text-center">
                                    <p class="small text-muted mb-3">
                                        Take a photo of the table of contents using your smartphone or desktop webcam.
                                    </p>
                                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                                        <label class="btn btn-primary rounded-pill px-4 shadow-sm cursor-pointer mb-0">
                                            <i class="bi bi-camera-fill me-2"></i>@L["TakePhotoWithSmartphone"]
                                            <InputFile OnChange="HandleScanImageFile" accept="image/*" capture="environment" style="display: none;" />
                                        </label>
                                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm" @onclick="ToggleLiveCamera">
                                            <i class="bi bi-camera-video me-2"></i>@(_isLiveCameraActive ? "Close Live Camera" : "Live Camera Preview")
                                        </button>
                                    </div>

                                    @if (_isLiveCameraActive)
                                    {
                                        <div id="papers-scanner-wrapper" class="scanner-preview-wrapper rounded-3 overflow-hidden position-relative bg-black mt-3 mx-auto shadow-sm" style="max-width: 600px; min-height: 280px;">
                                            <BarcodeReader 
                                                OnBarcodeReceived="(args) => { }" 
                                                Title=""
                                                StartCameraAutomatically="true"
                                                ShowStart="false"
                                                ShowReset="false"
                                                ShowVideoDeviceList="true"
                                            />
                                            <div class="d-flex justify-content-center position-absolute bottom-0 w-100 p-3" style="z-index: 10;">
                                                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-lg" @onclick="CaptureLiveCameraFrame" disabled="@_isAnalyzingPapers">
                                                    <i class="bi bi-camera-fill me-2"></i> @L["TakePhotoWithSmartphone"]
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Tab 1: Upload Image File *@
                            @if (_scanActiveTab == 1)
                            {
                                <div class="mb-3 p-3 bg-white rounded-3 border">
                                    <label class="form-label x-small text-uppercase fw-bold text-muted">Select image file (JPG, PNG, WEBP)</label>
                                    <InputFile OnChange="HandleScanImageFile" accept="image/*" class="form-control form-control-sm mb-2" />
                                    @if (!string.IsNullOrEmpty(_scannedImagePreview))
                                    {
                                        <div class="d-flex align-items-center gap-3 mt-2">
                                            <img src="@_scannedImagePreview" alt="Scanned Preview" class="rounded border shadow-xs" style="max-height: 120px; max-width: 200px; object-fit: contain;" />
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" @onclick="AnalyzePapersImage" disabled="@_isAnalyzingPapers">
                                                <i class="bi bi-stars me-1"></i> Analyze Image
                                            </button>
                                        </div>
                                    }
                                </div>
                            }

                            @* Tab 2: Paste Text / OCR *@
                            @if (_scanActiveTab == 2)
                            {
                                <div class="mb-3 p-3 bg-white rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label x-small text-uppercase fw-bold text-muted mb-0">Paste Table of Contents / SOMMARIO Text</label>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none x-small text-serif" @onclick="LoadSampleSommarioText">
                                            <i class="bi bi-magic me-1"></i>@L["LoadSampleSommario"]
                                        </button>
                                    </div>
                                    <textarea class="form-control serif bg-white shadow-xs small mb-2" rows="6" placeholder="Paste table of contents text (SOMMARIO, papers with authors and page numbers)..." @bind="_scanInputText"></textarea>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm" @onclick="AnalyzePapersText" disabled="@(string.IsNullOrWhiteSpace(_scanInputText) || _isAnalyzingPapers)">
                                            <i class="bi bi-stars me-1"></i> Analyze Text
                                        </button>
                                    </div>
                                </div>
                            }

                            @* Analysis Loading Spinner *@
                            @if (_isAnalyzingPapers)
                            {
                                <div class="p-4 text-center bg-white rounded-3 border my-3">
                                    <div class="spinner-border text-primary me-2" role="status"></div>
                                    <span class="text-muted fw-bold serif">@L["RecognizingPapers"]</span>
                                    <p class="small text-muted mt-2 mb-0">Extracting papers, articles, authors, and page references with AI recognition...</p>
                                </div>
                            }

                            @* Staged Recognized Papers List *@
                            @if (_stagedPapers.Any() && !_isAnalyzingPapers)
                            {
                                <div class="mt-4 pt-3 border-top">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                        <div>
                                            <h6 class="serif mb-0 fw-bold text-dark">
                                                <i class="bi bi-check2-circle text-success me-2"></i>@L["RecognizedPapersTitle"]
                                                <span class="badge bg-primary-subtle text-primary rounded-pill ms-2 small">
                                                    @_stagedPapers.Count(p => p.IsSelected) / @_stagedPapers.Count Selected
                                                </span>
                                            </h6>
                                            <span class="x-small text-muted">@GetStagedAuthorsSummary()</span>
                                        </div>

                                        <!-- Batch controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1 small" @onclick="ToggleSelectAllStaged">
                                                @(_stagedPapers.All(p => p.IsSelected) ? "Deselect All" : "Select All")
                                            </button>

                                            <!-- Batch Category Dropdown -->
                                            <div class="dropdown d-inline-block">
                                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1 small dropdown-toggle" data-bs-toggle="dropdown">
                                                    <i class="bi bi-bookmark-plus me-1"></i>@L["ApplyCategoryToSelected"]
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="max-height: 200px; overflow-y: auto;">
                                                    @foreach (var cat in Category.AllCases())
                                                    {
                                                        <li><button type="button" class="dropdown-item small" @onclick="() => ApplyCategoryToAllSelected(cat)">@cat.Value()</button></li>
                                                    }
                                                </ul>
                                            </div>

                                            <!-- Batch Tag Dropdown -->
                                            <div class="dropdown d-inline-block">
                                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-1 small dropdown-toggle" data-bs-toggle="dropdown">
                                                    <i class="bi bi-tag me-1"></i>@L["ApplyTagToSelected"]
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="max-height: 200px; overflow-y: auto;">
                                                    @foreach (var tag in allAvailableTags)
                                                    {
                                                        <li><button type="button" class="dropdown-item small" @onclick="() => ApplyTagToAllSelected(tag)">@tag.TagName</button></li>
                                                    }
                                                </ul>
                                            </div>

                                            <!-- Global Auto-Add Authors Switch -->
                                            <div class="form-check form-switch mb-0 ms-2 small">
                                                <input class="form-check-input" type="checkbox" id="autoAddAuthorsSwitch" checked="@_batchAutoAddAllNewAuthors" @onchange="ToggleAutoAddAllAuthors" />
                                                <label class="form-check-label x-small text-muted" for="autoAddAuthorsSwitch">Auto-add missing authors</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Cards for each staged paper -->
                                    <div class="d-flex flex-column gap-3 mb-4">
                                        @for (int i = 0; i < _stagedPapers.Count; i++)
                                        {
                                            var index = i;
                                            var staged = _stagedPapers[index];
                                            <div class="card p-3 shadow-xs border @(staged.IsSelected ? "border-primary-subtle bg-white" : "border-light opacity-60 bg-light") rounded-3 transition-all">
                                                <div class="row g-2 align-items-start">
                                                    <!-- Checkbox & Index -->
                                                    <div class="col-auto pt-1">
                                                        <input type="checkbox" class="form-check-input" @bind="staged.IsSelected" />
                                                        <span class="x-small text-muted ms-1">#@(index + 1)</span>
                                                    </div>

                                                    <!-- Main details -->
                                                    <div class="col">
                                                        <!-- Title & Page -->
                                                        <div class="d-flex gap-2 mb-2">
                                                            <div class="flex-grow-1">
                                                                <input type="text" class="form-control form-control-sm serif fw-bold bg-light-subtle" placeholder="Paper title" @bind="staged.Title" />
                                                            </div>
                                                            <div style="width: 110px;">
                                                                <input type="text" class="form-control form-control-sm text-end small" placeholder="Page" @bind="staged.PageNumber" />
                                                            </div>
                                                            <button type="button" class="btn btn-link text-danger p-0 ms-1" title="Remove" @onclick="() => _stagedPapers.RemoveAt(index)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>

                                                        <!-- Section / Notes -->
                                                        <div class="mb-2">
                                                            <input type="text" class="form-control form-control-sm text-muted small fst-italic" placeholder="Section / Note / Session header" @bind="staged.Section" />
                                                        </div>

                                                        <!-- Authors -->
                                                        <div class="mb-2 p-2 bg-surface-low rounded border">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="x-small text-uppercase fw-bold text-muted">
                                                                    <i class="bi bi-people-fill me-1"></i>@L["PaperAuthors"] (@staged.Authors.Count)
                                                                </span>
                                                                <button type="button" class="btn btn-link btn-xs p-0 text-decoration-none x-small" @onclick="() => PromptAddAuthorToStaged(staged)">
                                                                    + Add Author
                                                                </button>
                                                            </div>

                                                            @if (!staged.Authors.Any())
                                                            {
                                                                <span class="x-small text-muted fst-italic">No authors detected (anonymous, round table, or editor preface)</span>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex flex-wrap gap-2">
                                                                    @foreach (var author in staged.Authors)
                                                                    {
                                                                        if (author.MatchedAuthor != null)
                                                                        {
                                                                            <div class="badge bg-success-subtle text-success-emphasis border border-success-subtle p-2 rounded-pill d-inline-flex align-items-center gap-1 small">
                                                                                <i class="bi bi-check-circle-fill text-success" title="@L["AuthorFoundInLibrary"]"></i>
                                                                                <span class="fw-semibold">@author.ScannedName</span>
                                                                                <div class="form-check form-check-inline m-0 ps-2 ms-1 border-start border-success-subtle">
                                                                                    <input type="checkbox" class="form-check-input" id="@($"assoc_{staged.Id}_{author.ScannedName}")" @bind="author.ConfirmAssociate" title="Associate with catalog author" />
                                                                                    <label class="form-check-label x-small" for="@($"assoc_{staged.Id}_{author.ScannedName}")">Matched</label>
                                                                                </div>
                                                                                <button type="button" class="btn-close ms-1 small" style="font-size: 0.5rem;" @onclick="() => staged.Authors.Remove(author)"></button>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle p-2 rounded-pill d-inline-flex align-items-center gap-1 small">
                                                                                <i class="bi bi-person-plus-fill text-warning" title="@L["AuthorNotInLibrary"]"></i>
                                                                                <span class="fw-semibold">@author.ScannedName</span>
                                                                                <div class="form-check form-check-inline m-0 ps-2 ms-1 border-start border-warning-subtle">
                                                                                    <input type="checkbox" class="form-check-input" id="@($"new_{staged.Id}_{author.ScannedName}")" @bind="author.AutoAddNewAuthor" title="Add as new author to library" />
                                                                                    <label class="form-check-label x-small" for="@($"new_{staged.Id}_{author.ScannedName}")">Add to library</label>
                                                                                </div>
                                                                                <button type="button" class="btn-close ms-1 small" style="font-size: 0.5rem;" @onclick="() => staged.Authors.Remove(author)"></button>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </div>

                                                        <!-- Categories and Tags Bar -->
                                                        <div class="d-flex flex-wrap align-items-center gap-3 pt-1">
                                                            <!-- Categories -->
                                                            <div class="d-flex align-items-center flex-wrap gap-1">
                                                                <span class="x-small text-muted me-1"><i class="bi bi-bookmark me-1"></i>Categories:</span>
                                                                @foreach (var cat in staged.Categories)
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill py-1 px-2 x-small d-inline-flex align-items-center">
                                                                        @cat.Value()
                                                                        <span class="ms-1 cursor-pointer fw-bold" @onclick="() => staged.Categories.Remove(cat)">&times;</span>
                                                                    </span>
                                                                }
                                                                <div class="dropdown d-inline-block">
                                                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 x-small dropdown-toggle" data-bs-toggle="dropdown">
                                                                        + Category
                                                                    </button>
                                                                    <ul class="dropdown-menu shadow-sm" style="max-height: 180px; overflow-y: auto;">
                                                                        @foreach (var cat in Category.AllCases())
                                                                        {
                                                                            if (!staged.Categories.Contains(cat))
                                                                            {
                                                                                <li><button type="button" class="dropdown-item x-small" @onclick="() => staged.Categories.Add(cat)">@cat.Value()</button></li>
                                                                            }
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </div>

                                                            <!-- Tags -->
                                                            <div class="d-flex align-items-center flex-wrap gap-1">
                                                                <span class="x-small text-muted me-1"><i class="bi bi-tag me-1"></i>Tags:</span>
                                                                @foreach (var tag in staged.Tags)
                                                                {
                                                                    <span class="badge @GetTagColorClass(GetTagTypeName(tag)) rounded-pill py-1 px-2 x-small d-inline-flex align-items-center">
                                                                        @tag.TagName
                                                                        <span class="ms-1 cursor-pointer fw-bold" @onclick="() => staged.Tags.Remove(tag)">&times;</span>
                                                                    </span>
                                                                }
                                                                <div class="dropdown d-inline-block">
                                                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 x-small dropdown-toggle" data-bs-toggle="dropdown">
                                                                        + Tag
                                                                    </button>
                                                                    <ul class="dropdown-menu shadow-sm" style="max-height: 180px; overflow-y: auto;">
                                                                        @foreach (var tag in allAvailableTags)
                                                                        {
                                                                            if (!staged.Tags.Contains(tag))
                                                                            {
                                                                                <li><button type="button" class="dropdown-item x-small" @onclick="() => staged.Tags.Add(tag)">@tag.TagName</button></li>
                                                                            }
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- Final Import Buttons -->
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="ImportStagedPapers" disabled="@(!_stagedPapers.Any(p => p.IsSelected) || _isImportingStagedPapers)">
                                            @if (_isImportingStagedPapers)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                @L["ImportingPapers"]
                                            }
                                            else
                                            {
                                                <i class="bi bi-check2-all me-1"></i>
                                                <span>@L["ImportSelectedPapers"] (@_stagedPapers.Count(p => p.IsSelected))</span>
                                            }
                                        </button>
                                        <button type="button" class="btn btn-white border rounded-pill px-4" @onclick="CancelScanPapers" disabled="@_isImportingStagedPapers">
                                            @L["Cancel"]
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* Papers List / Drill Down View *@
                    @if (_isPapersDrillDownOpen)
                    {
                        @if (!_bookDetails.Book.Papers.Any())
                        {
                            <div class="p-4 bg-surface-low rounded-xl text-center border dashed">
                                <p class="text-muted fst-italic small mb-0 serif">@L["NoPapersInBook"]</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3 animate-fade-in">
                                @for (int i = 0; i < _bookDetails.Book.Papers.Length; i++)
                                {
                                    var paper = _bookDetails.Book.Papers[i];
                                    var paperIndex = i + 1;
                                    <div class="p-4 bg-surface-low rounded-xl border border-light shadow-sm transition-all hover-shadow">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-baseline gap-2">
                                                <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 small fw-bold">#@paperIndex</span>
                                                <h6 class="serif mb-0 fw-bold fs-5 text-dark">@paper.Title.Value</h6>
                                            </div>
                                            @if (_bookDetails.Book.Editable)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" title="@L["RemovePaper"]" @onclick="() => RemovePaper(paper)">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="small">@L["RemovePaper"]</span>
                                                </button>
                                            }
                                        </div>

                                        @if (FSharpOption<string>.get_IsSome(paper.Description) && !string.IsNullOrWhiteSpace(paper.Description.Value))
                                        {
                                            <p class="serif italic text-muted small mb-3 lh-base" style="white-space: pre-wrap;">
                                                @paper.Description.Value
                                            </p>
                                        }

                                        @if (paper.Authors.Any())
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                                <span class="x-small text-muted text-uppercase fw-bold me-1"><i class="bi bi-people me-1"></i>@L["Authors"]:</span>
                                                @foreach (var authorId in paper.Authors)
                                                {
                                                    <a href="/author-details/@authorId.Value" class="badge-sanctuary badge-neutral text-decoration-none p-1 px-2 small">
                                                        <i class="bi bi-person me-1"></i>@GetPaperAuthorName(authorId)
                                                    </a>
                                                }
                                            </div>
                                        }

                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top border-light">
                                            @if (paper.Categories.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1 align-items-center me-3">
                                                    <span class="x-small text-muted text-uppercase fw-bold me-1">@L["Categories"]:</span>
                                                    @foreach (var cat in paper.Categories)
                                                    {
                                                        <span class="badge-sanctuary bg-surface-container text-muted small" style="font-size: 0.75rem;">@cat.Value()</span>
                                                    }
                                                </div>
                                            }
                                            @if (paper.Tags.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                                    <span class="x-small text-muted text-uppercase fw-bold me-1">@L["Tags"]:</span>
                                                    @foreach (var tag in paper.Tags)
                                                    {
                                                        <span class="tag-chip @GetTagColorClass(GetTagTypeName(tag)) py-1 px-2 small" style="font-size: 0.75rem;">
                                                            @tag.TagName
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

            </div> <!-- End lg-8 -->
        </div> <!-- End row g-5 -->

        <!-- Status & Future Engagements -->
        <div class="row g-5 mt-4">
            <div class="col-lg-12">
                <div class="card-sanctuary">
                    <h5 class="serif mb-4 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">@L["ArchivalLifecycle"]</h5>
                    
                    <div class="row g-4">
                        <div class="col-md-6 border-end" style="border-color: var(--surface-container-low) !important;">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-3">@L["CurrentLoanStatus"]</label>
                            @if (FSharpOption<BookLibrary.Shared.Details.LoanDetails>.get_IsSome(_bookDetails.CurrentLoan))
                            {
                                var loan = _bookDetails.CurrentLoan.Value;
                                <div class="p-4 bg-surface-low rounded-xl border border-warning-subtle">
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <i class="bi bi-journal-minus fs-3 text-warning"></i>
                                        <div>
                                            <h6 class="serif mb-1">@L["ItemCurrentlyWithBorrower"]</h6>
                                            <p class="small text-muted mb-0">UID: @loan.UserDetails.AppUser.UserName</p>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between small border-top pt-2">
                                        <span>@L["CheckoutDate"]: <strong class="serif">@loan.Loan.TimeSlot.Start.ToShortDateString()</strong></span>
                                        <span>@L["ExpectedReturn"]: <strong class="serif">@loan.Loan.TimeSlot.End.ToShortDateString()</strong></span>
                                    </div>
                                </div>
                            }
                            else if (_bookDetails.Book.Available)
                            {
                                <div class="p-4 bg-surface-low rounded-xl border border-success-subtle d-flex align-items-center gap-3">
                                    <i class="bi bi-journal-check fs-3 text-success"></i>
                                    <div>
                                        <h6 class="serif mb-1">@L["AvailableInStacks"]</h6>
                                        <p class="small text-muted mb-0">@L["ReadyForDissemination"]</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 bg-surface-low rounded-xl border d-flex align-items-center gap-3">
                                    <i class="bi bi-journal-x fs-3 text-muted"></i>
                                    <div>
                                        <h6 class="serif mb-1">@L["ProvisionallyUnavailable"]</h6>
                                        <p class="small text-muted mb-0">@L["ContactRepositoryManager"]</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-3">@L["ScheduledReservations"]</label>
                            @if (_bookDetails.ReservationsDetails.Any())
                            {
                                <div class="editorial-ledger">
                                    <table class="table table-borderless mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-0">@L["Patron"]</th>
                                                <th>@L["TimeSlot"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var pendingRes = _bookDetails.PendingReservationsDetails.ToList();
                                            }
                                            @for (int i = 0; i < pendingRes.Count; i++)
                                            {
                                                var res = pendingRes[i];
                                                <tr>
                                                    <td class="ps-0 py-3">
                                                        <div class="fw-bold serif">@res.UserDetails.AppUser.UserName</div>
                                                        <div class="x-small text-muted">@res.UserDetails.AppUser.CodiceFiscale</div>
                                                    </td>
                                                    <td class="py-3">
                                                        <div class="small font-monospace">@res.Reservation.TimeSlot.Start.ToShortDateString() — @res.Reservation.TimeSlot.End.ToShortDateString()</div>
                                                        @if (i == 0)
                                                        {
                                                            <div class="mt-3 p-3 bg-light rounded border border-primary-subtle shadow-sm animate-fade-in">
                                                                <div class="input-group input-group-sm">
                                                                    <input type="text" 
                                                                           class="form-control" 
                                                                           placeholder="Reservation Code" 
                                                                           @bind="_reservationCodeInput" />
                                                                    <button class="btn btn-primary" @onclick="() => ConvertToLoan(res)">
                                                                        <i class="bi bi-arrow-repeat me-1"></i>
                                                                        Convert to Loan
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 bg-surface-low rounded-xl text-center border dashed">
                                    <p class="text-muted fst-italic small mb-0 serif">@L["NoFutureProvisions"]</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_bookDetails.Book.Editable)
        {
            <!-- Archival Removal -->
            <div class="mt-5 pt-5 border-top" style="border-color: var(--outline-variant) !important; border-style: dashed !important;">
                <div class="card-sanctuary bg-surface-low border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="serif text-danger mb-1">@L["DeaccessionItem"]</h5>
                            <p class="text-muted small mb-0 serif">@L["PermanentlyRemoveFromArchivalRecord"]</p>
                        </div>
                        <button class="btn btn-outline-danger px-4 py-2 serif" @onclick="DeleteBook" disabled="@(!_bookDetails.Book.Editable)">
                            <i class="bi bi-trash me-2"></i>@L["PurgeRecord"]
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>
}


