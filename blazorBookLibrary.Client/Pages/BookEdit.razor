    private async Task HandleScanImageFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            _scannedImageBase64 = Convert.ToBase64String(bytes);
            _scannedImageMimeType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            _scannedImagePreview = $"data:{_scannedImageMimeType};base64,{_scannedImageBase64}";
            StateHasChanged();

            await AnalyzePapersImage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reading uploaded or captured image");
            await ShowStatus($"Error reading image: {ex.Message}", "alert-danger");
        }
    }

    private async Task CaptureLiveCameraFrame()
    {
        _isAnalyzingPapers = true;
        StateHasChanged();
        try
        {
            await Task.Delay(200);
            var base64Data = await JSRuntime.InvokeAsync<string>("captureVideoFrame", "#papers-scanner-wrapper video");
            if (string.IsNullOrEmpty(base64Data))
            {
                await ShowStatus("Failed to capture image frame from camera.", "alert-warning");
                _isAnalyzingPapers = false;
                return;
            }

            var parts = base64Data.Split(',');
            _scannedImageBase64 = parts.Length > 1 ? parts[1] : parts[0];
            _scannedImageMimeType = "image/jpeg";
            _scannedImagePreview = base64Data;
            _isLiveCameraActive = false;

            await AnalyzePapersImage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error capturing frame from camera");
            await ShowStatus($"Camera capture failed: {ex.Message}", "alert-danger");
            _isAnalyzingPapers = false;
        }
    }

    private async Task AnalyzePapersImage()
    {
        if (string.IsNullOrEmpty(_scannedImageBase64)) return;
        _isAnalyzingPapers = true;
        StateHasChanged();

        try
        {
            var context = await GetContext();
            var result = await TextEmbeddingService.RecognizePapersFromImageAsync(
                context,
                _scannedImageBase64,
                _scannedImageMimeType,
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                var candidates = result.ResultValue;
                if (!candidates.Any())
                {
                    await ShowStatus("No papers or articles recognized in the image.", "alert-warning");
                }
                else
                {
                    await PopulateStagedPapersFromCandidates(candidates);
                    await ShowStatus($"Recognized {candidates.Length} paper(s) from image.", "alert-success");
                }
            }
            else
            {
                await ShowStatus($"Recognition failed: {result.ErrorValue}", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during image paper recognition");
            await ShowStatus($"Error during recognition: {ex.Message}", "alert-danger");
        }
        finally
        {
            _isAnalyzingPapers = false;
            StateHasChanged();
        }
    }

