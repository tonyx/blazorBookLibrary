    private async Task PopulateStagedPapersFromCandidates(IEnumerable<RecognizedPaperCandidate> candidates)
    {
        var context = await GetContext();
        _stagedPapers.Clear();

        foreach (var cand in candidates)
        {
            var staged = new StagedScannedPaper
            {
                Title = cand.Title ?? "",
                PageNumber = FSharpOption<string>.get_IsSome(cand.PageNumber) ? cand.PageNumber.Value : "",
                Section = FSharpOption<string>.get_IsSome(cand.Section) ? cand.Section.Value : "",
                Description = FSharpOption<string>.get_IsSome(cand.Description) ? cand.Description.Value : "",
                IsSelected = true
            };

            if (_bookDetails?.Book.MainCategory != null)
            {
                staged.Categories.Add(_bookDetails.Book.MainCategory);
            }

            foreach (var authorName in cand.Authors)
            {
                if (string.IsNullOrWhiteSpace(authorName)) continue;
                var cleanName = authorName.Trim();

                Author? matchedAuthor = null;
                try
                {
                    var searchRes = await AuthorService.SearchByNameAsync(context, Name.New(cleanName), FSharpOption<CancellationToken>.None);
                    if (searchRes.IsOk && searchRes.ResultValue.Any())
                    {
                        matchedAuthor = searchRes.ResultValue.FirstOrDefault(a => a.Name.Value.Equals(cleanName, StringComparison.OrdinalIgnoreCase))
                            ?? searchRes.ResultValue.First();
                    }
                    else if (cleanName.Contains(' '))
                    {
                        var surname = cleanName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Last();
                        if (surname.Length > 2)
                        {
                            var surnameRes = await AuthorService.SearchByNameAsync(context, Name.New(surname), FSharpOption<CancellationToken>.None);
                            if (surnameRes.IsOk && surnameRes.ResultValue.Any())
                            {
                                matchedAuthor = surnameRes.ResultValue.FirstOrDefault(a => a.Name.Value.Contains(surname, StringComparison.OrdinalIgnoreCase))
                                    ?? surnameRes.ResultValue.First();
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Error searching for author '{Name}'", cleanName);
                }

                var stagedAuthor = new StagedScannedAuthor
                {
                    ScannedName = cleanName,
                    MatchedAuthor = matchedAuthor,
                    ConfirmAssociate = matchedAuthor != null,
                    AutoAddNewAuthor = matchedAuthor == null ? _batchAutoAddAllNewAuthors : false
                };
                staged.Authors.Add(stagedAuthor);
            }

            _stagedPapers.Add(staged);
        }
    }

