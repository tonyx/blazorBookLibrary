@page "/tenants"
@using Microsoft.AspNetCore.Authorization
@using blazorBookLibrary.Shared.Resources
@using BookLibrary.Domain
@using Microsoft.Extensions.Localization
@using Microsoft.FSharp.Collections
@using static BookLibrary.Shared.Commons
@using BookLibrary.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize]
@inject ITenantService TenantService
@inject IUserService UserService
@inject IStringLocalizer<SharedResources> L
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject IJSRuntime JSRuntime
@rendermode InteractiveAuto

<PageTitle>@L["Tenants"] — @L["TheModernArchivist"]</PageTitle>

<div class="sanctuary-container py-5">
    @* Page Header *@
    <div class="mb-5 animate-slide-down">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["Tenants"]</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-4">
            <div>
                <h1 class="display-4 text-serif mb-2">@L[CurrentTitleKey]</h1>
                <p class="text-muted lead mb-0">@L[CurrentDescriptionKey]</p>
            </div>
            
            @* View Selector *@
            <div class="btn-group p-1 bg-surface-low rounded-pill shadow-sm border" role="group">
                <button type="button" 
                        class="btn btn-sm rounded-pill px-4 @(currentView == TenantView.Allowed ? "btn-primary" : "btn-link text-decoration-none text-muted")"
                        @onclick="() => SwitchView(TenantView.Allowed)">
                    <i class="bi bi-grid-fill me-2"></i>@L["Allowed"]
                </button>
                <button type="button" 
                        class="btn btn-sm rounded-pill px-4 @(currentView == TenantView.My ? "btn-primary" : "btn-link text-decoration-none text-muted")"
                        @onclick="() => SwitchView(TenantView.My)">
                    <i class="bi bi-person-workspace me-2"></i>@L["My"]
                </button>
                <button type="button" 
                        class="btn btn-sm rounded-pill px-4 @(currentView == TenantView.Owned ? "btn-primary" : "btn-link text-decoration-none text-muted")"
                        @onclick="() => SwitchView(TenantView.Owned)">
                    <i class="bi bi-shield-lock me-2"></i>@L["Owned"]
                </button>
            </div>
        </div>
    </div>

    @if (currentView == TenantView.Owned)
    {
        @* Create Tenant Form *@
        <div class="card card-sanctuary mb-5 border-0 shadow-sm bg-surface-low animate-slide-down">
            <div class="card-body p-4">
                <h2 class="h4 text-serif mb-4"><i class="bi bi-plus-circle-fill text-primary me-2"></i>@L["CreateNewLibrary"]</h2>
                <EditForm Model="@newTenant" OnValidSubmit="HandleCreateTenant">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">@L["LibraryName"]</label>
                            <InputText @bind-Value="newTenant.Name" class="form-control" placeholder="@L["EnterLibraryName"]" />
                            <ValidationMessage For="@(() => newTenant.Name)" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">@L["LibraryAddress"]</label>
                            <InputText @bind-Value="newTenant.Address" class="form-control" placeholder="@L["EnterAddress"]" />
                            <ValidationMessage For="@(() => newTenant.Address)" class="text-danger small" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-muted">@L["PublicStatus"]</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox @bind-Value="newTenant.IsPublic" class="form-check-input" id="publicSwitch" />
                                <label class="form-check-label small text-muted" for="publicSwitch">@L["Public"]</label>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                @L["CreateLibrary"]
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 animate-shake" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill h4 mb-0 me-3"></i>
                <div>
                    <h4 class="alert-heading h5 mb-1">@L["ArchivalRetrievalError"]</h4>
                    <p class="mb-0">@errorMessage</p>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5 animate-fade-in">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">@L["Loading"]...</span>
            </div>
        </div>
    }
    else if (tenants == null || !tenants.Any())
    {
        <div class="card card-sanctuary p-5 text-center border-0 shadow-sm bg-surface-low animate-fade-in">
            <div class="py-5">
                <i class="bi bi-building-exclamation display-1 text-muted opacity-25 mb-4"></i>
                <h3 class="text-serif">@L["NoResultsYet"]</h3>
                <p class="text-muted">@L["TrySwitchingView"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 animate-slide-up">
            @foreach (var tenant in tenants)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-sanctuary h-100 border-0 shadow-sm hover-lift transition-all bg-surface-low">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-4">
                                <div class="tenant-icon-wrapper bg-primary bg-opacity-10 text-primary rounded-4 p-3 me-3 shadow-sm">
                                    <i class="bi bi-building h3 mb-0"></i>
                                </div>
                                <div>
                                    <h3 class="card-title h5 text-serif mb-1">@tenant.Name.Value</h3>
                                    <span class="badge-sanctuary badge-neutral small">
                                        <i class="bi bi-geo-alt me-1"></i> @(string.IsNullOrWhiteSpace(tenant.Address) ? L["Unspecified"] : tenant.Address)
                                    </span>
                                </div>
                            </div>
                            
                            <div class="mb-4 flex-grow-1">
                                <div class="small text-muted text-uppercase fw-bold letter-spacing-1 mb-2">@L["Status"]</div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="dot @(tenant.TenantState.IsActive ? "bg-success" : "bg-warning")"></span>
                                    <span class="small fw-bold">@tenant.TenantState.Value</span>
                                </div>
                            </div>

                            <div class="mt-auto border-top pt-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="small text-muted italic serif">@tenant.Patrons.Count() @L["ArchivalStatus"]</div>
                                    <div class="d-flex gap-2">
                                        @if (TenantState.CurrentTenant?.TenantId.Value == tenant.TenantId.Value)
                                        {
                                            <button class="btn btn-success btn-sm rounded-pill px-4" disabled>
                                                <i class="bi bi-check-circle-fill me-1"></i> @L["Selected"]
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="() => HandleSelectTenant(tenant)">
                                                @L["Select"]
                                            </button>
                                        }
                                        @if (currentView == TenantView.Owned)
                                        {
                                            <a href="/tenants/@tenant.TenantId.Value" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                                @L["ViewDetails"] <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .dot {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
    }
    .letter-spacing-1 {
        letter-spacing: 0.1em;
    }
</style>

@code {
    private enum TenantView { Allowed, My, Owned }
    private TenantView currentView = TenantView.Allowed;
    private FSharpList<Tenant>? tenants;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isSubmitting = false;

    private NewTenantModel newTenant = new();

    private class NewTenantModel
    {
        [Required(ErrorMessage = "Library name is required")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Name must be between 3 and 100 characters")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Address is required")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "Address must be between 5 and 200 characters")]
        public string Address { get; set; } = "";

        public bool IsPublic { get; set; } = true;
    }

    private string CurrentTitleKey => currentView switch
    {
        TenantView.Allowed => "AllowedTenants",
        TenantView.My => "MyTenants",
        TenantView.Owned => "OwnedTenants",
        _ => "Tenants"
    };

    private string CurrentDescriptionKey => currentView switch
    {
        TenantView.Allowed => "AllowedTenantsDescription",
        TenantView.My => "MyTenantsDescription",
        TenantView.Owned => "OwnedTenantsDescription",
        _ => "TenantsDescription"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task SwitchView(TenantView view)
    {
        if (currentView == view) return;
        currentView = view;
        await LoadTenants();
    }

    private async Task HandleSelectTenant(Tenant tenant)
    {
        try 
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // 1. Update backend state (Sharpino aggregate)
                var userContext = TenantState.GetUserContext(authState.User);
                var result = await UserService.SetCurrentTenantAsync(userContext, userContext.UserId.Value, tenant.TenantId, Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                
                if (result.IsError)
                {
                    await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
                    return;
                }
            }

            // 2. Update local state (Cookie + Memory)
            await TenantState.SetTenantAsync(tenant);
            await JSRuntime.InvokeVoidAsync("showToast", L["TenantUpdated"], "success");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showToast", ex.Message, "error");
        }
        finally 
        {
            StateHasChanged();
        }
    }

    private async Task HandleCreateTenant()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var name = TenantName.New(newTenant.Name);
            if (name.IsError)
            {
                errorMessage = name.ErrorValue;
                return;
            }
            
            var tenant = Tenant.New(
                userContext.UserId.Value,
                name.ResultValue, 
                newTenant.Address, 
                Microsoft.FSharp.Core.FSharpOption<bool>.Some(newTenant.IsPublic)
            );

            var result = await TenantService.CreateTenantAsync(userContext, tenant, default);

            if (result.IsOk)
            {
                newTenant = new();
                await LoadTenants();
            }
            else
            {
                errorMessage = result.ErrorValue;
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["ErrorCreatingLibrary", ex.Message];
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadTenants()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(authState.User);
                
                var result = currentView switch
                {
                    TenantView.Allowed => await TenantService.GetAllowedTenantsAsync(userContext, default),
                    TenantView.My => await TenantService.GetMyTenantsAsync(userContext, default),
                    TenantView.Owned => await TenantService.GetMyOwnedTenantsAsync(userContext, default),
                    _ => await TenantService.GetAllowedTenantsAsync(userContext, default)
                };
                isLoading = false;
                
                if (result.IsOk)
                {
                    tenants = result.ResultValue;
                }
                else
                {
                    errorMessage = result.ErrorValue;
                }
            }
            else
            {
                errorMessage = L["AccessDenied"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["ErrorLoadingData", ex.Message];
        }
    }
}
