@page "/tenants"
@using Microsoft.AspNetCore.Authorization
@using blazorBookLibrary.Shared.Resources
@using BookLibrary.Domain
@using Microsoft.Extensions.Localization
@using Microsoft.FSharp.Collections
@using static BookLibrary.Shared.Commons
@using BookLibrary.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client

@attribute [Authorize]
@inject ITenantService TenantService
@inject IUserService UserService
@inject IDistributionPointService DistributionPointService
@inject IStringLocalizer<SharedResources> L
@inject ILogger<Tenants> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IUserTenantResolverService UserTenantResolverService
@rendermode InteractiveAuto
@implements IAsyncDisposable


<PageTitle>@L["AllowedTenants"] — @L["BiblioNet"]</PageTitle>

<div class="sanctuary-container py-5">
    @* Page Header *@
    <div class="mb-5 animate-slide-down">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["Tenants"]</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-4">
            <div>
                <h1 class="display-4 text-serif mb-2">@L["AllowedTenants"]</h1>
                <p class="text-muted lead mb-0">@L["AllowedTenantsDescription"]</p>
            </div>

            <div class="d-flex gap-2">
                @* Toggle Button for Joining a Library by PIN *@
                <button type="button"
                    class="btn btn-outline-primary rounded-pill px-4"
                    @onclick="ToggleJoinForm">
                    @if (showJoinForm)
                    {
                        <i class="bi bi-dash-circle-fill me-2"></i>@L["Cancel"]
                    }
                    else
                    {
                        <i class="bi bi-key-fill me-2"></i>@L["JoinByPIN", "Join by PIN"]
                    }
                </button>

                @* Toggle Button for Creating a Library *@
                <button type="button"
                    class="btn btn-sanctuary-primary rounded-pill px-4"
                    @onclick="ToggleCreateForm">
                    @if (showCreateForm)
                    {
                        <i class="bi bi-dash-circle-fill me-2"></i>@L["Cancel"]
                    }
                    else
                    {
                        <i class="bi bi-plus-circle-fill me-2"></i>@L["CreateNewLibrary"]
                    }
                </button>
            </div>
        </div>
    </div>

    @if (showJoinForm)
    {
        @* Join Tenant by PIN Form *@
        <div class="card card-sanctuary mb-5 border-0 shadow-sm bg-surface-low animate-slide-down">
            <div class="card-body p-4">
                <h2 class="h4 text-serif mb-4"><i
                        class="bi bi-key-fill text-primary me-2"></i>@L["JoinLibraryByPIN", "Join Library by PIN"]</h2>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label small fw-bold text-muted">@L["JoinPIN", "6-Digit Join PIN"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-shield-lock-fill text-muted"></i></span>
                            <input type="text" @bind="joinPin" @bind:event="oninput" @onkeyup="HandlePinKeypress" class="form-control border-start-0 ps-0 text-center fw-bold letter-spacing-1"
                                   placeholder="e.g. 123456" maxlength="6" style="font-size: 1.1rem; letter-spacing: 0.2rem;" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary w-100 rounded-pill shadow-sm"
                                @onclick="HandleLookupPin" disabled="@(joinPin.Length != 6 || isLookingUpPin)">
                            @if (isLookingUpPin)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @L["LookupLibrary", "Lookup Library"]
                        </button>
                    </div>
                </div>

                @if (foundTenant != null)
                {
                    <div class="mt-4 p-4 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-10 animate-fade-in">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h4 class="text-serif h5 mb-1"><i class="bi bi-building me-2"></i>@foundTenant.Name.Value</h4>
                                <p class="small text-muted mb-0"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(foundTenant.Address) ? L["Unspecified"].Value : foundTenant.Address)</p>
                            </div>
                            <div>
                                @if (isAlreadyMember)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> @L["AlreadyMember", "Already a Member"]</span>
                                }
                                else if (isJoinRequested)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-hourglass-split me-1"></i> @L["RequestPending", "Request Pending"]</span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm"
                                            @onclick="HandleSubmitJoinRequest" disabled="@isSubmittingJoin">
                                        @if (isSubmittingJoin)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-send-fill me-1"></i> @L["SendJoinRequest", "Request to Join"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (showCreateForm)
    {
        @* Create Tenant Form *@
        <div class="card card-sanctuary mb-5 border-0 shadow-sm bg-surface-low animate-slide-down">
            <div class="card-body p-4">
                <h2 class="h4 text-serif mb-4"><i
                        class="bi bi-plus-circle-fill text-primary me-2"></i>@L["CreateNewLibrary"]</h2>
                <EditForm Model="@newTenant" OnValidSubmit="HandleCreateTenant">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">@L["LibraryName"]</label>
                            <InputText @bind-Value="newTenant.Name" class="form-control"
                                placeholder="@L["EnterLibraryName"]" />
                            <ValidationMessage For="@(() => newTenant.Name)" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">@L["LibraryAddress"]</label>
                            <InputText @bind-Value="newTenant.Address" class="form-control"
                                placeholder="@L["EnterAddress"]" />
                            <ValidationMessage For="@(() => newTenant.Address)" class="text-danger small" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-muted">@L["PublicStatus"]</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox @bind-Value="newTenant.IsPublic" class="form-check-input"
                                    id="publicSwitch" />
                                <label class="form-check-label small text-muted" for="publicSwitch">@L["Public"]</label>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm"
                                disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                @L["CreateLibrary"]
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 animate-shake" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill h4 mb-0 me-3"></i>
                <div>
                    <h4 class="alert-heading h5 mb-1">@L["ArchivalRetrievalError"]</h4>
                    <p class="mb-0">@errorMessage</p>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5 animate-fade-in">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">@L["Loading"]...</span>
            </div>
        </div>
    }
    else if (tenants == null || !tenants.Any())
    {
        <div class="card card-sanctuary p-5 text-center border-0 shadow-sm bg-surface-low animate-fade-in">
            <div class="py-5">
                <i class="bi bi-building-exclamation display-1 text-muted opacity-25 mb-4"></i>
                <h3 class="text-serif">@L["NoResultsYet"]</h3>
                <p class="text-muted">@L["TrySwitchingView"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 animate-slide-up">
            @foreach (var tenant in tenants)
            {
                var isManager = currentUserId.HasValue && tenant.IsManager(UserId.NewUserId(currentUserId.Value));
                var isOwner = currentUserId.HasValue && tenant.OwnerId.Value == currentUserId.Value;
                var isPatron = currentUserId.HasValue && tenant.Patrons.Any(p => p.Item1.Value == currentUserId.Value);
                tenantStats.TryGetValue(tenant.TenantId.Value, out var stats);

                <div class="col-md-6 col-lg-4">
                    <div class="card card-sanctuary h-100 border-0 shadow-sm hover-lift transition-all bg-surface-low">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div
                                    class="tenant-icon-wrapper bg-primary bg-opacity-10 text-primary rounded-4 p-3 me-3 shadow-sm">
                                    <i class="bi bi-building h3 mb-0"></i>
                                </div>
                                <div class="flex-grow-1 min-width-0">
                                    <h3 class="card-title h5 text-serif mb-1 text-truncate">@tenant.Name.Value</h3>
                                    <span class="badge-sanctuary badge-neutral small">
                                        <i class="bi bi-geo-alt me-1"></i> @(string.IsNullOrWhiteSpace(tenant.Address) ?
                                L["Unspecified"] : tenant.Address)
                                    </span>
                                </div>
                            </div>

                            @* Relationship Badges *@
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (isOwner || isManager)
                                {
                                    <span class="badge-sanctuary badge-owner small">
                                        <i class="bi bi-shield-fill"></i> @L["Owner"]
                                    </span>
                                }
                                @if (isPatron)
                                {
                                    <span class="badge-sanctuary badge-patron small">
                                        <i class="bi bi-person-workspace"></i> @L["Patron"]
                                    </span>
                                }
                                @if (tenant.TenantVisibility.IsPublic)
                                {
                                    <span class="badge-sanctuary badge-public small">
                                        <i class="bi bi-globe"></i> @L["Public"]
                                    </span>
                                }
                                @if (isAdmin && !isOwner && !isPatron)
                                {
                                    <span class="badge-sanctuary badge-admin small">
                                        <i class="bi bi-shield-lock-fill"></i> @L["Admin"]
                                    </span>
                                }
                            </div>

                            <div class="mb-4 flex-grow-1">
                                <div class="small text-muted text-uppercase fw-bold letter-spacing-1 mb-2">@L["Status"]</div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="dot @(tenant.TenantState.IsActive ? "bg-success" : "bg-warning")"></span>
                                    <span class="small fw-bold">@tenant.TenantState.Value</span>
                                </div>
                            </div>

                            <div class="mt-auto border-top pt-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="small text-muted italic serif">@tenant.Patrons.Count() @L["ArchivalStatus"]
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (TenantState.CurrentTenant?.TenantId.Value == tenant.TenantId.Value)
                                        {
                                            <button class="btn btn-success btn-sm rounded-pill px-4" disabled>
                                                <i class="bi bi-check-circle-fill me-1"></i> @L["Selected"]
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4"
                                            @onclick="() => HandleSelectTenant(tenant)">
                                                @L["Select"]
                                            </button>
                                        }
                                        @if (isOwner || isAdmin || isManager)
                                        {
                                            <button class="btn btn-outline-primary btn-sm rounded-pill px-4"
                                                @onclick="() => HandleViewDetails(tenant)">
                                                @L["ViewDetails"] <i class="bi bi-arrow-right ms-1"></i>
                                            </button>
                                            @if (stats != null && stats.IsDeletable)
                                            {
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-4"
                                                    @onclick="() => HandleDeleteTenant(tenant)">
                                                    <i class="bi bi-trash-fill me-1"></i> @L["Delete"]
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                                @if ((isOwner || isAdmin || isManager) && stats != null && !stats.IsDeletable)
                                {
                                    <div class="text-danger small mt-3 d-flex align-items-start gap-2 p-2 bg-danger bg-opacity-10 rounded border border-danger border-opacity-10 animate-fade-in" style="font-size: 0.8rem;">
                                        <i class="bi bi-exclamation-circle-fill mt-0.5"></i>
                                        <span>
                                            @(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "it" 
                                                ? $"Non eliminabile. Contiene: {stats.PatronCount} lettori, {stats.DistributionPointCount} punti di distribuzione."
                                                : $"Not deletable. Contains: {stats.PatronCount} patrons, {stats.DistributionPointCount} distribution points.")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .dot {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .08) !important;
    }

    .letter-spacing-1 {
        letter-spacing: 0.1em;
    }

    .badge-owner {
        background-color: #ffdcc1;
        color: #2c1603;
        border: 1px solid rgba(93, 70, 50, 0.2);
    }

    .badge-patron {
        background-color: #c1ecd4;
        color: #002114;
        border: 1px solid rgba(1, 45, 29, 0.2);
    }

    .badge-public {
        background-color: var(--surface-container);
        color: var(--secondary);
        border: 1px solid var(--outline-variant);
    }

    .badge-admin {
        background-color: #e8daff;
        color: #2b0066;
        border: 1px solid rgba(43, 0, 102, 0.2);
    }
</style>

@code {
    private FSharpList<Tenant>? tenants;
    private Dictionary<Guid, TenantStats> tenantStats = new();

    private class TenantStats
    {
        public int PatronCount { get; set; }
        public int DistributionPointCount { get; set; }
        
        public bool IsDeletable => PatronCount == 0 && DistributionPointCount == 0;
    }

    private bool isLoading = true;
    private string? errorMessage;
    private bool isSubmitting = false;
    private bool showCreateForm = false;
    private bool showJoinForm = false;
    private string joinPin = "";
    private bool isLookingUpPin = false;
    private bool isSubmittingJoin = false;
    private Tenant? foundTenant;
    private bool isAlreadyMember = false;
    private bool isJoinRequested = false;

    private Guid? currentUserId;
    private bool isAdmin = false;

    private NewTenantModel newTenant = new();

    [SupplyParameterFromQuery(Name = "create")]
    public bool? Create { get; set; }

    protected override void OnParametersSet()
    {
        if (Create == true)
        {
            showCreateForm = true;
            showJoinForm = false;
        }
    }

    private class NewTenantModel
    {
        [Required(ErrorMessage = "Library name is required")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Name must be between 3 and 100 characters")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Address is required")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "Address must be between 5 and 200 characters")]
        public string Address { get; set; } = "";

        public bool IsPublic { get; set; } = true;
    }

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/library"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On("TenantListChanged", async () =>
            {
                await LoadTenants();
                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not start SignalR hub connection in Tenants. Expected during prerendering.");
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var userContext = TenantState.GetUserContext(authState.User);
            if (userContext.UserId != null)
            {
                currentUserId = userContext.UserId.Value.Value;
            }
            isAdmin = userContext.IsInRole(Role.Admin);
        }
        await LoadTenants();
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        if (showCreateForm) showJoinForm = false;
    }

    private void ToggleJoinForm()
    {
        showJoinForm = !showJoinForm;
        if (showJoinForm) showCreateForm = false;
        joinPin = "";
        foundTenant = null;
    }

    private async Task HandlePinKeypress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && joinPin.Length == 6 && !isLookingUpPin)
        {
            await HandleLookupPin();
        }
    }

    private async Task HandleLookupPin()
    {
        if (joinPin.Length != 6) return;
        isLookingUpPin = true;
        foundTenant = null;
        errorMessage = null;
        try
        {
            var result = await TenantService.FindTenantByJoinPinAsync(joinPin, default);
            if (result.IsOk)
            {
                foundTenant = result.ResultValue;
                if (currentUserId.HasValue)
                {
                    isAlreadyMember = foundTenant.OwnerId.Value == currentUserId.Value ||
                                      foundTenant.Patrons.Any(p => p.Item1.Value == currentUserId.Value);
                    isJoinRequested = foundTenant.JoinRequests.Any(r => r.Value == currentUserId.Value);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error looking up tenant by pin");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isLookingUpPin = false;
        }
    }

    private async Task HandleSubmitJoinRequest()
    {
        if (foundTenant == null || !currentUserId.HasValue) return;
        isSubmittingJoin = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = await TenantService.SubmitJoinRequestAsync(userContext, foundTenant.TenantId, userContext.UserId.Value, default);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["JoinRequestSubmitted", "Join request submitted successfully"].Value, "success");
                isJoinRequested = true;
                foundTenant = null;
                joinPin = "";
                showJoinForm = false;
                await LoadTenants();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting join request");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isSubmittingJoin = false;
        }
    }

    private async Task<bool> HandleSelectTenant(Tenant tenant)
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // 1. Update backend state (Sharpino aggregate)
                var userContext = TenantState.GetUserContext(authState.User);
                var result = await UserService.SetCurrentTenantAsync(userContext, userContext.UserId.Value, tenant.TenantId,
                Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);

                if (result.IsError)
                {
                    Logger.LogError("Error setting current tenant: {Error}", result.ErrorValue);
                    await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
                    return false;
                }
            }

            // 2. Update local state (Cookie + Memory)
            await TenantState.SetTenantAsync(tenant);
            await JSRuntime.InvokeVoidAsync("showToast", L["TenantUpdated"].Value, "success");
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception when selecting tenant");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            return false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task HandleViewDetails(Tenant tenant)
    {
        var success = true;
        if (TenantState.CurrentTenant?.TenantId.Value != tenant.TenantId.Value)
        {
            success = await HandleSelectTenant(tenant);
        }
        if (success)
        {
            NavigationManager.NavigateTo($"/tenants/{tenant.TenantId.Value}");
        }
    }

    private async Task HandleCreateTenant()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var name = TenantName.New(newTenant.Name);
            if (name.IsError)
            {
                errorMessage = name.ErrorValue;
                return;
            }

            var tenant = Tenant.New(
                userContext.UserId.Value,
                name.ResultValue,
                newTenant.Address,
                Microsoft.FSharp.Core.FSharpOption<bool>.Some(newTenant.IsPublic)
            );

            var result = await TenantService.CreateTenantAsync(userContext, tenant, default);

            if (result.IsOk)
            {
                newTenant = new();
                showCreateForm = false;
                await LoadTenants();
            }
            else
            {
                errorMessage = result.ErrorValue;
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["ErrorCreatingLibrary", ex.Message];
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadTenants()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(authState.User);

                var result = await TenantService.GetAllowedTenantsAsync(userContext, default);
                isLoading = false;

                if (result.IsOk)
                {
                    tenants = result.ResultValue;
                    tenantStats.Clear();
                    foreach (var tenant in tenants)
                    {
                        var dpsRes = await DistributionPointService.GetAllDistributionPointsOfATenantAsync(userContext, tenant.TenantId, default);

                        tenantStats[tenant.TenantId.Value] = new TenantStats
                        {
                            PatronCount = tenant.Patrons.Count(),
                            DistributionPointCount = dpsRes.IsOk ? dpsRes.ResultValue.Count() : 0
                        };
                    }
                }
                else
                {
                    errorMessage = result.ErrorValue;
                }
            }
            else
            {
                errorMessage = L["AccessDenied"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["ErrorLoadingData", ex.Message];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDeleteTenant(Tenant tenant)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", L["ConfirmDeleteTenant", tenant.Name.Value].Value ?? $"Are you sure you want to delete the library '{tenant.Name.Value}'?");
            if (!confirmed) return;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);

            // Check if the tenant being deleted is the currently resolved active tenant
            var activeTenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext);
            bool isDeletingCurrentTenant = false;
            if (activeTenantResult.IsOk && activeTenantResult.ResultValue.Value == tenant.TenantId.Value)
            {
                isDeletingCurrentTenant = true;
            }

            var result = await TenantService.DeleteTenantAsync(userContext, tenant.TenantId, default);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["TenantDeletedSuccessfully"].Value ?? "Library deleted successfully", "success");
                
                if (isDeletingCurrentTenant)
                {
                    if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        var setDefaultResult = await UserService.SetCurrentTenantAsync(userContext, userContext.UserId.Value, TenantId.Default,
                            Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                        if (setDefaultResult.IsError)
                        {
                            Logger.LogError("Error setting current tenant to default: {Error}", setDefaultResult.ErrorValue);
                        }
                    }

                    await LoadTenants();

                    var defaultTenantObj = tenants?.FirstOrDefault(t => t.TenantId.Value == TenantId.Default.Value);
                    if (defaultTenantObj != null)
                    {
                        await TenantState.SetTenantAsync(defaultTenantObj);
                    }
                    else
                    {
                        await TenantState.ClearTenantAsync();
                    }
                }
                else
                {
                    // If the deleted tenant was the active one, clear/reset selection
                    if (TenantState.CurrentTenant?.TenantId.Value == tenant.TenantId.Value)
                    {
                        await TenantState.ClearTenantAsync();
                    }
                    await LoadTenants();
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception when deleting tenant");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
