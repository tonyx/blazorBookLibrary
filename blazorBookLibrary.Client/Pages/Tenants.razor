</style>

@code {
    private FSharpList<Tenant>? tenants;
    private Dictionary<Guid, TenantStats> tenantStats = new();

    private class TenantStats
    {
        public int PatronCount { get; set; }
        public int DistributionPointCount { get; set; }
        
        public bool IsDeletable => PatronCount == 0 && DistributionPointCount == 0;
    }

    private bool isLoading = true;
    private string? errorMessage;
    private bool isSubmitting = false;
    private bool showCreateForm = false;
    private bool showJoinForm = false;
    private string joinPin = "";
    private bool isLookingUpPin = false;
    private bool isSubmittingJoin = false;
    private Tenant? foundTenant;
    private bool isAlreadyMember = false;
    private bool isJoinRequested = false;

    private Guid? currentUserId;
    private bool isAdmin = false;

    private NewTenantModel newTenant = new();

    [SupplyParameterFromQuery(Name = "create")]
    public bool? Create { get; set; }

    protected override void OnParametersSet()
    {
        if (Create == true)
        {
            showCreateForm = true;
            showJoinForm = false;
        }
    }

    private class NewTenantModel
    {
        [Required(ErrorMessage = "Library name is required")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Name must be between 3 and 100 characters")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Address is required")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "Address must be between 5 and 200 characters")]
        public string Address { get; set; } = "";

        public bool IsPublic { get; set; } = true;
    }

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/library"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On("TenantListChanged", async () =>
            {
                await LoadTenants();
                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not start SignalR hub connection in Tenants. Expected during prerendering.");
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var userContext = TenantState.GetUserContext(authState.User);
            if (userContext.UserId != null)
            {
                currentUserId = userContext.UserId.Value.Value;
            }
            isAdmin = userContext.IsInRole(Role.Admin);
        }
        await LoadTenants();
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        if (showCreateForm) showJoinForm = false;
    }

    private void ToggleJoinForm()
    {
        showJoinForm = !showJoinForm;
        if (showJoinForm) showCreateForm = false;
        joinPin = "";
        foundTenant = null;
    }

    private async Task HandlePinKeypress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && joinPin.Length == 6 && !isLookingUpPin)
        {
            await HandleLookupPin();
        }
    }

    private async Task HandleLookupPin()
    {
        if (joinPin.Length != 6) return;
        isLookingUpPin = true;
        foundTenant = null;
        errorMessage = null;
        try
        {
            var result = await TenantService.FindTenantByJoinPinAsync(joinPin, default);
            if (result.IsOk)
            {
                foundTenant = result.ResultValue;
                if (currentUserId.HasValue)
                {
                    isAlreadyMember = foundTenant.OwnerId.Value == currentUserId.Value ||
                                      foundTenant.Patrons.Any(p => p.Item1.Value == currentUserId.Value);
                    isJoinRequested = foundTenant.JoinRequests.Any(r => r.Value == currentUserId.Value);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error looking up tenant by pin");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isLookingUpPin = false;
        }
    }

    private async Task HandleSubmitJoinRequest()
    {
        if (foundTenant == null || !currentUserId.HasValue) return;
        isSubmittingJoin = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = await TenantService.SubmitJoinRequestAsync(userContext, foundTenant.TenantId, userContext.UserId.Value, default);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["JoinRequestSubmitted", "Join request submitted successfully"].Value, "success");
                isJoinRequested = true;
                foundTenant = null;
                joinPin = "";
                showJoinForm = false;
                await LoadTenants();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting join request");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isSubmittingJoin = false;
        }
    }

    private async Task<bool> HandleSelectTenant(Tenant tenant)
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // 1. Update backend state (Sharpino aggregate)
                var userContext = TenantState.GetUserContext(authState.User);
                var result = await UserService.SetCurrentTenantAsync(userContext, userContext.UserId.Value, tenant.TenantId,
                Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);

                if (result.IsError)
                {
                    Logger.LogError("Error setting current tenant: {Error}", result.ErrorValue);
                    await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
                    return false;
                }
            }

            // 2. Update local state (Cookie + Memory)
            await TenantState.SetTenantAsync(tenant);
            await JSRuntime.InvokeVoidAsync("showToast", L["TenantUpdated"].Value, "success");
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception when selecting tenant");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            return false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task HandleViewDetails(Tenant tenant)
    {
        var success = true;
        if (TenantState.CurrentTenant?.TenantId.Value != tenant.TenantId.Value)
        {
            success = await HandleSelectTenant(tenant);
        }
        if (success)
        {
            NavigationManager.NavigateTo($"/tenants/{tenant.TenantId.Value}");
        }
    }

    private async Task HandleCreateTenant()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var name = TenantName.New(newTenant.Name);
            if (name.IsError)
            {
                errorMessage = name.ErrorValue;
                return;
            }

            var tenant = Tenant.New(
                userContext.UserId.Value,
                name.ResultValue,
                newTenant.Address,
                Microsoft.FSharp.Core.FSharpOption<bool>.Some(newTenant.IsPublic)
            );

            var result = await TenantService.CreateTenantAsync(userContext, tenant, default);

            if (result.IsOk)
            {
                newTenant = new();
                showCreateForm = false;
                await LoadTenants();
                await HandleSelectTenant(tenant);
            }
            else
            {
                errorMessage = result.ErrorValue;
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["ErrorCreatingLibrary", ex.Message];
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadTenants()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(authState.User);

                var result = await TenantService.GetAllowedTenantsAsync(userContext, default);
                isLoading = false;

                if (result.IsOk)
                {
                    tenants = result.ResultValue;
                    tenantStats.Clear();
                    foreach (var tenant in tenants)
                    {
                        var dpsRes = await DistributionPointService.GetAllDistributionPointsOfATenantAsync(userContext, tenant.TenantId, default);

                        tenantStats[tenant.TenantId.Value] = new TenantStats
                        {
                            PatronCount = tenant.Patrons.Count(),
                            DistributionPointCount = dpsRes.IsOk ? dpsRes.ResultValue.Count() : 0
                        };
                    }
                }
                else
                {
                    errorMessage = result.ErrorValue;
                }
            }
            else
            {
                errorMessage = L["AccessDenied"];
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["ErrorLoadingData", ex.Message];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleDeleteTenant(Tenant tenant)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", L["ConfirmDeleteTenant", tenant.Name.Value].Value ?? $"Are you sure you want to delete the library '{tenant.Name.Value}'?");
            if (!confirmed) return;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);

            // Check if the tenant being deleted is the currently resolved active tenant
            var activeTenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext);
            bool isDeletingCurrentTenant = false;
            if (activeTenantResult.IsOk && activeTenantResult.ResultValue.Value == tenant.TenantId.Value)
            {
                isDeletingCurrentTenant = true;
            }

            var result = await TenantService.DeleteTenantAsync(userContext, tenant.TenantId, default);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["TenantDeletedSuccessfully"].Value ?? "Library deleted successfully", "success");
                
                if (isDeletingCurrentTenant)
                {
                    if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        var setDefaultResult = await UserService.SetCurrentTenantAsync(userContext, userContext.UserId.Value, TenantId.Default,
                            Microsoft.FSharp.Core.FSharpOption<System.Threading.CancellationToken>.None);
                        if (setDefaultResult.IsError)
                        {
                            Logger.LogError("Error setting current tenant to default: {Error}", setDefaultResult.ErrorValue);
                        }
                    }

                    await LoadTenants();

                    var defaultTenantObj = tenants?.FirstOrDefault(t => t.TenantId.Value == TenantId.Default.Value);
                    if (defaultTenantObj != null)
                    {
                        await TenantState.SetTenantAsync(defaultTenantObj);
                    }
                    else
                    {
                        await TenantState.ClearTenantAsync();
                    }
                }
                else
                {
                    // If the deleted tenant was the active one, clear/reset selection
                    if (TenantState.CurrentTenant?.TenantId.Value == tenant.TenantId.Value)
                    {
                        await TenantState.ClearTenantAsync();
                    }
                    await LoadTenants();
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception when deleting tenant");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
    }

    private Tenant? activeApiKeyTenant;
    private List<PartnerApiKey> tenantApiKeys = new();
    private bool isLoadingApiKeys = false;
    private string? apiKeyErrorMessage;
    private string newKeyLabel = "";
    private DateTime? newKeyExpiresAt;
    private bool isGeneratingKey = false;
    private string adminPartnerIdInput = "";

    private async Task HandleOpenApiKeyModal(Tenant tenant)
    {
        activeApiKeyTenant = tenant;
        newKeyLabel = $"{tenant.Name.Value} Partner Key";
        newKeyExpiresAt = null;
        adminPartnerIdInput = currentUserId.HasValue ? currentUserId.Value.ToString() : "";
        await LoadApiKeysForTenant(tenant);
    }

    private void CloseApiKeyModal()
    {
        activeApiKeyTenant = null;
        tenantApiKeys.Clear();
        apiKeyErrorMessage = null;
    }

    private async Task LoadApiKeysForTenant(Tenant tenant)
    {
        isLoadingApiKeys = true;
        apiKeyErrorMessage = null;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = await TenantApiKeyService.GetPartnerKeysAsync(userContext, tenant.TenantId, default);
            if (result.IsOk)
            {
                tenantApiKeys = result.ResultValue.ToList();
            }
            else
            {
                apiKeyErrorMessage = result.ErrorValue;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading API keys for tenant");
            apiKeyErrorMessage = ex.Message;
        }
        finally
        {
            isLoadingApiKeys = false;
        }
    }

    private async Task HandleGenerateMyKey()
    {
        if (activeApiKeyTenant == null || !currentUserId.HasValue) return;
        isGeneratingKey = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var partnerId = UserId.NewUserId(currentUserId.Value);
            var label = string.IsNullOrWhiteSpace(newKeyLabel) ? $"{activeApiKeyTenant.Name.Value} Partner Key" : newKeyLabel.Trim();
            var now = DateTime.UtcNow;
            var expiresAtOpt = newKeyExpiresAt.HasValue
                ? FSharpOption<DateTime>.Some(newKeyExpiresAt.Value)
                : FSharpOption<DateTime>.None;

            var result = await TenantApiKeyService.AddPartnerKeyAsync(
                userContext,
                activeApiKeyTenant.TenantId,
                partnerId,
                label,
                now,
                expiresAtOpt,
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["KeyCreatedSuccess", "API key generated successfully!"].Value, "success");
                await LoadApiKeysForTenant(activeApiKeyTenant);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating API key");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isGeneratingKey = false;
        }
    }

    private async Task HandleGenerateAdminKey()
    {
        if (activeApiKeyTenant == null) return;
        isGeneratingKey = true;
        try
        {
            Guid targetGuid = currentUserId ?? Guid.Empty;
            if (!string.IsNullOrWhiteSpace(adminPartnerIdInput))
            {
                if (!Guid.TryParse(adminPartnerIdInput.Trim(), out targetGuid))
                {
                    await JSRuntime.InvokeVoidAsync("showToast", "Invalid Partner User ID (must be a GUID)", "error");
                    return;
                }
            }

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var partnerId = UserId.NewUserId(targetGuid);
            var label = string.IsNullOrWhiteSpace(newKeyLabel) ? $"{activeApiKeyTenant.Name.Value} Partner Key" : newKeyLabel.Trim();
            var now = DateTime.UtcNow;
            var expiresAtOpt = newKeyExpiresAt.HasValue
                ? FSharpOption<DateTime>.Some(newKeyExpiresAt.Value)
                : FSharpOption<DateTime>.None;

            var result = await TenantApiKeyService.AddPartnerKeyAsync(
                userContext,
                activeApiKeyTenant.TenantId,
                partnerId,
                label,
                now,
                expiresAtOpt,
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", L["KeyCreatedSuccess", "API key generated successfully!"].Value, "success");
                await LoadApiKeysForTenant(activeApiKeyTenant);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating API key");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
        finally
        {
            isGeneratingKey = false;
        }
    }

    private async Task HandleRevokeApiKey(PartnerApiKey key)
    {
        if (activeApiKeyTenant == null) return;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to revoke key '{key.Label}'? The partner will be notified in-app and by email.");
        if (!confirmed) return;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = await TenantApiKeyService.RevokeCatalogKeyAsync(
                userContext,
                activeApiKeyTenant.TenantId,
                key.Key,
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", "API key revoked successfully", "success");
                await LoadApiKeysForTenant(activeApiKeyTenant);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error revoking API key");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
    }

    private async Task HandleDeleteApiKey(PartnerApiKey key)
    {
        if (activeApiKeyTenant == null) return;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete key '{key.Label}'?");
        if (!confirmed) return;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = TenantState.GetUserContext(authState.User);
            var result = await TenantApiKeyService.RemovePartnerKeyAsync(
                userContext,
                activeApiKeyTenant.TenantId,
                key.Key,
                FSharpOption<CancellationToken>.None);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", "API key deleted successfully", "success");
                await LoadApiKeysForTenant(activeApiKeyTenant);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting API key");
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
    }

    private List<Guid> GetManagersWithoutKey(Tenant? tenant)
    {
        var list = new List<Guid>();
        if (tenant == null) return list;

        if (!tenantApiKeys.Any(k => k.PartnerId.Value == tenant.OwnerId.Value))
        {
            list.Add(tenant.OwnerId.Value);
        }

        if (tenant.Patrons != null)
        {
            foreach (var p in tenant.Patrons)
            {
                if (p.Item2.IsManager && !tenantApiKeys.Any(k => k.PartnerId.Value == p.Item1.Value))
                {
                    if (!list.Contains(p.Item1.Value))
                    {
                        list.Add(p.Item1.Value);
                    }
                }
            }
        }
        return list;
    }

    private async Task CopyToClipboard(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await JSRuntime.InvokeVoidAsync("showToast", L["CopiedToClipboard", "Copied to clipboard!"].Value, "success");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
