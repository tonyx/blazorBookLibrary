@page "/tenants"
@using Microsoft.AspNetCore.Authorization
@using blazorBookLibrary.Shared.Resources
@using BookLibrary.Domain
@using Microsoft.Extensions.Localization
@using Microsoft.FSharp.Collections
@using Microsoft.FSharp.Core
@using static BookLibrary.Shared.Commons
@using BookLibrary.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@using BookLibrary.Shared.Services

@attribute [Authorize]
@inject ITenantService TenantService
@inject ITenantApiKeyService TenantApiKeyService
@inject IUserService UserService
@inject IDistributionPointService DistributionPointService
@inject IStringLocalizer<SharedResources> L
@inject ILogger<Tenants> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IUserTenantResolverService UserTenantResolverService
@rendermode InteractiveAuto
@implements IAsyncDisposable


<PageTitle>@L["AllowedTenants"] — @L["BiblioNet"]</PageTitle>

<div class="sanctuary-container py-5">
    @* Page Header *@
    <div class="mb-5 animate-slide-down">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["Tenants"]</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-4">
            <div>
                <h1 class="display-4 text-serif mb-2">@L["AllowedTenants"]</h1>
                <p class="text-muted lead mb-0">@L["AllowedTenantsDescription"]</p>
            </div>

            <div class="d-flex gap-2">
                @* Toggle Button for Joining a Library by PIN *@
                <button type="button"
                    class="btn btn-outline-primary rounded-pill px-4"
                    @onclick="ToggleJoinForm">
                    @if (showJoinForm)
                    {
                        <i class="bi bi-dash-circle-fill me-2"></i>@L["Cancel"]
                    }
                    else
                    {
                        <i class="bi bi-key-fill me-2"></i>@L["JoinByPIN", "Join by PIN"]
                    }
                </button>

                @* Toggle Button for Creating a Library *@
                <button type="button"
                    class="btn btn-sanctuary-primary rounded-pill px-4"
                    @onclick="ToggleCreateForm">
                    @if (showCreateForm)
                    {
                        <i class="bi bi-dash-circle-fill me-2"></i>@L["Cancel"]
                    }
                    else
                    {
                        <i class="bi bi-plus-circle-fill me-2"></i>@L["CreateNewLibrary"]
                    }
                </button>
            </div>
        </div>
    </div>

    @if (showJoinForm)
    {
        @* Join Tenant by PIN Form *@
        <div class="card card-sanctuary mb-5 border-0 shadow-sm bg-surface-low animate-slide-down">
            <div class="card-body p-4">
                <h2 class="h4 text-serif mb-4"><i
                        class="bi bi-key-fill text-primary me-2"></i>@L["JoinLibraryByPIN", "Join Library by PIN"]</h2>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label small fw-bold text-muted">@L["JoinPIN", "6-Digit Join PIN"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-shield-lock-fill text-muted"></i></span>
                            <input type="text" @bind="joinPin" @bind:event="oninput" @onkeyup="HandlePinKeypress" class="form-control border-start-0 ps-0 text-center fw-bold letter-spacing-1"
                                   placeholder="e.g. 123456" maxlength="6" style="font-size: 1.1rem; letter-spacing: 0.2rem;" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary w-100 rounded-pill shadow-sm"
                                @onclick="HandleLookupPin" disabled="@(joinPin.Length != 6 || isLookingUpPin)">
                            @if (isLookingUpPin)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @L["LookupLibrary", "Lookup Library"]
                        </button>
                    </div>
                </div>

                @if (foundTenant != null)
                {
                    <div class="mt-4 p-4 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-10 animate-fade-in">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h4 class="text-serif h5 mb-1"><i class="bi bi-building me-2"></i>@foundTenant.Name.Value</h4>
                                <p class="small text-muted mb-0"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(foundTenant.Address) ? L["Unspecified"].Value : foundTenant.Address)</p>
                            </div>
                            <div>
                                @if (isAlreadyMember)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> @L["AlreadyMember", "Already a Member"]</span>
                                }
                                else if (isJoinRequested)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-hourglass-split me-1"></i> @L["RequestPending", "Request Pending"]</span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm"
                                            @onclick="HandleSubmitJoinRequest" disabled="@isSubmittingJoin">
                                        @if (isSubmittingJoin)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-send-fill me-1"></i> @L["SendJoinRequest", "Request to Join"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (showCreateForm)
    {
        @* Create Tenant Form *@
        <div class="card card-sanctuary mb-5 border-0 shadow-sm bg-surface-low animate-slide-down">
            <div class="card-body p-4">
                <h2 class="h4 text-serif mb-4"><i
                        class="bi bi-plus-circle-fill text-primary me-2"></i>@L["CreateNewLibrary"]</h2>
                <EditForm Model="@newTenant" OnValidSubmit="HandleCreateTenant">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">@L["LibraryName"]</label>
                            <InputText @bind-Value="newTenant.Name" class="form-control"
                                placeholder="@L["EnterLibraryName"]" />
                            <ValidationMessage For="@(() => newTenant.Name)" class="text-danger small" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">@L["LibraryAddress"]</label>
                            <InputText @bind-Value="newTenant.Address" class="form-control"
                                placeholder="@L["EnterAddress"]" />
                            <ValidationMessage For="@(() => newTenant.Address)" class="text-danger small" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-muted">@L["PublicStatus"]</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox @bind-Value="newTenant.IsPublic" class="form-check-input"
                                    id="publicSwitch" />
                                <label class="form-check-label small text-muted" for="publicSwitch">@L["Public"]</label>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm"
                                disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                @L["CreateLibrary"]
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 animate-shake" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill h4 mb-0 me-3"></i>
                <div>
                    <h4 class="alert-heading h5 mb-1">@L["ArchivalRetrievalError"]</h4>
                    <p class="mb-0">@errorMessage</p>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5 animate-fade-in">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">@L["Loading"]...</span>
            </div>
        </div>
    }
    else if (tenants == null || !tenants.Any())
    {
        <div class="card card-sanctuary p-5 text-center border-0 shadow-sm bg-surface-low animate-fade-in">
            <div class="py-5">
                <i class="bi bi-building-exclamation display-1 text-muted opacity-25 mb-4"></i>
                <h3 class="text-serif">@L["NoResultsYet"]</h3>
                <p class="text-muted">@L["TrySwitchingView"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 animate-slide-up">
            @foreach (var tenant in tenants)
            {
                var isManager = currentUserId.HasValue && tenant.IsManager(UserId.NewUserId(currentUserId.Value));
                var isOwner = currentUserId.HasValue && tenant.OwnerId.Value == currentUserId.Value;
                var isPatron = currentUserId.HasValue && tenant.Patrons.Any(p => p.Item1.Value == currentUserId.Value);
                tenantStats.TryGetValue(tenant.TenantId.Value, out var stats);

                <div class="col-md-6 col-lg-4">
                    <div class="card card-sanctuary h-100 border-0 shadow-sm hover-lift transition-all bg-surface-low">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div
                                    class="tenant-icon-wrapper bg-primary bg-opacity-10 text-primary rounded-4 p-3 me-3 shadow-sm">
                                    <i class="bi bi-building h3 mb-0"></i>
                                </div>
                                <div class="flex-grow-1 min-width-0">
                                    <h3 class="card-title h5 text-serif mb-1 text-truncate">@tenant.Name.Value</h3>
                                    <span class="badge-sanctuary badge-neutral small">
                                        <i class="bi bi-geo-alt me-1"></i> @(string.IsNullOrWhiteSpace(tenant.Address) ?
                                L["Unspecified"] : tenant.Address)
                                    </span>
                                </div>
                            </div>

                            @* Relationship Badges *@
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (isOwner || isManager)
                                {
                                    <span class="badge-sanctuary badge-owner small">
                                        <i class="bi bi-shield-fill"></i> @L["Owner"]
                                    </span>
                                }
                                @if (isPatron)
                                {
                                    <span class="badge-sanctuary badge-patron small">
                                        <i class="bi bi-person-workspace"></i> @L["Patron"]
                                    </span>
                                }
                                @if (tenant.TenantVisibility.IsPublic)
                                {
                                    <span class="badge-sanctuary badge-public small">
                                        <i class="bi bi-globe"></i> @L["Public"]
                                    </span>
                                }
                                @if (isAdmin && !isOwner && !isPatron)
                                {
                                    <span class="badge-sanctuary badge-admin small">
                                        <i class="bi bi-shield-lock-fill"></i> @L["Admin"]
                                    </span>
                                }
                            </div>

                            <div class="mb-4 flex-grow-1">
                                <div class="small text-muted text-uppercase fw-bold letter-spacing-1 mb-2">@L["Status"]</div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="dot @(tenant.TenantState.IsActive ? "bg-success" : "bg-warning")"></span>
                                    <span class="small fw-bold">@tenant.TenantState.Value</span>
                                </div>
                            </div>

                            <div class="mt-auto border-top pt-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="small text-muted italic serif">@tenant.Patrons.Count() @L["ArchivalStatus"]
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (TenantState.CurrentTenant?.TenantId.Value == tenant.TenantId.Value)
                                        {
                                            <button class="btn btn-success btn-sm rounded-pill px-4" disabled>
                                                <i class="bi bi-check-circle-fill me-1"></i> @L["Selected"]
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-4"
                                            @onclick="() => HandleSelectTenant(tenant)">
                                                @L["Select"]
                                            </button>
                                        }
                                        @if (isOwner || isAdmin || isManager)
                                        {
                                            <button class="btn btn-outline-primary btn-sm rounded-pill px-4"
                                                @onclick="() => HandleViewDetails(tenant)">
                                                @L["ViewDetails"] <i class="bi bi-arrow-right ms-1"></i>
                                            </button>
                                            <button class="btn btn-outline-dark btn-sm rounded-pill px-3"
                                                @onclick="() => HandleOpenApiKeyModal(tenant)">
                                                <i class="bi bi-key-fill me-1"></i> @L["ApiKeys", "API Keys"]
                                            </button>
                                            @if (stats != null && stats.IsDeletable)
                                            {
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-4"
                                                    @onclick="() => HandleDeleteTenant(tenant)">
                                                    <i class="bi bi-trash-fill me-1"></i> @L["Delete"]
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                                @if ((isOwner || isAdmin || isManager) && stats != null && !stats.IsDeletable)
                                {
                                    <div class="text-danger small mt-3 d-flex align-items-start gap-2 p-2 bg-danger bg-opacity-10 rounded border border-danger border-opacity-10 animate-fade-in" style="font-size: 0.8rem;">
                                        <i class="bi bi-exclamation-circle-fill mt-0.5"></i>
                                        <span>
                                            @(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "it" 
                                                ? $"Non eliminabile. Contiene: {stats.PatronCount} lettori, {stats.DistributionPointCount} punti di distribuzione."
                                                : $"Not deletable. Contains: {stats.PatronCount} patrons, {stats.DistributionPointCount} distribution points.")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (activeApiKeyTenant != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content card-sanctuary border-0 shadow-lg bg-surface-low">
                    <div class="modal-header border-bottom pb-3">
                        <div class="d-flex align-items-center">
                            <div class="tenant-icon-wrapper bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3">
                                <i class="bi bi-key-fill h4 mb-0"></i>
                            </div>
                            <div>
                                <h5 class="modal-title text-serif mb-0">@L["ApiKeysManagement", "API Keys Management"]</h5>
                                <span class="small text-muted">@activeApiKeyTenant.Name.Value</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseApiKeyModal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        @if (isLoadingApiKeys)
                        {
                            <div class="d-flex justify-content-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">@L["Loading"]...</span>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(apiKeyErrorMessage))
                        {
                            <div class="alert alert-danger shadow-sm border-0" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@apiKeyErrorMessage
                            </div>
                        }
                        else if (isAdmin)
                        {
                            @* GLOBAL ADMIN VIEW: ALL KEYS *@
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-uppercase fw-bold text-muted small mb-0">
                                    <i class="bi bi-shield-lock-fill text-primary me-1"></i> @L["AllPartnerKeys", "All Library Partner Keys (Global Admin)"]
                                </h6>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">@tenantApiKeys.Count keys</span>
                            </div>

                            @if (!tenantApiKeys.Any())
                            {
                                <div class="text-center py-4 border rounded-4 bg-surface-lowest mb-4">
                                    <i class="bi bi-key text-muted opacity-50 display-6 mb-2"></i>
                                    <p class="text-muted mb-0 small">@L["NoApiKeysFound", "No partner API keys configured for this library yet."]</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive mb-4">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small text-uppercase">
                                            <tr>
                                                <th>@L["Label", "Label"]</th>
                                                <th>@L["Key", "Key"]</th>
                                                <th>@L["Partner", "Partner"]</th>
                                                <th>@L["Expires", "Expires"]</th>
                                                <th>@L["Status", "Status"]</th>
                                                <th class="text-end">@L["Actions", "Actions"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var k in tenantApiKeys)
                                            {
                                                var isRevoked = k.RevokedAt != null && FSharpOption<DateTime>.get_IsSome(k.RevokedAt);
                                                var isExpired = k.ExpiresAt != null && FSharpOption<DateTime>.get_IsSome(k.ExpiresAt) && k.ExpiresAt.Value < DateTime.UtcNow;

                                                <tr>
                                                    <td>
                                                        <span class="fw-bold">@k.Label</span>
                                                        <div class="text-muted small">@k.CreatedAt.ToString("g")</div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <code class="small text-truncate" style="max-width: 140px;">@k.Key.Value</code>
                                                            <button class="btn btn-link btn-sm text-muted p-0" title="Copy key" @onclick="() => CopyToClipboard(k.Key.Value)">
                                                                <i class="bi bi-clipboard"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="small font-monospace text-truncate d-inline-block" style="max-width: 100px;" title="@k.PartnerId.Value">
                                                            @k.PartnerId.Value.ToString().Substring(0, 8)...
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="small">
                                                            @(k.ExpiresAt != null && FSharpOption<DateTime>.get_IsSome(k.ExpiresAt) ? k.ExpiresAt.Value.ToString("d") : "Never")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (isRevoked)
                                                        {
                                                            <span class="badge bg-danger rounded-pill">@L["Revoked", "Revoked"]</span>
                                                        }
                                                        else if (isExpired)
                                                        {
                                                            <span class="badge bg-warning text-dark rounded-pill">@L["Expired", "Expired"]</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success rounded-pill">@L["Active", "Active"]</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="btn-group btn-group-sm">
                                                            @if (!isRevoked)
                                                            {
                                                                <button class="btn btn-outline-warning rounded-pill px-2 me-1" title="Revoke key (manager will be notified)" @onclick="() => HandleRevokeApiKey(k)">
                                                                    <i class="bi bi-slash-circle me-1"></i>@L["Revoke", "Revoke"]
                                                                </button>
                                                            }
                                                            <button class="btn btn-outline-danger rounded-pill px-2" title="Delete key" @onclick="() => HandleDeleteApiKey(k)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @* Generate Key Form (Admin) *@
                            <div class="card border rounded-4 p-3 bg-surface-lowest">
                                <h6 class="fw-bold small mb-3"><i class="bi bi-plus-circle me-1 text-primary"></i> @L["GeneratePartnerKey", "Generate Partner Key"]</h6>

                                @{
                                    var managersWithoutKey = GetManagersWithoutKey(activeApiKeyTenant);
                                }
                                @if (managersWithoutKey.Any())
                                {
                                    <div class="mb-3 p-2 bg-warning-subtle rounded-3">
                                        <span class="small text-muted fw-bold d-block mb-1">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>@L["ManagersWithoutKey", "Managers without Partner Key"]:
                                        </span>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var mgrId in managersWithoutKey)
                                            {
                                                var isOwnerId = mgrId == activeApiKeyTenant.OwnerId.Value;
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0"
                                                        @onclick='() => { adminPartnerIdInput = mgrId.ToString(); newKeyLabel = isOwnerId ? "Owner Partner Key" : "Manager Partner Key"; }'>
                                                    <i class="bi bi-person-fill me-1"></i>@(isOwnerId ? L["Owner", "Owner"] : L["Manager", "Manager"]): @mgrId.ToString().Substring(0, 8)...
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted">@L["PartnerId", "Partner User ID"]</label>
                                        <input type="text" @bind="adminPartnerIdInput" class="form-control form-control-sm font-monospace" placeholder="e.g. Guid (leave empty for self)" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-muted">@L["Label", "Label"]</label>
                                        <input type="text" @bind="newKeyLabel" class="form-control form-control-sm" placeholder="e.g. OPAC Integration" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small text-muted">@L["Expires", "Expires"]</label>
                                        <input type="date" @bind="newKeyExpiresAt" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-primary btn-sm w-100 rounded-pill" @onclick="HandleGenerateAdminKey" disabled="@isGeneratingKey">
                                            @if (isGeneratingKey) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            @L["Generate", "Generate"]
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @* MANAGER VIEW: USER'S OWN KEY *@
                            var myKey = tenantApiKeys.FirstOrDefault(k => currentUserId.HasValue && k.PartnerId.Value == currentUserId.Value);

                            <div class="mb-3">
                                <h6 class="text-uppercase fw-bold text-muted small mb-3">
                                    <i class="bi bi-person-badge-fill text-primary me-1"></i> @L["MyPartnerApiKey", "My Partner API Key"]
                                </h6>

                                @if (myKey != null)
                                {
                                    var isRevoked = myKey.RevokedAt != null && FSharpOption<DateTime>.get_IsSome(myKey.RevokedAt);
                                    var isExpired = myKey.ExpiresAt != null && FSharpOption<DateTime>.get_IsSome(myKey.ExpiresAt) && myKey.ExpiresAt.Value < DateTime.UtcNow;

                                    <div class="p-4 border rounded-4 bg-surface-lowest shadow-sm">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div>
                                                <h6 class="fw-bold mb-1">@myKey.Label</h6>
                                                <div class="small text-muted">
                                                    @L["Created", "Created"]: @myKey.CreatedAt.ToString("g")
                                                    @if (myKey.ExpiresAt != null && FSharpOption<DateTime>.get_IsSome(myKey.ExpiresAt))
                                                    {
                                                        <span class="ms-2">| @L["Expires", "Expires"]: @myKey.ExpiresAt.Value.ToString("g")</span>
                                                    }
                                                </div>
                                            </div>
                                            <div>
                                                @if (isRevoked)
                                                {
                                                    <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i>@L["Revoked", "Revoked"]</span>
                                                }
                                                else if (isExpired)
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-clock-history me-1"></i>@L["Expired", "Expired"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i>@L["Active", "Active"]</span>
                                                }
                                            </div>
                                        </div>

                                        <label class="form-label small fw-bold text-muted">@L["ApiKeySecret", "API Key Secret (Header: X-API-Key)"]</label>
                                        <div class="input-group mb-2">
                                            <input type="text" class="form-control font-monospace bg-surface-high border-end-0" readonly value="@myKey.Key.Value" />
                                            <button class="btn btn-outline-primary" type="button" @onclick="() => CopyToClipboard(myKey.Key.Value)">
                                                <i class="bi bi-clipboard me-1"></i> @L["Copy", "Copy"]
                                            </button>
                                        </div>

                                        @if (isRevoked)
                                        {
                                            <div class="alert alert-warning border-0 small mt-3 mb-0">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                @L["KeyRevokedManagerNotice", "Your key has been revoked by administration. You have received a notification in-app and by email."]
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 border rounded-4 bg-surface-lowest text-center">
                                        <i class="bi bi-key display-6 text-muted opacity-50 mb-3 d-block"></i>
                                        <h6 class="fw-bold mb-2">@L["NoKeyAssigned", "No API Key Assigned"]</h6>
                                        <p class="text-muted small mb-4">
                                            @L["NoKeyExplanation", "You do not have a partner API key associated to your user for this library. Generate one to interact with the catalogue endpoints."]
                                        </p>

                                        <div class="row g-3 justify-content-center text-start">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold text-muted">@L["KeyLabel", "Key Description / Label"]</label>
                                                <input type="text" @bind="newKeyLabel" class="form-control" placeholder="e.g. My Integration" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-bold text-muted">@L["OptionalExpiry", "Optional Expiration Date"]</label>
                                                <input type="date" @bind="newKeyExpiresAt" class="form-control" />
                                            </div>
                                        </div>

                                        <button type="button" class="btn btn-primary rounded-pill px-4 mt-4 shadow-sm" @onclick="HandleGenerateMyKey" disabled="@isGeneratingKey">
                                            @if (isGeneratingKey)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            }
                                            <i class="bi bi-plus-circle-fill me-2"></i>@L["CreateApiKey", "Create My API Key"]
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="modal-footer border-top pt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseApiKeyModal">
                            @L["Close", "Close"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

