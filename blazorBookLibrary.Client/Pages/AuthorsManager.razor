@page "/authors-manager"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using BookLibrary.Shared.Services
@using BookLibrary.Shared
@using blazorBookLibrary.Shared.Resources
@using BookLibrary.Domain
@using static BookLibrary.Shared.Commons
@using Microsoft.FSharp.Core
@using Microsoft.FSharp.Collections
@using System.Threading
@using Microsoft.AspNetCore.SignalR.Client

@attribute [Authorize]
@inject ITenantService TenantService
@inject IAuthorService AuthorService
@inject IDetailsService DetailsService
@inject IUserTenantResolverService UserTenantResolverService
@inject IAuthorsSearchService AuthorsSearchService
@inject IJSRuntime JSRuntime
@inject ILogger<AuthorsManager> Logger
@inject IStringLocalizer<SharedResources> L
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@rendermode InteractiveAuto
@implements IAsyncDisposable

<PageTitle>@L["AuthorsManager"] — @L["BiblioNet"]</PageTitle>

@if (isPageLoading)
{
    <div class="sanctuary-container py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]...</span>
        </div>
        <p class="mt-2 text-muted">@L["RetrievingArchivalRecords"]...</p>
    </div>
}
else if (!isAuthorized)
{
    <div class="sanctuary-container py-5">
        <div class="card-sanctuary p-5 text-center shadow-lg border-0 rounded-4" style="max-width: 600px; margin: 0 auto; background: #fff; border: 1px solid rgba(0,0,0,0.05); border-radius: 1.25rem;">
            <div class="text-danger mb-4">
                <i class="bi bi-shield-lock-fill display-1" style="font-size: 5rem; color: #dc3545;"></i>
            </div>
            <h1 class="display-5 text-serif mb-3 text-dark">@L["AccessDenied"]</h1>
            <p class="text-muted lead mb-4">
                Access Denied. You must be the Owner of the current library (tenant) or a global Administrator to manage authors.
            </p>
            <a href="/" class="btn btn-primary rounded-pill px-5 py-3 shadow-sm shadow-hover">
                <i class="bi bi-house-door me-2"></i> @L["Home"]
            </a>
        </div>
    </div>
}
else
{
<div class="sanctuary-container py-5">
    @* Page Header *@
    <div class="mb-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["AuthorsManager"]</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h1 class="display-4 text-serif mb-2">@L["AuthorRegistry"]</h1>
                <p class="text-muted lead mb-0">@L["ManageCatalogedAuthors"]</p>
            </div>
            
            <button class="btn btn-sanctuary @(_showAddSection ? "active" : "")" @onclick="() => _showAddSection = !_showAddSection">
                <i class="bi @(_showAddSection ? "bi-dash-lg" : "bi-plus-lg") me-2"></i>
                @(_showAddSection ? L["CloseEntryForm"] : L["NewAuthorRegistration"])
            </button>
        </div>
    </div>

    @* Search Filters *@
    <div class="card-sanctuary mb-5 p-4 border-0 shadow-none bg-surface-low">
        <EditForm Model="@this" OnValidSubmit="HandleSearch" FormName="SearchAuthorForm">
            <div class="row g-4 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["AuthorName"]</label>
                    <InputText class="form-control bg-white border-0 shadow-sm py-2" @bind-Value="_searchName" placeholder="@L["SearchByName"]" />
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["IsniIdentifier"]</label>
                    <InputText class="form-control bg-white border-0 shadow-sm py-2" @bind-Value="_searchIsni" placeholder="@L["SearchByIsni"]" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill" disabled="@_isSearching">
                        @if (_isSearching)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-search me-2"></i>
                        }
                        @L["Search"]
                    </button>
                </div>
            </div>
        </EditForm>
    </div>

    @* Add New Author Section *@
    @if (_showAddSection)
    {
        <div class="mb-5 animate-slide-up">
            <div class="card-sanctuary p-5">
                <div class="border-bottom pb-4 mb-4">
                    <h2 class="display-6 text-serif mb-2">@L["NewAuthorDiscovery"]</h2>
                    <p class="text-muted">@L["RegisterNewScholarlyAuthorRecord"]</p>
                </div>

                <EditForm Model="@this" OnValidSubmit="HandleAddAuthor" FormName="AddAuthorForm">
                    <div class="row g-4">
                        <div class="col-md-5">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["FullName"]</label>
                            <InputText class="form-control bg-surface-low border-0 py-2 shadow-sm serif fw-bold" @bind-Value="_newAuthorName" placeholder="e.g. Stephen King" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["IsniIdentifier"] (@L["Optional"])</label>
                            <InputText class="form-control bg-surface-low border-0 py-2 shadow-sm font-monospace" @bind-Value="_newAuthorIsni" placeholder="0000 0001..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["ProfileImage"] (@L["Optional"])</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <InputText class="form-control bg-surface-low border-0 py-2" @bind-Value="_newAuthorImageUrl" placeholder="https://..." />
                                <button type="button" class="btn btn-white border-start" @onclick="LookupAuthorImage" disabled="@(string.IsNullOrWhiteSpace(_newAuthorName) || _isSearchingImage)" title="@L["WikipediaImageLookup"]">
                                    @if (_isSearchingImage) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-wikipedia me-2"></i> @L["Lookup"] }
                                </button>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["Biography"] (@L["Optional"])</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <InputTextArea class="form-control bg-surface-low border-0 py-2" @bind-Value="_newAuthorBio" rows="3" placeholder="@L["AuthorBioPlaceholder"]" />
                                <button type="button" class="btn btn-white border-start" @onclick="LookupAuthorBio" disabled="@(string.IsNullOrWhiteSpace(_newAuthorName) || _isSearchingBio)" title="@L["WikipediaBioLookup"]">
                                    @if (_isSearchingBio) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-wikipedia me-2"></i> @L["LookupBio"] }
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["WikipediaLink"] (@L["Optional"])</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <InputText class="form-control bg-surface-low border-0 py-2" @bind-Value="_newAuthorWikipediaUrl" placeholder="https://it.wikipedia.org/wiki/..." />
                                <button type="button" class="btn btn-white border-start" @onclick="LookupAuthorWikipediaUri" disabled="@(string.IsNullOrWhiteSpace(_newAuthorName) || _isSearchingUri)" title="@L["WikipediaUriLookup"]">
                                    @if (_isSearchingUri) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-link-45deg me-2"></i> @L["Link"] }
                                </button>
                            </div>
                        </div>

                        @if (_candidateBios.Any())
                        {
                            <div class="col-12 mt-3 animate-slide-up">
                                <div class="card bg-surface-low border shadow-sm p-3">
                                    <h6 class="text-serif mb-3">@L["SelectBestBioMatch"]</h6>
                                    <div class="list-group list-group-flush overflow-auto" style="max-height: 200px;">
                                        @foreach (var bio in _candidateBios)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action py-3 small text-muted border-0 rounded-2 mb-1" @onclick="() => { _newAuthorBio = bio; _candidateBios.Clear(); }">
                                                <i class="bi bi-text-left me-2"></i> @(bio.Length > 200 ? bio.Substring(0, 200) + "..." : bio)
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (!string.IsNullOrWhiteSpace(_newAuthorImageUrl))
                        {
                            <div class="col-12 mt-3 animate-fade-in">
                                <div class="p-3 bg-surface-low rounded-3 border d-flex align-items-center gap-4">
                                    <div class="position-relative" style="width: 100px; height: 100px; overflow: hidden; border-radius: 50%; border: 4px solid white; box-shadow: var(--shadow-sm);">
                                        <img src="@_newAuthorImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Preview" @onerror='() => _newAuthorImageUrl = ""' />
                                    </div>
                                    <div>
                                        <h6 class="text-serif mb-1">@L["VisualIdentityPreview"]</h6>
                                        <p class="small text-muted mb-0 italic">@L["VerifyAuthorImageBeforeRegistration"]</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="col-12 mt-5">
                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-sanctuary btn-lg flex-grow-1 py-3 shadow-sm shadow-hover">
                                    <i class="bi bi-person-check me-2"></i> @L["FinalizeAuthorRegistration"]
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-lg px-4" @onclick="() => _showAddSection = false">
                                    @L["Discard"]
                                </button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @* Authors Ledger *@
    @if (_searchPerformed)
    {
        <div class="animate-fade-in">
            <div class="card-sanctuary p-0 overflow-hidden">
                <div class="px-5 py-4 bg-surface-container d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <h2 class="h4 text-serif mb-0">@L["AuthorLedger"]</h2>
                        <span class="badge-sanctuary badge-neutral">@_authors.Count @L["TotalRegistered"]</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <QuickGrid Items="@FilteredAuthors" Pagination="@_pagination" Class="editorial-ledger w-100 align-middle">
                        <TemplateColumn Title="@L["AuthorName"]" SortBy="@_sortName" Class="col-title text-serif fw-bold h5">
                            <ColumnOptions>
                                <div class="p-3 bg-surface-low rounded-3 border shadow-sm" style="min-width: 300px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-filter"></i></span>
                                        <input type="search" autofocus @bind="_nameFilter" @bind:event="oninput" 
                                               placeholder="@L["FilterRecords"]" 
                                               class="form-control border-start-0 ps-0" />
                                    </div>
                                </div>
                            </ColumnOptions>
                            <ChildContent>
                                <a href="/author-details/@context.Author.Id" class="text-decoration-none text-reset transition-hover py-2 d-block">
                                    @context.Author.Name.Value
                                </a>
                            </ChildContent>
                        </TemplateColumn>

                        <TemplateColumn Title="@L["Identity"]" Align="Align.Center">
                            @if (context.Author.ImageUri != null && FSharpOption<Uri>.get_IsSome(context.Author.ImageUri))
                            {
                                <span class="text-success"><i class="bi bi-person-badge-fill"></i></span>
                            }
                            else
                            {
                                <span class="text-muted opacity-25"><i class="bi bi-person-badge"></i></span>
                            }
                        </TemplateColumn>

                        <TemplateColumn Title="@L["IsniIdentifier"]" Sortable="true" Class="font-monospace small">
                            @if (string.IsNullOrEmpty(context.Author.Isni.Value))
                            {
                                <span class="text-muted opacity-25 italic">@L["NoneNotSet"]</span>
                            }
                            else
                            {
                                @context.Author.Isni.Value
                            }
                        </TemplateColumn>

                        <TemplateColumn Title="@L["LinkedTitles"]" Align="Align.Center">
                            <span class="badge-sanctuary badge-neutral">@context.Books.Length</span>
                        </TemplateColumn>

                        <TemplateColumn Title="@L["Status"]" Align="Align.End" Class="pe-5">
                            @if (context.Author.Sealed.Sealed)
                            {
                                <span class="text-muted small fw-bold"><i class="bi bi-lock-fill me-2" style="font-size: 0.5rem;"></i>@L["Sealed"]</span>
                            }
                            else
                            {
                                <span class="text-success small fw-bold"><i class="bi bi-unlock-fill me-2" style="font-size: 0.5rem;"></i>@L["Active"]</span>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                </div>
                
                <div class="px-5 py-3 bg-surface-container border-top d-flex justify-content-center">
                    <Paginator State="@_pagination" />
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    private bool isAuthorized = false;
    private bool isPageLoading = true;

    private async Task<UserContext> GetContext()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return TenantState.GetUserContext(authState.User);
    }

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/library"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On("AuthorsChanged", async () =>
            {
                if (_searchPerformed)
                {
                    await LoadAuthors();
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On("AuthorCatalogChanged", async () =>
            {
                if (_searchPerformed)
                {
                    await LoadAuthors();
                    await InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not start SignalR hub connection in AuthorsManager. Expected during prerendering.");
        }

        isPageLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal != null && claimsPrincipal.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(claimsPrincipal);
                var isAdmin = claimsPrincipal.IsInRole("Admin");
                bool isOwner = false;

                var tenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext);
                if (tenantResult.IsOk)
                {
                    var tenantId = tenantResult.ResultValue;
                    var tenantInfoResult = await TenantService.GetTenantAsync(userContext, tenantId);
                    if (tenantInfoResult.IsOk)
                    {
                        var tenant = tenantInfoResult.ResultValue;
                        isOwner = userContext.UserId.Value.Value.Equals(tenant.OwnerId.Value);
                    }
                }

                if (isAdmin || isOwner)
                {
                    isAuthorized = true;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during page authorization check");
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private bool _showAddSection = false;
    private List<Details.AuthorDetails> _authors = new();
    private PaginationState _pagination = new() { ItemsPerPage = 12 };
    private GridSort<Details.AuthorDetails> _sortName = GridSort<Details.AuthorDetails>.ByAscending(a => a.Author.Name.Value);
    
    private string _nameFilter = "";
    private string _isniFilter = "";
    
    private string _newAuthorName = "";
    private string _newAuthorIsni = "";
    private string _newAuthorImageUrl = "";
    private string _newAuthorBio = "";
    private string _newAuthorWikipediaUrl = "";
    private bool _isSearchingImage = false;
    private bool _isSearchingBio = false;
    private bool _isSearchingUri = false;
    private List<string> _candidateBios = new();

    private string statusMessage = "";

    private string _searchName = "";
    private string _searchIsni = "";
    private bool _searchPerformed = false;
    private bool _isSearching = false;

    private async Task HandleSearch()
    {
        _isSearching = true;
        _searchPerformed = true;
        try
        {
            await LoadAuthors();
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task LoadAuthors()
    {
        FSharpResult<FSharpList<Author>, string> result;

        bool hasName = !string.IsNullOrWhiteSpace(_searchName);
        bool hasIsni = !string.IsNullOrWhiteSpace(_searchIsni);

        if (hasName && hasIsni)
        {
            var context = await GetContext();
            var name = Name.New(_searchName);
            var isni = Isni.NewInvalid(_searchIsni);
            result = await AuthorService.SearchByIsniAndNameAsync(context, isni, name, FSharpOption<CancellationToken>.None);
        }
        else if (hasName)
        {
            var context = await GetContext();
            var name = Name.New(_searchName);
            result = await AuthorService.SearchByNameAsync(context, name, FSharpOption<CancellationToken>.None);
        }
        else if (hasIsni)
        {
            var context = await GetContext();
            var isni = Isni.NewInvalid(_searchIsni);
            result = await AuthorService.SearchByIsniAsync(context, isni, FSharpOption<CancellationToken>.None); 
        }
        else
        {
            var context = await GetContext();
            result = await AuthorService.GetAllAsync(context, FSharpOption<CancellationToken>.None);
        }

        if (result.IsOk)
        {
            var context = await GetContext();
            var authorIds = ListModule.OfSeq(result.ResultValue.Select(a => a.AuthorId));
            var detailsResult = await DetailsService.GetAuthorsDetailsAsync(context, authorIds, FSharpOption<CancellationToken>.None);
            if (detailsResult.IsOk)
            {
                _authors = detailsResult.ResultValue.ToList();
            }
            else
            {
                await ShowStatus(string.Format(L["ErrorLoadingAuthors"], detailsResult.ErrorValue), "error");
            }
        }
        else
        {
            await ShowStatus(string.Format(L["ErrorLoadingAuthors"], result.ErrorValue), "error");
        }
    }

    private IQueryable<Details.AuthorDetails> FilteredAuthors => 
        _authors.AsQueryable()
            .Where(a => a.Author.Name.Value.Contains(_nameFilter, StringComparison.OrdinalIgnoreCase))
            .Where(a => a.Author.Isni.Value.Contains(_isniFilter, StringComparison.OrdinalIgnoreCase));

    private async Task HandleAddAuthor()
    {
        if (string.IsNullOrWhiteSpace(_newAuthorName))
        {
            await ShowStatus(L["AuthorNameRequired"], "warning");
            return;
        }

        FSharpOption<Isni> isniOpt = FSharpOption<Isni>.None;
        if (!string.IsNullOrWhiteSpace(_newAuthorIsni))
        {
            var isniResult = Isni.New(_newAuthorIsni);
            if (isniResult.IsError)
            {
                await ShowStatus(string.Format(L["InvalidIsniValue"], isniResult.ErrorValue), "error");
                return;
            }
            isniOpt = FSharpOption<Isni>.Some(isniResult.ResultValue);
        }

        FSharpOption<Uri> imageUrlOpt = FSharpOption<Uri>.None;
        if (!string.IsNullOrWhiteSpace(_newAuthorImageUrl))
        {
            if (Uri.TryCreate(_newAuthorImageUrl, UriKind.Absolute, out var uri))
            {
                imageUrlOpt = FSharpOption<Uri>.Some(uri);
            }
            else
            {
                await ShowStatus(L["InvalidImageUrl"], "warning");
                return;
            }
        }

        var name = Name.New(_newAuthorName);

        FSharpOption<Uri> wikipediaUriOpt = FSharpOption<Uri>.None;
        if (!string.IsNullOrWhiteSpace(_newAuthorWikipediaUrl))
        {
            if (Uri.TryCreate(_newAuthorWikipediaUrl, UriKind.Absolute, out var uri))
            {
                wikipediaUriOpt = FSharpOption<Uri>.Some(uri);
            }
        }

        var context = await GetContext();
        if (!context.IsAuthenticated)
        {
            await ShowStatus(L["AccessDenied"], "error");
            return;
        }

        var tryTenant = await UserTenantResolverService.GetTenantForUserAsync(context);
        if (tryTenant.IsError) 
        {
            await ShowStatus("an error occurred", "error");
            Logger.LogError(tryTenant.ErrorValue);
            return;
        }
        var tenantId = tryTenant.ResultValue;

        var author = Author.NewWithOptionalIsniAndImageUrlAndBio(tenantId, name, isniOpt, imageUrlOpt, FSharpOption<string>.Some(_newAuthorBio), wikipediaUriOpt);
        var result = await AuthorService.AddAuthorAsync(context, author);

        if (tryTenant.IsOk)
        {
            await ShowStatus(string.Format(L["AuthorAddedSuccessfully"], _newAuthorName), "success");
            _newAuthorName = "";
            _newAuthorIsni = "";
            _newAuthorImageUrl = "";
            _newAuthorBio = "";
            _newAuthorWikipediaUrl = "";
            _candidateBios.Clear();
            await LoadAuthors();
        }
        else
        {
            await ShowStatus(string.Format(L["ErrorCreatingAuthor"], tryTenant.ErrorValue), "error");
        }
    }

    private async Task LookupAuthorImage()
    {
        if (string.IsNullOrWhiteSpace(_newAuthorName)) return;

        _isSearchingImage = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await AuthorsSearchService.LookupImageUrlByNameAndThumbSizeAsync(userContext, _newAuthorName, FSharpOption<int>.Some(200));
            if (result.IsOk)
            {
                _newAuthorImageUrl = result.ResultValue;
                await ShowStatus(L["ImageFoundWikipedia"], "success");
            }
            else
            {
                await ShowStatus(string.Format(L["WikipediaLookupError"], result.ErrorValue), "warning");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorSearchingImage"], ex.Message), "error");
        }
        finally
        {
            _isSearchingImage = false;
        }
    }

    private async Task LookupAuthorBio()
    {
        if (string.IsNullOrWhiteSpace(_newAuthorName)) return;

        _isSearchingBio = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userContext = Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var lang = ShortLang.New(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
            var result = await AuthorsSearchService.LookupBioByNameAsync(userContext, _newAuthorName, FSharpOption<ShortLang>.Some(lang));
            if (result.IsOk)
            {
                _candidateBios = result.ResultValue.ToList();
                if (_candidateBios.Any())
                {
                    await ShowStatus(L["BioFoundWikipedia"], "success");
                }
                else
                {
                    await ShowStatus(L["NoBioFoundWikipedia"], "warning");
                }
            }
            else
            {
                await ShowStatus(string.Format(L["WikipediaLookupError"], result.ErrorValue), "warning");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorSearchingBio"], ex.Message), "error");
        }
        finally
        {
            _isSearchingBio = false;
        }
    }

    private async Task LookupAuthorWikipediaUri()
    {
        if (string.IsNullOrWhiteSpace(_newAuthorName)) return;

        _isSearchingUri = true;
        try
        {
            var context = await GetContext();
            var lang = ShortLang.New(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
            var result = await AuthorsSearchService.LookupWikipediaUriByNameAsync(context, _newAuthorName, lang);
            if (result.IsOk)
            {
                _newAuthorWikipediaUrl = result.ResultValue;
                await ShowStatus(L["WikipediaLinkFound"], "success");
            }
            else
            {
                await ShowStatus(string.Format(L["WikipediaLookupError"], result.ErrorValue), "warning");
            }
        }
        catch (Exception ex)
        {
            await ShowStatus(string.Format(L["ErrorSearchingUri"], ex.Message), "error");
        }
        finally
        {
            _isSearchingUri = false;
        }
    }

    private async Task ShowStatus(string message, string type)
    {
        statusMessage = message;
        await JSRuntime.InvokeVoidAsync("showToast", message, type);
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
