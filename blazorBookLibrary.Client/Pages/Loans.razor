@page "/loans"
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using static BookLibrary.Shared.Details
@using Microsoft.AspNetCore.SignalR.Client

@attribute [Authorize]
@inject IUserTenantResolverService UserTenantResolverService
@inject ITenantService TenantService
@inject Services.TenantStateService TenantState
@inject ILoanService LoanService
@inject IDetailsService DetailsService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResources> L
@inject ILogger<Loans> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveAuto
@implements IAsyncDisposable

<PageTitle>@L["LoansManagement"] — @L["BiblioNet"]</PageTitle>

@if (_isPageLoading)
{
    <div class="sanctuary-container py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]...</span>
        </div>
        <p class="mt-2 text-muted">@L["RetrievingArchivalRecords"]...</p>
    </div>
}
else if (!_isAuthorized)
{
    <div class="sanctuary-container py-5">
        <div class="card-sanctuary p-5 text-center shadow-lg border-0 rounded-4" style="max-width: 600px; margin: 0 auto; background: #fff; border: 1px solid rgba(0,0,0,0.05); border-radius: 1.25rem;">
            <div class="text-danger mb-4">
                <i class="bi bi-shield-lock-fill display-1" style="font-size: 5rem; color: #dc3545;"></i>
            </div>
            <h1 class="display-5 text-serif mb-3 text-dark">@L["AccessDenied"]</h1>
            <p class="text-muted lead mb-4">
                Access Denied. You must be the Owner of the current library (tenant) or a global Administrator to manage loans.
            </p>
            <a href="/" class="btn btn-primary rounded-pill px-5 py-3 shadow-sm shadow-hover">
                <i class="bi bi-house-door me-2"></i> @L["Home"]
            </a>
        </div>
    </div>
}
else
{
<div class="sanctuary-container py-5">
    @* Page Header *@
    <div class="mb-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">@L["Home"]</a></li>
                <li class="breadcrumb-item active text-serif" aria-current="page">@L["LoansManagement"]</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h1 class="display-4 text-serif mb-2">@L["LoansManagement"]</h1>
                <p class="text-muted lead mb-0">@L["MonitorAndManageArchivalLoans"]</p>
            </div>
            
            <div class="d-flex gap-3">
                <div class="badge-sanctuary badge-neutral px-4 py-2">
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1 me-2">@L["TotalLoans"]:</span>
                    <span class="h4 mb-0 fw-bold">@FilteredLoans.Count()</span>
                </div>
            </div>
        </div>
    </div>

    @* Filters *@
    <div class="card-sanctuary mb-5 p-4 border-0 shadow-none bg-surface-low">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control border-start-0" @bind="_bookFilter" @bind:event="oninput" placeholder="@L["FilterByBookTitle"]" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-person"></i></span>
                    <input type="search" class="form-control border-start-0" @bind="patronFilter" @bind:event="oninput" placeholder="@L["FilterByPatron"]" />
                </div>
            </div>
        </div>
    </div>

    @* Loans Ledger *@
    <div class="card-sanctuary p-0 overflow-hidden animate-fade-in">
        <div class="table-responsive">
            <QuickGrid Items="@FilteredLoans" Pagination="@_pagination" Class="editorial-ledger w-100 align-middle">
                
                <TemplateColumn Title="@L["Book"]" SortBy="@_sortTitle">
                    <div class="d-flex align-items-center gap-3 py-2">
                        @if (context.Book.ImageUrl != null && Microsoft.FSharp.Core.FSharpOption<Uri>.get_IsSome(context.Book.ImageUrl))
                        {
                            <img src="@context.Book.ImageUrl.Value" class="rounded shadow-sm" style="width: 40px; height: 60px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-surface-neutral rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 60px;">
                                <i class="bi bi-book text-muted opacity-50"></i>
                            </div>
                        }
                        <div>
                            <div class="fw-bold text-serif">@context.Book.Title.Value</div>
                            <div class="small text-muted">@context.Book.Year.Value</div>
                        </div>
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="@L["Patron"]" SortBy="@_sortPatron">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle text-muted"></i>
                        <span>@context.UserDetails.AppUser.Email</span>
                    </div>
                </TemplateColumn>

                <PropertyColumn Property="@(ld => ld.Loan.TimeSlot.Start.ToLocalTime())" Title="@L["LoanedAt"]" Format="yyyy-MM-dd HH:mm" Sortable="true" />
                
                <TemplateColumn Title="@L["DueDate"]" SortBy="@_sortDueDate">
                    @{
                        var isOverdue = context.Loan.IsOverdue(DateTime.UtcNow);
                    }
                    <div class="@(isOverdue ? "text-danger fw-bold overdue-pulse" : "")">
                        @context.Loan.TimeSlot.End.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        @if (isOverdue)
                        {
                            <i class="bi bi-exclamation-triangle-fill ms-2 animate-bounce" title="@L["OverdueLoanWarning"]"></i>
                        }
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="@L["Actions"]">
                    <button class="btn btn-sm btn-outline-primary shadow-sm" @onclick="() => ConfirmReturn(context)">
                        <i class="bi bi-box-arrow-in-right me-1"></i> @L["Release"]
                    </button>
                </TemplateColumn>

            </QuickGrid>
        </div>
        <div class="px-4 py-3 bg-surface-container border-top d-flex justify-content-between align-items-center">
            <div class="small text-muted serif italic">@L["Showing"] @FilteredLoans.Count() @L["Records"]</div>
            <Paginator State="@_pagination" />
        </div>
    </div>
</div>
}

<style>
    .overdue-pulse {
        animation: subtle-pulse 2s infinite;
    }

    @@keyframes subtle-pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.02); text-shadow: 0 0 5px rgba(220, 53, 69, 0.2); }
        100% { transform: scale(1); }
    }

    .animate-bounce {
        display: inline-block;
        animation: bounce 1s infinite;
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3px); }
    }

    .editorial-ledger thead th {
        background-color: var(--surface-container-low);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding-top: 1rem;
        padding-bottom: 1rem;
        border-bottom-width: 2px;
    }

    .editorial-ledger tbody td {
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
    }
</style>

@code {
    private bool _isAuthorized = false;
    private bool _isPageLoading = true;
    private List<LoanDetails> _loanDetailsList = new();
    private string _bookFilter = "";
    private string patronFilter = "";
    private PaginationState _pagination = new() { ItemsPerPage = 10 };

    private GridSort<LoanDetails> _sortTitle = GridSort<LoanDetails>.ByAscending(ld => ld.Book.Title.Value);
    private GridSort<LoanDetails> _sortPatron = GridSort<LoanDetails>.ByAscending(ld => ld.UserDetails.AppUser.Email);
    private GridSort<LoanDetails> _sortDueDate = GridSort<LoanDetails>.ByAscending(ld => ld.Loan.TimeSlot.End);

    private IQueryable<LoanDetails> FilteredLoans => 
        _loanDetailsList.AsQueryable()
            .Where(ld => ld.Loan.InProgress && 
                         (string.IsNullOrEmpty(_bookFilter) || ld.Book.Title.Value.Contains(_bookFilter, StringComparison.OrdinalIgnoreCase)) &&
                         (string.IsNullOrEmpty(patronFilter) || (ld.UserDetails.AppUser.Email != null && ld.UserDetails.AppUser.Email.Contains(patronFilter, StringComparison.OrdinalIgnoreCase))))
            .OrderByDescending(ld => ld.Loan.TimeSlot.Start);

    private HubConnection? hubConnection;
    private Guid? activeTenantId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/library"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<Guid, Guid>("BookAvailabilityChanged", async (tenantId, bookId) =>
            {
                if (activeTenantId.HasValue && activeTenantId.Value == tenantId)
                {
                    await LoadLoans();
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<Guid>("BookCatalogChanged", async (bookId) =>
            {
                if (_loanDetailsList != null && _loanDetailsList.Any(l => l.Book.BookId.Value == bookId))
                {
                    await LoadLoans();
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<Guid>("LoanListChanged", async (loanId) =>
            {
                if (_loanDetailsList != null && _loanDetailsList.Any(l => l.Loan.LoanId.Value == loanId))
                {
                    await LoadLoans();
                    await InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not start SignalR hub connection in Loans. Expected during prerendering.");
        }

        _isPageLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal != null && claimsPrincipal.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(claimsPrincipal);
                var isAdmin = claimsPrincipal.IsInRole("Admin");
                bool isOwner = false;

                var tenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext);
                if (tenantResult.IsOk)
                {
                    var tenantId = tenantResult.ResultValue;
                    activeTenantId = tenantId.Value;
                    if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
                    {
                        try
                        {
                            await hubConnection.SendAsync("JoinTenantGroup", activeTenantId.Value);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Failed to join tenant group in Loans");
                        }
                    }
                    var tenantInfoResult = await TenantService.GetTenantAsync(userContext, tenantId);
                    if (tenantInfoResult.IsOk)
                    {
                        var tenant = tenantInfoResult.ResultValue;
                        isOwner = userContext.UserId.Value.Value.Equals(tenant.OwnerId.Value);
                    }
                }

                if (isAdmin || isOwner)
                {
                    _isAuthorized = true;
                    await LoadLoans();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during page authorization check");
        }
        finally
        {
            _isPageLoading = false;
        }
    }

    private async Task LoadLoans()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var context = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
        var result = await DetailsService.GetAllLoansDetailsAsync(context);
        if (result.IsOk)
        {
            _loanDetailsList = result.ResultValue.ToList();
        }
        else
        {
            Logger.LogError("Error loading loans details: {Error}", result.ErrorValue);
            await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
        }
    }

    private async Task ConfirmReturn(LoanDetails loanDetails)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"{L["ConfirmReturnOf"]} {loanDetails.Book.Title.Value}?");
        if (confirmed)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var context = Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
            var result = await LoanService.ReleaseLoanAsync(context, loanDetails.Loan.LoanId, DateTime.UtcNow);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", $"{L["LoanReturnedSuccessfully"]}", "success");
                await LoadLoans();
            }
            else
            {
                Logger.LogError("Error returning loan: {Error}", result.ErrorValue);
                await JSRuntime.InvokeVoidAsync("showToast", L["ErrorOccurred"].Value, "error");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            if (activeTenantId.HasValue)
            {
                try
                {
                    await hubConnection.SendAsync("LeaveTenantGroup", activeTenantId.Value);
                }
                catch {}
            }
            await hubConnection.DisposeAsync();
        }
    }
}
