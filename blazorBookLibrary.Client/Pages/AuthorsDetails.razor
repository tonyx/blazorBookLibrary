                Logger.LogError("Error looking up Wikipedia URI for {Name}: {Error}", _authorDetails.Author.Name.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-warning");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while looking up Wikipedia URI for {Name}", _authorDetails.Author.Name.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
        finally
        {
            _isSearchingUri = false;
        }
    }

    private async Task ShowStatus(string message, string cssClass)
    {
        _statusMessage = message;

        string type = "info";
        if (cssClass.Contains("success")) type = "success";
        else if (cssClass.Contains("danger")) type = "error";
        else if (cssClass.Contains("warning")) type = "warning";

        await JSRuntime.InvokeVoidAsync("showToast", message, type);
    }

    protected override async Task OnInitializedAsync()
    {
        isPageLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var claimsPrincipal = authState.User;
            if (claimsPrincipal != null && claimsPrincipal.Identity?.IsAuthenticated == true)
            {
                var userContext = TenantState.GetUserContext(claimsPrincipal);
                var isAdmin = claimsPrincipal.IsInRole("Admin");
                bool isOwner = false;

                var tenantResult = await UserTenantResolverService.GetTenantForUserAsync(userContext);
                if (tenantResult.IsOk)
                {
                    var tenantId = tenantResult.ResultValue;
                    var tenantInfoResult = await TenantService.GetTenantAsync(userContext, tenantId);
                    if (tenantInfoResult.IsOk)
                    {
                        var tenant = tenantInfoResult.ResultValue;
                        isOwner = userContext.UserId.Value.Value.Equals(tenant.OwnerId.Value);
                    }
                }

                if (isAdmin || isOwner)
                {
                    isAuthorized = true;
                    await LoadAuthorDetails();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during page authorization check");
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task LoadAuthorDetails()
    {
        _isLoading = true;
        try
        {
            if (Guid.TryParse(AuthorIdStr, out var guid))
            {
                var authorId = AuthorId.NewAuthorId(guid);
                var context = await GetContext();
                var result = await DetailsService.GetAuthorDetailsAsync(context, authorId);

                if (result.IsOk)
                {
                    _authorDetails = result.ResultValue;
                }
            }
        }
        catch (Exception)
        {
            // Error handling can be expanded here
        }
        finally
        {
            _isLoading = false;
        }
    }

