    private void StartEditWikipediaUri()
    {
        if (_authorDetails != null && _authorDetails.Author.Editable)
        {
            CancelAllEdits();
            _isEditingWikipediaUri = true;
            _editedWikipediaUri = _authorDetails.Author.WikipediaUri != null && FSharpOption<Uri>.get_IsSome(_authorDetails.Author.WikipediaUri)
                ? _authorDetails.Author.WikipediaUri.Value.ToString()
                : "";
        }
    }

    private async Task UpdateWikipediaUri()
    {
        if (_authorDetails == null) return;
        if (string.IsNullOrWhiteSpace(_editedWikipediaUri))
        {
            // Optional: handle removal
            _isEditingWikipediaUri = false;
            return;
        }

        if (Uri.TryCreate(_editedWikipediaUri, UriKind.Absolute, out var uri))
        {
            try
            {
                var context = await GetContext();
                var result = await AuthorService.UpdateWikipediaUriAsync(context, _authorDetails.Author.AuthorId, uri);
                if (result.IsOk)
                {
                    await LoadAuthorDetails();
                    _isEditingWikipediaUri = false;
                    await ShowStatus(L["WikipediaLinkUpdated"], "alert-success");
                }
                else
                {
                    Logger.LogError("Error updating Wikipedia URI for author {AuthorId}: {Error}", _authorDetails.Author.AuthorId.Value, result.ErrorValue);
                    await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Exception while updating Wikipedia URI for author {AuthorId}", _authorDetails.Author.AuthorId.Value);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        else
        {
            Logger.LogWarning("Invalid URL format entered: {Url}", _editedWikipediaUri);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

    private async Task LookupWikipediaUri()
    {
        if (_authorDetails == null) return;
        _isSearchingUri = true;
        try
        {
            var context = await GetContext();
            var lang = ShortLang.New(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
            var result = await AuthorsSearchService.LookupWikipediaUriByNameAsync(context, _authorDetails.Author.Name.Value, lang);
            if (result.IsOk)
