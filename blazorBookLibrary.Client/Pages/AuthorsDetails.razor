
@page "/author-details/{AuthorIdStr}"
@using Microsoft.AspNetCore.Authorization
@using static BookLibrary.Shared.Commons
@using Microsoft.FSharp.Core

@attribute [Authorize]
@inject IUserTenantResolverService UserTenantResolverService
@inject ITenantService TenantService
@inject Services.TenantStateService TenantState
@inject IAuthorService AuthorService
@inject IAuthorsSearchService AuthorsSearchService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JSRuntime
@inject IDetailsService DetailsService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<AuthorsDetails> Logger
@rendermode InteractiveAuto

<PageTitle>@L["AuthorDetails"]</PageTitle>

@if (isPageLoading)
{
    <div class="sanctuary-container py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]...</span>
        </div>
        <p class="mt-2 text-muted">@L["RetrievingArchivalRecords"]...</p>
    </div>
}
else if (!isAuthorized)
{
    <div class="sanctuary-container py-5">
        <div class="card-sanctuary p-5 text-center shadow-lg border-0 rounded-4" style="max-width: 600px; margin: 0 auto; background: #fff; border: 1px solid rgba(0,0,0,0.05); border-radius: 1.25rem;">
            <div class="text-danger mb-4">
                <i class="bi bi-shield-lock-fill display-1" style="font-size: 5rem; color: #dc3545;"></i>
            </div>
            <h1 class="display-5 text-serif mb-3 text-dark">@L["AccessDenied"]</h1>
            <p class="text-muted lead mb-4">
                Access Denied. You must be the Owner of the current library (tenant) or a global Administrator to view author records.
            </p>
            <a href="/" class="btn btn-primary rounded-pill px-5 py-3 shadow-sm shadow-hover">
                <i class="bi bi-house-door me-2"></i> @L["Home"]
            </a>
        </div>
    </div>
}
else
{
<div class="sanctuary-container" @onclick="CancelAllEdits">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-end mb-5 border-bottom pb-4" style="border-color: var(--outline-variant) !important;">
        <div>
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb mb-0" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--secondary);">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-reset">@L["Home"]</a></li>
                    <li class="breadcrumb-item"><a href="/books-manager" class="text-decoration-none text-reset">@L["Library"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@L["AuthorProfile"]</li>
                </ol>
            </nav>
            <h1 class="serif display-5 mb-0" style="font-weight: 800; color: var(--primary);">@L["AuthorProfile"]</h1>
        </div>
        <a href="/books-manager" class="btn-sanctuary-outline text-decoration-none">
            <i class="bi bi-arrow-left me-2"></i>@L["BackToLibrary"]
        </a>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
            <div class="spinner-grow text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_authorDetails != null)
    {
        <div class="row g-5">
            <!-- Left Column: Portrait & Stats -->
            <div class="col-lg-4">
                <div class="card-sanctuary floating text-center mb-4">
                    <div class="profile-image-wrap mb-4 bg-surface-low rounded-circle mx-auto position-relative" style="width: 200px; height: 200px; overflow: hidden; border: 8px solid var(--surface-container-lowest);">
                        @if (_authorDetails.Author.ImageUri != null && FSharpOption<Uri>.get_IsSome(_authorDetails.Author.ImageUri))
                        {
                            <img src="@_authorDetails.Author.ImageUri.Value.ToString()" 
                                 class="w-100 h-100" 
                                 style="object-fit: cover;" 
                                 alt="@_authorDetails.Author.Name.Value Profile" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted opacity-25">
                                <i class="bi bi-person-fill" style="font-size: 6rem;"></i>
                                @if (_authorDetails.Author.Editable)
                                {
                                    <button class="btn btn-link btn-sm text-decoration-none mt-n4 text-serif" @onclick:stopPropagation @onclick="StartEditImageUrl">
                                        + @L["AddPortrait"]
                                    </button>
                                }
                            </div>
                        }

                        @if (_authorDetails.Author.Editable)
                        {
                            <div class="image-edit-badge position-absolute" @onclick="StartEditImageUrl" @onclick:stopPropagation title="@L["ChangeProfileImage"]">
                                <i class="bi bi-camera-fill"></i>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-center flex-wrap gap-2">
                             <span class="badge-sanctuary badge-neutral">
                                <i class="bi bi-journals me-2"></i> @_authorDetails.Books.Length @L["RegisteredTitles"]
                            </span>
                            
                            @if (_authorDetails.UnSealable)
                            {
                                <div class="badge-sanctuary @(isAuthorSealed ? "badge-borrowed" : "badge-available") d-flex align-items-center py-1">
                                    <i class="bi @(isAuthorSealed ? "bi-lock-fill" : "bi-unlock-fill") me-2"></i>
                                    <div class="form-check form-switch p-0 m-0 d-flex align-items-center">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="sealSwitch" 
                                               checked="@(!isAuthorSealed)" 
                                               @onchange="ToggleSeal"
                                               style="cursor: pointer; width: 2em; height: 1em;" />
                                        <label class="form-check-label small fw-bold" for="sealSwitch">
                                            @(isAuthorSealed ? L["LockedSealed"] : L["EditableUnsealed"])
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (_authorDetails.Books.Length == 0 && _authorDetails.Author.Editable)
                    {
                        <div class="mt-5 p-4 bg-surface-low rounded-xl text-start">
                            <h6 class="serif text-danger mb-2">@L["DangerZone"]</h6>
                            <p class="small text-muted mb-3">@L["PermanentlyRemoveAuthor"]</p>
                            <button class="btn btn-sm btn-outline-danger w-100 rounded-pill" @onclick="DeleteAuthor">
                                <i class="bi bi-trash me-2"></i>@L["DeleteAuthorProfile"]
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Details & Works Ledger -->
            <div class="col-lg-8">
                <!-- Administrative Ledger (Profile Stats) -->
                <div class="card-sanctuary mb-5">
                    <h5 class="serif mb-4 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">@L["ArchivalRecord"]</h5>
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["AuthorFullName"]</label>
                            @if (_isEditingName)
                            {
                                <div class="input-group input-group-sm mb-2" @onclick:stopPropagation>
                                    <input type="text" class="form-control bg-surface-low border-0 serif fw-bold" @bind="_editedName" @onkeyup="HandleKeyUp" autofocus />
                                    <button class="btn btn-primary" @onclick="UpdateName">@L["Confirm"]</button>
                                    <button class="btn btn-outline-secondary" @onclick="CancelEditName"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <p class="serif h4 mb-0" style="color: var(--primary); font-weight: 700;">@_authorDetails.Author.Name.Value</p>
                                    @if (_authorDetails.Author.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditName" @onclick:stopPropagation><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["IsniNumber"]</label>
                            @if (_isEditingIsni)
                            {
                                <div class="edit-isni-container" @onclick:stopPropagation>
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="text" class="form-control font-monospace py-2" @bind="_editedIsni" placeholder="0000 0001 2140 1961" />
                                        <button class="btn btn-primary px-3" @onclick="UpdateIsni">@L["Confirm"]</button>
                                        <button class="btn btn-outline-secondary" @onclick="CancelEditIsni"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="invalidIsniSwitch" @bind="_acceptInvalidIsni" />
                                        <label class="form-check-label text-muted" for="invalidIsniSwitch">@L["AcceptInvalidIsni"]</label>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    @if (string.IsNullOrEmpty(_authorDetails.Author.Isni.Value))
                                    {
                                        <span class="text-muted small fst-italic">@L["NoneNotSet"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge-sanctuary badge-neutral font-monospace">@_authorDetails.Author.Isni.Value</span>
                                    }
                                    @if (_authorDetails.Author.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditIsni" @onclick:stopPropagation><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>

                        @if (_isEditingImageUrl)
                        {
                            <div class="col-12 mt-4 animate-fade-in" @onclick:stopPropagation>
                                <div class="p-4 bg-surface-low rounded-xl border border-dashed border-primary-subtle shadow-sm">
                                    <label class="form-label small text-muted text-uppercase fw-bold mb-3 d-flex justify-content-between align-items-center">
                                        <span>@L["ModifyAuthorPortrait"]</span>
                                        @if (_isLookingUpImage) { <span class="spinner-border spinner-border-sm text-primary"></span> }
                                    </label>
                                    
                                    <div class="input-group shadow-sm rounded-3 overflow-hidden mb-4 border">
                                        <input type="text" class="form-control border-0 py-2 serif" 
                                               placeholder="@L["EnterPortraitUrlPlaceholder"]" 
                                               @bind="_editedImageUrl" />
                                        <button class="btn btn-white border-start" type="button" @onclick="LookupImage" disabled="@_isLookingUpImage">
                                            <i class="bi bi-magic me-2 text-primary"></i>@L["DiscoverPortrait"]
                                        </button>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(_editedImageUrl))
                                    {
                                        <div class="mb-4 text-center animate-fade-in">
                                            <p class="small text-muted mb-2 italic">@L["PortraitPreview"]</p>
                                            <div class="preview-circle bg-surface-container mx-auto rounded-circle overflow-hidden shadow-sm border border-4 border-white" style="width: 120px; height: 120px;">
                                                <img src="@_editedImageUrl" class="w-100 h-100" style="object-fit: cover;" @onerror="HandlePreviewError" />
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex gap-2 mt-2">
                                        <button class="btn btn-primary flex-grow-1" @onclick="UpdateImageUrl" disabled="@(string.IsNullOrWhiteSpace(_editedImageUrl))">
                                            <i class="bi bi-check2-circle me-2"></i>@L["FinalizePortraitUpdate"]
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="CancelEditImageUrl">@L["Discard"]</button>
                                        @if (_authorDetails.Author.ImageUri != null && FSharpOption<Uri>.get_IsSome(_authorDetails.Author.ImageUri))
                                        {
                                            <button class="btn btn-outline-danger" @onclick="RemoveImageUrl" title="@L["DiscardPortrait"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="col-12 mt-4">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["Biography"]</label>
                            @if (_isEditingBio)
                            {
                                <div class="p-4 bg-surface-low rounded-xl border shadow-sm" @onclick:stopPropagation>
                                    <div class="input-group shadow-sm rounded-3 overflow-hidden mb-3">
                                        <textarea class="form-control border-0 py-2 serif" rows="4" @bind="_editedBio"></textarea>
                                        <button class="btn btn-white border-start" type="button" @onclick="LookupBio" disabled="@_isSearchingBio">
                                            <i class="bi bi-wikipedia me-2 text-primary"></i>@L["Lookup"]
                                        </button>
                                    </div>
                                    @if (_candidateBios.Any())
                                    {
                                        <div class="list-group list-group-flush mb-3 border rounded overflow-auto" style="max-height: 150px;">
                                            @foreach (var bio in _candidateBios)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action py-2 small" @onclick="() => { _editedBio = bio; _candidateBios.Clear(); }">
                                                    @bio.Substring(0, Math.Min(bio.Length, 100))...
                                                </button>
                                            }
                                        </div>
                                    }
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary flex-grow-1" @onclick="UpdateBio">@L["Confirm"]</button>
                                        <button class="btn btn-outline-secondary" @onclick="() => _isEditingBio = false">@L["Discard"]</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-start gap-3 p-3 bg-surface-low rounded-xl">
                                    <p class="mb-0 text-muted serif italic" style="font-size: 0.95rem; line-height: 1.6;">
                                        @(string.IsNullOrWhiteSpace(_authorDetails.Author.Bio) ? L["NoBiographyRegistered"] : _authorDetails.Author.Bio)
                                    </p>
                                    @if (_authorDetails.Author.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditBio" @onclick:stopPropagation><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="col-12 mt-3">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["WikipediaLink"]</label>
                            @if (_isEditingWikipediaUri)
                            {
                                <div class="input-group input-group-sm" @onclick:stopPropagation>
                                    <input type="text" class="form-control bg-surface-low border-0" @bind="_editedWikipediaUri" placeholder="https://it.wikipedia.org/wiki/..." />
                                    <button class="btn btn-white border-start" type="button" @onclick="LookupWikipediaUri" disabled="@_isSearchingUri">
                                        <i class="bi bi-link-45deg text-primary"></i>
                                    </button>
                                    <button class="btn btn-primary" @onclick="UpdateWikipediaUri">@L["Confirm"]</button>
                                    <button class="btn btn-outline-secondary" @onclick="() => _isEditingWikipediaUri = false"><i class="bi bi-x-lg"></i></button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3">
                                    @if (_authorDetails.Author.WikipediaUri == null || FSharpOption<Uri>.get_IsNone(_authorDetails.Author.WikipediaUri))
                                    {
                                        <span class="text-muted small fst-italic">@L["NoneNotSet"]</span>
                                    }
                                    else
                                    {
                                        <a href="@_authorDetails.Author.WikipediaUri.Value.ToString()" target="_blank" class="text-primary text-decoration-none small d-flex align-items-center">
                                            <i class="bi bi-wikipedia me-2"></i> @_authorDetails.Author.WikipediaUri.Value.ToString()
                                        </a>
                                    }
                                    @if (_authorDetails.Author.Editable)
                                    {
                                        <button class="btn btn-link p-0 text-muted" @onclick="StartEditWikipediaUri" @onclick:stopPropagation><i class="bi bi-pencil-square"></i></button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Works Published Section -->
                <div class="card-sanctuary p-0 overflow-hidden">
                    <div class="px-5 pt-5 pb-4 d-flex justify-content-between align-items-end">
                        <h5 class="serif display-6 mb-0">@L["WorksPublished"]</h5>
                        <div class="badge-sanctuary badge-neutral">@_authorDetails.Books.Length @L["BooksInLibrary"]</div>
                    </div>

                    <div class="px-5 pb-5">
                        <div class="table-responsive">
                            <QuickGrid Items="@_authorDetails.Books.AsQueryable()" Pagination="@_bookPagination" Class="table table-editorial align-middle mb-0">
                                <TemplateColumn Title="@L["Title"]" SortBy="@_sortTitle" Class="col-title serif fw-bold">
                                    <a href="/book-view/@context.Id" class="text-decoration-none text-reset d-flex align-items-center gap-3 py-2">
                                        <div class="bg-surface-low rounded p-2" style="width: 40px; height: 55px; display: flex; align-items: center; justify-content: center;">
                                            @if (FSharpOption<Uri>.get_IsSome(context.ImageUrl))
                                            {
                                                <img src="@context.ImageUrl.Value.ToString()" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-journal-text opacity-25"></i>
                                            }
                                        </div>
                                        <span>@context.Title.Value</span>
                                    </a>
                                </TemplateColumn>
                                
                                <PropertyColumn Property="@(b => b.Year.Value)" Title="@L["Year"]" Sortable="true" Class="col-year text-muted" />
                                
                                <TemplateColumn Title="@L["Category"]" Sortable="true" Class="col-category">
                                    <span class="badge-sanctuary badge-neutral" style="font-size: 0.7rem;">@context.MainCategory.Value()</span>
                                </TemplateColumn>
                                
                                <TemplateColumn Title="@L["Availability"]" Sortable="true" Align="Align.End" Class="col-available">
                                    @if (context.Available)
                                    {
                                        <span class="text-success small fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>@L["Available"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold"><i class="bi bi-circle-fill me-2" style="font-size: 0.5rem;"></i>@L["OnLoan"]</span>
                                    }
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        
                        <div class="mt-4 d-flex justify-content-between align-items-center">
                            <div class="small text-muted serif italic">@L["Showing"] @Math.Min(_bookPagination.ItemsPerPage, _authorDetails.Books.Length) @L["Of"] @_authorDetails.Books.Length @L["CatalogedTitles"]</div>
                            <Paginator State="@_bookPagination" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!_isLoading && _authorDetails == null)
    {
        <div class="card-sanctuary text-center p-5">
            <i class="bi bi-exclamation-triangle display-4 text-warning mb-3"></i>
            <h4 class="serif">@L["ErrorLoadingAuthor"]</h4>
            <a href="/books-manager" class="btn-sanctuary-outline text-decoration-none d-inline-block mt-3">@L["BackToLibrary"]</a>
        </div>
    }
</div>
}

@code {
    private bool isAuthorized = false;
    private bool isPageLoading = true;

    [Parameter]
    public string AuthorIdStr { get; set; } = "";

    private async Task<UserContext> GetContext()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
    }

    private bool _isLoading = true;
    private Details.AuthorDetails? _authorDetails;
    private PaginationState _bookPagination = new() { ItemsPerPage = 10 };
    private GridSort<Book> _sortTitle = GridSort<Book>.ByAscending(b => b.Title.Value);
    
    private string _statusMessage = "";
    private string _statusClass = "alert-info";

    private bool _isEditingName = false;
    private string _editedName = "";
    
    private bool _isEditingIsni = false;
    private string _editedIsni = "";
    private bool _acceptInvalidIsni = false;

    private bool _isEditingImageUrl = false;
    private string _editedImageUrl = "";
    private bool _isLookingUpImage = false;

    private bool _isEditingBio = false;
    private string _editedBio = "";
    private bool _isSearchingBio = false;
    private List<string> _candidateBios = new();

    private bool _isEditingWikipediaUri = false;
    private string _editedWikipediaUri = "";
    private bool _isSearchingUri = false;

    private async Task LookupImage()
    {
        if (_authorDetails == null) return;
        
        _isLookingUpImage = true;
        _statusMessage = "Looking up author image...";
        _statusClass = "alert-info";
        StateHasChanged();

        try
        {
            var context = await this.GetContext();
            var result = await AuthorsSearchService.LookupImageUrlByNameAndThumbSizeAsync(context, _authorDetails.Author.Name.Value, FSharpOption<int>.None);
            if (result.IsOk)
            {
                _editedImageUrl = result.ResultValue;
                await ShowStatus("Image URL found. Please click 'Apply' to save.", "alert-info");
            }
            else
            {
                Logger.LogError("Error looking up author image for {Name}: {Error}", _authorDetails.Author.Name.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-warning");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while looking up author image for {Name}", _authorDetails.Author.Name.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
        finally
        {
            _isLookingUpImage = false;
        }
    }

    private bool isAuthorSealed => _authorDetails != null && _authorDetails.Author.Sealed.IsSealed(DateTime.UtcNow);

    private void StartEditImageUrl()
    {
        if (_authorDetails != null && _authorDetails.Author.Editable)
        {
            CancelAllEdits();
            _isEditingImageUrl = true;
            _editedImageUrl = _authorDetails.Author.ImageUri != null && FSharpOption<Uri>.get_IsSome(_authorDetails.Author.ImageUri) 
                ? _authorDetails.Author.ImageUri.Value.ToString() 
                : "";
        }
    }

    private void CancelEditImageUrl()
    {
        _isEditingImageUrl = false;
    }

    private void CancelAllEdits()
    {
        _isEditingName = false;
        _isEditingIsni = false;
        _isEditingImageUrl = false;
        _isEditingBio = false;
        _isEditingWikipediaUri = false;
    }

    private async Task UpdateImageUrl()
    {
        if (_authorDetails == null) return;
        
        if (string.IsNullOrWhiteSpace(_editedImageUrl))
        {
            await RemoveImageUrl();
            return;
        }

        if (!Uri.TryCreate(_editedImageUrl, UriKind.Absolute, out var newUri))
        {
            Logger.LogWarning("Invalid image URL format entered: {Url}", _editedImageUrl);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            return;
        }

        try
        {
            _statusMessage = "Validating image link...";
            _statusClass = "alert-info";
            StateHasChanged();

            // Perform broken link check
            using var client = new HttpClient();
            client.Timeout = TimeSpan.FromSeconds(5);
            // Wikipedia and some sites require a User-Agent
            client.DefaultRequestHeaders.UserAgent.ParseAdd("BlazorBookLibrary/1.0");
            
            using var response = await client.GetAsync(newUri, HttpCompletionOption.ResponseHeadersRead);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogError("Broken link check failed for URL {Url} with status code {StatusCode}", newUri, response.StatusCode);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
                return;
            }

            var context = await GetContext();
            var result = await AuthorService.UpdateImageUrlAsync(context, _authorDetails.Author.AuthorId, newUri);
            if (result.IsOk)
            {
                await LoadAuthorDetails();
                _isEditingImageUrl = false;
                await ShowStatus(L["ImageUrlUpdated"], "alert-success");
            }
            else
            {
                Logger.LogError("Error updating author image URL to {Url}: {Error}", newUri, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while updating author image URL to {Url}", newUri);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

    private async Task RemoveImageUrl()
    {
        if (_authorDetails == null) return;

        try
        {
            var context = await GetContext();
            var result = await AuthorService.RemoveImageUrlAsync(context, _authorDetails.Author.AuthorId);
            if (result.IsOk)
            {
                await LoadAuthorDetails();
                _isEditingImageUrl = false;
                await ShowStatus(L["ImageCoverRemoved"], "alert-success");
            }
            else
            {
                Logger.LogError("Error removing author image URL: {Error}", result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while removing author image URL");
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

    private async Task StartEditName()
    {
        if (_authorDetails != null && _authorDetails.Author.Editable)
        {
            _isEditingName = true;
            _editedName = _authorDetails.Author.Name.Value;
        }
        else if (isAuthorSealed)
        {
            await ShowStatus(L["AuthorLockedCannotEdit"], "alert-warning");
        }
    }

    private void CancelEditName()
    {
        _isEditingName = false;
    }

    private async Task UpdateName()
    {
        if (_authorDetails == null || string.IsNullOrWhiteSpace(_editedName) || _editedName == _authorDetails.Author.Name.Value)
        {
            _isEditingName = false;
            return;
        }

        try
        {
            var context = await GetContext();
            var newName = Name.New(_editedName);
            var result = await AuthorService.RenameAsync(context, _authorDetails.Author.AuthorId, newName);
            if (result.IsOk)
            {
                await LoadAuthorDetails();
                _isEditingName = false;
                await ShowStatus(L["AuthorNameUpdated"], "alert-success");
            }
            else
            {
                Logger.LogError("Error updating author name to {NewName}: {Error}", _editedName, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while updating author name to {NewName}", _editedName);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

    private async Task StartEditIsni()
    {
        if (_authorDetails != null && _authorDetails.Author.Editable)
        {
            _isEditingIsni = true;
            _editedIsni = _authorDetails.Author.Isni.Value;
            _acceptInvalidIsni = _authorDetails.Author.Isni.IsInvalidIsni;
        }
        else if (isAuthorSealed)
        {
            await ShowStatus("This author is currently locked. Please unlock (unseal) to edit.", "alert-warning");
        }
    }

    private void CancelEditIsni()
    {
        _isEditingIsni = false;
    }

    private async Task UpdateIsni()
    {
        if (_authorDetails == null) return;

        Isni newIsni;
        if (string.IsNullOrWhiteSpace(_editedIsni))
        {
            newIsni = Isni.NewEmpty();
        }
        else
        {
            var result = Isni.New(_editedIsni);
            if (result.IsOk)
            {
                newIsni = result.ResultValue;
            }
            else if (_acceptInvalidIsni)
            {
                newIsni = Isni.NewInvalid(_editedIsni);
            }
            else
            {
                Logger.LogWarning("Invalid ISNI value entered: {Error}", result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
                return;
            }
        }

        try
        {
            var context = await GetContext();
            var result = await AuthorService.UpdateIsniAsync(context, _authorDetails.Author.AuthorId, newIsni);
            if (result.IsOk)
            {
                await LoadAuthorDetails();
                _isEditingIsni = false;
                await ShowStatus(L["IsniUpdated"], "alert-success");
            }
            else
            {
                Logger.LogError("Error updating author ISNI: {Error}", result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while updating author ISNI");
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await UpdateName();
        }
        else if (e.Key == "Escape")
        {
            CancelEditName();
        }
    }


    private async Task DeleteAuthor()
    {
        if (_authorDetails == null) return;
        
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", string.Format(L["ConfirmPermanentlyDeleteAuthor"], _authorDetails.Author.Name.Value));
        if (!confirmed) return;
        
        try 
        {
            var context = await GetContext();
            var result = await AuthorService.RemoveAsync(context, _authorDetails.Author.AuthorId);
            if (result.IsOk)
            {
                NavigationManager.NavigateTo("/books-manager");
            }
            else
            {
                Logger.LogError("Error deleting author {AuthorId}: {Error}", _authorDetails.Author.AuthorId.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while deleting author {AuthorId}", _authorDetails.Author.AuthorId.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

    private async Task ToggleSeal()
    {
        if (_authorDetails == null) return;
        
        try
        {
            var context = await GetContext();
            var result = isAuthorSealed 
                ? await AuthorService.UnsealAsync(context, _authorDetails.Author.AuthorId)
                : await AuthorService.SealAsync(context, _authorDetails.Author.AuthorId);
                
            if (result.IsOk)
            {
                await LoadAuthorDetails();
                await ShowStatus(isAuthorSealed ? L["AuthorProfileLocked"] : L["AuthorProfileUnlocked"], "alert-success");
            }
            else
            {
                Logger.LogError("Error toggling seal state for author {AuthorId}: {Error}", _authorDetails.Author.AuthorId.Value, result.ErrorValue);
                await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while toggling seal state for author {AuthorId}", _authorDetails.Author.AuthorId.Value);
            await ShowStatus(L["ErrorOccurred"].Value, "alert-danger");
        }
    }

