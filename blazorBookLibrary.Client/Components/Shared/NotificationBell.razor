        z-index: 100;
        overflow: hidden;
        padding: 0;
        margin-top: 0.5rem;
    }

    .dropdown-header {
        padding: var(--spacing-3) var(--spacing-4);
        border-bottom: 1px solid var(--outline-variant);
        background: rgba(255, 255, 255, 0.4);
