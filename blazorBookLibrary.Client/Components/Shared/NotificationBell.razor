@using BookLibrary.Domain
@using BookLibrary.Shared.Services
@using BookLibrary.Shared
@using Microsoft.FSharp.Core
@using Microsoft.FSharp.Collections
@inject INotificationService NotificationService
@inject ITenantService TenantService
@inject IUserService UserService
@inject blazorBookLibrary.Client.Services.TenantStateService TenantState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="notification-container dropdown">
    <button class="btn-notification-bell dropdown-toggle-no-caret" 
            type="button" 
            id="notificationDropdownButton"
            data-bs-toggle="dropdown" 
            aria-expanded="false"
            aria-label="Notifications">
        <i class="bi bi-bell"></i>
        @if (unreadCount > 0)
        {
            <span class="notification-badge">@unreadCount</span>
        }
    </button>

    <div class="notification-dropdown dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="notificationDropdownButton">
        <div class="dropdown-header d-flex align-items-center justify-content-between">
            <span class="header-title">Notifications</span>
            @if (unreadCount > 0)
            {
                <a href="/Notifications/MarkAllAsRead?returnUrl=@currentUrl" class="btn-mark-all-read btn-link text-decoration-none">Mark all as read</a>
            }
        </div>

        <div class="dropdown-body">
            @if (notifications == null || !notifications.Any())
            {
                <div class="dropdown-placeholder text-muted py-4">
                    <i class="bi bi-bell-slash fs-3 d-block mb-2"></i>
                    <span>No new notifications</span>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var notif in notifications)
                    {
                        var notifUrl = FSharpOption<string>.get_IsSome(notif.ActionUrl) ? notif.ActionUrl.Value : "";
                        var clickUrl = $"/Notifications/HandleClick?notificationId={notif.NotificationId.Value}&redirectUrl={Uri.EscapeDataString(notifUrl)}";

                        <div class="notification-item @(notif.IsRead ? "" : "unread")">
                            <a href="@clickUrl" class="notif-content-wrapper text-decoration-none text-dark">
                                <div class="notif-icon-box">
                                    @if (notif.Title.Contains("Public Request"))
                                    {
                                        <i class="bi bi-globe text-info"></i>
                                    }
                                    else if (notif.Title.Contains("Invite") || notif.Title.Contains("Onboarding"))
                                    {
                                        <i class="bi bi-envelope-open text-primary"></i>
                                    }
                                    else if (notif.Title.Contains("Request"))
                                    {
                                        <i class="bi bi-person-plus text-warning"></i>
                                    }
                                    else if (notif.Title.Contains("Approved"))
                                    {
                                        <i class="bi bi-check-circle text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-bell text-secondary"></i>
                                    }
                                </div>
                                <div class="notif-details">
                                    <h5 class="notif-title">@notif.Title</h5>
                                    <p class="notif-text">@notif.Content</p>
                                    <span class="notif-time">@GetTimeAgo(notif.CreatedAt)</span>
                                </div>
                            </a>

                            @if (notif.Title.Contains("Invitation") && FSharpOption<string>.get_IsSome(notif.ActionUrl))
                            {
                                var (tenantIdStr, codeStr) = ParseInvitationParams(notif.ActionUrl.Value);
                                var acceptUrl = $"/Notifications/AcceptInvitation?notificationId={notif.NotificationId.Value}&tenantId={tenantIdStr}&code={codeStr}";
                                var dismissUrl = $"/Notifications/Dismiss?notificationId={notif.NotificationId.Value}&returnUrl={Uri.EscapeDataString(currentUrl ?? "/")}";

                                <div class="notif-actions mt-2 d-flex gap-2">
                                    <a href="@acceptUrl" class="btn btn-sm btn-primary py-1 px-3 radius-full text-decoration-none">Accept</a>
                                    <a href="@dismissUrl" class="btn btn-sm btn-outline-secondary py-1 px-3 radius-full text-decoration-none">Dismiss</a>
                                </div>
                            }
                            else if (notif.Title.Contains("Join Request") && FSharpOption<string>.get_IsSome(notif.ActionUrl))
                            {
                                var (tenantIdStr, requesterIdStr) = ParseJoinRequestParams(notif.ActionUrl.Value);
                                var approveUrl = $"/Notifications/ApproveJoin?notificationId={notif.NotificationId.Value}&tenantId={tenantIdStr}&requesterId={requesterIdStr}";
                                var rejectUrl = $"/Notifications/RejectJoin?notificationId={notif.NotificationId.Value}&tenantId={tenantIdStr}&requesterId={requesterIdStr}&returnUrl={Uri.EscapeDataString(currentUrl ?? "/")}";

                                <div class="notif-actions mt-2 d-flex gap-2">
                                    <a href="@approveUrl" class="btn btn-sm btn-success py-1 px-3 radius-full text-decoration-none">Approve</a>
                                    <a href="@rejectUrl" class="btn btn-sm btn-outline-danger py-1 px-3 radius-full text-decoration-none">Reject</a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (isAdmin && publicRequestTenants.Count > 1)
{
    var visibleDialogs = publicRequestTenants
        .Where(t => !ignoredTenantIds.Contains(t.TenantId.Value))
        .ToList();

    // we'll take care of this later
    @* if (visibleDialogs.Any()) *@
    if (false)
    {
        <div class="admin-dialog-deck">
            @{
                var displayedDialogs = visibleDialogs.Take(3).ToList();
                var remainingCount = visibleDialogs.Count - displayedDialogs.Count;
            }

            @foreach (var (tenant, index) in displayedDialogs.Select((t, i) => (t, i)))
            {
                ownerUsers.TryGetValue(tenant.OwnerId.Value, out var owner);
                var ownerName = owner != null ? $"{owner.AppUserInfo.Nome} {owner.AppUserInfo.Cognome}" : "Loading...";
                var ownerEmail = owner != null ? owner.AppUserInfo.Email : "...";

                <div class="admin-dialog-card shadow-lg animate-card-slide" style="--card-index: @index; z-index: @(2000 - index);">
                    <div class="admin-card-glass-bg"></div>
                    <div class="admin-card-header d-flex justify-content-between align-items-center">
                        <span class="admin-card-badge"><i class="bi bi-globe me-1"></i> Public Request</span>
                        <button type="button" class="btn-close btn-close-white small-close" @onclick="() => HandleIgnore(tenant)" aria-label="Ignore"></button>
                    </div>
                    <div class="admin-card-body">
                        <h4 class="tenant-title serif text-truncate">@tenant.Name.Value</h4>
                        <div class="tenant-meta small mb-3">
                            <div class="meta-item"><i class="bi bi-geo-alt-fill text-muted me-1"></i> @(string.IsNullOrWhiteSpace(tenant.Address) ? "Unspecified Address" : tenant.Address)</div>
                            <div class="meta-item mt-1"><i class="bi bi-person-fill text-muted me-1"></i> <strong>Owner:</strong> @ownerName</div>
                            <div class="meta-item mt-0.5"><i class="bi bi-envelope-fill text-muted me-1"></i> @ownerEmail</div>
                        </div>
                        <p class="card-prompt small text-muted">Would you like to approve this library's request to go public, or push it back to private?</p>
                    </div>
                    <div class="admin-card-footer d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-approve flex-grow-1" @onclick="() => HandleSetPublic(tenant)" disabled="@isHandlingRequest">
                            <i class="bi bi-check-circle-fill me-1"></i> Approve
                        </button>
                        <button type="button" class="btn btn-sm btn-pushback flex-grow-1" @onclick="() => HandleSetPrivate(tenant)" disabled="@isHandlingRequest">
                            <i class="bi bi-slash-circle-fill me-1"></i> Push Private
                        </button>
                        <button type="button" class="btn btn-sm btn-ignore" @onclick="() => HandleIgnore(tenant)" title="Ignore">
                            Ignore
                        </button>
                    </div>
                </div>
            }

            @if (remainingCount > 0)
            {
                <div class="admin-dialog-queue-badge shadow-sm">
                    <i class="bi bi-layers-fill me-1"></i> +@remainingCount more requests in queue
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public string? currentUrl { get; set; }

    private List<Notification> notifications = new();
    private int unreadCount = 0;
    private Commons.UserContext? userContext;
    private bool isAdmin = false;

    private List<Tenant> publicRequestTenants = new();
    private Dictionary<Guid, User> ownerUsers = new();
    private HashSet<Guid> ignoredTenantIds = new();
    private bool isHandlingRequest = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            userContext = TenantState.GetUserContext(authState.User);
            if (userContext != null)
            {
                isAdmin = userContext.IsInRole(BookLibrary.Shared.Commons.Role.Admin);
                try
                {
                    var result = await NotificationService.GetUnreadNotificationsForUserAsync(userContext, FSharpOption<CancellationToken>.None);
                    if (result.IsOk)
                    {
                        notifications = result.ResultValue.ToList();
                    }

                    if (isAdmin)
                    {
                        var publicTenantsResult = await TenantService.GetTenantsRequstingPublicAsync(userContext, FSharpOption<CancellationToken>.None);
                        if (publicTenantsResult.IsOk)
                        {
                            publicRequestTenants = publicTenantsResult.ResultValue.ToList();
                            
                            // Load owner users info asynchronously
                            foreach (var tenant in publicRequestTenants)
                            {
                                var userRes = await UserService.GetUserAsync(userContext, tenant.OwnerId, FSharpOption<CancellationToken>.None);
                                if (userRes.IsOk)
                                {
                                    ownerUsers[tenant.OwnerId.Value] = userRes.ResultValue;
                                }
                            }

                            // If count is greater than 1, inject virtual notifications
                            if (publicRequestTenants.Count > 1)
                            {
                                foreach (var tenant in publicRequestTenants)
                                {
                                    var ownerName = ownerUsers.TryGetValue(tenant.OwnerId.Value, out var owner) 
                                        ? $"{owner.AppUserInfo.Nome} {owner.AppUserInfo.Cognome}"
                                        : tenant.OwnerId.Value.ToString();
                                    
                                    var virtualNotif = new Notification(
                                        NotificationId.NewNotificationId(Guid.NewGuid()),
                                        userContext.UserId.Value,
                                        "Public Request: " + tenant.Name.Value,
                                        $"Library '{tenant.Name.Value}' requested public access (Owner: {ownerName}).",
                                        false,
                                        DateTime.UtcNow,
                                        FSharpOption<string>.Some($"/tenants/{tenant.TenantId.Value}")
                                    );
                                    notifications.Insert(0, virtualNotif);
                                }
                            }
                        }
                    }

                    unreadCount = notifications.Count;
                }
                catch (Exception)
                {
                    // Fail silently
                }
            }
        }
    }

    private async Task HandleSetPublic(Tenant tenant)
    {
        if (userContext == null || isHandlingRequest) return;
        isHandlingRequest = true;
        try
        {
            var result = await TenantService.SetPublicAsync(userContext, tenant.TenantId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", $"Library '{tenant.Name.Value}' is now Public!", "success");
                publicRequestTenants.Remove(tenant);
                var virtualNotif = notifications.FirstOrDefault(n => n.Title.Contains(tenant.Name.Value));
                if (virtualNotif != null)
                {
                    notifications.Remove(virtualNotif);
                }
                unreadCount = notifications.Count;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showToast", $"Failed to approve: {ex.Message}", "error");
        }
        finally
        {
            isHandlingRequest = false;
            StateHasChanged();
        }
    }

    private async Task HandleSetPrivate(Tenant tenant)
    {
        if (userContext == null || isHandlingRequest) return;
        isHandlingRequest = true;
        try
        {
            var result = await TenantService.SetPrivateAsync(userContext, tenant.TenantId, FSharpOption<CancellationToken>.None);
            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("showToast", $"Library '{tenant.Name.Value}' reverted to Private.", "success");
                publicRequestTenants.Remove(tenant);
                var virtualNotif = notifications.FirstOrDefault(n => n.Title.Contains(tenant.Name.Value));
                if (virtualNotif != null)
                {
                    notifications.Remove(virtualNotif);
                }
                unreadCount = notifications.Count;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showToast", result.ErrorValue, "error");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showToast", $"Failed to push back: {ex.Message}", "error");
        }
        finally
        {
            isHandlingRequest = false;
            StateHasChanged();
        }
    }

    private void HandleIgnore(Tenant tenant)
    {
        ignoredTenantIds.Add(tenant.TenantId.Value);
        StateHasChanged();
    }

    private string GetTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt.ToUniversalTime();
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        return $"{dt.ToString("dd MMM")}";
    }

    private (string tenantId, string code) ParseInvitationParams(string actionUrl)
    {
        try
        {
            var uri = new Uri(NavigationManager.ToAbsoluteUri(actionUrl).ToString());
            var queryStr = uri.Query.TrimStart('?');
            var query = queryStr.Split(new[] { '&' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Split('='))
                .ToDictionary(p => p[0], p => p.Length > 1 ? Uri.UnescapeDataString(p[1]) : "", StringComparer.OrdinalIgnoreCase);

            query.TryGetValue("tenantId", out var tenantId);
            query.TryGetValue("code", out var code);
            return (tenantId ?? "", code ?? "");
        }
        catch
        {
            return ("", "");
        }
    }

    private (string tenantId, string requesterId) ParseJoinRequestParams(string actionUrl)
    {
        try
        {
            var parts = actionUrl.Split('/');
            var tenantId = parts.Length >= 3 ? parts[2] : "";
            
            // Check query string for requesterId
            var requesterId = "";
            if (actionUrl.Contains("?"))
            {
                var queryPart = actionUrl.Split('?')[1];
                var queryParts = queryPart.Split(new[] { '&' }, StringSplitOptions.RemoveEmptyEntries);
                foreach (var p in queryParts)
                {
                    var kv = p.Split('=');
                    if (kv.Length >= 2 && kv[0].Equals("requesterId", StringComparison.OrdinalIgnoreCase))
                    {
                        requesterId = Uri.UnescapeDataString(kv[1]);
                        break;
                    }
                }
            }
            // Remove query params from tenantId if it somehow got appended
            if (tenantId.Contains("?"))
            {
                tenantId = tenantId.Split('?')[0];
            }
            return (tenantId, requesterId);
        }
        catch
        {
            return ("", "");
        }
    }
}

<style>
    .notification-container {
        position: relative;
        display: inline-block;
    }

    .btn-notification-bell {
        background: none;
        border: none;
        color: var(--primary);
        font-size: 1.35rem;
        cursor: pointer;
        position: relative;
        padding: 4px;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-notification-bell:hover {
        background-color: var(--surface-container);
        transform: scale(1.1) rotate(5deg);
    }

    .dropdown-toggle-no-caret {
        background: none;
        border: none;
    }

    .dropdown-toggle-no-caret::after {
        display: none !important;
    }

    .notification-badge {
        position: absolute;
        top: -2px;
        right: -2px;
        background: linear-gradient(135deg, #e06c75, #d14a5b);
        color: white;
        border-radius: 50%;
        padding: 2px 6px;
        font-size: 0.65rem;
        font-weight: 800;
        min-width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 5px rgba(224, 108, 117, 0.4);
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.15); }
        100% { transform: scale(1); }
    }

    .notification-dropdown {
        position: absolute;
        right: 0;
        top: 2.8rem;
        width: 340px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: var(--radius-lg);
