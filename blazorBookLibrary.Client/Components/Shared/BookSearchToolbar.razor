@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.FSharp.Collections
@using Microsoft.FSharp.Core
@using System.Threading
@using BookLibrary.Domain
@using BookLibrary.Shared
@using static BookLibrary.Shared.Commons
@using blazorBookLibrary.Shared.Security
@inject IBookService BookService
@inject IAuthorService AuthorService
@inject ITenantService TenantService
@inject ITextEmbeddingService TextEmbeddingService
@inject IVectorDbService VectorDbService
@inject IJSRuntime JSRuntime
@inject IAdminServices AdminService
@inject IDistributionPointService DistributionPointService
@inject IStringLocalizer<SharedResources> L
@inject ILogger<BookSearchToolbar> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService
@implements IDisposable

<div class="card-sanctuary bg-surface-lowest floating mb-3 p-0 overflow-hidden">
    <div class="px-3 px-md-5 pt-3 pt-md-4 pb-4">
        
        <EditForm Model="@this" OnValidSubmit="HandleBookSearch" FormName="SearchBookComponentForm">
            @if (searchMode == "Simple" || searchMode == "Advanced")
            {
                <!-- The Entryway: Main Title Search with Autocomplete -->
                <div class="position-relative mb-2">
                    <div class="d-flex align-items-stretch">
                        <div class="position-relative flex-grow-1">
                            <input type="text" 
                                   class="search-entryway w-100" 
                                   value="@searchBookTitle" 
                                   @oninput="HandleTitleInput" 
                                   @onkeydown="HandleTitleKeyDown"
                                   @onfocus="HandleTitleFocus"
                                   @onblur="HandleTitleBlur"
                                   placeholder="@L["SearchByTitlePlaceholder"]" 
                                   role="combobox"
                                   aria-autocomplete="list"
                                   aria-expanded="@(showAutocompleteDropdown ? "true" : "false")"
                                   aria-controls="title-autocomplete-dropdown"
                                   style="border-top-right-radius: 0; border-bottom-right-radius: 0; border-right: none; padding-right: @(isLoadingAutocomplete ? "2.5rem" : "1.5rem");" />
                            @if (isLoadingAutocomplete)
                            {
                                <div class="position-absolute top-50 translate-middle-y end-0 me-3 text-muted">
                                    <span class="spinner-border spinner-border-sm text-primary" role="status" style="width: 1rem; height: 1rem;"></span>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn-sanctuary-primary d-flex align-items-center justify-content-center px-3 px-md-4" 
                                disabled="@_isLoading" style="border-top-left-radius: 0; border-bottom-left-radius: 0; white-space: nowrap;">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search"></i>
                            }
                            <span class="d-none d-md-inline ms-2">@L["Search"]</span>
                        </button>
                    </div>

                    @if (showAutocompleteDropdown && autocompleteSuggestions.Any())
                    {
                        <div id="title-autocomplete-dropdown" 
                             class="autocomplete-dropdown-panel shadow-lg border-0 bg-surface-lowest position-absolute start-0 end-0 mt-1" 
                             role="listbox"
                             style="z-index: 1050; border-radius: var(--radius-lg, 14px); overflow: hidden; border: 1px solid var(--outline-variant, #e0e0e0) !important;">
                            <div class="py-1" style="max-height: 380px; overflow-y: auto;">
                                @for (int i = 0; i < autocompleteSuggestions.Count; i++)
                                {
                                    var item = autocompleteSuggestions[i];
                                    var isSelected = (i == activeSuggestionIndex);
                                    <div class="autocomplete-item px-3 py-2 d-flex align-items-center justify-content-between @(isSelected ? "bg-surface-high text-primary" : "")"
                                         role="option"
                                         aria-selected="@(isSelected ? "true" : "false")"
                                         id="@($"suggestion-item-{i}")"
                                         style="cursor: pointer; transition: background-color 0.15s ease;"
                                         @onmousedown="() => SelectSuggestion(item)">
                                        <div class="d-flex align-items-center gap-3 overflow-hidden me-2">
                                            <div class="flex-shrink-0 bg-surface-low rounded d-flex align-items-center justify-content-center overflow-hidden" 
                                                 style="width: 36px; height: 50px;">
                                                @if (item.ImageUrl != null && FSharpOption<string>.get_IsSome(item.ImageUrl) && !string.IsNullOrWhiteSpace(item.ImageUrl.Value))
                                                {
                                                    <img src="@item.ImageUrl.Value" alt="@item.Title" style="max-width: 100%; max-height: 100%; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-journal-text text-muted opacity-50" style="font-size: 1.2rem;"></i>
                                                }
                                            </div>
                                            <div class="text-truncate">
                                                <div class="fw-bold text-truncate text-serif" style="font-size: 0.95rem;">@item.Title</div>
                                                <div class="small text-muted text-truncate d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(item.Authors))
                                                    {
                                                        <span><i class="bi bi-person me-1"></i>@item.Authors</span>
                                                    }
                                                    @if (item.Year != null && FSharpOption<int>.get_IsSome(item.Year))
                                                    {
                                                        <span class="opacity-75">(@item.Year.Value)</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.MainCategory))
                                                    {
                                                        <span class="badge-sanctuary badge-neutral ms-1" style="font-size: 0.7rem; padding: 2px 6px;">@item.MainCategory</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0 text-end d-flex align-items-center gap-2">
                                            @if (item.AvailabilityStatus == BookLibrary.Shared.Commons.AvailabilityStatus.Available)
                                            {
                                                <span class="badge bg-success-subtle text-success small rounded-pill px-2 py-1"><i class="bi bi-check-circle me-1"></i>@L["Available"]</span>
                                            }
                                            else if (item.AvailabilityStatus == BookLibrary.Shared.Commons.AvailabilityStatus.Reserved)
                                            {
                                                <span class="badge bg-warning-subtle text-warning small rounded-pill px-2 py-1"><i class="bi bi-clock-history me-1"></i>@L["Reserved"]</span>
                                            }
                                            else if (item.AvailabilityStatus == BookLibrary.Shared.Commons.AvailabilityStatus.NotAvailable)
                                            {
                                                <span class="badge bg-danger-subtle text-danger small rounded-pill px-2 py-1"><i class="bi bi-x-circle me-1"></i>@L["NotAvailable"]</span>
                                            }
                                            else if (item.AvailabilityStatus == BookLibrary.Shared.Commons.AvailabilityStatus.Consultable)
                                            {
                                                <span class="badge bg-info-subtle text-info small rounded-pill px-2 py-1"><i class="bi bi-eye me-1"></i>@L["Consultable"]</span>
                                            }
                                            <a href="/book-view/@item.BookId" 
                                               class="btn btn-sm btn-link text-muted p-1 hover-primary"
                                               title="@L["BookDetails"]"
                                               @onmousedown:stopPropagation="true">
                                                <i class="bi bi-arrow-up-right-square fs-6"></i>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center mb-4 mb-md-5 ms-1">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="includePapersInTitleSearch" @bind="includePapersInTitleSearch" />
                        <label class="form-check-label x-small text-muted" for="includePapersInTitleSearch">
                            <i class="bi bi-file-earmark-text me-1"></i>@L["IncludePapersInTitleSearch"]
                        </label>
                    </div>
                </div>
            }

            @if (searchMode == "AI")
            {
                <!-- AI Semantic Discovery Region -->
                <div class="bg-surface-low rounded-xl p-3 p-md-4 mb-4 border border-primary-subtle border-opacity-25 shadow-sm">
                     <h6 class="serif mb-3 small text-primary text-uppercase fw-bold letter-spacing-1 d-flex align-items-center gap-2">
                          <i class="bi bi-magic"></i> @L["AISemanticDiscovery"]
                      </h6>
                      <div class="row g-3 align-items-end">
                          <div class="col-12">
                              <label class="form-label x-small text-muted text-uppercase fw-bold mb-2">@L["ConceptualDescription"]</label>
                              <div class="d-flex align-items-stretch">
                                  <InputText class="form-control bg-surface-lowest border-0 shadow-sm py-2 flex-grow-1" 
                                             @bind-Value="semanticSearchText" 
                                             placeholder="@L["SemanticSearchPlaceholder"]" 
                                             style="border-top-right-radius: 0; border-bottom-right-radius: 0; border-top-left-radius: var(--radius-lg); border-bottom-left-radius: var(--radius-lg);" />
                                  <button type="submit" class="btn-sanctuary-primary d-flex align-items-center justify-content-center px-3 px-md-4" 
                                          disabled="@_isLoading" style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: var(--radius-lg); border-bottom-right-radius: var(--radius-lg); white-space: nowrap;">
                                      @if (_isLoading)
                                      {
                                          <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                      }
                                      else
                                      {
                                          <i class="bi bi-search"></i>
                                      }
                                      <span class="d-none d-md-inline ms-2">@L["Search"]</span>
                                  </button>
                              </div>
                          </div>
                      </div>
                      <p class="x-small text-muted mt-2 mb-0 italic">@L["SemanticSearchHelp"]</p>
                </div>
            }


            <!-- Segmented Capsule Search Mode Switcher -->
            <div class="search-toggle-container">
                <div class="search-toggle-pill">
                    <button type="button" class="search-toggle-btn @(searchMode == "Simple" ? "active" : "")" @onclick='() => searchMode = "Simple"'>
                        <i class="bi bi-search"></i> @L["SimpleSearch"]
                    </button>
                    <button type="button" class="search-toggle-btn @(searchMode == "Advanced" ? "active" : "")" @onclick='() => searchMode = "Advanced"'>
                        <i class="bi bi-sliders"></i> @L["AdvancedSearch"]
                        @if (ActiveAdvancedFiltersCount > 0)
                        {
                            <span class="search-toggle-badge">@ActiveAdvancedFiltersCount</span>
                        }
                    </button>
                    <button type="button" class="search-toggle-btn @(searchMode == "AI" ? "active" : "")" @onclick='() => searchMode = "AI"'>
                        <i class="bi bi-magic"></i> @L["AISearch"]
                    </button>
                </div>
            </div>

            @if (searchMode == "Advanced")
            {
                <div class="bg-surface-low rounded-xl p-3 p-md-5 advanced-filters-panel mb-4">
                    <div class="row g-4 g-md-5">
                    <!-- Column 1: ISBN & Category -->
                    <div class="col-lg-4">
                        <h6 class="serif mb-3 mb-md-4 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">@L["CoreIdentifiers"]</h6>
                        
                        <div class="mb-3 mb-md-4">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["ISBN"]</label>
                            <InputText class="form-control bg-surface-lowest border-0 rounded-lg shadow-sm py-2 py-md-3" @bind-Value="searchBookIsbn" placeholder="@L["PartialIsbnPlaceholder"]" />
                        </div>

                        <div class="mb-3 mb-md-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small text-muted text-uppercase fw-bold mb-0">@L["SbnIdentifier"]</label>
                                <select class="form-select form-select-sm bg-surface-lowest border-0 shadow-xs py-0 px-2 text-muted" style="width: auto; font-size: 0.75rem;" @bind="sbnSearchMode">
                                    <option value="contains">@L["Contains"]</option>
                                    <option value="exact">@L["Exact"]</option>
                                    <option value="hasSbn">@L["HasSbnCode"]</option>
                                    <option value="missingSbn">@L["MissingSbnCode"]</option>
                                </select>
                            </div>
                            @if (sbnSearchMode != "hasSbn" && sbnSearchMode != "missingSbn")
                            {
                                <InputText class="form-control bg-surface-lowest border-0 rounded-lg shadow-sm py-2 py-md-3 font-monospace" @bind-Value="searchBookSbnCode" placeholder="@L["PartialSbnPlaceholder"]" />
                            }
                        </div>

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small text-muted text-uppercase fw-bold mb-0">@L["RefineByCategory"]</label>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" id="includePapersInCategories" @bind="includePapersInCategoriesSearch" />
                                    <label class="form-check-label x-small text-muted" for="includePapersInCategories">
                                        <i class="bi bi-file-earmark-text me-1"></i>@L["IncludePapers"]
                                    </label>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <select class="form-select bg-surface-lowest border-0 rounded-lg shadow-sm py-2 py-md-3" @bind="selectedCategoryForFilter">
                                    <option value="">@L["SelectCategoryPlaceholder"]</option>
                                    @foreach (var category in allCategories)
                                    {
                                        <option value="@category.Value()">@category.Value()</option>
                                    }
                                </select>
                                <button type="button" class="btn-sanctuary-outline bg-surface-lowest px-3" @onclick="AddCategoryToSearchCriteria" disabled="@(string.IsNullOrEmpty(selectedCategoryForFilter))">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            
                            <div class="mt-3 d-flex flex-wrap gap-2">
                                @foreach (var category in searchCategoriesCriteria)
                                {
                                    <span class="badge-sanctuary badge-neutral">
                                        @category.Value()
                                        <i class="bi bi-x-circle-fill ms-2" style="cursor: pointer" @onclick="() => RemoveCategoryFromSearchCriteria(category)"></i>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small text-muted text-uppercase fw-bold mb-0">@L["FilterByTags"]</label>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="checkbox" id="includePapersInTags" @bind="includePapersInTagsSearch" />
                                    <label class="form-check-label x-small text-muted" for="includePapersInTags">
                                        <i class="bi bi-file-earmark-text me-1"></i>@L["IncludePapers"]
                                    </label>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <select class="form-select bg-surface-lowest border-0 rounded-lg shadow-sm py-2" @bind="selectedTagNameForFilter">
                                    <option value="">@L["SelectTagPlaceholder"]</option>
                                    @foreach (var tag in allBookTags)
                                    {
                                        if (!searchTagsCriteria.Contains(tag))
                                        {
                                            <option value="@tag.TagName">@tag.TagName</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn-sanctuary-outline bg-surface-lowest px-3" @onclick="AddTagToSearchCriteria" disabled="@(string.IsNullOrEmpty(selectedTagNameForFilter))">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            
                            <div class="mt-3 d-flex flex-wrap gap-2">
                                @foreach (var tag in searchTagsCriteria)
                                {
                                    <span class="badge-sanctuary badge-neutral">
                                        @tag.TagName
                                        <i class="bi bi-x-circle-fill ms-2" style="cursor: pointer" @onclick="() => RemoveTagFromSearchCriteria(tag)"></i>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Authors -->
                    <div class="col-lg-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">
                            <h6 class="serif mb-0">@L["Authorship"]</h6>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="checkbox" id="includePapersInAuthors" @bind="includePapersInAuthorsSearch" />
                                <label class="form-check-label x-small text-muted" for="includePapersInAuthors">
                                    <i class="bi bi-file-earmark-text me-1"></i>@L["IncludePapers"]
                                </label>
                            </div>
                        </div>
                        
                        <div class="position-relative">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["SearchAuthorNamePlaceholder"]</label>
                            <div class="input-group bg-surface-lowest rounded-lg shadow-sm overflow-hidden">
                                <input type="text" 
                                       class="form-control border-0 py-2 py-md-3" 
                                       value="@authorSearchNameFilter"
                                       @oninput="HandleAuthorSearchInput"
                                       @onfocus='() => { if(foundAuthorsForFilter.Any()) showAuthorSearchResults = true; }' />
                                <button type="button" class="btn btn-link text-primary border-0 p-2 p-md-3" @onclick="AddAuthorToSearchCriteria" disabled="@(selectedAuthorFromResults == null)">
                                    <i class="bi bi-person-plus-fill fs-4"></i>
                                </button>
                            </div>
                            
                            @if (showAuthorSearchResults)
                            {
                                <div class="list-group position-absolute w-100 shadow mt-1 glass border-0" style="z-index: 1100; max-height: 250px; overflow-y: auto; border-radius: var(--radius-lg);">
                                    @foreach (var author in foundAuthorsForFilter)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action bg-transparent border-0 py-2" @onclick="() => SelectAuthorFromResults(author)">
                                            @author.Name.Value
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="mt-4 d-flex flex-wrap gap-2">
                            @if (!searchAuthorsCriteria.Any())
                            {
                                <p class="text-muted small fst-italic">@L["NoAuthorsSelected"]</p>
                            }
                            @foreach (var author in searchAuthorsCriteria)
                            {
                                <span class="badge-sanctuary badge-neutral">
                                    @author.Name.Value
                                    <i class="bi bi-x-circle-fill ms-2" style="cursor: pointer" @onclick="() => RemoveAuthorFromSearchCriteria(author)"></i>
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Column 3: Year & Availability -->
                    <div class="col-lg-4">
                        <h6 class="serif mb-3 mb-md-4 pb-2 border-bottom" style="border-color: var(--outline-variant) !important;">@L["TimelineStatus"]</h6>
                        
                        <div class="mb-4">
                            <div class="btn-group w-100 shadow-sm rounded-lg overflow-hidden mb-3">
                                <button type="button" class="btn btn-xs btn-light py-2 @(yearSearchMode == "exact" ? "active" : "")" @onclick='() => yearSearchMode = "exact"'>@L["Exact"]</button>
                                <button type="button" class="btn btn-xs btn-light py-2 @(yearSearchMode == "after" ? "active" : "")" @onclick='() => yearSearchMode = "after"'>@L["From"]</button>
                                <button type="button" class="btn btn-xs btn-light py-2 @(yearSearchMode == "before" ? "active" : "")" @onclick='() => yearSearchMode = "before"'>@L["To"]</button>
                                <button type="button" class="btn btn-xs btn-light py-2 @(yearSearchMode == "between" ? "active" : "")" @onclick='() => yearSearchMode = "between"'>@L["Range"]</button>
                            </div>
                            <div class="row g-2">
                                <div class="col">
                                    <InputNumber class="form-control bg-surface-lowest border-0 rounded-lg shadow-sm py-2" @bind-Value="searchBookYear" placeholder="@L["Year"]" />
                                </div>
                                @if (yearSearchMode == "between")
                                {
                                    <div class="col">
                                        <InputNumber class="form-control bg-surface-lowest border-0 rounded-lg shadow-sm py-2" @bind-Value="searchBookYearTo" placeholder="@L["To"]" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div>
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["AvailabilityFilters"]</label>
                            <select class="form-select bg-surface-lowest border-0 rounded-lg shadow-sm py-2" @bind="searchBookAvailability">
                                <option value="All">@L["AllBooks"]</option>
                                <option value="Circulating">@L["CirculatingRule"]</option>
                                <option value="ReferenceOnly">@L["ReferenceOnlyRule"]</option>
                                <option value="ImmediatelyAvailable">@L["ImmediatelyAvailableOnly"]</option>
                            </select>
                        </div>

                        <div class="mt-4">
                            <label class="form-label small text-muted text-uppercase fw-bold mb-2">@L["FilterByDistributionPoint"]</label>
                            <div class="d-flex gap-2">
                                <select class="form-select bg-surface-lowest border-0 rounded-lg shadow-sm py-2" @bind="selectedDistributionPointIdForFilter">
                                    <option value="">@L["SelectDistributionPoint"]</option>
                                    @foreach (var dp in allDistributionPoints)
                                    {
                                        if (!searchDistributionPointsCriteria.Any(x => x.DistributionPointId == dp.DistributionPointId))
                                        {
                                            <option value="@dp.DistributionPointId.Value.ToString()">@dp.Name.Value</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn-sanctuary-outline bg-surface-lowest px-3" @onclick="AddDistributionPointToSearchCriteria" disabled="@(string.IsNullOrEmpty(selectedDistributionPointIdForFilter))">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            
                            <div class="mt-3 d-flex flex-wrap gap-2">
                                @foreach (var dp in searchDistributionPointsCriteria)
                                {
                                    <span class="badge-sanctuary badge-neutral">
                                        @dp.Name.Value
                                        <i class="bi bi-x-circle-fill ms-2" style="cursor: pointer" @onclick="() => RemoveDistributionPointFromSearchCriteria(dp)"></i>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            }


        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback<List<BookSearchResult>> OnSearchResultsFound { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback<bool> OnSearchStarted { get; set; }
    [Parameter] public string? InitialDistributionPointId { get; set; }

    private string searchMode = "Simple";

    private int ActiveAdvancedFiltersCount
    {
        get
        {
            int count = 0;
            if (!string.IsNullOrWhiteSpace(searchBookIsbn)) count++;
            if (sbnSearchMode == "hasSbn" || sbnSearchMode == "missingSbn" || !string.IsNullOrWhiteSpace(searchBookSbnCode)) count++;
            if (searchCategoriesCriteria != null && searchCategoriesCriteria.Any()) count++;
            if (searchTagsCriteria != null && searchTagsCriteria.Any()) count++;
            if (searchAuthorsCriteria != null && searchAuthorsCriteria.Any()) count++;
            if (searchBookYear.HasValue) count++;
            if (!string.IsNullOrEmpty(searchBookAvailability) && searchBookAvailability != "All") count++;
            if (searchDistributionPointsCriteria != null && searchDistributionPointsCriteria.Any()) count++;
            return count;
        }
    }

    private bool _isLoading = false;

    private bool includePapersInTitleSearch = false;
    private bool includePapersInAuthorsSearch = false;
    private bool includePapersInCategoriesSearch = false;
    private bool includePapersInTagsSearch = false;

    private string searchBookTitle = "";
    private List<AutocompleteSuggestion> autocompleteSuggestions = new();
    private bool showAutocompleteDropdown = false;
    private bool isLoadingAutocomplete = false;
    private int activeSuggestionIndex = -1;
    private CancellationTokenSource? _autocompleteCts;
    private string searchBookIsbn = "";
    private string searchBookSbnCode = "";
    private string sbnSearchMode = "contains"; // contains, exact, hasSbn, missingSbn
    private int? searchBookYear = null;
    private int? searchBookYearTo = null;
    private string yearSearchMode = "exact"; // exact, after, before, between
    
    private string authorSearchNameFilter ="";
    private List<Author> foundAuthorsForFilter = new();
    private Author? selectedAuthorFromResults = null;
    private bool showAuthorSearchResults = false;
    private bool isLoadingAuthors = false;
    private List<Author> searchAuthorsCriteria = new();

    private string selectedCategoryForFilter = "";
    private List<Category> searchCategoriesCriteria = new();

    public string CurrentSemanticQuery => semanticSearchText;
    private string semanticSearchText = "";
    private int semanticSearchLimit = 10;

    private List<Tag> allBookTags = new();
    private List<Tag> searchTagsCriteria = new();
    private string selectedTagNameForFilter = "";

    private List<DistributionPoint> allDistributionPoints = new();
    private List<DistributionPoint> searchDistributionPointsCriteria = new();
    private string selectedDistributionPointIdForFilter = "";

    private bool isInitialSearchTriggered = false;
    private UserContext? _userContext;
    private TenantId _currentTenant = TenantId.Default;

    private async Task<UserContext> GetUserContextAsync()
    {
        if (_userContext == null)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _userContext = blazorBookLibrary.Shared.ConverterUtils.fromClaimsPrincipal(authState.User);
        }
        return _userContext;
    }

    protected override async Task OnInitializedAsync()
    {
        var userContext = await GetUserContextAsync();

        if (userContext.IsAuthenticated)
        {
            var userId = userContext.UserId.Value;
            var userResult = await UserService.GetUserAsync(userContext, userId);
            if (userResult.IsOk)
            {
                _currentTenant = userResult.ResultValue.CurrentTenant;
                _userContext = _userContext.WithNewTenant(_currentTenant);
            }
        }

        var tenantResult = await TenantService.GetTenantAsync(_userContext ?? userContext, _currentTenant, FSharpOption<CancellationToken>.None);
        if (tenantResult.IsOk)
        {
            allBookTags = tenantResult.ResultValue.Tags.Where(t => t.IsBookTag).ToList();
        }

        var dpResult = await DistributionPointService.GetAllDistributionPointsAsync(userContext);
        if (dpResult.IsOk)
        {
            allDistributionPoints = dpResult.ResultValue.ToList();
        }

        if (!isInitialSearchTriggered && !string.IsNullOrEmpty(InitialDistributionPointId) && allDistributionPoints.Any())
        {
            var guidResult = Guid.TryParse(InitialDistributionPointId, out var guid);
            if (guidResult)
            {
                var dp = allDistributionPoints.FirstOrDefault(d => d.DistributionPointId.Value == guid);
                if (dp != null && !searchDistributionPointsCriteria.Any(x => x.DistributionPointId == dp.DistributionPointId))
                {
                    searchDistributionPointsCriteria.Add(dp);
                    isInitialSearchTriggered = true;
                    // We need a small delay or StateHasChanged to ensure the UI reflects the added criteria before search starts
                    await HandleBookSearch();
                }
            }
        }
    }

    private bool AreOtherFiltersActive => 
        !string.IsNullOrWhiteSpace(searchBookTitle) || 
        !string.IsNullOrWhiteSpace(searchBookIsbn) || 
        (sbnSearchMode == "hasSbn" || sbnSearchMode == "missingSbn" || !string.IsNullOrWhiteSpace(searchBookSbnCode)) ||
        searchBookYear.HasValue || 
        searchAuthorsCriteria.Any() || 
        searchCategoriesCriteria.Any() ||
        searchTagsCriteria.Any() ||
        searchDistributionPointsCriteria.Any() ||
        searchBookAvailability != "All";

    private bool IsIsbnSearchActive => !string.IsNullOrWhiteSpace(searchBookIsbn);
    private bool IsSbnSearchActive => sbnSearchMode == "hasSbn" || sbnSearchMode == "missingSbn" || !string.IsNullOrWhiteSpace(searchBookSbnCode);

    private FSharpList<Category> allCategories = Category.AllCases();

    private string searchBookAvailability = "All"; // All, Circulating, ReferenceOnly, Unspecified, ImmediatelyAvailable
    private BookSearchCriteria searchCriteria 
    {
        get 
        {
            var criteriaList = new List<BookSearchCriteria>();

            bool anyPaperInclusion = includePapersInTitleSearch || includePapersInAuthorsSearch || includePapersInCategoriesSearch;

            if (anyPaperInclusion)
            {
                if (!string.IsNullOrWhiteSpace(searchBookTitle))
                {
                    criteriaList.Add(SearchCriteria.searchByTitleWithPapers(searchBookTitle, includePapersInTitleSearch));
                }

                if (searchAuthorsCriteria.Any())
                {
                    var authorIds = searchAuthorsCriteria.Select(a => a.AuthorId);
                    criteriaList.Add(SearchCriteria.searchByAuthorsWithPapers(authorIds, includePapersInAuthorsSearch));
                }

                if (searchCategoriesCriteria.Any())
                {
                    criteriaList.Add(SearchCriteria.searchByCategoriesWithPapers(searchCategoriesCriteria, includePapersInCategoriesSearch));
                }
            }

            if (!string.IsNullOrEmpty(searchBookAvailability) && searchBookAvailability != "All")
            {
                criteriaList.Add(SearchCriteria.searchByAvailability(searchBookAvailability));
            }

            if (searchTagsCriteria.Any())
            {
                criteriaList.Add(SearchCriteria.searchByTagsWithPapers(searchTagsCriteria, includePapersInTagsSearch));
            }

            if (searchDistributionPointsCriteria.Any())
            {
                var dpIds = searchDistributionPointsCriteria.Select(dp => dp.DistributionPointId);
                criteriaList.Add(SearchCriteria.searchByDistributionPoints(dpIds));
            }

            if (sbnSearchMode == "hasSbn")
            {
                criteriaList.Add(SearchCriteria.searchHasSbnCode);
            }
            else if (sbnSearchMode == "missingSbn")
            {
                criteriaList.Add(SearchCriteria.searchMissingSbnCode);
            }
            else if (!string.IsNullOrWhiteSpace(searchBookSbnCode))
            {
                if (sbnSearchMode == "exact")
                {
                    criteriaList.Add(SearchCriteria.searchByExactSbnCode(searchBookSbnCode));
                }
                else
                {
                    criteriaList.Add(SearchCriteria.searchBySbnCode(searchBookSbnCode));
                }
            }

            return SearchCriteria.composeAll(criteriaList);
        }
    }

    private async Task HandleAuthorSearchInput(ChangeEventArgs e)
    {
        authorSearchNameFilter = e.Value?.ToString() ?? "";
        if (authorSearchNameFilter.Length >= 2)
        {
            isLoadingAuthors = true;
            try
            {
                var userContext = await GetUserContextAsync();
                var name = Name.New(authorSearchNameFilter);
                var result = await AuthorService.SearchByNameAsync(userContext, name, FSharpOption<CancellationToken>.None);
                
                if (result.IsOk)
                {
                    foundAuthorsForFilter = result.ResultValue.ToList();
                    showAuthorSearchResults = foundAuthorsForFilter.Any();
                }
                else
                {
                    foundAuthorsForFilter.Clear();
                    showAuthorSearchResults = false;
                    await OnError.InvokeAsync(L["ErrorSearchingAuthors", result.ErrorValue]);
                }
            }
            finally
            {
                isLoadingAuthors = false;
            }
        }
        else
        {
            foundAuthorsForFilter.Clear();
            showAuthorSearchResults = false;
            selectedAuthorFromResults = null;
        }
    }

    private void SelectAuthorFromResults(Author author)
    {
        selectedAuthorFromResults = author;
        authorSearchNameFilter = author.Name.Value;
        showAuthorSearchResults = false;
    }

    private void AddAuthorToSearchCriteria()
    {
        if (selectedAuthorFromResults == null) return;
        
        if (!searchAuthorsCriteria.Any(a => a.AuthorId == selectedAuthorFromResults.AuthorId))
        {
            searchAuthorsCriteria.Add(selectedAuthorFromResults);
        }
        authorSearchNameFilter = "";
        selectedAuthorFromResults = null;
    }

    private void RemoveAuthorFromSearchCriteria(Author author)
    {
        searchAuthorsCriteria.Remove(author);
    }

    private void AddCategoryToSearchCriteria()
    {
        if (string.IsNullOrEmpty(selectedCategoryForFilter)) return;
        var category = Category.FromString(selectedCategoryForFilter);
        if (!searchCategoriesCriteria.Contains(category))
        {
            searchCategoriesCriteria.Add(category);
        }
    }

    private void RemoveCategoryFromSearchCriteria(Category category)
    {
        searchCategoriesCriteria.Remove(category);
    }

    private void AddTagToSearchCriteria()
    {
        if (string.IsNullOrEmpty(selectedTagNameForFilter)) return;
        var tag = allBookTags.FirstOrDefault(t => t.TagName == selectedTagNameForFilter);
        if (tag != null && !searchTagsCriteria.Contains(tag))
        {
            searchTagsCriteria.Add(tag);
        }
        selectedTagNameForFilter = "";
    }

    private void RemoveTagFromSearchCriteria(Tag tag)
    {
        searchTagsCriteria.Remove(tag);
    }

    private void AddDistributionPointToSearchCriteria()
    {
        if (string.IsNullOrEmpty(selectedDistributionPointIdForFilter)) return;
        
        var dpId = new Guid(selectedDistributionPointIdForFilter);
        var dp = allDistributionPoints.FirstOrDefault(d => d.DistributionPointId.Value == dpId);
        
        if (dp != null && !searchDistributionPointsCriteria.Any(x => x.DistributionPointId == dp.DistributionPointId))
        {
            searchDistributionPointsCriteria.Add(dp);
        }
        selectedDistributionPointIdForFilter = "";
    }

    private void RemoveDistributionPointFromSearchCriteria(DistributionPoint dp)
    {
        searchDistributionPointsCriteria.Remove(dp);
    }

    private async Task HandleBookSearch()
    {
        await OnSearchStarted.InvokeAsync(true);
        _isLoading = true;

        try
        {
            if (searchMode == "AI")
            {
                if (string.IsNullOrWhiteSpace(semanticSearchText))
                {
                    await OnSearchResultsFound.InvokeAsync(new List<BookSearchResult>());
                    return;
                }

                var context = await GetUserContextAsync();
                var embeddingResult = await TextEmbeddingService.GetEmbeddingAsync(context, semanticSearchText);
                if (!embeddingResult.IsOk)
                {
                    await OnError.InvokeAsync($"{L["SemanticAnalysisFailed"]}: {embeddingResult.ErrorValue}");
                    return;
                }

                IEnumerable<(BookId, double)> targetResults;
                var vectorResult = await VectorDbService.SearchSimilarEmbeddingsWithScoreAsync(
                    embeddingResult.ResultValue, 
                    _currentTenant,
                    semanticSearchLimit);
                
                if (!vectorResult.IsOk)
                {
                    await OnError.InvokeAsync($"{L["VectorSearchFailed"]}: {vectorResult.ErrorValue}");
                    return;
                }
                targetResults = vectorResult.ResultValue.Select(r => (r.Item2, r.Item3));

                var targetResultsList = targetResults
                    .GroupBy(r => r.Item1)
                    .Select(g => (BookId: g.Key, Score: g.Max(x => x.Item2)))
                    .OrderByDescending(x => x.Score)
                    .ToList();

                var bookIdList = targetResultsList.Select(r => r.BookId).Distinct().ToList();
                if (!bookIdList.Any())
                {
                    await OnSearchResultsFound.InvokeAsync(new List<BookSearchResult>());
                    return;
                }

                var userContext = await GetUserContextAsync();
                var booksResult = await BookService.GetBooksAsync(userContext, ListModule.OfSeq(bookIdList));
                if (booksResult.IsOk)
                {
                    var booksDict = booksResult.ResultValue
                        .GroupBy(b => b.BookId)
                        .ToDictionary(g => g.Key, g => g.First());
                    var sortedResults = new List<BookSearchResult>();
                    
                    for (int i = 0; i < targetResultsList.Count; i++)
                    {
                        var r = targetResultsList[i];
                        if (booksDict.TryGetValue(r.BookId, out var book))
                        {
                            sortedResults.Add(new BookSearchResult(book, FSharpOption<double>.Some(r.Score), FSharpOption<string>.None));
                        }
                    }
                    await OnSearchResultsFound.InvokeAsync(sortedResults);
                }
                else
                {
                    Logger.LogError($"{L["ErrorRetrievingBooks"]}: {booksResult.ErrorValue}");
                    await OnError.InvokeAsync($"{L["ErrorSearchingBooks"]}");
                }
            }
            else
            {
                var result = await ExecuteStandardSearch();
                if (result.IsOk)
                {
                    var results = result.ResultValue
                        .Select(b => new BookSearchResult(b, FSharpOption<double>.None, FSharpOption<string>.None))
                        .ToList();
                    await OnSearchResultsFound.InvokeAsync(results);
                }
                else
                {
                    await OnError.InvokeAsync(L["ErrorSearchingBooks", result.ErrorValue]);
                }
            }
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"{L["UnexpectedSearchError"]}: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<FSharpResult<FSharpList<Book>, string>> ExecuteStandardSearch()
    {
        bool hasTitle = !string.IsNullOrWhiteSpace(searchBookTitle);
        bool hasIsbn = !string.IsNullOrWhiteSpace(searchBookIsbn);
        bool hasYear = searchBookYear.HasValue;
        bool hasBetweenYear = yearSearchMode == "between" && searchBookYear.HasValue && searchBookYearTo.HasValue;

        var userContext = await GetUserContextAsync();

        YearSearch GetYearSearch() {
            var year = searchBookYear ?? 0;
            var yearTo = searchBookYearTo ?? 0;
            return yearSearchMode switch
            {
                "after" => YearSearch.NewAfter(year),
                "before" => YearSearch.NewBefore(year),
                "between" => YearSearch.NewRange(year, yearTo),
                _ => YearSearch.NewExact(year)
            };
        }
        
        bool hasEffectiveYear = hasYear || hasBetweenYear;

        bool anyPaperInclusion = includePapersInTitleSearch || includePapersInAuthorsSearch || includePapersInCategoriesSearch;

        if (anyPaperInclusion)
        {
            if (hasIsbn)
            {
                var isbn = Isbn.NewInvalid(searchBookIsbn);
                return await BookService.SearchByIsbnAsync(userContext, isbn, searchCriteria, CancellationToken.None);
            }
            else if (hasEffectiveYear)
            {
                return await BookService.SearchByYearAsync(userContext, GetYearSearch(), searchCriteria, CancellationToken.None);
            }
            else
            {
                return await BookService.GetAllAsync(userContext, searchCriteria, CancellationToken.None);
            }
        }

        if (hasIsbn)
        {
            var isbn = Isbn.NewInvalid(searchBookIsbn);
            if (hasTitle)
            {
                return await BookService.SearchByIsbnOrTitleAsync(userContext, isbn, Title.New(searchBookTitle), searchCriteria, CancellationToken.None);
            }
            else
            {
                return await BookService.SearchByIsbnAsync(userContext, isbn, searchCriteria, CancellationToken.None);
            }
        }
        else 
        {
            
            if (searchCategoriesCriteria.Any())
            {
                var authorIds = ListModule.OfSeq(searchAuthorsCriteria.Select(a => a.AuthorId));
                var categories = ListModule.OfSeq(searchCategoriesCriteria);
                var yearSearch = GetYearSearch();
                bool hasAuthors = searchAuthorsCriteria.Any();
                
                if (hasAuthors)
                {
                    if (hasTitle && hasEffectiveYear)
                    {
                        return await BookService.SearchByTitleAndAuthorsAndYearAndCategoriesAsync(userContext, Title.New(searchBookTitle), authorIds, yearSearch, categories, searchCriteria, CancellationToken.None);
                    }
                    else if (hasTitle)
                    {
                        return await BookService.SearchByTitleAndAuthorsAndCategoriesAsync(userContext, Title.New(searchBookTitle), authorIds, categories, searchCriteria, CancellationToken.None);
                    }
                    else if (hasEffectiveYear)
                    {
                        return await BookService.SearchByAuthorsAndYearAndCategoriesAsync(userContext, authorIds, yearSearch, categories, searchCriteria, CancellationToken.None);
                    }
                    else
                    {
                        return await BookService.SearchByAuthorsAndCategoriesAsync(userContext, authorIds, categories, searchCriteria, CancellationToken.None);
                    }
                }
                else
                {
                    if (hasTitle && hasEffectiveYear)
                    {
                        return await BookService.SearchByTitleAndYearAndCategoriesAsync(userContext, Title.New(searchBookTitle), yearSearch, categories, searchCriteria, CancellationToken.None);
                    }
                    else if (hasTitle)
                    {
                        return await BookService.SearchByTitleAndCategoriesAsync(userContext, Title.New(searchBookTitle), categories, searchCriteria, CancellationToken.None);
                    }
                    else if (hasEffectiveYear)
                    {
                        return await BookService.SearchByYearAndCategoriesAsync(userContext, yearSearch, categories, searchCriteria, CancellationToken.None); 
                    }
                    else
                    {
                        return await BookService.SearchByCategoriesAsync(userContext, categories, searchCriteria, CancellationToken.None); 
                    }
                }
            }
            else if (searchAuthorsCriteria.Any())
            {
                var authorIds = ListModule.OfSeq(searchAuthorsCriteria.Select(a => a.AuthorId));
                if (hasTitle && hasEffectiveYear)
                {
                    return await BookService.SearchByTitleAndAuthorsAndYearAsync(userContext, Title.New(searchBookTitle), authorIds, GetYearSearch(), searchCriteria, CancellationToken.None);
                }
                else if (hasTitle)
                {
                    return await BookService.SearchByTitleAndAuthorsAsync(userContext, Title.New(searchBookTitle), authorIds, searchCriteria, CancellationToken.None);
                }
                else if (hasEffectiveYear)
                {
                    return await BookService.SearchByAuthorsAndYearAsync(userContext, authorIds, GetYearSearch(), searchCriteria, CancellationToken.None);
                }
                else
                {
                    return await BookService.SearchByAuthorsAsync(userContext, authorIds, searchCriteria, CancellationToken.None);
                }
            }
            else if (hasTitle && hasEffectiveYear)
            {
                return await BookService.SearchByTitleAndYearAsync(userContext, Title.New(searchBookTitle), GetYearSearch(), searchCriteria, CancellationToken.None);
            }
            else if (hasTitle)
            {
                return await BookService.SearchByTitleAsync(userContext, Title.New(searchBookTitle), searchCriteria, CancellationToken.None);
            }
            else if (hasEffectiveYear)
            {
                return await BookService.SearchByYearAsync(userContext, GetYearSearch(), searchCriteria, CancellationToken.None);
            }
            else
            {
                return await BookService.GetAllAsync(userContext, searchCriteria, CancellationToken.None);
            }
        }
    }

    private void CancelAutocompleteToken()
    {
        if (_autocompleteCts != null)
        {
            try
            {
                if (!_autocompleteCts.IsCancellationRequested)
                {
                    _autocompleteCts.Cancel();
                }
            }
            catch (ObjectDisposedException) { }
            catch (AggregateException) { }

            try
            {
                _autocompleteCts.Dispose();
            }
            catch (ObjectDisposedException) { }

            _autocompleteCts = null;
        }
    }

    private async Task HandleTitleInput(ChangeEventArgs e)
    {
        searchBookTitle = e.Value?.ToString() ?? "";
        activeSuggestionIndex = -1;

        CancelAutocompleteToken();

        if (string.IsNullOrWhiteSpace(searchBookTitle) || searchBookTitle.Trim().Length < 2)
        {
            autocompleteSuggestions.Clear();
            showAutocompleteDropdown = false;
            isLoadingAutocomplete = false;
            return;
        }

        var cts = new CancellationTokenSource();
        _autocompleteCts = cts;
        var token = cts.Token;

        try
        {
            isLoadingAutocomplete = true;
            await Task.Delay(250, token);

            var userContext = await GetUserContextAsync();
            var result = await BookService.AutocompleteAsync(userContext, searchBookTitle.Trim(), FSharpOption<int>.Some(8), FSharpOption<CancellationToken>.Some(token));

            if (!token.IsCancellationRequested)
            {
                if (result.IsOk)
                {
                    autocompleteSuggestions = result.ResultValue.ToList();
                    showAutocompleteDropdown = autocompleteSuggestions.Any();
                }
                else
                {
                    autocompleteSuggestions.Clear();
                    showAutocompleteDropdown = false;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Debounced or superseded
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error during title autocompletion");
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                isLoadingAutocomplete = false;
                StateHasChanged();
            }
        }
    }

    private async Task HandleTitleKeyDown(KeyboardEventArgs e)
    {
        if (!showAutocompleteDropdown || !autocompleteSuggestions.Any())
        {
            return;
        }

        if (e.Key == "ArrowDown")
        {
            activeSuggestionIndex = (activeSuggestionIndex + 1) % autocompleteSuggestions.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            activeSuggestionIndex = activeSuggestionIndex <= 0 ? autocompleteSuggestions.Count - 1 : activeSuggestionIndex - 1;
        }
        else if (e.Key == "Enter")
        {
            if (activeSuggestionIndex >= 0 && activeSuggestionIndex < autocompleteSuggestions.Count)
            {
                var selected = autocompleteSuggestions[activeSuggestionIndex];
                await SelectSuggestion(selected);
            }
        }
        else if (e.Key == "Escape")
        {
            showAutocompleteDropdown = false;
            activeSuggestionIndex = -1;
        }
    }

    private async Task SelectSuggestion(AutocompleteSuggestion suggestion)
    {
        searchBookTitle = suggestion.Title;
        showAutocompleteDropdown = false;
        activeSuggestionIndex = -1;
        await HandleBookSearch();
    }

    private void HandleTitleFocus()
    {
        if (autocompleteSuggestions.Any() && !string.IsNullOrWhiteSpace(searchBookTitle) && searchBookTitle.Trim().Length >= 2)
        {
            showAutocompleteDropdown = true;
        }
    }

    private async Task HandleTitleBlur()
    {
        await Task.Delay(250);
        showAutocompleteDropdown = false;
        activeSuggestionIndex = -1;
        StateHasChanged();
    }

    public void Dispose()
    {
        CancelAutocompleteToken();
    }

    public Task PerformSearch() => HandleBookSearch();
}

