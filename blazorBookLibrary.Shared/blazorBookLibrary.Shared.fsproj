<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Slices/Security/RecaptchaVerifyResponse.fs" />
    <Compile Include="Slices/Security/IBotScoreService.fs" />
    <Compile Include="Library.fs" />
    <Compile Include="Slices/Common/Commons.fs" />
    <Compile Include="Slices/Common/ConverterUtils.fs" />

    <!-- <Compile Include="Domain/Tags.fs" /> -->

    <Compile Include="Slices/Book/Book.fs" />
