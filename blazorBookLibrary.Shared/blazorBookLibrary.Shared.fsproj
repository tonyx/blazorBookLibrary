    <Compile Include="Slices/User/User.fs" />
    <Compile Include="Slices/Book/IsbnRegistry.fs" />
    <Compile Include="Slices/Tenant/Tenant.fs" />
    <Compile Include="Slices/Reservation/Reservation.fs" />
    <Compile Include="Slices/Loan/Loan.fs" />
    <Compile Include="Slices/Review/Review.fs" />
    <Compile Include="Slices/DistributionPoint/DistributionPoint.fs" />
    <Compile Include="Slices/Notification/Notification.fs" />

    <Compile Include="SearchModels.fs" />
    <Compile Include="Slices/Details/Details.fs" />
    
    <Compile Include="Slices/Notification/IMailBodyRetriever.fs" />
    <Compile Include="Slices/Notification/IInAppMessagesRetriever.fs" />
    <Compile Include="Slices/Author/IAuthorService.fs" />
    <Compile Include="Slices/Book/IVectorDbService.fs" />
    <Compile Include="Slices/Book/IBookService.fs" />
    <Compile Include="Slices/Editor/IEditorService.fs" />
    <Compile Include="Slices/Loan/ILoanService.fs" />
    <Compile Include="Slices/Reservation/IReservationService.fs" />
    <Compile Include="Slices/Book/IBooksMetadataSearchService.fs" />
    <Compile Include="Slices/Author/IAuthorsSearchService.fs" />
    <Compile Include="Slices/User/IUserService.fs" />
    <Compile Include="Slices/Tenant/ICookieService.fs" />
    <Compile Include="Slices/Tenant/IUserTenantResolverService.fs" />
    <Compile Include="Slices/Tenant/ITenantCacheWarmupService.fs" />
    <Compile Include="Slices/Review/IReviewService.fs" />
    <Compile Include="Slices/Details/IDetailsService.fs" />
    <Compile Include="Slices/DataExport/IDataExportService.fs" />
    <Compile Include="Slices/Book/ITextEmbeddingService.fs" />
    <Compile Include="Slices/Admin/IAdminService.fs" />
